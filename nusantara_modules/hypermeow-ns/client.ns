fungsi _thumb_kecil(path_sumber) {
    jika tipe(path_sumber) != "teks" || panjang(path_sumber) == 0 || !file_ada(path_sumber) { hasil ""; }
    buat path_kecil = "/tmp/thumb_" + ke_teks(waktu()) + "_" + CP["acak_bytes_hex"](4) + ".jpg";
    buat r = jalankan_perintah("timeout", ["-s", "KILL", "20", "ffmpeg", "-y", "-i", path_sumber,
        "-vf", "scale=320:-1", "-q:v", "12", path_kecil]);
    jika r["status"] == 0 && file_ada(path_kecil) { hasil baca_file(path_kecil); }
    hasil "";
}

fungsi kirim_tombol_lokasi_grup(k, group_user, judul, alamat, isi, footer, tombol_list, path_thumb, kutip, node_ekstra) {
    buat thumb = _thumb_kecil(path_thumb);
    buat wire = MS.BangunPesanTombolLokasi(judul, alamat, isi, footer, tombol_list, thumb, kutip);
    buat nodes = [MS.BuatNodeBizBypass()];
    jika tipe(node_ekstra) == "peta" { tambah(nodes, node_ekstra); }
    lain jika tipe(node_ekstra) == "larik" {
        untuk (buat i = 0; i < panjang(node_ekstra); i = i + 1) { tambah(nodes, node_ekstra[i]); }
    }
    hasil KirimWireGrup(k, group_user, wire, "[tombol-lokasi] " + ke_teks(judul), 0, nodes);
}

