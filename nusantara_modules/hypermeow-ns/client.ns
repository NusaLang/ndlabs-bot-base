fungsi unduh_media_pesan(k, m_media, path_tujuan) {
    jika tipe(m_media) != "peta" || tipe(m_media["url"]) != "teks" {
        lempar "gak ada media buat diunduh";
    }
    buat sha_hex = kosong;
    jika tipe(m_media["file_sha256"]) == "teks" && panjang(m_media["file_sha256"]) == 32 {
        sha_hex = CP["hex_encode"](m_media["file_sha256"]);
    }
    buat plain = MEDIA.UnduhMedia(m_media["url"], m_media["media_key"], m_media["tipe_media"], sha_hex, path_tujuan);
    tulis_file(path_tujuan, plain);
    hasil plain;
}

