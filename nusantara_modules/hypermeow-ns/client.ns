fungsi _json_teks(s) {
    buat out = "";
    untuk (buat i = 0; i < panjang(s); i = i + 1) {
        buat c = potong(s, i, i + 1);
        jika c == "\"" { out = out + "\\\""; }
        lain jika c == "\\" { out = out + "\\\\"; }
        lain { out = out + c; }
    }
    hasil out;
}

fungsi tombol_url(label, url) {
    buat json = "{\"display_text\":\"" + _json_teks(label) + "\",\"url\":\"" + _json_teks(url) + "\"}";
    hasil MS.BangunTombolNativeFlow("cta_url", json);
}

fungsi tombol_balasan_cepat(label, id_perintah) {
