
buat ST    = impor("store/session.ns");
buat KEYS  = impor("util/keys.ns");
buat FS    = impor("socket/framesocket.ns");
buat NS    = impor("socket/noisesocket.ns");
buat EN    = impor("binary/codec_encode.ns");
buat D     = impor("binary/codec_decode.ns");
buat PC    = impor("pair_code.ns");
buat PS    = impor("pair_success.ns");
buat PRES  = impor("presence.ns");
buat MS    = impor("msgsend.ns");
buat SEC   = impor("msgsecret.ns");
buat MEDIA = impor("media.ns");
buat NOTIF = impor("notification.ns");
buat GRP   = impor("group.ns");
buat CALL  = impor("call.ns");
buat AS    = impor("appstate.ns");
buat AK    = impor("appstate/keys.ns");
buat NEWS  = impor("newsletter.ns");
buat PB    = impor("proto/pb.ns");
buat CP    = muat_plugin("crypto");
buat WS    = muat_plugin("ws");

buat BATAS_UMUR_PESAN = 90;

// Format ID pesan asli WhatsApp: 32 karakter hex huruf besar (16 byte
// acak), bukan "msg_<timestamp>" -- biar kelihatan sama persis kayak yang
// dipakai klien WhatsApp beneran (mis. "AC147E78010B2C4D829DF11BCEAD2882").
fungsi _buat_msg_id() {
    hasil huruf_besar(CP["acak_bytes_hex"](16));
}

fungsi pesan_lama(k, node) {
    buat na = node["attrs"];
    jika tipe(na) != "peta" { hasil salah; }

    buat off = na["offline"];
    jika tipe(off) == "teks" && panjang(off) > 0 && off != "0" { hasil benar; }

    jika tipe(na["t"]) == "teks" && panjang(na["t"]) > 0 {
        buat umur = waktu() - ke_angka(na["t"]);
        jika umur > BATAS_UMUR_PESAN { hasil benar; }
    }

    jika tipe(k["mulai_koneksi"]) == "angka" && (waktu() - k["mulai_koneksi"]) < 5 { hasil benar; }
    hasil salah;
}

fungsi antrikan_node(k, node) {
    jika tipe(k["antrian_node"]) != "larik" { k["antrian_node"] = []; }
    jika panjang(k["antrian_node"]) >= 200 {
        cetak("[ANTRIAN] Penuh, node dibuang: " + ke_teks(node["tag"]));
        hasil kosong;
    }
    tambah(k["antrian_node"], node);
}

fungsi ProsesAntrian(k) {
    jika k["kuras_antrian"] == benar { hasil kosong; }
    jika tipe(k["antrian_node"]) != "larik" { hasil kosong; }
    k["kuras_antrian"] = benar;
    buat putaran = 0;
    selama panjang(k["antrian_node"]) > 0 && putaran < 500 {
        putaran = putaran + 1;
        buat n = k["antrian_node"][0];
        k["antrian_node"] = potong(k["antrian_node"], 1, panjang(k["antrian_node"]));
        coba {
            ProsesNode(k, n);
        } tangkap (e) {
            cetak("[ANTRIAN] Gagal proses node tertunda: " + ke_teks(e));
        }
    }
    k["kuras_antrian"] = salah;
}

// Multiplexer IQ: loop koneksi (runtime.ns) adalah SATU-SATUNYA pemanggil
// ws_terima -- native plugin ws.cpp gak nge-lock buffer terima (rbuf),
// jadi dua pembaca sekaligus di socket yang sama itu race condition
// beneran di level C++ (bukan cuma soal GC), bukan cuma "boleh apa
// enggak" secara logika. Siapapun (termasuk goroutine) yang perlu nunggu
// balesan IQ tertentu daftar kanal di sini; loop koneksi yang isi kanalnya
// begitu nemu node <iq> yang id-nya cocok -- lihat coba_serahkan_ke_penunggu.
//
// CATATAN (versi awal salah, jangan diulang): sempet nyoba satu goroutine
// timeout (jalan(...) + jalankan_perintah("sleep", ...)) per PANGGILAN
// tunggu_iq. Itu bikin leak beneran -- goroutine+subprocess-nya tetep
// idup penuh 30 detik walau responsnya udah dateng duluan, jadi pas
// traffic tinggi (banyak tunggu_iq/detik) numpuknya lebih cepet dari
// yang expire, RAM meledak (21MB -> 700MB+ dalam <1 menit pas dites live).
// Sekarang: gak ada goroutine/subprocess per panggilan sama sekali --
// deadline dicatet di peta, disapu bareng loop utama yang udah ada
// (sapu_iq_waiters_timeout, dipanggil dari runtime.ns tiap ~1 detik).
fungsi TungguIq(k, req_id, batas) {
    jika tipe(k["iq_waiters"]) != "peta" { k["iq_waiters"] = peta_baru(); }
    buat c = kanal_baru(1);
    buat w = peta_baru();
    w["kanal"] = c;
    w["batas_waktu"] = waktu() + 30;
    k["iq_waiters"][req_id] = w;
    buat hasil_node = kanal_terima(c);
    k["iq_waiters"][req_id] = kosong;
    jika tipe(hasil_node) == "teks" && hasil_node == "__IQ_TIMEOUT__" {
        lempar "timeout nunggu iq id=" + ke_teks(req_id);
    }
    hasil hasil_node;
}

// Dipanggil loop koneksi (satu-satunya pembaca socket) buat tiap node
// yang udah didekode. Kalau ini balesan yang lagi ditunggu (lewat
// tunggu_iq), dikirim ke kanal-nya; kalau bukan, diproses/diantrikan
// seperti biasa. Balikin `benar` kalau node ini "dikonsumsi" jalur
// tunggu (jadi jangan diproses lagi sebagai node biasa).
fungsi CobaSerahkanKePenunggu(k, node) {
    jika node["tag"] != "iq" { hasil salah; }
    jika tipe(k["iq_waiters"]) != "peta" { hasil salah; }
    buat req_id = node["attrs"]["id"];
    buat w = k["iq_waiters"][req_id];
    jika tipe(w) != "peta" { hasil salah; }
    k["iq_waiters"][req_id] = kosong;
    coba { kanal_kirim(w["kanal"], node); } tangkap (e) {}
    hasil benar;
}

// Disapu bareng loop koneksi (bukan goroutine sendiri per panggilan --
// lihat catatan di tunggu_iq) tiap ~1 detik buat nyariin waiter yang
// udah lewat batas_waktu-nya dan gak pernah dijawab.
fungsi SapuIqWaitersTimeout(k) {
    jika tipe(k["iq_waiters"]) != "peta" { hasil kosong; }
    buat kunci = peta_kunci(k["iq_waiters"]);
    buat sekarang = waktu();
    untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
        buat rid = kunci[i];
        buat w = k["iq_waiters"][rid];
        jika tipe(w) != "peta" { lanjut; }
        jika sekarang >= w["batas_waktu"] {
            k["iq_waiters"][rid] = kosong;
            coba { kanal_kirim(w["kanal"], "__IQ_TIMEOUT__"); } tangkap (e) {}
        }
    }
}

fungsi ambil_media_conn(k) {
    jika tipe(k["media_conn"]) == "peta" && k["media_conn"]["ok"] { hasil k["media_conn"]; }
    buat req_id = "mconn_" + ke_teks(waktu());
    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(MEDIA.BuatNodeMediaConn(req_id)));
    buat mc = MEDIA.UraiMediaConn(TungguIq(k, req_id, 200));
    jika !mc["ok"] { lempar "gagal dapet media_conn"; }
    k["media_conn"] = mc;
    hasil mc;
}

fungsi _histsync_ada(s, cari) {
    buat n = panjang(cari);
    untuk (buat i = 0; i + n <= panjang(s); i = i + 1) {
        jika potong(s, i, i + n) == cari { hasil benar; }
    }
    hasil salah;
}

fungsi _arsip_pesan_lama(k, chat, p) {
    jika tipe(p["message_wire"]) != "teks" || panjang(p["message_wire"]) == 0 { hasil kosong; }
    buat msg_id = p["id"];
    jika tipe(msg_id) != "teks" || panjang(msg_id) == 0 { hasil kosong; }
    jika k["ARSIP"].SudahDiarsip("lama_" + msg_id) { hasil kosong; }

    buat fields = PB.PbDekode(p["message_wire"]);
    buat bd = MS.EkstrakBudy(fields);
    buat sender = p["participant"];
    jika tipe(sender) != "teks" || panjang(sender) == 0 { sender = "?"; }
    jika _histsync_ada(sender, "@lid") {
        buat lid_user = sender;
        untuk (buat si = 0; si < panjang(sender); si = si + 1) {
            jika byte_di(sender, si) == 64 { lid_user = potong(sender, 0, si); berhenti; }
        }
        coba {
            buat pn = k["DB"].LIDKeJID(lid_user);
            jika tipe(pn) == "teks" && panjang(pn) > 0 { sender = pn; }
        } tangkap (e) {}
    }

    jika bd["ada_media"] {
        buat ext = "bin";
        buat mime = bd["media"]["mimetype"];
        jika tipe(mime) == "teks" {
            jika _histsync_ada(mime, "jpeg") { ext = "jpg"; }
            lain jika _histsync_ada(mime, "png") { ext = "png"; }
            lain jika _histsync_ada(mime, "webp") { ext = "webp"; }
            lain jika _histsync_ada(mime, "mp4") { ext = "mp4"; }
            lain jika _histsync_ada(mime, "ogg") { ext = "ogg"; }
        }
        buat dir = "arsip_media/" + chat + "/lama";
        jalankan_perintah("mkdir", ["-p", dir]);
        buat path_file = dir + "/" + msg_id + "." + ext;
        coba {
            unduh_media_pesan(k, bd["media"], path_file);
            k["ARSIP"].SimpanArsip("lama_" + msg_id, chat, sender, bd["media"]["tipe_media"], bd["media"]["mimetype"], bd["media"]["caption"], bd["body"], path_file, bd["dibungkus"]);
        } tangkap (e) {
            cetak("[WARN] Gagal download media lama: " + ke_teks(e));
        }
    } lain {
        k["ARSIP"].SimpanArsip("lama_" + msg_id, chat, sender, "text", "", bd["body"], bd["body"], "", bd["dibungkus"]);
    }
}

fungsi proses_history_sync_notifikasi(k, pm_bytes) {
    buat hsn = MS.UraiHistorySyncNotification(pm_bytes);
    jika !hsn["ok"] { hasil kosong; }
    jika tipe(k["ARSIP"]) != "peta" { hasil kosong; }
    cetak("[HISTORY SYNC] Notifikasi diterima, download blob...");
    buat mc = ambil_media_conn(k);
    jika tipe(mc) != "peta" || !mc["ok"] { lempar "media_conn gak siap"; }
    buat tmp_path = "/tmp/histsync_" + ke_teks(waktu()) + "_" + CP["acak_bytes_hex"](4) + ".bin";
    buat blob = MEDIA.UnduhMediaByPath(mc["host"][0], hsn["direct_path"], hsn["file_enc_sha256"], hsn["media_key"], MEDIA.INFO_HISTORY, "md-msg-hist", tmp_path);
    buat parsed = MS.UraiHistorySyncBlob(blob);
    cetak("[HISTORY SYNC] " + ke_teks(panjang(parsed["conversations"])) + " percakapan diterima.");

    buat target_grup = k["GRUP_USER_DIBISUKAN"];
    jika tipe(target_grup) != "teks" { hasil kosong; }

    untuk (buat ci = 0; ci < panjang(parsed["conversations"]); ci = ci + 1) {
        buat conv = parsed["conversations"][ci];
        buat conv_user = conv["id"];
        jika tipe(conv_user) != "teks" { lanjut; }
        untuk (buat gi = 0; gi < panjang(conv_user); gi = gi + 1) {
            jika byte_di(conv_user, gi) == 64 { conv_user = potong(conv_user, 0, gi); berhenti; }
        }
        jika conv_user != target_grup { lanjut; }

        cetak("[HISTORY SYNC] Grup dibisukan ketemu, " + ke_teks(panjang(conv["pesan"])) + " pesan lama diproses.");
        untuk (buat pi = 0; pi < panjang(conv["pesan"]); pi = pi + 1) {
            coba { _arsip_pesan_lama(k, conv["id"], conv["pesan"][pi]); }
            tangkap (e) { cetak("[WARN] Gagal arsip pesan lama: " + ke_teks(e)); }
        }
    }
}

fungsi unggah_berkas(k, path_berkas, tipe_media) {
    buat isi = baca_file(path_berkas);
    jika tipe(isi) != "teks" || panjang(isi) == 0 { lempar "file kosong/gak kebaca: " + ke_teks(path_berkas); }
    buat siap = MEDIA.SiapkanUpload(isi, tipe_media);
    coba {
        hasil MEDIA.UnggahMedia(siap, tipe_media, ambil_media_conn(k), path_berkas + ".enc");
    } tangkap (e) {
        // media_conn (token auth upload) di-cache di k["media_conn"] dan
        // gak ada pengecekan expiry -- token-nya beneran punya TTL di
        // sisi WhatsApp, jadi kalau bot idle lama terus ada yang kirim
        // media, upload bisa gagal 401 pake token basi. Retry SEKALI
        // dengan media_conn baru sebelum benar-benar nyerah.
        buat pesan_err = ke_teks(e);
        jika _ada_potongan(pesan_err, "401") {
            k["media_conn"] = kosong;
            hasil MEDIA.UnggahMedia(siap, tipe_media, ambil_media_conn(k), path_berkas + ".enc");
        }
        lempar e;
    }
}

fungsi durasi_media_detik(path_media) {
    buat res = jalankan_perintah("timeout", ["-s", "KILL", "15", "ffprobe", "-v", "error", "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1", path_media]);
    jika res["status"] != 0 { hasil 0; }
    buat teks_durasi = ke_teks(res["keluaran"]);
    buat bersih = "";
    untuk (buat i = 0; i < panjang(teks_durasi); i = i + 1) {
        buat b = byte_di(teks_durasi, i);
        jika (b >= 48 && b <= 57) || b == 46 { bersih = bersih + potong(teks_durasi, i, i + 1); }
    }
    jika panjang(bersih) == 0 { hasil 0; }
    coba { hasil ke_angka(bersih); } tangkap (e) { hasil 0; }
}

fungsi _webp_valid(path_webp) {
    jika !file_ada(path_webp) { hasil salah; }
    buat isi = baca_file(path_webp);
    jika tipe(isi) != "teks" || panjang(isi) < 100 { hasil salah; }
    hasil potong(isi, 0, 4) == "RIFF" && potong(isi, 8, 12) == "WEBP";
}

fungsi buat_stiker_dari_gambar(path_sumber, path_webp, crop) {
    buat filter = "scale=512:512:force_original_aspect_ratio=decrease,pad=512:512:(ow-iw)/2:(oh-ih)/2:color=#00000000";
    jika crop { filter = "scale=512:512:force_original_aspect_ratio=increase,crop=512:512"; }
    buat percobaan = 0;
    buat res = kosong;
    selama percobaan < 3 {
        res = jalankan_perintah("timeout", ["-s", "KILL", "30", "ffmpeg", "-y", "-i", path_sumber, "-vf", filter,
            "-vcodec", "libwebp", "-lossless", "0", "-compression_level", "6", "-q:v", "70",
            "-preset", "picture", "-loop", "0", "-an", "-vsync", "0", path_webp]);
        jika res["status"] == 0 && _webp_valid(path_webp) { hasil benar; }
        percobaan = percobaan + 1;
    }
    lempar "gagal konversi ke stiker: " + ke_teks(res["error"]);
}

fungsi buat_stiker_dari_video(path_sumber, path_webp, crop, fps_target) {
    buat filter = "scale=512:512:force_original_aspect_ratio=decrease,pad=512:512:(ow-iw)/2:(oh-ih)/2:color=#00000000,fps=" + ke_teks(fps_target);
    jika crop { filter = "scale=512:512:force_original_aspect_ratio=increase,crop=512:512,fps=" + ke_teks(fps_target); }
    buat percobaan = 0;
    buat res = kosong;
    selama percobaan < 3 {
        res = jalankan_perintah("timeout", ["-s", "KILL", "60", "ffmpeg", "-y", "-i", path_sumber, "-vf", filter,
            "-vcodec", "libwebp", "-lossless", "0", "-compression_level", "6", "-q:v", "45",
            "-preset", "picture", "-loop", "0", "-an", "-vsync", "0", "-t", "10", path_webp]);
        jika res["status"] == 0 && _webp_valid(path_webp) { hasil benar; }
        percobaan = percobaan + 1;
    }
    lempar "gagal konversi video ke stiker: " + ke_teks(res["error"]);
}

fungsi _le4(n) {
    hasil teks_dari(n % 256) + teks_dari((n / 256) % 256) + teks_dari((n / 65536) % 256) + teks_dari((n / 16777216) % 256);
}

fungsi tulis_metadata_stiker(path_webp, nama_paket, penulis) {
    buat json = "[{\"sticker-pack-id\":\"ndlabs-" + ke_teks(waktu()) + "\",\"sticker-pack-name\":\""
        + nama_paket + "\",\"sticker-pack-publisher\":\"" + penulis + "\",\"emojis\":[\"🤖\"]}]";

    buat prefix_awal = CP["hex_decode"]("49492a0008000000010041570700");
    buat prefix_akhir = CP["hex_decode"]("16000000");
    buat exif = prefix_awal + _le4(panjang(json)) + prefix_akhir + json;

    buat path_exif = path_webp + ".exif";
    tulis_file(path_exif, exif);
    buat res = jalankan_perintah("timeout", ["-s", "KILL", "20", "bash", "-c",
        "webpmux -set exif " + path_exif + " " + path_webp + " -o " + path_webp + ".tmp && mv " + path_webp + ".tmp " + path_webp]);
    jika res["status"] != 0 { lempar "gagal tulis metadata stiker: " + ke_teks(res["error"]); }
}

fungsi kirim_stiker_grup(k, group_user, path_webp, kutip) {
    buat isi = baca_file(path_webp);
    jika tipe(isi) != "teks" || panjang(isi) == 0 { lempar "file stiker kosong/gak kebaca"; }
    buat siap = MEDIA.SiapkanUpload(isi, "sticker");
    buat up = kosong;
    coba {
        up = MEDIA.UnggahMedia(siap, "sticker", ambil_media_conn(k), path_webp + ".enc");
    } tangkap (e) {
        // Sama kayak unggah_berkas -- media_conn di-cache tanpa
        // expiry-check, jadi bisa gagal 401 pake token basi. Jalur
        // upload stiker ini gak lewat unggah_berkas (punya upload
        // langsung sendiri), jadi retry-nya diulang di sini juga.
        jika _ada_potongan(ke_teks(e), "401") {
            k["media_conn"] = kosong;
            up = MEDIA.UnggahMedia(siap, "sticker", ambil_media_conn(k), path_webp + ".enc");
        } lain {
            lempar e;
        }
    }
    buat animasi = (_ada_potongan(isi, "ANIM"));
    buat wire = MS.BangunPesanSticker(up, 512, 512, animasi, kutip);
    hasil KirimWireGrup(k, group_user, wire, "[stiker]", 0, kosong);
}

fungsi _ada_potongan(s, cari) {
    buat n = panjang(cari);
    untuk (buat i = 0; i + n <= panjang(s); i = i + 1) {
        jika potong(s, i, i + n) == cari { hasil benar; }
    }
    hasil salah;
}

fungsi kirim_gambar_grup(k, group_user, path_berkas, caption, kutip) {
    buat up = unggah_berkas(k, path_berkas, "image");
    buat wire = MS.BangunPesanGambar(up, caption, "image/jpeg", 0, 0, kutip, kosong);
    hasil KirimWireGrup(k, group_user, wire, "[gambar] " + ke_teks(caption), 0, kosong);
}

fungsi kirim_dokumen_grup(k, group_user, path_berkas, nama_file, mimetype, kutip) {
    buat up = unggah_berkas(k, path_berkas, "document");
    buat wire = MS.BangunPesanDokumen(up, nama_file, mimetype, kutip);
    hasil KirimWireGrup(k, group_user, wire, "[dokumen] " + ke_teks(nama_file), 0, kosong);
}

fungsi kirim_video_grup(k, group_user, path_berkas, caption, kutip) {
    buat up = unggah_berkas(k, path_berkas, "video");
    buat detik = durasi_media_detik(path_berkas);
    buat wire = MS.BangunPesanVideo(up, caption, "video/mp4", detik, kutip, kosong);
    hasil KirimWireGrup(k, group_user, wire, "[video] " + ke_teks(caption), 0, kosong);
}

// items: larik peta {path, tipe: "image"|"video", caption}. Kirim satu
// AlbumMessage placeholder dulu (lewat skema generik pb_enkode_bernama,
// gak butuh raw builder khusus buat message sesimpel ini), ambil ID
// pesannya, terus tiap item dikirim SATU-SATU nempel
// messageContextInfo.messageAssociation yang nunjuk balik ke ID itu --
// itu yang bikin WA client ngegabungin jadi satu tampilan album.
// Belum pernah dites lawan client WhatsApp asli, jadi masih eksperimental.
fungsi kirim_album_grup(k, group_user, items) {
    buat n_gambar = 0;
    buat n_video = 0;
    untuk (buat i = 0; i < panjang(items); i = i + 1) {
        jika items[i]["tipe"] == "video" { n_video = n_video + 1; }
        lain { n_gambar = n_gambar + 1; }
    }

    buat album_struct = peta_baru();
    buat am = peta_baru();
    am["expectedImageCount"] = n_gambar;
    am["expectedVideoCount"] = n_video;
    album_struct["albumMessage"] = am;
    buat wire_album = PB.PbEnkodeBernama(album_struct, "Message");
    buat album_id = KirimWireGrup(k, group_user, wire_album, "[album]", 0, kosong);
    jika tipe(album_id) != "teks" || panjang(album_id) == 0 { lempar "gagal kirim placeholder album"; }

    buat remote_jid = group_user + "@g.us";
    untuk (buat i = 0; i < panjang(items); i = i + 1) {
        buat it = items[i];
        buat caption = "";
        jika tipe(it["caption"]) == "teks" { caption = it["caption"]; }
        buat asosiasi = MS.BangunAsosiasiAlbum(remote_jid, album_id, i);
        jika it["tipe"] == "video" {
            buat up = unggah_berkas(k, it["path"], "video");
            buat detik = durasi_media_detik(it["path"]);
            buat wire = MS.BangunPesanVideo(up, caption, "video/mp4", detik, kosong, asosiasi);
            KirimWireGrup(k, group_user, wire, "[album-video]", 0, kosong);
        } lain {
            buat up = unggah_berkas(k, it["path"], "image");
            buat wire = MS.BangunPesanGambar(up, caption, "image/jpeg", 0, 0, kosong, asosiasi);
            KirimWireGrup(k, group_user, wire, "[album-gambar]", 0, kosong);
        }
    }
    hasil album_id;
}

fungsi kirim_audio_grup(k, group_user, path_berkas, mimetype, ptt, kutip) {
    buat up = unggah_berkas(k, path_berkas, "audio");
    buat detik = durasi_media_detik(path_berkas);
    buat wire = MS.BangunPesanAudio(up, mimetype, detik, ptt, kutip);
    hasil KirimWireGrup(k, group_user, wire, "[audio]", 0, kosong);
}





fungsi unggah_sekali(k, path_gambar, tipe_media) {
    jika tipe(k["cache_unggah"]) != "peta" { k["cache_unggah"] = peta_baru(); }
    buat kunci = path_gambar + "|" + tipe_media;
    buat c = k["cache_unggah"][kunci];
    jika tipe(c) == "peta" { hasil c; }

    buat t0 = waktu();
    buat isi = baca_file(path_gambar);
    buat t1 = waktu();
    buat siap = MEDIA.SiapkanUpload(isi, tipe_media);
    buat t2 = waktu();
    buat mc = ambil_media_conn(k);
    buat t3 = waktu();
    buat up = kosong;
    coba {
        up = MEDIA.UnggahMedia(siap, tipe_media, mc, path_gambar + ".enc");
    } tangkap (e) {
        jika _ada_potongan(ke_teks(e), "401") {
            k["media_conn"] = kosong;
            up = MEDIA.UnggahMedia(siap, tipe_media, ambil_media_conn(k), path_gambar + ".enc");
        } lain {
            lempar e;
        }
    }
    buat t4 = waktu();
    cetak("[UNGGAH] baca=" + ke_teks(t1-t0) + "s enkripsi=" + ke_teks(t2-t1)
        + "s media_conn=" + ke_teks(t3-t2) + "s upload=" + ke_teks(t4-t3) + "s");

    up["isi"] = isi;
    k["cache_unggah"][kunci] = up;
    hasil up;
}

fungsi kirim_preview_media_grup(k, group_user, teks, url_cocok, judul, deskripsi, path_gambar, lebar, tinggi) {
    buat up = unggah_sekali(k, path_gambar, "thumbnail-link");
    buat t0 = waktu();
    buat wire = MS.BangunPesanPreviewMedia(teks, url_cocok, judul, deskripsi, up["isi"], up, lebar, tinggi, kosong);
    buat t1 = waktu();
    buat h = KirimWireGrup(k, group_user, wire, "[preview-media] " + ke_teks(judul), 0, kosong);
    cetak("[TIMING] bangun_wire=" + ke_teks(t1-t0) + "s kirim=" + ke_teks(waktu()-t1) + "s");
    hasil h;
}






fungsi TikKeepalive(k) {
    jika tipe(k["ka_terakhir"]) != "angka" { k["ka_terakhir"] = waktu(); k["ka_iterasi"] = 0; }
    jika (waktu() - k["ka_terakhir"]) < 22 { hasil kosong; }
    k["ka_terakhir"] = waktu();
    k["ka_iterasi"] = k["ka_iterasi"] + 1;

    coba {
        buat kp_to = peta_baru();
        kp_to["jid"] = benar; kp_to["user"] = ""; kp_to["server"] = "s.whatsapp.net";
        kp_to["agent"] = 0; kp_to["device"] = 0;
        buat kp_attrs = peta_baru();
        kp_attrs["id"] = "keepalive_" + ke_teks(waktu());
        kp_attrs["to"] = kp_to; kp_attrs["type"] = "get"; kp_attrs["xmlns"] = "w:p";
        buat kp_node = peta_baru();
        kp_node["tag"] = "iq"; kp_node["attrs"] = kp_attrs; kp_node["children"] = [];
        kp_node["content"] = kosong; kp_node["ada_isi"] = salah;
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(kp_node));
        cetak("[KEEPALIVE] Kirim w:p get id=" + kp_attrs["id"]);
    } tangkap (e) {
        cetak("[KEEPALIVE] Gagal kirim: " + ke_teks(e));
        lempar e;
    }

    jika k["ka_iterasi"] % 8 == 0 {
        coba {
            buat ref_to = peta_baru();
            ref_to["jid"] = benar; ref_to["user"] = ""; ref_to["server"] = "s.whatsapp.net";
            ref_to["agent"] = 0; ref_to["device"] = 0;
            buat ref_attrs = peta_baru();
            ref_attrs["id"] = "refresh_active_" + ke_teks(waktu());
            ref_attrs["to"] = ref_to; ref_attrs["type"] = "set"; ref_attrs["xmlns"] = "passive";
            buat ref_child = peta_baru();
            ref_child["tag"] = "active"; ref_child["attrs"] = peta_baru(); ref_child["children"] = [];
            ref_child["content"] = kosong; ref_child["ada_isi"] = salah;
            buat ref_node = peta_baru();
            ref_node["tag"] = "iq"; ref_node["attrs"] = ref_attrs; ref_node["children"] = [ref_child];
            ref_node["content"] = kosong; ref_node["ada_isi"] = benar;
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(ref_node));

            buat ref_pres = PRES.BuatNodePresenceUpdate("available", "NDLabs Bot");
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(ref_pres));
            cetak("[REFRESH] Kirim ulang passive->active + presence available.");
        } tangkap (e) { cetak("[WARN] Gagal kirim refresh: " + ke_teks(e)); }
    }

    jika k["ka_iterasi"] % 3 == 0 { gc_paksa(); }
}

