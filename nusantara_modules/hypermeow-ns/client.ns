}

fungsi proses_rahasia_pesan(k, node, chat_jid, fields) {
    jika tipe(fields) != "peta" { hasil kosong; }
    buat pengirim = node["attrs"]["participant"];
    jika tipe(pengirim) != "peta" { pengirim = node["attrs"]["from"]; }
    buat msg_id = node["attrs"]["id"];

    coba { SEC.SimpanSecretDariPesan(chat_jid, pengirim, msg_id, fields); } tangkap (e) {}

    jika tipe(fields["46"]) == "teks" {
        coba {
            buat r = SEC.UraiReaksi(PB.PbDekode(fields["46"]));
            jika r["dihapus"] {
                cetak("[REAKSI] " + SEC.JidTeks(pengirim) + " hapus reaksi");
            } lain {
                cetak("[REAKSI] " + SEC.JidTeks(pengirim) + " kasih " + r["emoji"]);
            }
        } tangkap (e) { cetak("[WARN] Gagal baca reaksi: " + ke_teks(e)); }
    }

    jika tipe(fields["56"]) == "teks" {
        coba {
            buat r = SEC.DekripsiReaksi(chat_jid, pengirim, PB.PbDekode(fields["56"]));
            cetak("[REAKSI ENC] " + SEC.JidTeks(pengirim) + " kasih " + r["emoji"]);
        } tangkap (e) { cetak("[WARN] Gagal dekripsi reaksi: " + ke_teks(e)); }
    }

    jika tipe(fields["49"]) == "teks" {
        coba {
            buat pf = PB.PbDekode(fields["49"]);
            buat opsi = PB.PbDekodeBerulang(fields["49"], "3");
            buat nama_opsi = [];
            untuk (buat i = 0; i < panjang(opsi); i = i + 1) {
                buat of = PB.PbDekode(opsi[i]);
                jika tipe(of["1"]) == "teks" { tambah(nama_opsi, of["1"]); }
            }
            cetak("[POLL] \"" + ke_teks(pf["2"]) + "\" opsi: " + ke_teks(nama_opsi));
        } tangkap (e) { cetak("[WARN] Gagal baca poll: " + ke_teks(e)); }
    }

    jika tipe(fields["50"]) == "teks" {
        coba {
            buat v = SEC.DekripsiVotePoll(chat_jid, pengirim, PB.PbDekode(fields["50"]));
            cetak("[POLL VOTE] " + SEC.JidTeks(pengirim) + " vote di poll " + ke_teks(v["poll_msg_id"]) + " (" + ke_teks(panjang(v["hash_dipilih"])) + " opsi)");
        } tangkap (e) { cetak("[WARN] Gagal dekripsi vote poll: " + ke_teks(e)); }
    }
}

fungsi KirimBootstrap(k) {
k["cnt_id"] = kosong;
jika tipe(k["session_data"]["jid"]) == "teks" && panjang(k["session_data"]["jid"]) > 0 {
    coba {
        k["cnt_id"] = "cnt_" + ke_teks(waktu());
        buat cnt_to = peta_baru();
        cnt_to["jid"] = benar; cnt_to["user"] = ""; cnt_to["server"] = "s.whatsapp.net"; cnt_to["agent"] = 0; cnt_to["device"] = 0;
        buat cnt_attrs = peta_baru();
        cnt_attrs["id"] = k["cnt_id"]; cnt_attrs["to"] = cnt_to; cnt_attrs["type"] = "get"; cnt_attrs["xmlns"] = "encrypt";
        buat cnt_child = peta_baru();
        cnt_child["tag"] = "count"; cnt_child["attrs"] = peta_baru(); cnt_child["children"] = []; cnt_child["content"] = kosong; cnt_child["ada_isi"] = salah;
        buat cnt_node = peta_baru();
        cnt_node["tag"] = "iq"; cnt_node["attrs"] = cnt_attrs; cnt_node["children"] = [cnt_child]; cnt_node["content"] = kosong; cnt_node["ada_isi"] = benar;
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(cnt_node));
        cetak("[ENCRYPT-COUNT] Kirim <iq type=get xmlns=encrypt><count/></iq>");

        buat active_id = "active_" + ke_teks(waktu());
        buat active_to = peta_baru();
        active_to["jid"] = benar; active_to["user"] = ""; active_to["server"] = "s.whatsapp.net"; active_to["agent"] = 0; active_to["device"] = 0;
        buat active_attrs = peta_baru();
        active_attrs["id"] = active_id; active_attrs["to"] = active_to; active_attrs["type"] = "set"; active_attrs["xmlns"] = "passive";
        buat active_child = peta_baru();
        active_child["tag"] = "active"; active_child["attrs"] = peta_baru(); active_child["children"] = []; active_child["content"] = kosong; active_child["ada_isi"] = salah;
        buat active_node = peta_baru();
        active_node["tag"] = "iq"; active_node["attrs"] = active_attrs; active_node["children"] = [active_child]; active_node["content"] = kosong; active_node["ada_isi"] = benar;
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(active_node));
        cetak("[PASSIVE->ACTIVE] Kirim <iq type=set xmlns=passive><active/></iq>");
    } tangkap (e) {
        cetak("[WARN] Gagal kirim encrypt-count/passive-active: " + ke_teks(e));
    }
}

}

// Ringkasan teks dari sebuah struct Message (buat label log/cache) --
// dipakai SendMessage yang nerima struct Message mentah (field-nya sama
// kayak proto: conversation/imageMessage/buttonsMessage/dst), jadi gak
// selalu ada satu "teks" yang jelas kayak fungsi Kirim* lama.
fungsi _ringkas_pesan_map(msg) {
    jika tipe(msg) != "peta" { hasil "[pesan]"; }
    jika tipe(msg["conversation"]) == "teks" && panjang(msg["conversation"]) > 0 { hasil msg["conversation"]; }
    jika tipe(msg["extendedTextMessage"]) == "peta" && tipe(msg["extendedTextMessage"]["text"]) == "teks" { hasil msg["extendedTextMessage"]["text"]; }
    jika tipe(msg["imageMessage"]) == "peta" { hasil "[gambar] " + ke_teks(msg["imageMessage"]["caption"]); }
    jika tipe(msg["videoMessage"]) == "peta" { hasil "[video] " + ke_teks(msg["videoMessage"]["caption"]); }
    jika tipe(msg["audioMessage"]) == "peta" { hasil "[audio]"; }
    jika tipe(msg["documentMessage"]) == "peta" { hasil "[dokumen] " + ke_teks(msg["documentMessage"]["title"]); }
    jika tipe(msg["stickerMessage"]) == "peta" { hasil "[stiker]"; }
    jika tipe(msg["buttonsMessage"]) == "peta" { hasil "[buttons]"; }
    jika tipe(msg["interactiveMessage"]) == "peta" { hasil "[interactive]"; }
    jika tipe(msg["listMessage"]) == "peta" { hasil "[list]"; }
    jika tipe(msg["templateMessage"]) == "peta" { hasil "[template]"; }
    jika tipe(msg["pollCreationMessage"]) == "peta" { hasil "[poll]"; }
    jika tipe(msg["reactionMessage"]) == "peta" { hasil "[reaksi]"; }
    hasil "[pesan]";
}

fungsi kirim_balasan_grup(k, group_user, reply_teks, retry_awal) {
    hasil KirimWireGrup(k, group_user, MS.BangunPesanTeks(reply_teks), reply_teks, retry_awal, kosong);
}

fungsi KirimWireGrup(k, group_user, msg_wire, label, retry_awal, node_ekstra) {
    kanal_terima(k["kirim_lock"]);
    buat edit_attr = "";
    jika panjang(label) >= 5 && potong(label, 0, 5) == "edit:" { edit_attr = "1"; }
    lain jika panjang(label) >= 9 && potong(label, 0, 9) == "revoke:1:" { edit_attr = "7"; }
    lain jika panjang(label) >= 9 && potong(label, 0, 9) == "revoke:0:" { edit_attr = "8"; }
    coba {
        buat us_devices = kosong;
        jika tipe(k["grup_device_cache"]) == "peta" && tipe(k["grup_device_cache"][group_user]) == "larik" && panjang(k["grup_device_cache"][group_user]) > 0 {
            us_devices = k["grup_device_cache"][group_user];
            cetak("[REPLY GRUP] Pake device list dari RAM cache (" + ke_teks(panjang(us_devices)) + " device, skip SQLite+usync).");
        } lain {
            us_devices = ST.CariGroupDevices(group_user);
            jika panjang(us_devices) == 0 {
                buat gi_id = "groupinfo_" + ke_teks(waktu());
                buat gi_iq = MS.BuatIqGroupInfo(gi_id, group_user);
                NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(gi_iq));
                buat gnode = TungguIq(k, gi_id, 200);
                buat gi_res = kosong;
                buat gparsed = MS.UraiResponsGroupInfo(gnode);
                jika gparsed["ok"] { gi_res = gparsed; }
                jika tipe(gi_res) != "peta" { lempar "Gagal dapetin daftar participant grup."; }

                buat our_lid_raw = k["session_data"]["lid"];
                buat our_lid_user = our_lid_raw;
                untuk (buat ci = 0; ci < panjang(our_lid_raw); ci = ci + 1) {
                    jika byte_di(our_lid_raw, ci) == 58 { our_lid_user = potong(our_lid_raw, 0, ci); berhenti; }
                }
                buat target_lid_users = [];
                untuk (buat pi = 0; pi < panjang(gi_res["participants"]); pi = pi + 1) {
                    buat pentri = gi_res["participants"][pi];
                    jika pentri["lid_user"] == our_lid_user { lanjut; }
                    jika tipe(pentri["pn_user"]) == "teks" && panjang(pentri["pn_user"]) > 0 {
                        k["DB"].SimpanLIDJID(pentri["lid_user"], pentri["pn_user"] + "@s.whatsapp.net");
                    }
                    tambah(target_lid_users, pentri["lid_user"]);
                }
                jika panjang(target_lid_users) == 0 { lempar "Gak ada participant lain buat dikirimin."; }

                // Cache device per-PARTICIPANT dulu (niru GetUserDevices whatsmeow):
                // device list satu user dipake lagi lintas grup, cuma di-usync
                // ulang buat yang belum/nggak ke-cache -- gak usah usync semua
                // member tiap kali cache grup ini kosong.
                us_devices = [];
                buat perlu_sync = [];
                untuk (buat ti = 0; ti < panjang(target_lid_users); ti = ti + 1) {
                    buat cache_user = ST.CariUserDevices(target_lid_users[ti]);
                    jika panjang(cache_user) > 0 {
                        untuk (buat cdi = 0; cdi < panjang(cache_user); cdi = cdi + 1) { tambah(us_devices, cache_user[cdi]); }
                    } lain {
                        tambah(perlu_sync, target_lid_users[ti]);
                    }
                }
                cetak("[REPLY GRUP] Device per-participant cache: " + ke_teks(panjang(target_lid_users) - panjang(perlu_sync)) + "/" + ke_teks(panjang(target_lid_users)) + " hit, " + ke_teks(panjang(perlu_sync)) + " perlu usync.");

                jika panjang(perlu_sync) > 0 {
                    buat us_id = "usyncgrup_" + ke_teks(waktu());
                    buat us_iq = MS.BuatIqUsyncBanyak(us_id, perlu_sync);
                    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(us_iq));
                    buat unode = TungguIq(k, us_id, 200);
                    buat us_baru = kosong;
                    buat uparsed = MS.UraiResponsUsync(unode);
                    jika uparsed["ok"] { us_baru = uparsed["devices"]; }
                    jika tipe(us_baru) != "larik" { lempar "Gagal resolve device list participant grup."; }

                    buat per_user = peta_baru();
                    untuk (buat bi = 0; bi < panjang(us_baru); bi = bi + 1) {
                        buat bdv = us_baru[bi];
                        jika tipe(per_user[bdv["user"]]) != "larik" { per_user[bdv["user"]] = []; }
                        tambah(per_user[bdv["user"]], bdv);
                        tambah(us_devices, bdv);
                    }
                    untuk (buat pui = 0; pui < panjang(perlu_sync); pui = pui + 1) {
                        buat pu = perlu_sync[pui];
                        jika tipe(per_user[pu]) == "larik" { ST.SimpanUserDevices(pu, per_user[pu]); }
                    }
                }
                jika panjang(us_devices) == 0 { lempar "Gagal resolve device list participant grup."; }
                ST.SimpanGroupDevices(group_user, us_devices);
            } lain {
                cetak("[REPLY GRUP] Pake device list dari SQLite cache (" + ke_teks(panjang(us_devices)) + " device, skip fetch+usync).");
            }
            jika tipe(k["grup_device_cache"]) != "peta" { k["grup_device_cache"] = peta_baru(); }
            k["grup_device_cache"][group_user] = us_devices;
        }

        buat all_sessions = ST.MuatSemuaSesiKirim();
        buat devices_perlu_bundle = [];
        untuk (buat di = 0; di < panjang(us_devices); di = di + 1) {
            buat dv = us_devices[di];
            buat dk = MS.DeviceKey(dv["user"], dv["server"], dv["device"]);
            buat existing = kosong;
            jika tipe(all_sessions[dk]) == "peta" { existing = all_sessions[dk]; }
            jika tipe(existing) != "peta" { tambah(devices_perlu_bundle, dv); }
        }

        buat pf_bundles = [];
        jika panjang(devices_perlu_bundle) > 0 {
            buat pf_id = "prekeyfetchgrup_" + ke_teks(waktu());
            buat pf_iq = MS.BuatIqPrekeyFetch(pf_id, devices_perlu_bundle);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(pf_iq));
            buat pnode = TungguIq(k, pf_id, 200);
            buat pparsed = MS.UraiResponsPrekey(pnode);
            jika pparsed["ok"] { pf_bundles = pparsed["bundles"]; }
        }

        buat bundle_by_dk = peta_baru();
        untuk (buat bi2 = 0; bi2 < panjang(pf_bundles); bi2 = bi2 + 1) {
            buat b = pf_bundles[bi2];
            bundle_by_dk[MS.DeviceKey(b["user"], b["server"], b["device"])] = b;
        }

        buat tprof0 = waktu();
        buat sk_state_out = MS.SiapkanSenderKeyKirim(group_user);
        buat skdm_protobuf = MS.BangunSkdmMessageProtobuf(group_user, sk_state_out);
        buat tprof1 = waktu();

        buat enc_list_grup = [];
        buat batch_when_idx = "";
        buat batch_when_key = "";
        buat batch_in = "";
        buat batch_count = 0;
        ST.MulaiTransaksi();
        coba {
            untuk (buat di2 = 0; di2 < panjang(us_devices); di2 = di2 + 1) {
                buat dv2 = us_devices[di2];
                buat dk2 = MS.DeviceKey(dv2["user"], dv2["server"], dv2["device"]);
                buat bundle2 = bundle_by_dk[dk2];
                coba {
                    buat sap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], bundle2, dk2, all_sessions);
                    buat enc_hasil = MS.EnkripsiPesanKirim(sap["sesi"], skdm_protobuf);
                    buat entri_g = peta_baru();
                    entri_g["user"] = dv2["user"]; entri_g["server"] = dv2["server"]; entri_g["device"] = dv2["device"];
                    jika sap["acked"] != benar && tipe(sap["sesi"]["our_base_kp"]) == "peta" {
                        entri_g["wire"] = MS.BungkusPrekeyMessage(sap["sesi"], enc_hasil["wire"], k["our_registration_id"]);
                        entri_g["type"] = "pkmsg";
                    } lain {
                        entri_g["wire"] = enc_hasil["wire"];
                        entri_g["type"] = "msg";
                    }
                    jika sap["fresh"] {
                        MS.SimpanSesiKirimBaru(dk2, sap["sesi"], enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
                    } lain {
                        batch_when_idx = batch_when_idx + "WHEN '" + dk2 + "' THEN " + ke_teks(enc_hasil["chain_index_baru"]) + " ";
                        batch_when_key = batch_when_key + "WHEN '" + dk2 + "' THEN '" + enc_hasil["chain_key_baru_hex"] + "' ";
                        jika batch_count > 0 { batch_in = batch_in + ", "; }
                        batch_in = batch_in + "'" + dk2 + "'";
                        batch_count = batch_count + 1;
                    }
                    tambah(enc_list_grup, entri_g);
                } tangkap (e) {
                    cetak("[WARN] Skip device " + dk2 + " (gak ada bundle/sesi): " + ke_teks(e));
                }
            }
            jika batch_count > 0 {
                buat sql_batch = "UPDATE send_sessions SET chain_index = CASE device_key " + batch_when_idx + "END, sending_chain_key = CASE device_key " + batch_when_key + "END WHERE device_key IN (" + batch_in + ")";
                ST.JalankanQueryMentah(sql_batch);
            }
            ST.SelesaiTransaksi();
        } tangkap (err_tx) {
            ST.BatalTransaksi();
            lempar err_tx;
        }
        jika panjang(enc_list_grup) == 0 { lempar "Gak ada device yang bisa dikirimin (semua gagal bangun sesi)."; }
        buat tprof2 = waktu();

        buat eg = MS.EnkripsiGroupMessageWire(sk_state_out, msg_wire);
        ST.UpdateSenderKeyKirimProgress(group_user, eg["iterasi_baru"], eg["chain_key_baru_hex"]);
        buat tprof3 = waktu();

        buat msg_id_grup = _buat_msg_id();
        buat node_grup = MS.BuatNodePesanGrup(msg_id_grup, group_user, enc_list_grup, CP["hex_decode"](k["session_data"]["account_hex"]), eg["skmsg_wire"], node_ekstra, edit_attr);
        buat tprof4 = waktu();
        buat bin_kirim = EN.BcMarshal(node_grup);
        buat tprof5 = waktu();
        NS.KirimAman(k["ws_id"], k["noise_socket"], bin_kirim);
        buat tprof6 = waktu();
        cetak("[PROFIL KIRIM] sk_setup=" + ke_teks(tprof1-tprof0) + "s per_device=" + ke_teks(tprof2-tprof1)
            + "s enc_group=" + ke_teks(tprof3-tprof2) + "s node=" + ke_teks(tprof4-tprof3)
            + "s marshal=" + ke_teks(tprof5-tprof4) + "s(" + ke_teks(panjang(bin_kirim)) + "b) kirim_aman=" + ke_teks(tprof6-tprof5) + "s");
        cetak("[REPLY GRUP] Terkirim ke " + ke_teks(panjang(enc_list_grup)) + " device: " + ke_teks(label));

        buat cache_entri = peta_baru();
        cache_entri["group_user"] = group_user;
        cache_entri["teks"] = label;
        cache_entri["wire"] = msg_wire;
        cache_entri["skdm"] = skdm_protobuf;
        cache_entri["skmsg_wire"] = eg["skmsg_wire"];
        cache_entri["retry"] = 0;
        k["pesan_grup_terkirim"][msg_id_grup] = cache_entri;

        jika tipe(k["urutan_cache"]) != "larik" { k["urutan_cache"] = []; }
        tambah(k["urutan_cache"], msg_id_grup);
        jika panjang(k["urutan_cache"]) > 20 {
            buat sisa = potong(k["urutan_cache"], panjang(k["urutan_cache"]) - 10, panjang(k["urutan_cache"]));
            buat peta_baru_cache = peta_baru();
            untuk (buat ci = 0; ci < panjang(sisa); ci = ci + 1) {
                peta_baru_cache[sisa[ci]] = k["pesan_grup_terkirim"][sisa[ci]];
            }
            k["pesan_grup_terkirim"] = peta_baru_cache;
            k["urutan_cache"] = sisa;
            gc_paksa();
        }
        hasil msg_id_grup;
    } tangkap (e) {
        cetak("[WARN] Gagal kirim balasan grup: " + ke_teks(e));
        hasil kosong;
    } akhirnya {
        kanal_kirim(k["kirim_lock"], 1);
    }
}

fungsi kirim_peer_message(k, msg_wire, prioritas_tinggi) {
    kanal_terima(k["kirim_lock"]);
    coba {
        buat dv = peta_baru();
        dv["user"] = _lid_kita(k); dv["server"] = "lid"; dv["device"] = 0;
        buat dk = MS.DeviceKey(dv["user"], dv["server"], dv["device"]);
        buat existing = ST.CariSesiKirim(dk);
        buat bundle = kosong;
        jika tipe(existing) != "peta" {
            buat pf_id = "prekeypeer_" + ke_teks(waktu());
            buat pf_iq = MS.BuatIqPrekeyFetch(pf_id, [dv]);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(pf_iq));
            buat pnode = TungguIq(k, pf_id, 200);
            buat pparsed = MS.UraiResponsPrekey(pnode);
            jika pparsed["ok"] && panjang(pparsed["bundles"]) > 0 { bundle = pparsed["bundles"][0]; }
        }

        buat sap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], bundle, dk, kosong);
        buat enc_hasil = MS.EnkripsiPesanKirim(sap["sesi"], msg_wire);
        buat wire_akhir = kosong;
        buat tipe_enc = "msg";
        jika sap["acked"] != benar && tipe(sap["sesi"]["our_base_kp"]) == "peta" {
            wire_akhir = MS.BungkusPrekeyMessage(sap["sesi"], enc_hasil["wire"], k["our_registration_id"]);
            tipe_enc = "pkmsg";
        } lain {
            wire_akhir = enc_hasil["wire"];
        }
        jika sap["fresh"] {
            MS.SimpanSesiKirimBaru(dk, sap["sesi"], enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
        } lain {
            ST.UpdateSesiKirimProgress(dk, enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
        }

        buat n_enc = peta_baru();
        n_enc["tag"] = "enc"; n_enc["attrs"] = peta_baru();
        n_enc["attrs"]["v"] = "2"; n_enc["attrs"]["type"] = tipe_enc;
        n_enc["children"] = []; n_enc["content"] = wire_akhir; n_enc["ada_isi"] = benar;

        buat n_meta = peta_baru();
        n_meta["tag"] = "meta"; n_meta["attrs"] = peta_baru();
        n_meta["attrs"]["appdata"] = "default";
        n_meta["children"] = []; n_meta["content"] = kosong; n_meta["ada_isi"] = salah;

        buat isi = [n_meta, n_enc];
        jika tipe_enc == "pkmsg" {
            buat n_di = peta_baru();
            n_di["tag"] = "device-identity"; n_di["attrs"] = peta_baru();
            n_di["children"] = []; n_di["content"] = CP["hex_decode"](k["session_data"]["account_hex"]); n_di["ada_isi"] = benar;
            tambah(isi, n_di);
        }

        buat msg_attrs = peta_baru();
        msg_attrs["id"] = "peer_" + ke_teks(waktu());
        msg_attrs["type"] = "text";
        msg_attrs["category"] = "peer";
        msg_attrs["to"] = MS._jid_peta(k["session_data"]["jid"], "s.whatsapp.net", 0);
        jika prioritas_tinggi {
            msg_attrs["push_priority"] = "high_force";
            msg_attrs["privacy_sensitive"] = "1";
        }

        buat msg_node = peta_baru();
        msg_node["tag"] = "message"; msg_node["attrs"] = msg_attrs;
        msg_node["children"] = isi; msg_node["content"] = kosong; msg_node["ada_isi"] = benar;

        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(msg_node));
        cetak("[PEER] Terkirim id=" + msg_attrs["id"]);
        hasil msg_attrs["id"];
    } tangkap (e) {
        cetak("[WARN] kirim_peer_message gagal: " + ke_teks(e));
        hasil kosong;
    } akhirnya {
        kanal_kirim(k["kirim_lock"], 1);
    }
}

fungsi kirim_teks_1_1(k, target_user, teks) {
    kanal_terima(k["kirim_lock"]);
    coba {
        buat us_id = "usync1_" + ke_teks(waktu());
        buat us_iq = MS.BuatIqUsync(us_id, target_user);
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(us_iq));
        buat unode = TungguIq(k, us_id, 200);
        buat us_devices = kosong;
        buat uparsed = MS.UraiResponsUsync(unode);
        jika uparsed["ok"] { us_devices = uparsed["devices"]; }
        jika tipe(us_devices) != "larik" || panjang(us_devices) == 0 { lempar "Gagal resolve device list target."; }

        buat devices_perlu_bundle = [];
        untuk (buat di = 0; di < panjang(us_devices); di = di + 1) {
            buat dv = us_devices[di];
            buat dk = MS.DeviceKey(dv["user"], dv["server"], dv["device"]);
            buat existing = ST.CariSesiKirim(dk);
            jika tipe(existing) != "peta" { tambah(devices_perlu_bundle, dv); }
        }

        buat pf_bundles = [];
        jika panjang(devices_perlu_bundle) > 0 {
            buat pf_id = "prekeyfetch1_" + ke_teks(waktu());
            buat pf_iq = MS.BuatIqPrekeyFetch(pf_id, devices_perlu_bundle);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(pf_iq));
            buat pnode = TungguIq(k, pf_id, 200);
            buat pparsed = MS.UraiResponsPrekey(pnode);
            jika pparsed["ok"] { pf_bundles = pparsed["bundles"]; }
        }

        buat bundle_by_dk = peta_baru();
        untuk (buat bi2 = 0; bi2 < panjang(pf_bundles); bi2 = bi2 + 1) {
            buat b = pf_bundles[bi2];
            bundle_by_dk[MS.DeviceKey(b["user"], b["server"], b["device"])] = b;
        }

        buat msg_wire = MS.BangunPesanTeks(teks);
        buat enc_list = [];
        buat lid_target = target_user;
        untuk (buat di2 = 0; di2 < panjang(us_devices); di2 = di2 + 1) {
            buat dv2 = us_devices[di2];
            jika dv2["server"] == "lid" { lid_target = dv2["user"]; }
            buat dk2 = MS.DeviceKey(dv2["user"], dv2["server"], dv2["device"]);
            buat bundle2 = bundle_by_dk[dk2];
            coba {
                buat sap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], bundle2, dk2, kosong);
                buat enc_hasil = MS.EnkripsiPesanKirim(sap["sesi"], msg_wire);
                buat entri = peta_baru();
                entri["user"] = dv2["user"]; entri["server"] = dv2["server"]; entri["device"] = dv2["device"];
                jika sap["acked"] != benar && tipe(sap["sesi"]["our_base_kp"]) == "peta" {
                    entri["wire"] = MS.BungkusPrekeyMessage(sap["sesi"], enc_hasil["wire"], k["our_registration_id"]);
                    entri["type"] = "pkmsg";
                } lain {
                    entri["wire"] = enc_hasil["wire"];
                    entri["type"] = "msg";
                }
                jika sap["fresh"] {
                    MS.SimpanSesiKirimBaru(dk2, sap["sesi"], enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
                } lain {
                    ST.UpdateSesiKirimProgress(dk2, enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
                }
                tambah(enc_list, entri);
            } tangkap (e) {
                cetak("[WARN] Skip device 1:1 " + dk2 + ": " + ke_teks(e));
            }
        }
        jika panjang(enc_list) == 0 { lempar "Gak ada device yang bisa dikirimin (semua gagal bangun sesi)."; }

        buat msg_id = _buat_msg_id();
        buat node = MS.BuatNodePesan(msg_id, target_user, lid_target, enc_list, CP["hex_decode"](k["session_data"]["account_hex"]));
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(node));
        cetak("[KIRIM 1:1] Terkirim ke " + ke_teks(target_user) + " (" + ke_teks(panjang(enc_list)) + " device)");
        hasil msg_id;
    } tangkap (e) {
        cetak("[WARN] kirim_teks_1_1 gagal: " + ke_teks(e));
        hasil kosong;
    } akhirnya {
        kanal_kirim(k["kirim_lock"], 1);
    }
}

fungsi _is_from_me_node(k, node, sender_str) {
    jika tipe(node) == "peta" && tipe(node["attrs"]) == "peta" {
        jika node["attrs"]["from_me"] == "true" || node["attrs"]["from_me"] == benar { hasil benar; }
    }
    jika tipe(k["session_data"]) == "peta" {
        buat jid_kita = k["session_data"]["jid"];
        buat lid_kita = k["session_data"]["lid"];
        jika tipe(sender_str) == "teks" {
            jika (tipe(jid_kita) == "teks" && panjang(jid_kita) > 0 && _ada_potongan(sender_str, jid_kita)) ||
               (tipe(lid_kita) == "teks" && panjang(lid_kita) > 0 && _ada_potongan(sender_str, lid_kita)) {
                hasil benar;
            }
        }
    }
    hasil salah;
}

fungsi _proses_pesan_grup_terdekripsi(k, node, sender_jid, dg) {
    cetak("[DECRYPT GRUP] Isi: " + dg["teks"]);
    proses_rahasia_pesan(k, node, sender_jid, dg["fields"]);

    buat sender_grup = MS.ResolveSenderString(node, sender_jid);
    buat from_me_grup = _is_from_me_node(k, node, sender_grup);
    buat api_grup = siapkan_konteks_pesan(k, node, sender_jid, dg["teks"], dg["fields"], dg["wire_mentah"]);
    jika k["waBot"]["_cekArsipDanBisu"](sender_grup, from_me_grup) { hasil kosong; }
    jika pesan_lama(k, node) {
        cetak("[SKIP] Pesan lama/offline, gak dibales: " + ke_teks(node["attrs"]["id"]));
        hasil kosong;
    }
    // Diproses lewat worker pool -- loop koneksi utama (runtime.ns) sekarang
    // satu-satunya pemanggil ws_terima; siapapun (termasuk worker) yang
    // perlu nunggu balesan IQ (device resolve/prekey-fetch/usync dst, lewat
    // tunggu_iq) nunggu lewat kanal yang di-isi loop utama (lihat
    // coba_serahkan_ke_penunggu), bukan baca socket sendiri -- jadi command
    // lambat di satu grup gak lagi nge-block grup lain, dan gak ada dua
    // pembaca ws_terima bareng (yang bisa korup s->rbuf di native plugin
    // ws.cpp). api_pesan (api_grup) dioper langsung ke goroutine
    // biar gak baca k["waBot"]["WA"] belakangan -- field itu bisa udah
    // ketimpa pesan lain pas rame (penyebab react/reply nyasar).
    jalan(_proses_dan_balas_grup, k, sender_grup, dg["teks"], from_me_grup, sender_jid["user"], api_grup);
}

// CATATAN: worker-pool tetap (N goroutine nunggu bareng di 1 kanal)
// pernah dicoba di sini tapi bikin proses segfault berulang (kebukti
// lewat journalctl -- pola stack overflow pas beberapa goroutine
// ngeblock bareng di kanal_terima). Balik ke goroutine-per-pesan biasa
// (jalan(...) langsung tiap pesan, lihat pemanggil di bawah) yang stabil.
fungsi _proses_dan_balas_grup(k, sender_grup, teks, from_me_grup, target_user, api_pesan) {
    coba {
        buat reply_grup = k["waBot"]["HandleMessage"](sender_grup, teks, from_me_grup, api_pesan);
        jika panjang(reply_grup) > 0 {
            kirim_balasan_grup(k, target_user, reply_grup, 0);
        }
    } tangkap (e) {
        cetak("[WARN] Goroutine proses pesan grup gagal: " + ke_teks(e));
    }
}

fungsi _coba_proses_skmsg_tertunda(k, sk_id) {
    jika tipe(k["skmsg_tertunda"]) != "peta" { hasil kosong; }
    buat tunda = k["skmsg_tertunda"][sk_id];
    jika tipe(tunda) != "peta" { hasil kosong; }
    k["skmsg_tertunda"][sk_id] = kosong;
    coba {
        buat sk_state = ST.CariSenderKey(sk_id);
        jika tipe(sk_state) != "peta" {
            cetak("[SKMSG] Sender-key masih belum ada buat " + sk_id + " (harusnya baru aja disimpen?)");
            hasil kosong;
        }
        buat sm_grup = MS.UraiSenderKeyMessage(tunda["konten"]);
        buat dg = MS.DekripsiGroupMessage(sk_id, sk_state, sm_grup);
        jika !dg["ok"] {
            cetak("[SKMSG] Retry decrypt masih gagal buat " + sk_id + ": " + ke_teks(dg["error"]));
            hasil kosong;
        }
        ST.UpdateSenderKeyProgress(sk_id, dg["iterasi_baru"], dg["chain_key_baru_hex"]);
        cetak("[SKMSG] Berhasil didekripsi ulang setelah sender-key dateng: " + sk_id);
        _proses_pesan_grup_terdekripsi(k, tunda["node"], tunda["sender_jid"], dg);
    } tangkap (e) {
        cetak("[WARN] Gagal proses skmsg tertunda: " + ke_teks(e));
    }
}

fungsi _proses_retransmisi_retry(k, node, retry_msg_id, cache_hit, rc) {
    coba {
        buat rp = node["attrs"]["participant"];
        buat rdk = MS.DeviceKey(rp["user"], rp["server"], rp["device"]);
        ST.HapusSesiKirim(rdk);

        buat rdev = [(fungsi() { buat d = peta_baru(); d["user"] = rp["user"]; d["server"] = rp["server"]; d["device"] = rp["device"]; hasil d; })()];
        buat rpf_id = "retrypf_" + ke_teks(waktu());
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(MS.BuatIqPrekeyFetch(rpf_id, rdev)));
        buat rnd = TungguIq(k, rpf_id, 200);
        buat rbundle = kosong;
        buat rpp = MS.UraiResponsPrekey(rnd);
        jika rpp["ok"] { rbundle = rpp["bundles"][0]; }
        jika tipe(rbundle) != "peta" { lempar "gagal fetch prekey buat retry"; }

        buat rsap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], rbundle, rdk, kosong);
        buat renc = MS.EnkripsiPesanKirim(rsap["sesi"], cache_hit["skdm"]);
        buat rwire = MS.BungkusPrekeyMessage(rsap["sesi"], renc["wire"], k["our_registration_id"]);
        MS.SimpanSesiKirimBaru(rdk, rsap["sesi"], renc["chain_index_baru"], renc["chain_key_baru_hex"]);

        buat rnode = MS.BuatNodeRetryKirim(retry_msg_id, node["attrs"]["t"], cache_hit["group_user"], rp, rwire, "pkmsg", rc, CP["hex_decode"](k["session_data"]["account_hex"]), cache_hit["skmsg_wire"]);
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(rnode));
        cetak("[RETRY KIRIM] Retransmisi id=" + ke_teks(retry_msg_id) + " ke " + rdk + " (count=" + ke_teks(rc) + ") -- id sama, gak bikin pesan baru.");
    } tangkap (e) {
        cetak("[WARN] Gagal retransmisi retry: " + ke_teks(e));
    }
}

fungsi ProsesNode(k, node) {

    cetak("[RECV NODE] Tag: " + ke_teks(node["tag"]) + " | Attrs: " + ke_teks(node["attrs"]));
    jika tipe(node["children"]) == "larik" {
        untuk (buat c_idx = 0; c_idx < panjang(node["children"]); c_idx = c_idx + 1) {
            buat c = node["children"][c_idx];
            cetak("   └── [CHILD " + ke_teks(c_idx) + "] Tag: " + ke_teks(c["tag"]) + " | Attrs: " + ke_teks(c["attrs"]));
        }
    }

    jika node["tag"] == "call" {
        coba {
            buat c = CALL.UraiPanggilan(node);
            jika c["jenis"] == "offer" || c["jenis"] == "offer_notice" {
                buat jenis_p = "suara";
                jika c["video"] { jenis_p = "video"; }
                cetak("[PANGGILAN] Masuk (" + jenis_p + ") dari " + ke_teks(c["dari"]["user"]) + " -- ditolak otomatis.");
                buat kita = MS._jid_peta(k["session_data"]["jid"], "s.whatsapp.net", 0);
                jika tipe(c["penelepon"]) == "peta" {
                    buat tolak = CALL.BuatNodeTolakPanggilan("call_" + ke_teks(waktu()), kita, c["penelepon"], c["call_id"]);
                    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(tolak));
                }
            }
        } tangkap (e) { cetak("[WARN] Gagal proses panggilan: " + ke_teks(e)); }
    }

    jika node["tag"] == "receipt" || node["tag"] == "call" {
        coba {
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(MS.BuatNodeAck(node)));
            cetak("[ACK] Kirim ack buat " + node["tag"] + " id=" + ke_teks(node["attrs"]["id"]) + " type=" + ke_teks(node["attrs"]["type"]));
        } tangkap (e) { cetak("[WARN] Gagal kirim ack " + node["tag"] + ": " + ke_teks(e)); }
    }

    jika node["tag"] == "receipt" && tipe(node["attrs"]) == "peta" && node["attrs"]["type"] == "retry" {
        buat retry_msg_id = node["attrs"]["id"];
        buat cache_hit = k["pesan_grup_terkirim"][retry_msg_id];
        jika tipe(cache_hit) == "peta" && tipe(node["attrs"]["participant"]) == "peta" {
            buat rc = cache_hit["retry"];
            jika tipe(rc) != "angka" { rc = 0; }
            rc = rc + 1;
            cache_hit["retry"] = rc;
            jika rc > 5 {
                cetak("[RETRY KIRIM] Diabaikan (id=" + ke_teks(retry_msg_id) + ", udah " + ke_teks(rc) + "x).");
            } lain {
                // Lewat worker pool (bukan goroutine baru per retry) --
                // fetch prekey lewat tunggu_iq itu BLOCKING nunggu kanal
                // yang cuma diisi loop utama sendiri; dipanggil langsung
                // dari proses_node (dijalanin loop utama) = deadlock.
                jalan(_proses_retransmisi_retry, k, node, retry_msg_id, cache_hit, rc);
            }
        }
    }

    jika node["tag"] == "iq" && tipe(node["attrs"]) == "peta" {
        jika node["attrs"]["xmlns"] == "urn:xmpp:ping" && node["attrs"]["type"] == "get" {
            buat pong = peta_baru();
            pong["tag"] = "iq";
            buat pong_attrs = peta_baru();
            buat pong_to = peta_baru();
            pong_to["jid"] = benar; pong_to["user"] = ""; pong_to["server"] = "s.whatsapp.net"; pong_to["agent"] = 0; pong_to["device"] = 0;
            pong_attrs["to"] = pong_to;
            pong_attrs["type"] = "result";
            pong_attrs["id"] = node["attrs"]["id"];
            pong["attrs"] = pong_attrs;
            pong["children"] = [];
            pong["content"] = "";
            pong["ada_isi"] = benar;
            buat pong_bin = EN.BcMarshal(pong);
            NS.KirimAman(k["ws_id"], k["noise_socket"], pong_bin);
            cetak("[PING] Sent pong response");
        }
    }

    jika tipe(k["cnt_id"]) == "teks" && node["tag"] == "iq" && node["attrs"]["id"] == k["cnt_id"] && tipe(node["children"]) == "larik" {
        untuk (buat cc = 0; cc < panjang(node["children"]); cc = cc + 1) {
            jika node["children"][cc]["tag"] == "count" {
                buat prekey_count = ke_angka(node["children"][cc]["attrs"]["value"]);
                cetak("[PREKEY-COUNT] Server bilang kita punya " + ke_teks(prekey_count) + " prekey.");
                jika prekey_count < 20 && k["retry_ctx"]["ada"] {
                    coba {
                        buat topup_id = "topup_" + ke_teks(waktu());
                        buat topup_iq = MS.BuatIqUploadPrekeys(topup_id, k["identity_kp"], k["our_registration_id"], k["retry_ctx"], 50);
                        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(topup_iq));
                        cetak("[PREKEY-COUNT] Count rendah, kirim top-up 50 prekey baru ke server.");
                    } tangkap (e) { cetak("[WARN] Gagal top-up prekey: " + ke_teks(e)); }
                }
            }
        }
    }

    jika node["tag"] == "iq" && tipe(node["attrs"]) == "peta" {
        jika tipe(node["attrs"]["type"]) == "teks" && node["attrs"]["type"] == "error" {
            buat err_code = "Unknown";
            buat err_text = "Unknown";
            jika tipe(node["children"]) == "larik" && panjang(node["children"]) > 0 {
                buat err_child = node["children"][0];
                jika tipe(err_child["attrs"]) == "peta" {
                    jika tipe(err_child["attrs"]["code"]) == "teks" { err_code = err_child["attrs"]["code"]; }
                    jika tipe(err_child["attrs"]["text"]) == "teks" { err_text = err_child["attrs"]["text"]; }
                }
            }
            cetak("[SERVER ERROR FATAL] Server menolak IQ. Code: " + err_code + ", Text: " + err_text);
        }
    }

    jika node["tag"] == "iq" && tipe(node["children"]) == "larik" && panjang(node["children"]) > 0 {
        jika node["children"][0]["tag"] == "pair-device" {
            cetak("[PAIR DEVICE] Received pair-device IQ. Sending result ACK...");
            buat ack_node = peta_baru();
            ack_node["tag"] = "iq";
            ack_node["attrs"] = peta_baru();
            ack_node["attrs"]["to"] = node["attrs"]["from"];
            ack_node["attrs"]["id"] = node["attrs"]["id"];
            ack_node["attrs"]["type"] = "result";
            ack_node["children"] = [];
            ack_node["content"] = "";
            ack_node["ada_isi"] = salah;

            buat ack_bin = EN.BcMarshal(ack_node);
            NS.KirimAman(k["ws_id"], k["noise_socket"], ack_bin);
        }
    }

    jika k["companion_info"]["menunggu_ref"] == benar && node["tag"] == "iq" && tipe(node["attrs"]) == "peta" {
        jika tipe(node["attrs"]["type"]) == "teks" && node["attrs"]["type"] == "result" {
            buat ref_content = "";
            jika tipe(node["children"]) == "larik" && panjang(node["children"]) > 0 {
                buat reg = node["children"][0];
                jika reg["tag"] == "link_code_companion_reg" && tipe(reg["children"]) == "larik" {
                    untuk (buat i = 0; i < panjang(reg["children"]); i = i + 1) {
                        jika reg["children"][i]["tag"] == "link_code_pairing_ref" {
                            ref_content = reg["children"][i]["content"];
                        }
                    }
                }
            }
            jika tipe(ref_content) == "teks" && panjang(ref_content) > 0 {
                k["companion_info"]["pairing_ref"] = CP["hex_encode"](ref_content);
                k["companion_info"]["menunggu_ref"] = salah;
                cetak("[PAIR] Pairing ref diterima: " + k["companion_info"]["pairing_ref"]);
            }
        }
        jika tipe(node["attrs"]["type"]) == "teks" && node["attrs"]["type"] == "error" {
            k["companion_info"]["menunggu_ref"] = salah;
            cetak("[PAIR] ❌ IQ companion_hello ditolak server!");
        }
    }

    jika node["tag"] == "notification" {
        coba {
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(MS.BuatNodeAck(node)));
            cetak("[ACK] Kirim ack buat notification id=" + ke_teks(node["attrs"]["id"]) + " type=" + ke_teks(node["attrs"]["type"]));
        } tangkap (e) { cetak("[WARN] Gagal kirim ack notification: " + ke_teks(e)); }

        coba {
            buat nt = node["attrs"]["type"];
            jika nt == "w:gp2" {
                buat g = NOTIF.UraiNotifikasiGrup(node);
                buat baris = NOTIF.RingkasNotifikasiGrup(g);
                untuk (buat bi = 0; bi < panjang(baris); bi = bi + 1) {
                    cetak("[GRUP] " + ke_teks(g["grup"]["user"]) + ": " + baris[bi]);
                }
                jika tipe(g["grup"]) == "peta" && tipe(g["grup"]["user"]) == "teks" && panjang(g["grup"]["user"]) > 0 {
                    buat grp_id = g["grup"]["user"];
                    jika tipe(g["keluar"]) == "larik" && panjang(g["keluar"]) > 0 {
                        untuk (buat ki = 0; ki < panjang(g["keluar"]); ki = ki + 1) {
                            buat ent_keluar = g["keluar"][ki];
                            buat user_out = "";
                            jika tipe(ent_keluar["lid"]) == "peta" && tipe(ent_keluar["lid"]["user"]) == "teks" {
                                user_out = ent_keluar["lid"]["user"];
                            } lain jika tipe(ent_keluar["jid"]) == "peta" && tipe(ent_keluar["jid"]["user"]) == "teks" {
                                user_out = ent_keluar["jid"]["user"];
                            }
                            jika panjang(user_out) > 0 {
                                ST.HapusGroupUserDevices(grp_id, user_out);
                                jika tipe(k["grup_device_cache"]) == "peta" { k["grup_device_cache"][grp_id] = kosong; }
                            }
                        }
                        cetak("[GRUP KEY] Anggota keluar/dikick dari " + grp_id + " -- device user bersangkutan dihapus dari cache (instant, tanpa purge grup).");
                    } lain jika tipe(g["gabung"]) == "larik" && panjang(g["gabung"]) > 0 {
                        ST.HapusGroupDevices(grp_id);
                        jika tipe(k["grup_device_cache"]) == "peta" { k["grup_device_cache"][grp_id] = kosong; }
                        cetak("[GRUP KEY] Anggota baru bergabung ke " + grp_id + " -- cache device grup dibuang agar pengiriman berikutnya mengambil device list terbaru.");
                    }
                }
            }
            jika nt == "devices" {
                buat d = NOTIF.UraiNotifikasiPerangkat(node);
                untuk (buat di3 = 0; di3 < panjang(d["perubahan"]); di3 = di3 + 1) {
                    buat ch3 = d["perubahan"][di3];
                    cetak("[DEVICE] " + ke_teks(d["dari"]["user"]) + " " + ke_teks(ch3["aksi"]) + " device -- invalidate cache device user ini (per-participant), bukan seluruh grup.");
                    ST.HapusUserDevices(d["dari"]["user"]);
                    // Cache per-grup (RAM+SQLite) masih bisa nyimpen device list
                    // lama user ini -- buang juga biar kepake ulang lewat cache
                    // per-participant yang udah fresh (murah: cuma user ini yang
                    // beneran perlu usync ulang, sisanya tetep hit cache).
                    ST.HapusSemuaGroupDevices();
                    k["grup_device_cache"] = peta_baru();
                }
            }
            jika nt == "picture" {
                buat f = NOTIF.UraiNotifikasiFoto(node);
                cetak("[FOTO] " + ke_teks(f["dari"]["user"]) + " " + ke_teks(f["aksi"]) + " foto profil");
            }
            jika nt == "encrypt" {
                buat en2 = NOTIF.UraiNotifikasiEnkripsi(node);
                jika tipe(en2["sisa_prekey"]) == "angka" {
                    cetak("[PREKEY] Server bilang sisa " + ke_teks(en2["sisa_prekey"]) + " prekey.");
                }
            }
        } tangkap (e) { cetak("[WARN] Gagal urai notification: " + ke_teks(e)); }
    }

    jika node["tag"] == "notification" {
        jika tipe(k["companion_info"]["encoded_linking_code"]) == "teks" {
            buat res_finish = PC.ProsesNotifikasiCodePair(node, k["companion_info"], k["identity_kp"]);
            jika tipe(res_finish["adv_secret"]) == "teks" {
                k["adv_secret"] = res_finish["adv_secret"];
                buat finish_bin = EN.BcMarshal(res_finish["finish_node"]);
                NS.KirimAman(k["ws_id"], k["noise_socket"], finish_bin);
                cetak("[PAIR PROTOCOL] Sent companion_finish IQ to WhatsApp server!");
            }
        }
    }

    jika node["tag"] == "iq" && tipe(node["children"]) == "larik" && panjang(node["children"]) > 0 {
        jika node["children"][0]["tag"] == "pair-success" {
            cetak("[PAIR SUCCESS] Pairing successful! Received pair-success node.");
            buat pair_res = PS.VerifikasiDanJawabPairSuccess(node, k["adv_secret"], k["noise_kp"]);
            cetak("[PAIR SUCCESS] Verified session JID: " + ke_teks(pair_res["jid"]));

            ST.SimpanSesi("main", CP["hex_encode"](k["noise_kp"]["priv"]), CP["hex_encode"](k["identity_kp"]["priv"]), pair_res["jid"], pair_res["lid"], CP["hex_encode"](k["adv_secret"]));

            ST.SimpanPrekeyInfo("main", CP["hex_encode"](k["identity_kp"]["signed_prekey_priv"]), ke_teks(k["identity_kp"]["signed_prekey_id"]), ke_teks(k["pairing_reg_id"]), pair_res["account_hex"]);
            cetak("[PAIR SUCCESS] Session saved to database/wa-bot.db");

            buat reply_bin = EN.BcMarshal(pair_res["reply_node"]);
            NS.KirimAman(k["ws_id"], k["noise_socket"], reply_bin);
        }
    }

    jika node["tag"] == "message" {
        cetak("[MSG MASUK] dari=" + ke_teks(node["attrs"]["from"]) + " id=" + ke_teks(node["attrs"]["id"]) + " type=" + ke_teks(node["attrs"]["type"]));

        buat msg_id = node["attrs"]["id"];
        buat msg_t = node["attrs"]["t"];
        buat sender_jid = node["attrs"]["from"];

        coba {
            buat ack_node2 = MS.BuatNodeAckPesan(msg_id, sender_jid);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(ack_node2));
        } tangkap (e) { cetak("[WARN] Gagal kirim ack pesan: " + ke_teks(e)); }

        coba {
            buat recv_node = MS.BuatNodeReceiptInactive(msg_id, sender_jid, node["attrs"]["participant"]);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(recv_node));
        } tangkap (e) { cetak("[WARN] Gagal kirim receipt inactive: " + ke_teks(e)); }

        coba {
            buat pn_val = kosong;
            jika tipe(node["attrs"]["participant_pn"]) == "peta" { pn_val = node["attrs"]["participant_pn"]; }
            jika tipe(node["attrs"]["sender_pn"]) == "peta" { pn_val = node["attrs"]["sender_pn"]; }
            buat lid_val = kosong;
            jika tipe(node["attrs"]["participant"]) == "peta" && node["attrs"]["participant"]["server"] == "lid" { lid_val = node["attrs"]["participant"]; }
            jika tipe(sender_jid) == "peta" && sender_jid["server"] == "lid" { lid_val = sender_jid; }
            jika tipe(pn_val) == "peta" && tipe(lid_val) == "peta" {
                k["DB"].SimpanLIDJID(lid_val["user"], pn_val["user"] + "@s.whatsapp.net");
            }
        } tangkap (e) {}

        fungsi kirim_retry_receipt2(alasan, paksa_keys) {
            coba {
                buat rr = MS.BuatNodeRetryReceipt(msg_id, sender_jid, msg_t, k["our_registration_id"], k["identity_kp"], k["retry_ctx"], node["attrs"]["participant"], paksa_keys);
                NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(rr["node"]));
                jika tipe(rr["otp_id"]) == "angka" {
                    cetak("[RETRY] Sisip bundle prekey baru (otp id=" + ke_teks(rr["otp_id"]) + ") di retry ke-" + ke_teks(rr["retry_count"]));
                }
                cetak("[RETRY] Minta pengirim kirim ulang pake pkmsg (" + alasan + "), count=" + ke_teks(rr["retry_count"]));
            } tangkap (e) { cetak("[WARN] Gagal kirim retry-receipt: " + ke_teks(e)); }
        }

        buat n_enc = kosong;
        untuk (buat c2 = 0; c2 < panjang(node["children"]); c2 = c2 + 1) {
            jika node["children"][c2]["tag"] == "enc" { n_enc = node["children"][c2]; berhenti; }
        }

        jika tipe(n_enc) != "peta" {
            kirim_retry_receipt2("gak ada <enc>", salah);
            hasil kosong;
        }

        jika n_enc["attrs"]["type"] == "skmsg" {
            coba {
                buat sender_lid_user = "";
                buat sender_device = 0;
                jika tipe(node["attrs"]["participant"]) == "peta" {
                    sender_lid_user = node["attrs"]["participant"]["user"];
                    sender_device = node["attrs"]["participant"]["device"];
                }
                buat sk_id = MS.SenderKeyId(sender_jid["user"], sender_lid_user, sender_device);
                buat sk_state = ST.CariSenderKey(sk_id);
                jika tipe(sk_state) != "peta" {
                    jika tipe(k["skmsg_tertunda"]) != "peta" { k["skmsg_tertunda"] = peta_baru(); }
                    buat tunda = peta_baru();
                    tunda["konten"] = n_enc["content"];
                    tunda["node"] = node;
                    tunda["sender_jid"] = sender_jid;
                    k["skmsg_tertunda"][sk_id] = tunda;
                    cetak("[SKMSG] Ditunda (belum ada sender-key), nunggu retry: " + sk_id);
                    kirim_retry_receipt2("skmsg tanpa sender-key state", benar);
                    hasil kosong;
                }
                buat sm_grup = MS.UraiSenderKeyMessage(n_enc["content"]);
                buat dg = MS.DekripsiGroupMessage(sk_id, sk_state, sm_grup);
                jika !dg["ok"] {
                    cetak("[DECRYPT GRUP] Gagal: " + ke_teks(dg["error"]));
                    kirim_retry_receipt2("grup: " + ke_teks(dg["error"]), salah);
                    hasil kosong;
                }
                ST.UpdateSenderKeyProgress(sk_id, dg["iterasi_baru"], dg["chain_key_baru_hex"]);
                _proses_pesan_grup_terdekripsi(k, node, sender_jid, dg);
            } tangkap (e) {
                cetak("[WARN] Error proses skmsg: " + ke_teks(e));
            }
            hasil kosong;
        }

        jika n_enc["attrs"]["type"] != "pkmsg" || tipe(k["our_signed_prekey_priv"]) != "teks" {

            kirim_retry_receipt2("enc type=" + ke_teks(n_enc["attrs"]["type"]), salah);
            hasil kosong;
        }

        buat text_content = "";
        buat fields_pesan = peta_baru();
        buat wire_mentah_pesan = kosong;
        coba {
            buat pkmsg = MS.UraiPrekeyMessage(n_enc["content"]);
            buat our_otp_priv = kosong;
            jika pkmsg["ada_otp"] {
                buat priv_hex2 = ST.CariPrekeyPrivat(pkmsg["prekey_id"]);
                jika tipe(priv_hex2) == "teks" && panjang(priv_hex2) > 0 { our_otp_priv = CP["hex_decode"](priv_hex2); }
            }
            buat sesi_rx = MS.BangunSesiX3dhPenerima(k["identity_kp"], k["our_signed_prekey_priv"], our_otp_priv, pkmsg);
            buat sm_rx = MS.UraiSignalMessage(pkmsg["signal_message_wire"]);
            buat dekripsi_hasil = MS.DekripsiPesanPertamaPenerima(sesi_rx, sm_rx);
            text_content = dekripsi_hasil["teks"];

            coba {
                buat ack_src = node["attrs"]["participant"];
                jika tipe(ack_src) != "peta" { ack_src = node["attrs"]["from"]; }
                jika tipe(ack_src) == "peta" && ack_src["server"] == "lid" {
                    buat ack_dk = MS.DeviceKey(ack_src["user"], ack_src["server"], ack_src["device"]);
                    jika ST.TandaiSesiKirimAcked(ack_dk) {
                        cetak("[SESI] " + ack_dk + " kirim pesan 1:1 yang sukses di-decrypt -- sesi acked.");
                    }
                }
            } tangkap (e) {}
            jika tipe(dekripsi_hasil["fields"]) == "peta" { fields_pesan = dekripsi_hasil["fields"]; }
            wire_mentah_pesan = dekripsi_hasil["wire_mentah"];
            cetak("[DECRYPT] Isi: " + text_content);
            proses_rahasia_pesan(k, node, sender_jid, dekripsi_hasil["fields"]);

            jika tipe(fields_pesan["12"]) == "teks" {
                coba { proses_history_sync_notifikasi(k, fields_pesan["12"]); }
                tangkap (e) { cetak("[WARN] Gagal proses history sync notif: " + ke_teks(e)); }
            }

            jika tipe(dekripsi_hasil["skdm_wire"]) == "teks" && panjang(dekripsi_hasil["skdm_wire"]) > 0 {
                coba {

                    buat skdm_sender_lid = sender_jid["user"];
                    buat skdm_sender_device = sender_jid["device"];
                    buat skdm_fallback_group = kosong;
                    jika tipe(node["attrs"]["participant"]) == "peta" {

                        skdm_sender_lid = node["attrs"]["participant"]["user"];
                        skdm_sender_device = node["attrs"]["participant"]["device"];
                        skdm_fallback_group = sender_jid["user"];
                    }
                    buat sk_id2 = MS.ProsesSenderKeyDistribution(skdm_sender_lid, skdm_sender_device, dekripsi_hasil["skdm_wire"], skdm_fallback_group);
                    cetak("[SENDER-KEY] Sender-key baru tersimpan (" + sk_id2 + ")");
                    _coba_proses_skmsg_tertunda(k, sk_id2);
                } tangkap (e) { cetak("[WARN] Gagal proses sender-key-distribution: " + ke_teks(e)); }
            }
        } tangkap (e) {
            cetak("[DECRYPT] Gagal: " + ke_teks(e));
            kirim_retry_receipt2("mac gagal: " + ke_teks(e), salah);
            hasil kosong;
        }

        buat sender = MS.ResolveSenderString(node, sender_jid);
        buat from_me = _is_from_me_node(k, node, sender);
        buat api_1_1 = siapkan_konteks_pesan(k, node, sender_jid, text_content, fields_pesan, wire_mentah_pesan);
        jika k["waBot"]["_cekArsipDanBisu"](sender, from_me) { hasil kosong; }
        jika pesan_lama(k, node) {
            cetak("[SKIP] Pesan lama/offline, gak dibales: " + ke_teks(node["attrs"]["id"]));
            hasil kosong;
        }
        // Lewat worker pool -- sama kayak jalur grup, bagian ini bisa
        // nyampe ke tunggu_iq (fetch prekey session) yang BLOCKING nunggu
        // kanal yang cuma diisi loop utama sendiri. Dipanggil langsung
        // (bukan lewat worker) dari proses_node -> loop utama = deadlock.
        // api_pesan dititip biar worker gak baca k["waBot"]["WA"] belakangan
        // (bisa ketimpa pesan lain -- penyebab react/reply nyasar).
        jalan(_proses_dan_balas_1_1, k, node, sender, from_me, sender_jid, text_content, api_1_1);
    }
}

fungsi _proses_dan_balas_1_1(k, node, sender, from_me, sender_jid, text_content, api_pesan) {
    buat reply_text = k["waBot"]["HandleMessage"](sender, text_content, from_me, api_pesan);
    jika panjang(reply_text) > 0 && sender_jid["server"] == "g.us" {
        kirim_balasan_grup(k, sender_jid["user"], reply_text, 0);
    } lain jika panjang(reply_text) > 0 {
        coba {
            buat target_pn = "";
            jika tipe(node["attrs"]["sender_pn"]) == "peta" { target_pn = node["attrs"]["sender_pn"]["user"]; }
            jika tipe(node["attrs"]["participant_pn"]) == "peta" { target_pn = node["attrs"]["participant_pn"]["user"]; }
            buat target_lid_user2 = sender_jid["user"];
            buat target_device2 = sender_jid["device"];

            buat rq_dk = MS.DeviceKey(target_lid_user2, "lid", target_device2);
            buat rq_bundle = kosong;

            jika tipe(ST.CariSesiKirim(rq_dk)) != "peta" {
                buat rq_id = "prekeyfetch_" + ke_teks(waktu());
                buat rq_devices = [(fungsi() { buat d = peta_baru(); d["user"] = target_lid_user2; d["server"] = "lid"; d["device"] = target_device2; hasil d; })()];
                NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(MS.BuatIqPrekeyFetch(rq_id, rq_devices)));
                cetak("[REPLY] Sesi belum ada, fetch prekey ke " + target_lid_user2 + ":" + ke_teks(target_device2) + "@lid");
                buat rp = MS.UraiResponsPrekey(TungguIq(k, rq_id, 200));
                jika !rp["ok"] { lempar "Gagal dapetin prekey bundle buat balasan."; }
                rq_bundle = rp["bundles"][0];
            }

            buat rsap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], rq_bundle, rq_dk, kosong);
            buat renc = MS.EnkripsiPesanKirim(rsap["sesi"], MS.BangunPesanTeks(reply_text));

            buat rq_wire = renc["wire"];
            buat rq_tipe = "msg";
            jika rsap["acked"] != benar && tipe(rsap["sesi"]["our_base_kp"]) == "peta" {
                rq_wire = MS.BungkusPrekeyMessage(rsap["sesi"], renc["wire"], k["our_registration_id"]);
                rq_tipe = "pkmsg";
            }

            jika rsap["fresh"] {
                MS.SimpanSesiKirimBaru(rq_dk, rsap["sesi"], renc["chain_index_baru"], renc["chain_key_baru_hex"]);
            } lain {
                ST.UpdateSesiKirimProgress(rq_dk, renc["chain_index_baru"], renc["chain_key_baru_hex"]);
            }

            buat rq_enc_list = [(fungsi() {
                buat en = peta_baru();
                en["user"] = target_lid_user2; en["server"] = "lid"; en["device"] = target_device2;
                en["wire"] = rq_wire; en["type"] = rq_tipe;
                hasil en;
            })()];
            buat rq_msg_id = _buat_msg_id();
            buat rq_msg_node = MS.BuatNodePesan(rq_msg_id, target_pn, target_lid_user2, rq_enc_list, CP["hex_decode"](k["session_data"]["account_hex"]));
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(rq_msg_node));
            cetak("[REPLY] Balasan terkirim (" + rq_tipe + "): " + reply_text);
        } tangkap (e) {
            cetak("[REPLY] Gagal kirim balasan: " + ke_teks(e));
        }
    }
}

fungsi _grup_iq(k, bikin_node) {
    buat req_id = "grp_" + ke_teks(waktu());
    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(bikin_node(req_id)));
    buat resp = TungguIq(k, req_id, 200);
    jika resp["attrs"]["type"] == "error" {
        buat kode = "?";
        jika tipe(resp["children"]) == "larik" && panjang(resp["children"]) > 0 {
            jika tipe(resp["children"][0]["attrs"]["code"]) == "teks" { kode = resp["children"][0]["attrs"]["code"]; }
        }
        lempar "server nolak (kode " + kode + ")";
    }
    hasil resp;
}

fungsi grup_info(k, group_user) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeDapatkanInfoGrup(id, group_user); });
}

fungsi _lid_kita(k) {
    buat raw = k["session_data"]["lid"];
    jika tipe(raw) != "teks" { hasil ""; }
    untuk (buat i = 0; i < panjang(raw); i = i + 1) {
        jika byte_di(raw, i) == 58 { hasil potong(raw, 0, i); }
    }
    hasil raw;
}

fungsi grup_peserta_detail(k, group_user) {
    buat info = grup_info(k, group_user);
    buat p = MS.UraiResponsGroupInfo(info);
    jika !p["ok"] { lempar "gagal baca daftar peserta grup"; }
    hasil p["participants"];
}

fungsi grup_kita_admin(k, group_user) {
    buat kita = _lid_kita(k);
    buat ps = grup_peserta_detail(k, group_user);
    untuk (buat i = 0; i < panjang(ps); i = i + 1) {
        jika ps[i]["lid_user"] == kita { hasil ps[i]["admin"]; }
    }
    hasil salah;
}

fungsi grup_ubah_peserta(k, group_user, nomor_list, aksi) {
    buat ps = grup_peserta_detail(k, group_user);
    buat kita = _lid_kita(k);

    buat aku_admin = salah;
    untuk (buat i = 0; i < panjang(ps); i = i + 1) {
        jika ps[i]["lid_user"] == kita && ps[i]["admin"] { aku_admin = benar; }
    }
    jika !aku_admin { lempar "bot bukan admin di grup ini"; }

    buat target = [];
    buat gak_ketemu = [];
    untuk (buat n = 0; n < panjang(nomor_list); n = n + 1) {
        buat cari = nomor_list[n];
        buat ketemu = kosong;
        untuk (buat i = 0; i < panjang(ps); i = i + 1) {
            jika ps[i]["pn_user"] == cari || ps[i]["lid_user"] == cari { ketemu = ps[i]; }
        }
        jika tipe(ketemu) == "peta" {
            jika aksi == "promote" && ketemu["admin"] { lempar cari + " udah admin"; }
            jika aksi == "demote" && !ketemu["admin"] { lempar cari + " bukan admin"; }
            buat e = peta_baru();
            e["user"] = ketemu["lid_user"];
            e["server"] = "lid";
            tambah(target, e);
        } lain {
            jika aksi == "add" {
                buat e2 = peta_baru();
                e2["user"] = cari;
                e2["server"] = "s.whatsapp.net";
                tambah(target, e2);
            } lain {
                tambah(gak_ketemu, cari);
            }
        }
    }
    jika panjang(gak_ketemu) > 0 { lempar ke_teks(gak_ketemu) + " gak ada di grup ini"; }

    buat unik = [];
    untuk (buat a2 = 0; a2 < panjang(target); a2 = a2 + 1) {
        buat dobel = salah;
        untuk (buat b2 = 0; b2 < panjang(unik); b2 = b2 + 1) {
            jika unik[b2]["user"] == target[a2]["user"] { dobel = benar; }
        }
        jika !dobel { tambah(unik, target[a2]); }
    }
    target = unik;
    jika panjang(target) == 0 { lempar "gak ada target yang valid"; }

    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeUbahPesertaJid(id, group_user, target, aksi); });
}

fungsi grup_set_nama(k, group_user, nama) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeSetNamaGrup(id, group_user, nama); });
}

fungsi grup_set_deskripsi(k, group_user, teks) {
    buat prev = "";
    coba {
        buat info = grup_info(k, group_user);
        jika tipe(info["children"]) == "larik" && panjang(info["children"]) > 0 {
            buat g = info["children"][0];
            jika tipe(g["children"]) == "larik" {
                untuk (buat i = 0; i < panjang(g["children"]); i = i + 1) {
                    jika g["children"][i]["tag"] == "description" {
                        jika tipe(g["children"][i]["attrs"]["id"]) == "teks" { prev = g["children"][i]["attrs"]["id"]; }
                    }
                }
            }
        }
    } tangkap (e) {}
    buat baru = "desc_" + ke_teks(waktu());
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeSetDeskripsiGrup(id, group_user, teks, prev, baru); });
}

fungsi grup_set_terkunci(k, group_user, terkunci) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeSetGrupTerkunci(id, group_user, terkunci); });
}

fungsi grup_set_announce(k, group_user, cuma_admin) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeSetGroupAnnounce(id, group_user, cuma_admin); });
}

fungsi grup_link(k, group_user, reset) {
    buat r = _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeLinkUndangan(id, group_user, reset); });
    buat u = GRP.UraiLinkUndangan(r);
    jika !u["ok"] { lempar "link undangan gak ketemu di respons"; }
    hasil u["link"];
}

fungsi grup_keluar(k, group_user) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeKeluarGrup(id, group_user); });
}

fungsi grup_buat(k, nama, nomor_list) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeBuatGrup(id, nama, nomor_list); });
}

fungsi grup_gabung(k, kode) {
    hasil _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeGabungLewatLink(id, kode); });
}

fungsi grup_daftar(k) {
    buat r = _grup_iq(k, fungsi(id) { hasil GRP.BuatNodeDaftarGrup(id); });
    hasil GRP.UraiDaftarGrup(r);
}

kelas WaApi {
    fungsi konstruktor(k_param, konteks_param) {
        ini.k = k_param;
        ini.konteks = konteks_param;
        ini.budy = konteks_param["budy"];
        ini.IsGrup = (konteks_param["server"] == "g.us");
    }

    fungsi KirimTeks(teks) {
        jika ini.IsGrup { hasil kirim_balasan_grup(ini.k, ini.konteks["chat_user"], teks, 0); }
        lempar "kirim teks non-grup lewat API belum didukung";
    }

    // SendMessage(messageStruct, opsi) -- niru whatsmeow: SATU pintu masuk
    // generik, messageStruct field-nya persis kayak proto Message (jadi
    // apapun yang ada di skema pb.ns -- conversation/imageMessage/
    // buttonsMessage/interactiveMessage/pollCreationMessage/dst -- bisa
    // langsung dipasang, gak perlu fungsi Kirim* baru tiap ada tipe pesan
    // baru). opsi (opsional): {additionalNodes: [node, ...] | node,
    // label: "teks buat log/cache"}. Quoted/mention dipasang langsung di
    // messageStruct (contextInfo.stanzaID/participant/quotedMessage/
    // mentionedJID), sama kayak whatsmeow.
    fungsi SendMessage(message_struct, opsi) {
        jika !ini.IsGrup { lempar "SendMessage non-grup belum didukung"; }
        jika tipe(message_struct) != "peta" {
            lempar "SendMessage: argumen pertama harus struct Message (peta) -- field-nya sama kayak proto (conversation/imageMessage/dst)";
        }
        buat node_ekstra = kosong;
        buat label = kosong;
        jika tipe(opsi) == "peta" {
            jika tipe(opsi["quoted"]) == "peta" { message_struct = MS.TerapkanKutip(message_struct, opsi["quoted"]); }
            jika tipe(opsi["additionalNodes"]) == "peta" || tipe(opsi["additionalNodes"]) == "larik" {
                node_ekstra = opsi["additionalNodes"];
            }
            jika tipe(opsi["label"]) == "teks" { label = opsi["label"]; }
        }
        jika tipe(label) != "teks" { label = _ringkas_pesan_map(message_struct); }
        buat wire = PB.PbEnkodeBernama(message_struct, "Message");
        hasil KirimWireGrup(ini.k, ini.konteks["chat_user"], wire, label, 0, node_ekstra);
    }

    fungsi KirimKutip(teks) {
        jika !ini.IsGrup { lempar "kutip non-grup belum didukung"; }
        hasil kirim_teks_kutip_grup(ini.k, ini.konteks["chat_user"], teks, ini.konteks["kutip"]);
    }

    fungsi KirimStiker(path_media, crop, tipe_media_asli) {
        jika !ini.IsGrup { lempar "stiker non-grup belum didukung"; }
        buat tmp_webp = "/tmp/stk_" + ke_teks(waktu()) + "_" + CP["acak_bytes_hex"](4) + ".webp";
        buat animasi = (tipe_media_asli == "video");
        buat durasi = 0;
        jika animasi { durasi = durasi_media_detik(path_media); }
        jika animasi && durasi > 10.5 {
            lempar "videonya kepanjangan (" + ke_teks(durasi) + " detik). Maksimal 10 detik buat stiker.";
        }
        jika animasi {
            buat fps = 15;
            jika crop { fps = 12; }
            buat_stiker_dari_video(path_media, tmp_webp, crop, fps);
        } lain {
            buat_stiker_dari_gambar(path_media, tmp_webp, crop);
        }
        tulis_metadata_stiker(tmp_webp, "MIAW BOT", "ND-Labs");
        hasil kirim_stiker_grup(ini.k, ini.konteks["chat_user"], tmp_webp, kosong);
    }

    fungsi KirimGambar(path, caption) {
        jika !ini.IsGrup { lempar "gambar non-grup belum didukung"; }
        hasil kirim_gambar_grup(ini.k, ini.konteks["chat_user"], path, caption, kosong);
    }
    fungsi KirimGambarKutip(path, caption) {
        jika !ini.IsGrup { lempar "gambar non-grup belum didukung"; }
        hasil kirim_gambar_grup(ini.k, ini.konteks["chat_user"], path, caption, ini.konteks["kutip"]);
    }
    fungsi KirimDokumen(path, nama_file, mimetype) {
        jika !ini.IsGrup { lempar "dokumen non-grup belum didukung"; }
        hasil kirim_dokumen_grup(ini.k, ini.konteks["chat_user"], path, nama_file, mimetype, kosong);
    }
    fungsi KirimDokumenKutip(path, nama_file, mimetype) {
        jika !ini.IsGrup { lempar "dokumen non-grup belum didukung"; }
        hasil kirim_dokumen_grup(ini.k, ini.konteks["chat_user"], path, nama_file, mimetype, ini.konteks["kutip"]);
    }
    fungsi KirimVideo(path, caption) {
        jika !ini.IsGrup { lempar "video non-grup belum didukung"; }
        hasil kirim_video_grup(ini.k, ini.konteks["chat_user"], path, caption, kosong);
    }
    fungsi KirimVideoKutip(path, caption) {
        jika !ini.IsGrup { lempar "video non-grup belum didukung"; }
        hasil kirim_video_grup(ini.k, ini.konteks["chat_user"], path, caption, ini.konteks["kutip"]);
    }
    fungsi KirimAlbum(items) {
        jika !ini.IsGrup { lempar "album non-grup belum didukung"; }
        hasil kirim_album_grup(ini.k, ini.konteks["chat_user"], items);
    }
    fungsi KirimAudio(path, mimetype, ptt) {
        jika !ini.IsGrup { lempar "audio non-grup belum didukung"; }
        hasil kirim_audio_grup(ini.k, ini.konteks["chat_user"], path, mimetype, ptt, kosong);
    }
    fungsi KirimAudioKutip(path, mimetype, ptt) {
        jika !ini.IsGrup { lempar "audio non-grup belum didukung"; }
        hasil kirim_audio_grup(ini.k, ini.konteks["chat_user"], path, mimetype, ptt, ini.konteks["kutip"]);
    }
    fungsi KirimReaksi(emoji) {
        jika !ini.IsGrup { lempar "reaksi non-grup belum didukung"; }
        hasil kirim_reaksi_grup(ini.k, ini.konteks["chat_user"], ini.konteks["msg_id"], ini.konteks["pengirim"], emoji);
    }
    // Alias -- method delegasi asli (bukan nyimpen reference kayak
    // "a['react'] = a['KirimReaksi']" versi peta dulu), soalnya method
    // instance yang diambil lepas dari objeknya (disimpen ke variabel
    // lain, dipanggil belakangan) kehilangan ikatan `ini`-nya di
    // Nusantara -- konfirmed lewat tes langsung sebelum refactor ini.
    fungsi react(emoji) { hasil ini.KirimReaksi(emoji); }

    fungsi UnduhMedia(m_media, path_tujuan) { hasil unduh_media_pesan(ini.k, m_media, path_tujuan); }
    fungsi _TargetGrup(target) {
        jika tipe(target) == "teks" && panjang(target) > 0 { hasil target; }
        hasil ini.konteks["chat_user"];
    }
    fungsi GrupInfo(target) { hasil grup_info(ini.k, ini._TargetGrup(target)); }
    fungsi GrupPesertaDetail(target) { hasil grup_peserta_detail(ini.k, ini._TargetGrup(target)); }
    fungsi GrupAkuAdmin(target) { hasil grup_kita_admin(ini.k, ini._TargetGrup(target)); }
    fungsi GrupPeserta(nomor, aksi, target) { hasil grup_ubah_peserta(ini.k, ini._TargetGrup(target), nomor, aksi); }
    fungsi GrupSetNama(nama, target) { hasil grup_set_nama(ini.k, ini._TargetGrup(target), nama); }
    fungsi GrupSetDesk(teks, target) { hasil grup_set_deskripsi(ini.k, ini._TargetGrup(target), teks); }
    fungsi GrupKunci(x, target) { hasil grup_set_terkunci(ini.k, ini._TargetGrup(target), x); }
    fungsi GrupAnnounce(x, target) { hasil grup_set_announce(ini.k, ini._TargetGrup(target), x); }
    fungsi GrupLink(reset, target) { hasil grup_link(ini.k, ini._TargetGrup(target), reset); }
    fungsi GrupKeluar(target) { hasil grup_keluar(ini.k, ini._TargetGrup(target)); }
    fungsi GrupBuat(nama, nomor) { hasil grup_buat(ini.k, nama, nomor); }
    fungsi GrupGabung(kode) { hasil grup_gabung(ini.k, kode); }
    fungsi GrupDaftar() { hasil grup_daftar(ini.k); }

    fungsi KirimLokasi(nama, alamat, thumb) {
        jika !ini.IsGrup { lempar "lokasi non-grup belum didukung"; }
        hasil kirim_lokasi_grup(ini.k, ini.konteks["chat_user"], nama, alamat, thumb, kosong);
    }

    fungsi KirimTeksAd(teks, judul, isi_kecil, thumb, besar) {
        jika !ini.IsGrup { lempar "ad-reply non-grup belum didukung"; }
        hasil kirim_teks_ad_grup(ini.k, ini.konteks["chat_user"], teks, judul, isi_kecil, thumb, besar, kosong,
            "https://app.nd-labs.dev/preview.jpg", "https://github.com/Nahidabyte");
    }

    fungsi KirimTeksExt(teks) {
        jika !ini.IsGrup { lempar "non-grup belum didukung"; }
        hasil kirim_teks_ext_grup(ini.k, ini.konteks["chat_user"], teks);
    }

    fungsi KirimPreview(teks, url, judul, desk, thumb, lebar, tinggi, besar) {
        jika !ini.IsGrup { lempar "preview non-grup belum didukung"; }
        hasil kirim_preview_grup(ini.k, ini.konteks["chat_user"], teks, url, judul, desk, thumb, lebar, tinggi, besar);
    }

    fungsi KirimPreviewMedia(teks, url, judul, desk, gambar, lebar, tinggi) {
        jika !ini.IsGrup { lempar "preview non-grup belum didukung"; }
        hasil kirim_preview_media_grup(ini.k, ini.konteks["chat_user"], teks, url, judul, desk, gambar, lebar, tinggi);
    }

    fungsi KirimInteraktif(teks, tombol_list, footer_teks, path_header_gambar, node_ekstra) {
        jika !ini.IsGrup { lempar "interaktif non-grup belum didukung"; }
        hasil kirim_interaktif_grup(ini.k, ini.konteks["chat_user"], teks, tombol_list, footer_teks, path_header_gambar, node_ekstra);
    }
    fungsi KirimTombolLokasi(judul, alamat, isi, footer, tombol_list, path_thumb, node_ekstra) {
        jika !ini.IsGrup { lempar "tombol-lokasi non-grup belum didukung"; }
        hasil kirim_tombol_lokasi_grup(ini.k, ini.konteks["chat_user"], judul, alamat, isi, footer, tombol_list, path_thumb, kosong, node_ekstra);
    }
    fungsi TombolUrl(label, url) { hasil tombol_url(label, url); }
    fungsi TombolBalasanCepat(label, id_perintah) { hasil tombol_balasan_cepat(label, id_perintah); }
    fungsi TombolList(label, sections) { hasil tombol_list_pilihan(label, sections); }

    fungsi KirimPoll(nama, opsi, jml) {
        jika !ini.IsGrup { lempar "poll non-grup belum didukung"; }
        hasil kirim_poll_grup(ini.k, ini.konteks["chat_user"], nama, opsi, jml);
    }
    fungsi KirimWireMentah(wire) {
        jika !ini.IsGrup { lempar "kirim raw non-grup belum didukung"; }
        hasil KirimWireGrup(ini.k, ini.konteks["chat_user"], wire, "[raw]", 0, kosong);
    }
    fungsi KirimTeksKe(target_user, teks) {
        hasil kirim_teks_1_1(ini.k, target_user, teks);
    }
    fungsi MintaHistori(chat_jid, oldest_id, oldest_from_me, oldest_ts, count) {
        buat wire = MS.BangunPesanMintaHistory(chat_jid, oldest_id, oldest_from_me, oldest_ts, count);
        hasil kirim_peer_message(ini.k, wire, benar);
    }
    fungsi Hapus(msg_id) {
        jika !ini.IsGrup { lempar "hapus non-grup belum didukung"; }
        hasil kirim_hapus_grup(ini.k, ini.konteks["chat_user"], msg_id, kosong, benar);
    }
    fungsi HapusPesanOrang(msg_id, sender_participant) {
        jika !ini.IsGrup { lempar "hapus non-grup belum didukung"; }
        hasil kirim_hapus_grup(ini.k, ini.konteks["chat_user"], msg_id, sender_participant, salah);
    }
    fungsi Edit(msg_id, konten_baru_wire) {
        jika !ini.IsGrup { lempar "edit non-grup belum didukung"; }
        hasil kirim_edit_grup(ini.k, ini.konteks["chat_user"], msg_id, konten_baru_wire);
    }
    fungsi EditTeks(msg_id, teks_baru) {
        jika !ini.IsGrup { lempar "edit non-grup belum didukung"; }
        hasil kirim_edit_grup(ini.k, ini.konteks["chat_user"], msg_id, MS.BangunPesanTeks(teks_baru));
    }
    fungsi AturDisappearing(detik) {
        jika !ini.IsGrup { lempar "disappearing non-grup belum didukung"; }
        hasil atur_disappearing_grup(ini.k, ini.konteks["chat_user"], detik);
    }

    fungsi KirimPesan(target, content, opsi) {
        jika tipe(content) != "peta" { lempar "KirimPesan: content harus peta, mis. {text: \"halo\"}"; }
        buat quoted = kosong;
        buat node_ekstra = kosong;
        jika tipe(opsi) == "peta" {
            jika tipe(opsi["quoted"]) == "peta" { quoted = opsi["quoted"]; }
            jika tipe(opsi["additionalNodes"]) == "peta" || tipe(opsi["additionalNodes"]) == "larik" {
                node_ekstra = opsi["additionalNodes"];
            }
        }
        buat lama_konteks_kutip = ini.konteks["kutip"];
        buat lama_chat_user = ini.konteks["chat_user"];
        jika tipe(quoted) == "peta" { ini.konteks["kutip"] = quoted; }
        jika tipe(target) == "teks" && panjang(target) > 0 { ini.konteks["chat_user"] = target; }

        buat res = kosong;
        coba {
            buat teks = content["text"];
            jika tipe(teks) != "teks" { teks = content["teks"]; }
            buat gambar = content["image"];
            jika tipe(gambar) != "teks" { gambar = content["gambar"]; }
            buat video = content["video"];
            buat dokumen = content["document"];
            jika tipe(dokumen) != "teks" { dokumen = content["dokumen"]; }
            buat audio = content["audio"];
            buat stiker = content["sticker"];
            jika tipe(stiker) != "teks" { stiker = content["stiker"]; }
            buat lokasi = content["location"];
            jika tipe(lokasi) != "peta" { lokasi = content["lokasi"]; }
            buat album = content["album"];
            buat poll = content["poll"];
            buat reaksi = content["reaction"];
            jika tipe(reaksi) != "teks" { reaksi = content["reaksi"]; }
            buat tombol = content["buttons"];
            jika tipe(tombol) != "larik" { tombol = content["tombol"]; }
            buat footer = content["footer"];
            buat header_img = content["headerImage"];
            jika tipe(header_img) != "teks" { header_img = content["header"]; }

            jika tipe(tombol) == "larik" && tipe(lokasi) == "peta" {
                res = ini.KirimTombolLokasi(lokasi["name"], lokasi["address"], teks, footer, tombol, lokasi["thumb"], node_ekstra);
            } lain jika tipe(tombol) == "larik" {
                res = ini.KirimInteraktif(teks, tombol, footer, header_img, node_ekstra);
            } lain jika tipe(teks) == "teks" {
                jika tipe(quoted) == "peta" { res = ini.KirimKutip(teks); }
                lain { res = ini.KirimTeks(teks); }
            } lain jika tipe(gambar) == "teks" {
                jika tipe(quoted) == "peta" { res = ini.KirimGambarKutip(gambar, content["caption"]); }
                lain { res = ini.KirimGambar(gambar, content["caption"]); }
            } lain jika tipe(video) == "teks" {
                jika tipe(quoted) == "peta" { res = ini.KirimVideoKutip(video, content["caption"]); }
                lain { res = ini.KirimVideo(video, content["caption"]); }
            } lain jika tipe(dokumen) == "teks" {
                buat nf = content["fileName"];
                jika tipe(nf) != "teks" { nf = content["namaFile"]; }
                jika tipe(quoted) == "peta" { res = ini.KirimDokumenKutip(dokumen, nf, content["mimetype"]); }
                lain { res = ini.KirimDokumen(dokumen, nf, content["mimetype"]); }
            } lain jika tipe(audio) == "teks" {
                buat ptt = (content["ptt"] == benar);
                jika tipe(quoted) == "peta" { res = ini.KirimAudioKutip(audio, content["mimetype"], ptt); }
                lain { res = ini.KirimAudio(audio, content["mimetype"], ptt); }
            } lain jika tipe(stiker) == "teks" {
                buat crop = (content["crop"] == benar);
                buat tipe_asli = content["originalType"];
                jika tipe(tipe_asli) != "teks" { tipe_asli = content["tipeAsli"]; }
                res = ini.KirimStiker(stiker, crop, tipe_asli);
            } lain jika tipe(lokasi) == "peta" {
                res = ini.KirimLokasi(lokasi["name"], lokasi["address"], lokasi["thumb"]);
            } lain jika tipe(album) == "larik" {
                res = ini.KirimAlbum(album);
            } lain jika tipe(poll) == "peta" {
                res = ini.KirimPoll(poll["name"], poll["values"], poll["selectableCount"]);
            } lain jika tipe(reaksi) == "teks" {
                res = ini.KirimReaksi(reaksi);
            } lain {
                lempar "KirimPesan: content gak dikenali -- pakai salah satu key: text/image/video/document/audio/sticker/location/album/poll/reaction/buttons";
            }
        } tangkap (e) {
            lempar e;
        } akhirnya {
            ini.konteks["kutip"] = lama_konteks_kutip;
            ini.konteks["chat_user"] = lama_chat_user;
        }
        hasil res;
    }
}

fungsi buat_api(k, konteks) {
    hasil WaApi(k, konteks);
}

fungsi siapkan_konteks_pesan(k, node, chat_jid, teks_asli, fields, wire_mentah) {
    buat pengirim = node["attrs"]["participant"];
    jika tipe(pengirim) != "peta" { pengirim = node["attrs"]["from"]; }

    buat kutip = peta_baru();
    kutip["stanza_id"] = node["attrs"]["id"];
    kutip["participant"] = pengirim;
    kutip["remote_jid"] = chat_jid;
    kutip["pesan_wire"] = MS.BangunPesanTeks(teks_asli);

    buat c = peta_baru();
    c["chat_user"] = chat_jid["user"];
    c["server"] = chat_jid["server"];
    c["msg_id"] = node["attrs"]["id"];
    c["ts"] = 0;
    jika tipe(node["attrs"]["t"]) == "teks" {
        coba { c["ts"] = ke_angka(node["attrs"]["t"]); } tangkap (e) {}
    }
    c["push_name"] = "";
    jika tipe(node["attrs"]["notify"]) == "teks" { c["push_name"] = node["attrs"]["notify"]; }
    c["pengirim"] = pengirim;
    c["teks"] = teks_asli;
    c["kutip"] = kutip;
    c["mention"] = [];
    c["dikutip"] = kosong;
    c["budy"] = peta_baru();
    coba {
        buat bd = MS.EkstrakBudy(fields);
        c["budy"] = bd;
        c["mention"] = bd["mention"];
        c["dikutip"] = bd["kutipan"];
    } tangkap (e) { cetak("[WARN] Gagal ekstrak budy: " + ke_teks(e)); }
    c["wire_mentah"] = wire_mentah;
    jika tipe(c["budy"]) == "peta" { c["budy"]["wire_mentah"] = wire_mentah; }

    // buat_api dipanggil sekali di sini, dan objeknya juga dioper langsung
    // ke goroutine pemroses (lihat jalan(_proses_dan_balas_grup/1_1, ...))
    // buat dibawa ke HandleMessage -- k["waBot"]["WA"] masih diisi buat
    // jalur lain yang sync (mis. eval, admin command), tapi goroutine
    // gak boleh baca field bersama ini belakangan karena bisa ketimpa
    // pesan lain yang masuk duluan (penyebab react/reply nyasar).
    buat api_pesan = buat_api(k, c);
    k["waBot"]["WA"] = api_pesan;
    // JANGAN simpen api_pesan balik ke c (mis. c["_api"] = api_pesan) --
    // closure api_pesan udah nangkep c lewat variabel "konteks", jadi
    // nyimpen api_pesan ke dalem c bikin siklus referensi (c -> api_pesan
    // -> c). Return api_pesan langsung aja (satu arah), biar gak ada
    // siklus yang bisa bikin GC/tracer rekursi tak terbatas (dicurigai
    // penyebab segfault stack-overflow yang kejadian abis ini ditambahin).
    hasil api_pesan;
}

fungsi atur_alamat_proxy(k, alamat) {
    hasil atur_proxy(k, alamat);
}

fungsi atur_disappearing_1_1(k, target_user, detik, setting_ts) {
    buat wire = MS.BangunPesanDisappearing(detik, setting_ts);
    hasil kirim_wire_1_1(k, target_user, wire, "disappearing:" + ke_teks(detik));
}

fungsi atur_disappearing_grup(k, group_user, detik) {
    hasil _grup_iq(k, fungsi(id) { hasil MS.BuatIqEphemeralGrup(id, group_user, detik); });
}

fungsi atur_proxy(k, proxy_url) {
    k["proxy_url"] = proxy_url;
    cetak("[PROXY] Disimpan di sesi (" + ke_teks(proxy_url) + "), TAPI belum diterapkan ke koneksi WS/curl -- perlu diintegrasikan manual ke socket/framesocket.ns + media.ns.");
    hasil benar;
}

fungsi atur_proxy_socks(k, alamat_socks) {
    k["proxy_socks"] = alamat_socks;
    cetak("[PROXY] SOCKS disimpan di sesi (" + ke_teks(alamat_socks) + "), TAPI belum diterapkan -- sama seperti atur_proxy, perlu integrasi manual.");
    hasil benar;
}

fungsi kirim_app_state_patch(k, nama, key_id_hex, mutasi_list) {
    buat kunci_hex = ST.CariAppstateKey(key_id_hex);
    jika tipe(kunci_hex) != "teks" { lempar "kunci appstate " + key_id_hex + " gak ditemukan di store -- minta dulu via request_app_state_keys."; }
    buat kunci = AK.ExpandAppStateKeys(CP["hex_decode"](kunci_hex));

    buat versi_row = ST.CariAppstateVersi(nama);
    buat versi_lama = 0;
    buat hash_lama = AS.HashKosong();
    jika tipe(versi_row) == "peta" {
        versi_lama = versi_row["version"];
        hash_lama = CP["hex_decode"](versi_row["hash"]);
    }

    buat built = AS.BangunPatchBytes(nama, mutasi_list, key_id_hex, kunci, versi_lama, hash_lama);

    buat req_id = "asend_" + ke_teks(waktu());
    buat node = AS.BuatIqKirimPatch(req_id, nama, built["patch_bytes"]);
    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(node));
    buat resp = TungguIq(k, req_id, 200);
    buat parsed = AS.UraiResponsKirimPatch(resp);
    jika !parsed["ok"] {
        lempar "app state update ditolak (kode " + ke_teks(parsed["error_kode"]) + ") -- retry setelah konflik BELUM diimplementasi, coba ambil ulang appstate dulu.";
    }

    ST.SimpanAppstateVersi(nama, built["versi_baru"], CP["hex_encode"](built["hash_baru"]));
    hasil benar;
}

fungsi kirim_edit_1_1(k, target_user, msg_id, konten_baru_wire) {
    buat remote_jid = target_user + "@s.whatsapp.net";
    buat wire = MS.BangunPesanEdit(remote_jid, msg_id, konten_baru_wire);
    hasil kirim_wire_1_1(k, target_user, wire, "edit:" + msg_id);
}

fungsi kirim_edit_grup(k, group_user, msg_id, konten_baru_wire) {
    buat remote_jid = group_user + "@g.us";
    buat wire = MS.BangunPesanEdit(remote_jid, msg_id, konten_baru_wire);
    hasil KirimWireGrup(k, group_user, wire, "edit:" + msg_id, 0, kosong);
}

fungsi kirim_hapus_1_1(k, target_user, msg_id, dari_saya) {
    buat remote_jid = target_user + "@s.whatsapp.net";
    buat wire = MS.BangunPesanHapus(remote_jid, kosong, msg_id, dari_saya);
    hasil kirim_wire_1_1(k, target_user, wire, "revoke:" + msg_id);
}

fungsi kirim_hapus_grup(k, group_user, msg_id, sender_participant, dari_saya) {
    buat remote_jid = group_user + "@g.us";
    buat wire = MS.BangunPesanHapus(remote_jid, sender_participant, msg_id, dari_saya);
    buat rev_flag = "0";
    jika dari_saya { rev_flag = "1"; }
    hasil KirimWireGrup(k, group_user, wire, "revoke:" + rev_flag + ":" + msg_id, 0, kosong);
}

fungsi kirim_wire_1_1(k, target_user, msg_wire, label) {
    kanal_terima(k["kirim_lock"]);
    coba {
        buat us_id = "usyncw1_" + ke_teks(waktu());
        buat us_iq = MS.BuatIqUsync(us_id, target_user);
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(us_iq));
        buat unode = TungguIq(k, us_id, 200);
        buat us_devices = kosong;
        buat uparsed = MS.UraiResponsUsync(unode);
        jika uparsed["ok"] { us_devices = uparsed["devices"]; }
        jika tipe(us_devices) != "larik" || panjang(us_devices) == 0 { lempar "Gagal resolve device list target."; }

        buat devices_perlu_bundle = [];
        untuk (buat di = 0; di < panjang(us_devices); di = di + 1) {
            buat dv = us_devices[di];
            buat dk = MS.DeviceKey(dv["user"], dv["server"], dv["device"]);
            buat existing = ST.CariSesiKirim(dk);
            jika tipe(existing) != "peta" { tambah(devices_perlu_bundle, dv); }
        }

        buat pf_bundles = [];
        jika panjang(devices_perlu_bundle) > 0 {
            buat pf_id = "prekeyfetchw1_" + ke_teks(waktu());
            buat pf_iq = MS.BuatIqPrekeyFetch(pf_id, devices_perlu_bundle);
            NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(pf_iq));
            buat pnode = TungguIq(k, pf_id, 200);
            buat pparsed = MS.UraiResponsPrekey(pnode);
            jika pparsed["ok"] { pf_bundles = pparsed["bundles"]; }
        }

        buat bundle_by_dk = peta_baru();
        untuk (buat bi2 = 0; bi2 < panjang(pf_bundles); bi2 = bi2 + 1) {
            buat b = pf_bundles[bi2];
            bundle_by_dk[MS.DeviceKey(b["user"], b["server"], b["device"])] = b;
        }

        buat enc_list = [];
        buat lid_target = target_user;
        untuk (buat di2 = 0; di2 < panjang(us_devices); di2 = di2 + 1) {
            buat dv2 = us_devices[di2];
            jika dv2["server"] == "lid" { lid_target = dv2["user"]; }
            buat dk2 = MS.DeviceKey(dv2["user"], dv2["server"], dv2["device"]);
            buat bundle2 = bundle_by_dk[dk2];
            coba {
                buat sap = MS.AmbilAtauBangunSesiKirim(k["identity_kp"], bundle2, dk2, kosong);
                buat enc_hasil = MS.EnkripsiPesanKirim(sap["sesi"], msg_wire);
                buat entri = peta_baru();
                entri["user"] = dv2["user"]; entri["server"] = dv2["server"]; entri["device"] = dv2["device"];
                jika sap["acked"] != benar && tipe(sap["sesi"]["our_base_kp"]) == "peta" {
                    entri["wire"] = MS.BungkusPrekeyMessage(sap["sesi"], enc_hasil["wire"], k["our_registration_id"]);
                    entri["type"] = "pkmsg";
                } lain {
                    entri["wire"] = enc_hasil["wire"];
                    entri["type"] = "msg";
                }
                jika sap["fresh"] {
                    MS.SimpanSesiKirimBaru(dk2, sap["sesi"], enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
                } lain {
                    ST.UpdateSesiKirimProgress(dk2, enc_hasil["chain_index_baru"], enc_hasil["chain_key_baru_hex"]);
                }
                tambah(enc_list, entri);
            } tangkap (e) {
                cetak("[WARN] Skip device wire-1:1 " + dk2 + ": " + ke_teks(e));
            }
        }
        jika panjang(enc_list) == 0 { lempar "Gak ada device yang bisa dikirimin (semua gagal bangun sesi)."; }

        buat msg_id = _buat_msg_id();
        buat node = MS.BuatNodePesan(msg_id, target_user, lid_target, enc_list, CP["hex_decode"](k["session_data"]["account_hex"]));
        NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(node));
        cetak("[KIRIM 1:1] wire (" + ke_teks(label) + ") terkirim ke " + ke_teks(target_user) + " (" + ke_teks(panjang(enc_list)) + " device)");
        hasil msg_id;
    } tangkap (e) {
        cetak("[WARN] kirim_wire_1_1 gagal: " + ke_teks(e));
        hasil kosong;
    } akhirnya {
        kanal_kirim(k["kirim_lock"], 1);
    }
}

fungsi logout(k) {
    buat own_user = k["session_data"]["jid"];
    jika tipe(own_user) != "teks" || panjang(own_user) == 0 { lempar "belum login (own JID kosong) -- gak bisa logout"; }

    buat req_id = "logout_" + ke_teks(waktu());
    buat n_rcd = peta_baru();
    n_rcd["tag"] = "remove-companion-device"; n_rcd["attrs"] = peta_baru();
    n_rcd["attrs"]["jid"] = MS._jid_peta(own_user, "s.whatsapp.net", 0);
    n_rcd["attrs"]["reason"] = "user_initiated";
    n_rcd["children"] = []; n_rcd["content"] = kosong; n_rcd["ada_isi"] = salah;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id; iq_attrs["to"] = MS._jid_peta("", "s.whatsapp.net", 0);
    iq_attrs["type"] = "set"; iq_attrs["xmlns"] = "md";

    buat node = peta_baru();
    node["tag"] = "iq"; node["attrs"] = iq_attrs; node["children"] = [n_rcd];
    node["content"] = kosong; node["ada_isi"] = benar;

    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(node));
    buat resp = TungguIq(k, req_id, 200);
    jika resp["attrs"]["type"] == "error" { lempar "server nolak permintaan logout"; }

    putuskan_paksa(k);
    cetak("[LOGOUT] Berhasil unlink device. CATATAN: data sesi lokal (identity, sesi, appstate) BELUM dihapus otomatis -- belum ada fungsi hapus-semua di store/session.ns, hapus manual DB kalau perlu.");
    hasil benar;
}

fungsi pisahkan_pemetaan_lid_pn(first_user, first_server, second_user, second_server) {
    buat r = peta_baru();
    r["ok"] = salah;
    jika first_server == "lid" && second_server == "s.whatsapp.net" {
        r["ok"] = benar; r["lid_user"] = first_user; r["pn_user"] = second_user; hasil r;
    }
    jika first_server == "s.whatsapp.net" && second_server == "lid" {
        r["ok"] = benar; r["lid_user"] = second_user; r["pn_user"] = first_user; hasil r;
    }
    hasil r;
}

fungsi putuskan_paksa(k) {
    coba { WS["ws_tutup"](k["ws_id"]); } tangkap (e) {}
    hasil benar;
}

fungsi reset_koneksi(k) {
    hasil putuskan_paksa(k);
}

fungsi tandai_appstate_bersih(k, clean_type, ts) {
    buat req_id = "dirty_" + ke_teks(waktu());
    buat node = AS.BuatIqMarkNotDirty(req_id, clean_type, ts);
    NS.KirimAman(k["ws_id"], k["noise_socket"], EN.BcMarshal(node));
    buat resp = TungguIq(k, req_id, 200);
    hasil resp["attrs"]["type"] != "error";
}

fungsi urai_pesan_web(chat_user, chat_server, wmi_bytes) {
    buat wmi = PB.PbDekode(wmi_bytes);
    buat r = peta_baru();
    r["ok"] = salah;
    jika tipe(wmi["1"]) != "teks" { hasil r; }
    buat key = PB.PbDekode(wmi["1"]);

    r["ok"] = benar;
    r["msg_id"] = key["3"];
    r["dari_saya"] = (key["2"] == 1);
    r["participant"] = key["4"];
    r["chat_user"] = chat_user;
    r["chat_server"] = chat_server;
    r["timestamp"] = wmi["3"];
    r["push_name"] = wmi["19"];
    r["message_wire"] = wmi["2"];

    r["budy"] = peta_baru();
    jika tipe(wmi["2"]) == "teks" {
        buat fields = PB.PbDekode(wmi["2"]);
        coba { r["budy"] = MS.EkstrakBudy(fields); } tangkap (e) {}
    }
    hasil r;
}
