
buat KEYS = impor("util/keys.ns");
buat B32  = impor("util/base32.ns");
buat JID  = impor("types/jid.ns");
buat HKDF = impor("util/hkdf.ns");
buat EN   = impor("binary/codec_encode.ns");
buat D    = impor("binary/codec_decode.ns");
buat FS   = impor("socket/framesocket.ns");
buat NS   = impor("socket/noisesocket.ns");
buat CP   = muat_plugin("crypto");
buat GCM  = impor("util/gcm.ns");

fungsi BuatCompanionEphemeralKey() {
    buat eph_kp = KEYS.KeypairBaru();
    buat salt = CP["hex_decode"](CP["acak_bytes_hex"](32));
    buat iv = CP["hex_decode"](CP["acak_bytes_hex"](16));
    buat link_code_bytes = CP["hex_decode"](CP["acak_bytes_hex"](5));
    buat encoded_linking_code = B32.EnkodeBase325byte(link_code_bytes);

    buat link_code_key_hex = CP["pbkdf2_sha256"](encoded_linking_code, salt, 131072, 32);

    buat encrypted_pub_hex = CP["aes_enkripsi"](CP["hex_encode"](eph_kp["pub"]), link_code_key_hex, "ctr", CP["hex_encode"](iv));
    buat encrypted_pub = CP["hex_decode"](encrypted_pub_hex);

    buat ephemeral_key = salt + iv + encrypted_pub;

    buat res = peta_baru();
    res["keypair"] = eph_kp;
    res["ephemeral_key"] = ephemeral_key;
    res["encoded_linking_code"] = encoded_linking_code;
    res["formatted_code"] = potong(encoded_linking_code, 0, 4) + "-" + potong(encoded_linking_code, 4, 8);
    hasil res;
}

fungsi BuatIqPairNode(req_id, phone_clean, companion_info, noise_pub) {
    buat children = [];

    buat n1 = peta_baru();
    n1["tag"] = "link_code_pairing_wrapped_companion_ephemeral_pub";
    n1["attrs"] = peta_baru();
    n1["children"] = [];
    n1["content"] = companion_info["ephemeral_key"];
    n1["ada_isi"] = benar;
    tambah(children, n1);

    buat n2 = peta_baru();
    n2["tag"] = "companion_server_auth_key_pub";
    n2["attrs"] = peta_baru();
    n2["children"] = [];
    n2["content"] = noise_pub;
    n2["ada_isi"] = benar;
    tambah(children, n2);

    buat n3 = peta_baru();
    n3["tag"] = "companion_platform_id";
    n3["attrs"] = peta_baru();
    n3["children"] = [];
    n3["content"] = "1";
    n3["ada_isi"] = benar;
    tambah(children, n3);

    buat n4 = peta_baru();
    n4["tag"] = "companion_platform_display";
    n4["attrs"] = peta_baru();
    n4["children"] = [];
    n4["content"] = "Chrome (Linux)";
    n4["ada_isi"] = benar;
    tambah(children, n4);

    buat n5 = peta_baru();
    n5["tag"] = "link_code_pairing_nonce";
    n5["attrs"] = peta_baru();
    n5["children"] = [];
    n5["content"] = CP["hex_decode"]("00");
    n5["ada_isi"] = benar;
    tambah(children, n5);

    buat jid_obj = JID.JidBaru(phone_clean, "s.whatsapp.net");
    buat reg_attrs = peta_baru();
    reg_attrs["jid"] = jid_obj;
    reg_attrs["stage"] = "companion_hello";
    reg_attrs["should_show_push_notification"] = "true";

    buat reg_node = peta_baru();
    reg_node["tag"] = "link_code_companion_reg";
    reg_node["attrs"] = reg_attrs;
    reg_node["children"] = children;
    reg_node["content"] = "";
    reg_node["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id;
    iq_attrs["to"] = JID.JidBaru("", "s.whatsapp.net");
    iq_attrs["type"] = "set";
    iq_attrs["xmlns"] = "md";

    buat iq_node = peta_baru();
    iq_node["tag"] = "iq";
    iq_node["attrs"] = iq_attrs;
    iq_node["children"] = [reg_node];
    iq_node["content"] = "";
    iq_node["ada_isi"] = benar;
    hasil iq_node;
}

fungsi ProsesNotifikasiCodePair(node, companion_info, identity_kp) {
    buat reg_child = peta_baru();
    jika tipe(node["children"]) == "larik" {
        untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
            jika node["children"][i]["tag"] == "link_code_companion_reg" {
                reg_child = node["children"][i];
                berhenti;
            }
        }
    }
    jika tipe(reg_child["tag"]) != "teks" { hasil peta_baru(); }

    buat wrapped_primary = [];
    buat primary_ident_pub = [];
    buat pairing_ref = [];

    jika tipe(reg_child["children"]) == "larik" {
        untuk (buat i = 0; i < panjang(reg_child["children"]); i = i + 1) {
            buat c = reg_child["children"][i];
            jika c["tag"] == "link_code_pairing_wrapped_primary_ephemeral_pub" {
                wrapped_primary = c["content"];
            }
            jika c["tag"] == "primary_identity_pub" {
                primary_ident_pub = c["content"];
            }
            jika c["tag"] == "link_code_pairing_ref" {
                pairing_ref = c["content"];
            }
        }
    }

    cetak("[DEBUG PAIR] panjang wrapped_primary: " + ke_teks(panjang(wrapped_primary)));
    cetak("[DEBUG PAIR] panjang primary_ident_pub: " + ke_teks(panjang(primary_ident_pub)));
    cetak("[DEBUG PAIR] pairing_ref dari notifikasi (hex): " + CP["hex_encode"](pairing_ref));
    cetak("[DEBUG PAIR] pairing_ref cached (hex, dari companion_hello): " + companion_info["pairing_ref"]);
    cetak("[DEBUG PAIR] dua-duanya SAMA: " + ke_teks(CP["hex_encode"](pairing_ref) == companion_info["pairing_ref"]));

    jika panjang(wrapped_primary) < 80 || panjang(primary_ident_pub) == 0 {
        cetak("[DEBUG PAIR] GAGAL: wrapped_primary atau primary_ident_pub kosong/kurang panjang!");
        hasil peta_baru();
    }

    buat pri_salt = potong(wrapped_primary, 0, 32);
    buat pri_iv = potong(wrapped_primary, 32, 48);
    buat pri_enc_pub = potong(wrapped_primary, 48, 80);

    buat primary_salt = potong(wrapped_primary, 0, 32);
    buat primary_iv = potong(wrapped_primary, 32, 48);
    buat primary_enc_pub = potong(wrapped_primary, 48, 80);
    buat link_code_key_hex = CP["pbkdf2_sha256"](companion_info["encoded_linking_code"], primary_salt, 131072, 32);
    buat primary_dec_pub_hex = CP["aes_enkripsi"](CP["hex_encode"](primary_enc_pub), link_code_key_hex, "ctr", CP["hex_encode"](primary_iv));
    buat primary_dec_pub = CP["hex_decode"](primary_dec_pub_hex);

    cetak("[DEBUG PAIR] primary_dec_pub_hex: " + primary_dec_pub_hex);

    buat eph_shared = CP["hex_decode"](CP["x25519"](CP["hex_encode"](companion_info["keypair"]["priv"]), primary_dec_pub_hex));
    buat ident_shared = CP["hex_decode"](CP["x25519"](CP["hex_encode"](identity_kp["priv"]), CP["hex_encode"](primary_ident_pub)));

    cetak("[DEBUG PAIR] eph_shared hex: " + CP["hex_encode"](eph_shared));
    cetak("[DEBUG PAIR] primary_ident_pub hex: " + CP["hex_encode"](primary_ident_pub));
    cetak("[DEBUG PAIR] ident_shared hex: " + CP["hex_encode"](ident_shared));

    buat adv_secret_random = CP["hex_decode"](CP["acak_bytes_hex"](32));
    buat key_bundle_salt = CP["hex_decode"](CP["acak_bytes_hex"](32));
    buat key_bundle_nonce = CP["hex_decode"](CP["acak_bytes_hex"](12));

    buat plaintext_kb_hex = CP["hex_encode"](identity_kp["pub"]) + CP["hex_encode"](primary_ident_pub) + CP["hex_encode"](adv_secret_random);
    buat plaintext_kb = CP["hex_decode"](plaintext_kb_hex);
    buat key_bundle_enc_key_hex = CP["hex_encode"](HKDF.HkdfSha256(eph_shared, key_bundle_salt, "link_code_pairing_key_bundle_encryption_key", 32));

    buat enc_kb_map = GCM.GcmEnkripsi(CP["hex_decode"](key_bundle_enc_key_hex), key_bundle_nonce, plaintext_kb, "");
    buat enc_kb_hex = CP["hex_encode"](enc_kb_map["ct"]) + CP["hex_encode"](enc_kb_map["tag"]);

    buat wrapped_kb_hex = CP["hex_encode"](key_bundle_salt) + CP["hex_encode"](key_bundle_nonce) + enc_kb_hex;
    buat wrapped_kb = CP["hex_decode"](wrapped_kb_hex);

    buat adv_input_hex = CP["hex_encode"](eph_shared) + CP["hex_encode"](ident_shared) + CP["hex_encode"](adv_secret_random);
    buat adv_input = CP["hex_decode"](adv_input_hex);
    buat adv_secret = HKDF.HkdfSha256(adv_input, "", "adv_secret", 32);

    buat finish_child1 = peta_baru();
    finish_child1["tag"] = "link_code_pairing_wrapped_key_bundle";
    finish_child1["attrs"] = peta_baru();
    finish_child1["children"] = [];
    finish_child1["content"] = wrapped_kb;
    finish_child1["ada_isi"] = benar;

    buat finish_child2 = peta_baru();
    finish_child2["tag"] = "companion_identity_public";
    finish_child2["attrs"] = peta_baru();
    finish_child2["children"] = [];
    finish_child2["content"] = identity_kp["pub"];
    finish_child2["ada_isi"] = benar;

    buat finish_child3 = peta_baru();
    finish_child3["tag"] = "link_code_pairing_ref";
    finish_child3["attrs"] = peta_baru();
    finish_child3["children"] = [];
    finish_child3["content"] = pairing_ref;
    finish_child3["ada_isi"] = benar;

    buat reg_finish_attrs = peta_baru();
    buat target_jid = peta_baru();
    target_jid["jid"] = benar;
    target_jid["user"] = companion_info["target_num"];
    target_jid["server"] = "s.whatsapp.net";
    target_jid["agent"] = 0;
    target_jid["device"] = 0;
    reg_finish_attrs["jid"] = target_jid;
    reg_finish_attrs["stage"] = "companion_finish";

    buat reg_finish_node = peta_baru();
    reg_finish_node["tag"] = "link_code_companion_reg";
    reg_finish_node["attrs"] = reg_finish_attrs;
    reg_finish_node["children"] = [finish_child1, finish_child2, finish_child3];
    reg_finish_node["content"] = "";
    reg_finish_node["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = "finish_1";
    iq_attrs["to"] = JID.JidBaru("", "s.whatsapp.net");
    iq_attrs["type"] = "set";
    iq_attrs["xmlns"] = "md";

    buat iq_finish = peta_baru();
    iq_finish["tag"] = "iq";
    iq_finish["attrs"] = iq_attrs;
    iq_finish["children"] = [reg_finish_node];
    iq_finish["content"] = "";
    iq_finish["ada_isi"] = benar;

    buat res = peta_baru();
    res["adv_secret"] = adv_secret;
    res["finish_node"] = iq_finish;
    hasil res;
}
