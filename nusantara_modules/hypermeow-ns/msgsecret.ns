buat PB   = impor("proto/pb.ns");
buat HKDF = impor("util/hkdf.ns");
buat GCM  = impor("util/gcm.ns");
buat ST   = impor("store/session.ns");
buat CP   = muat_plugin("crypto");

buat TIPE_POLL_VOTE      = "Poll Vote";
buat TIPE_REAKSI         = "Enc Reaction";
buat TIPE_KOMENTAR       = "Enc Comment";
buat TIPE_EVENT_RESPONSE = "Event Response";
buat TIPE_EDIT_PESAN     = "Message Edit";
buat TIPE_EDIT_POLL      = "Poll Edit";

fungsi JidTeks(j) {
    jika tipe(j) == "teks" { hasil j; }
    jika tipe(j) != "peta" { hasil ""; }
    hasil j["user"] + "@" + j["server"];
}

fungsi TurunkanKunciRahasia(tipe_guna, pengirim_modifikasi, msg_id_asli, pengirim_asli, secret_asli) {
    buat s_asli = JidTeks(pengirim_asli);
    buat s_mod  = JidTeks(pengirim_modifikasi);
    buat use_case = msg_id_asli + s_asli + s_mod + tipe_guna;

    buat r = peta_baru();
    r["kunci"] = HKDF.HkdfSha256(secret_asli, "", use_case, 32);
    jika tipe_guna == TIPE_POLL_VOTE || tipe_guna == TIPE_EVENT_RESPONSE || tipe_guna == "" {
        r["aad"] = msg_id_asli + teks_dari(0) + s_mod;
    } lain {
        r["aad"] = "";
    }
    hasil r;
}

fungsi enkripsi_rahasia(tipe_guna, pengirim_kita, chat, pengirim_asli, msg_id_asli, plaintext) {
    buat row = ST.CariMsgSecret(JidTeks(chat), JidTeks(pengirim_asli), msg_id_asli);
    jika tipe(row) != "peta" { lempar "message secret buat " + ke_teks(msg_id_asli) + " gak ketemu di store"; }
    buat secret = CP["hex_decode"](row["secret"]);

    buat k = TurunkanKunciRahasia(tipe_guna, pengirim_kita, msg_id_asli, pengirim_asli, secret);
    buat iv = CP["hex_decode"](CP["acak_bytes_hex"](12));
    buat e = GCM.GcmEnkripsi(k["kunci"], iv, plaintext, k["aad"]);

    buat r = peta_baru();
    r["payload"] = e["ct"] + e["tag"];
    r["iv"] = iv;
    hasil r;
}

fungsi dekripsi_rahasia(tipe_guna, pengirim_modifikasi, chat, pengirim_asli, msg_id_asli, enc_payload, enc_iv) {
    buat row = ST.CariMsgSecret(JidTeks(chat), JidTeks(pengirim_asli), msg_id_asli);
    jika tipe(row) != "peta" { lempar "message secret buat " + ke_teks(msg_id_asli) + " gak ketemu di store"; }
    buat secret = CP["hex_decode"](row["secret"]);

    jika panjang(enc_payload) < 16 { lempar "payload rahasia kependekan"; }
    buat ct  = potong(enc_payload, 0, panjang(enc_payload) - 16);
    buat tag = potong(enc_payload, panjang(enc_payload) - 16, panjang(enc_payload));

    buat k = TurunkanKunciRahasia(tipe_guna, pengirim_modifikasi, msg_id_asli, pengirim_asli, secret);
    coba {
        hasil GCM.GcmDekripsi(k["kunci"], enc_iv, ct, k["aad"], tag);
    } tangkap (e) {
        buat pengirim_simpan = row["sender"];
        jika tipe(pengirim_simpan) == "teks" && pengirim_simpan != JidTeks(pengirim_asli) {
            buat k2 = TurunkanKunciRahasia(tipe_guna, pengirim_modifikasi, msg_id_asli, pengirim_simpan, secret);
            hasil GCM.GcmDekripsi(k2["kunci"], enc_iv, ct, k2["aad"], tag);
        }
        lempar e;
    }
}

fungsi buat_message_key(chat, pengirim, msg_id, dari_kita) {
    buat f = [PB.PbBytes(1, JidTeks(chat))];
    jika dari_kita { tambah(f, PB.PbVarint(2, 1)); } lain { tambah(f, PB.PbVarint(2, 0)); }
    tambah(f, PB.PbBytes(3, msg_id));
    jika tipe(pengirim) != "kosong" && JidTeks(pengirim) != JidTeks(chat) {
        tambah(f, PB.PbBytes(4, JidTeks(pengirim)));
    }
    hasil PB.PbEnkode(f);
}

fungsi BangunReaksi(chat, pengirim, msg_id, dari_kita, emoji) {
    buat key = buat_message_key(chat, pengirim, msg_id, dari_kita);
    buat rf = [PB.PbBytes(1, key), PB.PbBytes(2, emoji), PB.PbVarint(4, waktu() * 1000)];
    hasil PB.PbEnkode([PB.PbBytes(46, PB.PbEnkode(rf))]);
}

fungsi bangun_hapus_reaksi(chat, pengirim, msg_id, dari_kita) {
    hasil BangunReaksi(chat, pengirim, msg_id, dari_kita, "");
}

fungsi bangun_reaksi_terenkripsi(chat, pengirim_kita, pengirim_asli, msg_id, dari_kita, emoji) {
    buat key = buat_message_key(chat, pengirim_asli, msg_id, dari_kita);
    buat inner = PB.PbEnkode([PB.PbBytes(1, key), PB.PbBytes(2, emoji), PB.PbVarint(4, waktu() * 1000)]);
    buat e = enkripsi_rahasia(TIPE_REAKSI, pengirim_kita, chat, pengirim_asli, msg_id, inner);
    buat ef = [PB.PbBytes(1, key), PB.PbBytes(2, e["payload"]), PB.PbBytes(3, e["iv"])];
    hasil PB.PbEnkode([PB.PbBytes(56, PB.PbEnkode(ef))]);
}

fungsi UraiReaksi(fields_reaksi) {
    buat r = peta_baru();
    r["emoji"] = "";
    jika tipe(fields_reaksi["2"]) == "teks" { r["emoji"] = fields_reaksi["2"]; }
    r["target_key"] = fields_reaksi["1"];
    r["waktu_ms"] = fields_reaksi["4"];
    r["dihapus"] = (panjang(r["emoji"]) == 0);
    hasil r;
}

fungsi DekripsiReaksi(chat, pengirim_modifikasi, fields_enc_reaksi) {
    buat key_bytes = fields_enc_reaksi["1"];
    jika tipe(key_bytes) != "teks" { lempar "encReactionMessage tanpa targetMessageKey"; }
    buat kf = PB.PbDekode(key_bytes);
    buat msg_id_asli = kf["3"];
    buat pengirim_asli = kf["4"];
    jika tipe(pengirim_asli) != "teks" { pengirim_asli = kf["1"]; }

    buat plain = dekripsi_rahasia(TIPE_REAKSI, pengirim_modifikasi, chat, pengirim_asli,
                                  msg_id_asli, fields_enc_reaksi["2"], fields_enc_reaksi["3"]);
    hasil UraiReaksi(PB.PbDekode(plain));
}

fungsi hash_opsi_poll(nama_opsi) {
    buat out = [];
    untuk (buat i = 0; i < panjang(nama_opsi); i = i + 1) {
        tambah(out, CP["hex_decode"](potong(sha256_hex(nama_opsi[i]), 0, 64)));
    }
    hasil out;
}

fungsi BangunPoll(nama, opsi_list, jumlah_pilihan) {
    buat secret = CP["hex_decode"](CP["acak_bytes_hex"](32));
    buat n = jumlah_pilihan;
    jika tipe(n) != "angka" || n < 0 || n > panjang(opsi_list) { n = 0; }

    buat f = [PB.PbBytes(2, nama)];
    untuk (buat i = 0; i < panjang(opsi_list); i = i + 1) {
        tambah(f, PB.PbBytes(3, PB.PbEnkode([PB.PbBytes(1, opsi_list[i])])));
    }
    tambah(f, PB.PbVarint(4, n));

    buat ctx = PB.PbEnkode([PB.PbBytes(3, secret)]);
    buat r = peta_baru();
    r["wire"] = PB.PbEnkode([PB.PbBytes(49, PB.PbEnkode(f)), PB.PbBytes(35, ctx)]);
    r["secret"] = secret;
    hasil r;
}

fungsi bangun_vote_poll(chat, pengirim_kita, pengirim_poll, poll_msg_id, dari_kita, opsi_dipilih) {
    buat hashes = hash_opsi_poll(opsi_dipilih);
    buat vf = [];
    untuk (buat i = 0; i < panjang(hashes); i = i + 1) { tambah(vf, PB.PbBytes(1, hashes[i])); }
    buat vote_plain = PB.PbEnkode(vf);

    buat e = enkripsi_rahasia(TIPE_POLL_VOTE, pengirim_kita, chat, pengirim_poll, poll_msg_id, vote_plain);
    buat key = buat_message_key(chat, pengirim_poll, poll_msg_id, dari_kita);
    buat enc_val = PB.PbEnkode([PB.PbBytes(1, e["payload"]), PB.PbBytes(2, e["iv"])]);
    buat uf = [PB.PbBytes(1, key), PB.PbBytes(2, enc_val), PB.PbVarint(4, waktu() * 1000)];
    hasil PB.PbEnkode([PB.PbBytes(50, PB.PbEnkode(uf))]);
}

fungsi DekripsiVotePoll(chat, pengirim_modifikasi, fields_poll_update) {
    buat key_bytes = fields_poll_update["1"];
    jika tipe(key_bytes) != "teks" { lempar "pollUpdateMessage tanpa pollCreationMessageKey"; }
    buat kf = PB.PbDekode(key_bytes);
    buat msg_id_asli = kf["3"];
    buat pengirim_asli = kf["4"];
    jika tipe(pengirim_asli) != "teks" { pengirim_asli = kf["1"]; }

    buat vote = fields_poll_update["2"];
    jika tipe(vote) != "teks" { lempar "pollUpdateMessage tanpa vote"; }
    buat vf = PB.PbDekode(vote);

    buat plain = dekripsi_rahasia(TIPE_POLL_VOTE, pengirim_modifikasi, chat, pengirim_asli,
                                  msg_id_asli, vf["1"], vf["2"]);
    buat r = peta_baru();
    r["poll_msg_id"] = msg_id_asli;
    r["hash_dipilih"] = PB.PbDekodeBerulang(plain, "1");
    hasil r;
}

fungsi cocokkan_hash_opsi(hash_list, nama_opsi) {
    buat semua = hash_opsi_poll(nama_opsi);
    buat out = [];
    untuk (buat i = 0; i < panjang(hash_list); i = i + 1) {
        untuk (buat j = 0; j < panjang(semua); j = j + 1) {
            jika hash_list[i] == semua[j] { tambah(out, nama_opsi[j]); }
        }
    }
    hasil out;
}

fungsi SimpanSecretDariPesan(chat, pengirim, msg_id, fields_pesan) {
    buat ctx = fields_pesan["35"];
    jika tipe(ctx) != "teks" { hasil salah; }
    buat cf = PB.PbDekode(ctx);
    jika tipe(cf["3"]) != "teks" { hasil salah; }
    hasil ST.SimpanMsgSecret(JidTeks(chat), JidTeks(pengirim), msg_id, CP["hex_encode"](cf["3"]));
}

fungsi bangun_komentar_terenkripsi(chat, pengirim_kita, pengirim_akar, msg_id_akar, dari_kita, wire_komentar) {
    buat e = enkripsi_rahasia(TIPE_KOMENTAR, pengirim_kita, chat, pengirim_akar, msg_id_akar, wire_komentar);

    buat kf = [PB.PbBytes(1, JidTeks(chat))];
    jika dari_kita { tambah(kf, PB.PbVarint(2, 1)); } lain { tambah(kf, PB.PbVarint(2, 0)); }
    tambah(kf, PB.PbBytes(3, msg_id_akar));
    tambah(kf, PB.PbBytes(4, JidTeks(pengirim_akar)));

    buat cf = [PB.PbBytes(1, PB.PbEnkode(kf)), PB.PbBytes(2, e["payload"]), PB.PbBytes(3, e["iv"])];
    hasil PB.PbEnkode([PB.PbBytes(71, PB.PbEnkode(cf))]);
}

fungsi dekripsi_komentar(chat, pengirim_modifikasi, fields_enc_komentar) {
    buat key_bytes = fields_enc_komentar["1"];
    jika tipe(key_bytes) != "teks" { lempar "encCommentMessage tanpa targetMessageKey"; }
    buat kf = PB.PbDekode(key_bytes);
    buat msg_id_akar = kf["3"];
    buat pengirim_akar = kf["4"];
    jika tipe(pengirim_akar) != "teks" { pengirim_akar = kf["1"]; }

    hasil dekripsi_rahasia(TIPE_KOMENTAR, pengirim_modifikasi, chat, pengirim_akar,
                           msg_id_akar, fields_enc_komentar["2"], fields_enc_komentar["3"]);
}

fungsi dekripsi_komentar_fields(chat, pengirim_modifikasi, fields_enc_komentar) {
    hasil PB.PbDekode(dekripsi_komentar(chat, pengirim_modifikasi, fields_enc_komentar));
}
