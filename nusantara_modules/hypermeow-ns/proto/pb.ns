buat _PB_CP = muat_plugin("crypto");

fungsi EnkodeVarint(n) {
    jika n == 0 { hasil teks_dari(0); }
    buat res = "";
    selama n > 0 {
        buat b = n % 128;
        n = (n - b) / 128;
        jika n > 0 { b = b + 128; }
        res = res + teks_dari(b);
    }
    hasil res;
}

fungsi PbVarint(tag, val) {
    buat header = EnkodeVarint(tag * 8 + 0);
    hasil header + EnkodeVarint(val);
}

fungsi PbFixed64(tag, bytes8) {
    jika panjang(bytes8) != 8 { lempar "fixed64 butuh tepat 8 byte"; }
    hasil EnkodeVarint(tag * 8 + 1) + bytes8;
}

fungsi DoubleNol() {
    buat s = "";
    untuk (buat i = 0; i < 8; i = i + 1) { s = s + teks_dari(0); }
    hasil s;
}

fungsi PbBytes(tag, bytes_val) {
    buat header = EnkodeVarint(tag * 8 + 2);
    buat len = EnkodeVarint(panjang(bytes_val));
    hasil header + len + bytes_val;
}

fungsi PbPesan(tag, fields_list) {
    buat body = PbEnkode(fields_list);
    hasil PbBytes(tag, body);
}

fungsi PbEnkode(fields_list) {
    buat res = "";
    untuk (buat i = 0; i < panjang(fields_list); i = i + 1) {
        res = res + fields_list[i];
    }
    hasil res;
}

fungsi PbDekode(data) {
    buat res = peta_baru();
    buat pos = 0;
    selama pos < panjang(data) {
        jika pos >= panjang(data) { berhenti; }
        buat val_tag = 0;
        buat shift = 1;
        selama pos < panjang(data) {
            buat b = byte_di(data, pos);
            pos = pos + 1;
            val_tag = val_tag + (b % 128) * shift;
            shift = shift * 128;
            jika b < 128 { berhenti; }
        }
        jika val_tag == 0 { berhenti; }

        buat wire_type = val_tag % 8;
        buat tag_num = (val_tag - wire_type) / 8;

        jika wire_type == 0 {
            buat val_var = 0;
            buat shift_v = 1;
            selama pos < panjang(data) {
                buat bv = byte_di(data, pos);
                pos = pos + 1;
                val_var = val_var + (bv % 128) * shift_v;
                shift_v = shift_v * 128;
                jika bv < 128 { berhenti; }
            }
            res[ke_teks(tag_num)] = val_var;
        } lain { jika wire_type == 2 {
            buat len_val = 0;
            buat shift_l = 1;
            selama pos < panjang(data) {
                buat bl = byte_di(data, pos);
                pos = pos + 1;
                len_val = len_val + (bl % 128) * shift_l;
                shift_l = shift_l * 128;
                jika bl < 128 { berhenti; }
            }
            jika pos + len_val > panjang(data) {
                len_val = panjang(data) - pos;
            }
            buat bytes_val = potong(data, pos, pos + len_val);
            pos = pos + len_val;
            res[ke_teks(tag_num)] = bytes_val;
        } lain {
            berhenti;
        }}
    }
    hasil res;
}

fungsi _pb_teks_valid(s) {
    untuk (buat i = 0; i < panjang(s); i = i + 1) {
        buat b = byte_di(s, i);
        jika b == 0 { hasil salah; }
        jika b < 9 { hasil salah; }
        jika b > 13 && b < 32 { hasil salah; }
    }
    hasil benar;
}

fungsi _pb_bisa_sub(data) {
    jika panjang(data) < 2 { hasil salah; }
    buat pos = 0;
    selama pos < panjang(data) {
        buat val_tag = 0; buat shift = 1;
        buat lanjut_baca = salah;
        selama pos < panjang(data) {
            buat b = byte_di(data, pos); pos = pos + 1;
            val_tag = val_tag + (b % 128) * shift; shift = shift * 128;
            jika b < 128 { lanjut_baca = benar; berhenti; }
            jika shift > 34359738368 { hasil salah; }
        }
        jika !lanjut_baca || val_tag == 0 { hasil salah; }
        buat wire_type = val_tag % 8;
        jika wire_type != 0 && wire_type != 2 { hasil salah; }
        jika wire_type == 0 {
            buat ok = salah;
            selama pos < panjang(data) {
                buat bv = byte_di(data, pos); pos = pos + 1;
                jika bv < 128 { ok = benar; berhenti; }
            }
            jika !ok { hasil salah; }
        } lain {
            buat len_val = 0; buat shift_l = 1; buat ok2 = salah;
            selama pos < panjang(data) {
                buat bl = byte_di(data, pos); pos = pos + 1;
                len_val = len_val + (bl % 128) * shift_l; shift_l = shift_l * 128;
                jika bl < 128 { ok2 = benar; berhenti; }
            }
            jika !ok2 { hasil salah; }
            jika pos + len_val > panjang(data) { hasil salah; }
            pos = pos + len_val;
        }
    }
    hasil pos == panjang(data);
}

fungsi pb_dekode_rekursif(data) {
    buat res = peta_baru();
    buat pos = 0;
    selama pos < panjang(data) {
        buat val_tag = 0; buat shift = 1;
        selama pos < panjang(data) {
            buat b = byte_di(data, pos); pos = pos + 1;
            val_tag = val_tag + (b % 128) * shift; shift = shift * 128;
            jika b < 128 { berhenti; }
        }
        jika val_tag == 0 { berhenti; }
        buat wire_type = val_tag % 8;
        buat tag_num = ke_teks((val_tag - wire_type) / 8);

        buat nilai = kosong;
        jika wire_type == 0 {
            buat val_var = 0; buat shift_v = 1;
            selama pos < panjang(data) {
                buat bv = byte_di(data, pos); pos = pos + 1;
                val_var = val_var + (bv % 128) * shift_v; shift_v = shift_v * 128;
                jika bv < 128 { berhenti; }
            }
            nilai = val_var;
        } lain jika wire_type == 2 {
            buat len_val = 0; buat shift_l = 1;
            selama pos < panjang(data) {
                buat bl = byte_di(data, pos); pos = pos + 1;
                len_val = len_val + (bl % 128) * shift_l; shift_l = shift_l * 128;
                jika bl < 128 { berhenti; }
            }
            jika pos + len_val > panjang(data) { len_val = panjang(data) - pos; }
            buat bytes_val = potong(data, pos, pos + len_val);
            pos = pos + len_val;

            jika _pb_bisa_sub(bytes_val) {
                nilai = pb_dekode_rekursif(bytes_val);
            } lain jika _pb_teks_valid(bytes_val) {
                nilai = bytes_val;
            } lain {
                buat pbin = peta_baru();
                pbin["__bytes_hex"] = _PB_CP["hex_encode"](bytes_val);
                pbin["__len"] = panjang(bytes_val);
                nilai = pbin;
            }
        } lain {
            berhenti;
        }

        jika tipe(res[tag_num]) == "kosong" {
            res[tag_num] = nilai;
        } lain jika tipe(res[tag_num]) == "larik" {
            tambah(res[tag_num], nilai);
        } lain {
            res[tag_num] = [res[tag_num], nilai];
        }
    }
    hasil res;
}

fungsi PbDekodeBerulang(data, tag_dicari) {
    buat out = [];
    buat pos = 0;
    selama pos < panjang(data) {
        buat val_tag = 0;
        buat shift = 1;
        selama pos < panjang(data) {
            buat b = byte_di(data, pos);
            pos = pos + 1;
            val_tag = val_tag + (b % 128) * shift;
            shift = shift * 128;
            jika b < 128 { berhenti; }
        }
        jika val_tag == 0 { berhenti; }

        buat wire_type = val_tag % 8;
        buat tag_num = (val_tag - wire_type) / 8;

        jika wire_type == 0 {
            buat val_var = 0;
            buat shift_v = 1;
            selama pos < panjang(data) {
                buat bv = byte_di(data, pos);
                pos = pos + 1;
                val_var = val_var + (bv % 128) * shift_v;
                shift_v = shift_v * 128;
                jika bv < 128 { berhenti; }
            }
            jika ke_teks(tag_num) == tag_dicari { tambah(out, val_var); }
        } lain { jika wire_type == 2 {
            buat len_val = 0;
            buat shift_l = 1;
            selama pos < panjang(data) {
                buat bl = byte_di(data, pos);
                pos = pos + 1;
                len_val = len_val + (bl % 128) * shift_l;
                shift_l = shift_l * 128;
                jika bl < 128 { berhenti; }
            }
            jika pos + len_val > panjang(data) { len_val = panjang(data) - pos; }
            buat bytes_val = potong(data, pos, pos + len_val);
            pos = pos + len_val;
            jika ke_teks(tag_num) == tag_dicari { tambah(out, bytes_val); }
        } lain {
            berhenti;
        }}
    }
    hasil out;
}

fungsi _pb_spasi(n) {
    buat s = "";
    untuk (buat i = 0; i < n; i = i + 1) { s = s + "  "; }
    hasil s;
}

fungsi _pb_json_escape(s) {
    buat out = "";
    untuk (buat i = 0; i < panjang(s); i = i + 1) {
        buat b = byte_di(s, i);
        buat c = potong(s, i, i + 1);
        jika c == "\"" { out = out + "\\\""; }
        lain jika c == "\\" { out = out + "\\\\"; }
        lain jika b == 10 { out = out + "\\n"; }
        lain jika b == 13 { out = out + "\\r"; }
        lain jika b == 9 { out = out + "\\t"; }
        lain { out = out + c; }
    }
    hasil out;
}

fungsi PbJsonRapi(v, level) {
    jika tipe(v) == "peta" {
        buat kunci = peta_kunci(v);
        jika panjang(kunci) == 0 { hasil "{}"; }
        buat out = "{\n";
        untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
            out = out + _pb_spasi(level + 1) + "\"" + kunci[i] + "\": " + PbJsonRapi(v[kunci[i]], level + 1);
            jika i < panjang(kunci) - 1 { out = out + ","; }
            out = out + "\n";
        }
        out = out + _pb_spasi(level) + "}";
        hasil out;
    } lain jika tipe(v) == "larik" {
        jika panjang(v) == 0 { hasil "[]"; }
        buat out = "[\n";
        untuk (buat i = 0; i < panjang(v); i = i + 1) {
            out = out + _pb_spasi(level + 1) + PbJsonRapi(v[i], level + 1);
            jika i < panjang(v) - 1 { out = out + ","; }
            out = out + "\n";
        }
        out = out + _pb_spasi(level) + "]";
        hasil out;
    } lain jika tipe(v) == "teks" {
        hasil "\"" + _pb_json_escape(v) + "\"";
    } lain jika tipe(v) == "angka" {
        hasil ke_teks(v);
    } lain jika tipe(v) == "boolean" {
        jika v { hasil "true"; }
        hasil "false";
    } lain {
        hasil "null";
    }
}

fungsi _pb_js_id_valid(k) {
    jika panjang(k) == 0 { hasil salah; }
    buat b0 = byte_di(k, 0);
    buat awal_ok = (b0 >= 97 && b0 <= 122) || (b0 >= 65 && b0 <= 90) || b0 == 95 || b0 == 36;
    jika !awal_ok { hasil salah; }
    untuk (buat i = 1; i < panjang(k); i = i + 1) {
        buat b = byte_di(k, i);
        buat ok = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 36;
        jika !ok { hasil salah; }
    }
    hasil benar;
}

fungsi _pb_js_str(s) {
    buat out = "'";
    untuk (buat i = 0; i < panjang(s); i = i + 1) {
        buat b = byte_di(s, i);
        buat c = potong(s, i, i + 1);
        jika c == "'" { out = out + "\\'"; }
        lain jika c == "\\" { out = out + "\\\\"; }
        lain jika b == 10 { out = out + "\\n"; }
        lain jika b == 13 { out = out + "\\r"; }
        lain jika b == 9 { out = out + "\\t"; }
        lain { out = out + c; }
    }
    hasil out + "'";
}

fungsi _pb_js_key(k) {
    jika _pb_js_id_valid(k) { hasil k; }
    hasil _pb_js_str(k);
}

fungsi _pb_js_scalar(v) {
    jika tipe(v) == "teks" { hasil _pb_js_str(v); }
    jika tipe(v) == "angka" { hasil ke_teks(v); }
    jika tipe(v) == "boolean" { jika v { hasil "true"; } hasil "false"; }
    hasil "null";
}

fungsi _pb_js_compact(v) {
    jika tipe(v) == "peta" {
        jika tipe(v["__bytes_hex"]) == "teks" { hasil "<Buffer " + ke_teks(v["__len"]) + " bytes>"; }
        buat kunci = peta_kunci(v);
        jika panjang(kunci) == 0 { hasil "{}"; }
        buat out = "{ ";
        untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
            out = out + _pb_js_key(kunci[i]) + ": " + _pb_js_compact(v[kunci[i]]);
            jika i < panjang(kunci) - 1 { out = out + ", "; }
        }
        hasil out + " }";
    } lain jika tipe(v) == "larik" {
        jika panjang(v) == 0 { hasil "[]"; }
        buat out = "[ ";
        untuk (buat i = 0; i < panjang(v); i = i + 1) {
            out = out + _pb_js_compact(v[i]);
            jika i < panjang(v) - 1 { out = out + ", "; }
        }
        hasil out + " ]";
    } lain {
        hasil _pb_js_scalar(v);
    }
}

fungsi PbJsInspect(v, level) {
    jika tipe(v) == "peta" {
        jika tipe(v["__bytes_hex"]) == "teks" { hasil "<Buffer " + ke_teks(v["__len"]) + " bytes>"; }
        buat kunci = peta_kunci(v);
        jika panjang(kunci) == 0 { hasil "{}"; }
        buat compact = _pb_js_compact(v);
        jika panjang(compact) <= 72 { hasil compact; }
        buat out = "{\n";
        untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
            out = out + _pb_spasi(level + 1) + _pb_js_key(kunci[i]) + ": " + PbJsInspect(v[kunci[i]], level + 1);
            jika i < panjang(kunci) - 1 { out = out + ","; }
            out = out + "\n";
        }
        out = out + _pb_spasi(level) + "}";
        hasil out;
    } lain jika tipe(v) == "larik" {
        jika panjang(v) == 0 { hasil "[]"; }
        buat compact = _pb_js_compact(v);
        jika panjang(compact) <= 72 { hasil compact; }
        buat out = "[\n";
        untuk (buat i = 0; i < panjang(v); i = i + 1) {
            out = out + _pb_spasi(level + 1) + PbJsInspect(v[i], level + 1);
            jika i < panjang(v) - 1 { out = out + ","; }
            out = out + "\n";
        }
        out = out + _pb_spasi(level) + "]";
        hasil out;
    } lain {
        hasil _pb_js_scalar(v);
    }
}

fungsi _pb_enkode_satu(tag, val) {
    jika tipe(val) == "angka" {
        hasil PbVarint(tag, val);
    } lain jika tipe(val) == "teks" {
        hasil PbBytes(tag, val);
    } lain jika tipe(val) == "peta" {
        jika tipe(val["__bytes_hex"]) == "teks" {
            hasil PbBytes(tag, _PB_CP["hex_decode"](val["__bytes_hex"]));
        }
        hasil PbBytes(tag, pb_enkode_dari_json(val));
    } lain {
        hasil "";
    }
}

fungsi pb_enkode_dari_json(v) {
    buat kunci = peta_kunci(v);
    buat keluar = "";
    untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
        buat tag = ke_angka(kunci[i]);
        buat val = v[kunci[i]];
        jika tipe(val) == "larik" {
            untuk (buat j = 0; j < panjang(val); j = j + 1) {
                keluar = keluar + _pb_enkode_satu(tag, val[j]);
            }
        } lain {
            keluar = keluar + _pb_enkode_satu(tag, val);
        }
    }
    hasil keluar;
}

