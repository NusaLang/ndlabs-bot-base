fungsi _pb_dekode_bernama_inner(data, skema_nama, semua) {
    buat skema = semua[skema_nama];
    buat res = peta_baru();
    buat pos = 0;
    selama pos < panjang(data) {
        buat val_tag = 0; buat shift = 1;
        selama pos < panjang(data) {
            buat b = byte_di(data, pos); pos = pos + 1;
            val_tag = val_tag + (b % 128) * shift; shift = shift * 128;
            jika b < 128 { berhenti; }
        }
        jika val_tag == 0 { berhenti; }
        buat wire_type = val_tag % 8;
        buat tag_num = ke_teks((val_tag - wire_type) / 8);

        buat field_def = kosong;
        jika tipe(skema) == "peta" { field_def = skema[tag_num]; }
        buat nama_field = tag_num;
        jika tipe(field_def) == "peta" && tipe(field_def["nama"]) == "teks" { nama_field = field_def["nama"]; }

        buat nilai = kosong;
        jika wire_type == 0 {
            buat val_var = 0; buat shift_v = 1;
            selama pos < panjang(data) {
                buat bv = byte_di(data, pos); pos = pos + 1;
                val_var = val_var + (bv % 128) * shift_v; shift_v = shift_v * 128;
                jika bv < 128 { berhenti; }
            }
            nilai = val_var;
            jika tipe(field_def) == "peta" && field_def["bool"] == benar { nilai = (val_var == 1); }
            lain jika tipe(field_def) == "peta" && tipe(field_def["enum"]) == "peta" {
                buat nm = field_def["enum"][ke_teks(val_var)];
                jika tipe(nm) == "teks" { nilai = nm; }
            }
        } lain jika wire_type == 2 {
            buat len_val = 0; buat shift_l = 1;
            selama pos < panjang(data) {
                buat bl = byte_di(data, pos); pos = pos + 1;
                len_val = len_val + (bl % 128) * shift_l; shift_l = shift_l * 128;
                jika bl < 128 { berhenti; }
            }
            jika pos + len_val > panjang(data) { len_val = panjang(data) - pos; }
            buat bytes_val = potong(data, pos, pos + len_val);
            pos = pos + len_val;

            jika tipe(field_def) == "peta" && tipe(field_def["sub"]) == "teks" {
                nilai = _pb_dekode_bernama_inner(bytes_val, field_def["sub"], semua);
            } lain jika tipe(field_def) == "peta" && field_def["bin"] == benar {
                nilai = base64_encode(bytes_val);
            } lain jika _pb_bisa_sub(bytes_val) {
                nilai = pb_dekode_rekursif(bytes_val);
            } lain jika _pb_teks_valid(bytes_val) {
                nilai = bytes_val;
            } lain {
                buat pbin = peta_baru();
                pbin["__bytes_hex"] = _PB_CP["hex_encode"](bytes_val);
                pbin["__len"] = panjang(bytes_val);
                nilai = pbin;
            }
        } lain {
            berhenti;
        }

        jika tipe(res[nama_field]) == "kosong" {
            res[nama_field] = nilai;
        } lain jika tipe(res[nama_field]) == "larik" {
            tambah(res[nama_field], nilai);
        } lain {
            res[nama_field] = [res[nama_field], nilai];
        }
    }
    hasil res;
}

fungsi PbDekodeBernama(data) {
    hasil _pb_dekode_bernama_inner(data, "Message", _pb_skema());
}

fungsi _pb_skema_balik(skema_nama, semua) {
    buat skema = semua[skema_nama];
    buat balik = peta_baru();
    jika tipe(skema) != "peta" { hasil balik; }
    buat kunci = peta_kunci(skema);
    untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
        buat tag = kunci[i];
        buat def = skema[tag];
        buat entri = peta_baru();
        entri["tag"] = ke_angka(tag);
        jika tipe(def["sub"]) == "teks" { entri["sub"] = def["sub"]; }
        jika def["bool"] == benar { entri["bool"] = benar; }
        jika def["bin"] == benar { entri["bin"] = benar; }
        jika tipe(def["enum"]) == "peta" {
            buat enum_rev = peta_baru();
            buat ekunci = peta_kunci(def["enum"]);
            untuk (buat j = 0; j < panjang(ekunci); j = j + 1) {
                enum_rev[def["enum"][ekunci[j]]] = ke_angka(ekunci[j]);
            }
            entri["enum_rev"] = enum_rev;
        }
        balik[def["nama"]] = entri;
    }
    hasil balik;
}

fungsi _pb_enkode_bernama_satu(tag, val, def) {
    jika tipe(def) == "peta" && def["bool"] == benar {
        buat n = 0;
        jika val == benar { n = 1; }
        hasil PbVarint(tag, n);
    }
    jika tipe(val) == "angka" { hasil PbVarint(tag, val); }
    jika tipe(val) == "teks" {
        jika tipe(def) == "peta" && def["bin"] == benar { hasil PbBytes(tag, base64_decode(val)); }
        jika tipe(def) == "peta" && tipe(def["enum_rev"]) == "peta" && tipe(def["enum_rev"][val]) == "angka" {
            hasil PbVarint(tag, def["enum_rev"][val]);
        }
        hasil PbBytes(tag, val);
    }
    jika tipe(val) == "boolean" {
        buat n = 0;
        jika val { n = 1; }
        hasil PbVarint(tag, n);
    }
    jika tipe(val) == "peta" {
        jika tipe(val["__bytes_hex"]) == "teks" { hasil PbBytes(tag, _PB_CP["hex_decode"](val["__bytes_hex"])); }
        jika tipe(def) == "peta" && tipe(def["sub"]) == "teks" {
            hasil PbBytes(tag, PbEnkodeBernama(val, def["sub"]));
        }
        hasil PbBytes(tag, pb_enkode_dari_json(val));
    }
    hasil "";
}

fungsi PbEnkodeBernama(v, skema_nama) {
    buat semua = _pb_skema();
    buat balik = _pb_skema_balik(skema_nama, semua);
    buat kunci = peta_kunci(v);
    buat keluar = "";
    untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
        buat nama = kunci[i];
        buat val = v[nama];
        buat def = balik[nama];
        buat tag = 0;
        jika tipe(def) == "peta" { tag = def["tag"]; }
        lain {
            coba { tag = ke_angka(nama); } tangkap (e) { lanjut; }
        }
        jika tipe(val) == "larik" {
            untuk (buat j = 0; j < panjang(val); j = j + 1) {
                keluar = keluar + _pb_enkode_bernama_satu(tag, val[j], def);
            }
        } lain {
            keluar = keluar + _pb_enkode_bernama_satu(tag, val, def);
        }
    }
    hasil keluar;
}
