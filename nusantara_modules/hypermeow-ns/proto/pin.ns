
buat PB = impor("pb.ns");

fungsi enkode_message_key(remote_jid, from_me, id) {
    buat fm_val = 0;
    jika from_me { fm_val = 1; }
    buat fields = [
        PB.PbBytes(1, remote_jid),
        PB.PbVarint(2, fm_val),
        PB.PbBytes(3, id)
    ];
    hasil PB.PbEnkode(fields);
}

fungsi EnkodePinInChatMessage(remote_jid, from_me, id, is_pin, expiration_seconds) {
    buat msg_key_bin = enkode_message_key(remote_jid, from_me, id);
    buat pin_type = 2;
    jika is_pin { pin_type = 1; }
    buat fields = [
        PB.PbBytes(1, msg_key_bin),
        PB.PbVarint(2, pin_type),
        PB.PbVarint(3, expiration_seconds)
    ];
    hasil PB.PbEnkode(fields);
}

fungsi EnkodePinAction(is_pinned) {
    buat p_val = 0;
    jika is_pinned { p_val = 1; }
    buat fields = [
        PB.PbVarint(1, p_val)
    ];
    hasil PB.PbEnkode(fields);
}
