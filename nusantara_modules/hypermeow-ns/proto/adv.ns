
buat PB = impor("pb.ns");

fungsi DekodeSignedDeviceIdentityHmac(data) {
    buat d = PB.PbDekode(data);
    buat res = peta_baru();
    res["details"] = "";
    res["hmac"] = "";
    res["account_type"] = 0;
    jika tipe(d["1"]) == "teks" { res["details"] = d["1"]; }
    jika tipe(d["2"]) == "teks" { res["hmac"] = d["2"]; }
    jika tipe(d["3"]) == "angka" { res["account_type"] = d["3"]; }
    hasil res;
}

fungsi DekodeSignedDeviceIdentity(data) {
    buat d = PB.PbDekode(data);
    buat res = peta_baru();
    res["details"] = "";
    res["account_signature_key"] = "";
    res["account_signature"] = "";
    res["device_signature"] = "";
    jika tipe(d["1"]) == "teks" { res["details"] = d["1"]; }
    jika tipe(d["2"]) == "teks" { res["account_signature_key"] = d["2"]; }
    jika tipe(d["3"]) == "teks" { res["account_signature"] = d["3"]; }
    jika tipe(d["4"]) == "teks" { res["device_signature"] = d["4"]; }
    hasil res;
}

fungsi DekodeDeviceIdentity(data) {
    buat d = PB.PbDekode(data);
    buat res = peta_baru();
    res["raw_id"] = 0;
    res["timestamp"] = 0;
    res["key_index"] = 0;
    res["account_type"] = 0;
    res["device_type"] = 0;
    jika tipe(d["1"]) == "angka" { res["raw_id"] = d["1"]; }
    jika tipe(d["2"]) == "angka" { res["timestamp"] = d["2"]; }
    jika tipe(d["3"]) == "angka" { res["key_index"] = d["3"]; }
    jika tipe(d["4"]) == "angka" { res["account_type"] = d["4"]; }
    jika tipe(d["5"]) == "angka" { res["device_type"] = d["5"]; }
    hasil res;
}

fungsi EnkodeSignedDeviceIdentity(details, account_sig_key, account_sig, device_sig) {
    buat fields = [
        PB.PbBytes(1, details)
    ];
    jika panjang(account_sig_key) > 0 { tambah(fields, PB.PbBytes(2, account_sig_key)); }
    jika panjang(account_sig) > 0 { tambah(fields, PB.PbBytes(3, account_sig)); }
    jika panjang(device_sig) > 0 { tambah(fields, PB.PbBytes(4, device_sig)); }
    hasil PB.PbEnkode(fields);
}
