
buat HK = impor("../util/hkdf.ns");
buat CP = muat_plugin("crypto");

buat WA_PATCH_INTEGRITY_INFO = "WhatsApp Patch Integrity";
buat WA_PATCH_INTEGRITY_SIZE = 128;

fungsi _hkdf_item(item_bin) {
    buat prk_hex = HK.HkdfExtract("", item_bin);
    hasil HK.HkdfExpand(prk_hex, WA_PATCH_INTEGRITY_INFO, WA_PATCH_INTEGRITY_SIZE);
}

fungsi SubtractThenAddInPlace(state, subtract, add) {
    multiple_op(state, subtract, benar);
    multiple_op(state, add, salah);
}

fungsi subtract_then_add(base, subtract, add) {
    buat st = peta_baru();
    st["buf"] = base;
    SubtractThenAddInPlace(st, subtract, add);
    hasil st["buf"];
}

fungsi multiple_op(state, items, subtract) {
    untuk (buat i = 0; i < panjang(items); i = i + 1) {
        perform_pointwise_with_overflow(state, _hkdf_item(items[i]), subtract);
    }
}

fungsi perform_pointwise_with_overflow(state, input, subtract) {
    buat base = state["buf"];
    buat out = "";
    untuk (buat i = 0; i < panjang(base); i = i + 2) {
        buat x = byte_di(base, i) + byte_di(base, i + 1) * 256;
        buat y = byte_di(input, i) + byte_di(input, i + 1) * 256;
        buat res = 0;
        jika subtract {
            res = x - y;
            jika res < 0 { res = res + 65536; }
        } lain {
            res = x + y;
            jika res >= 65536 { res = res - 65536; }
        }
        buat lo = res % 256;
        buat hi = (res - lo) / 256;
        out = out + teks_dari(lo) + teks_dari(hi);
    }
    state["buf"] = out;
}
