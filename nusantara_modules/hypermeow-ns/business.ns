}

fungsi _biz_json(data) {
    buat v = data;
    jika tipe(v) == "teks" { v = json_decode(v); }
    jika tipe(v) != "peta" { lempar "respons bukan objek JSON"; }
    hasil v;
}

fungsi biz_dekode_halaman_katalog(data) {
    buat v = _biz_json(data);
    buat root = v["xwa_product_catalog_get_product_catalog"];
    jika tipe(root) != "peta" || tipe(root["product_catalog"]) != "peta" {
        lempar "respons katalog kehilangan xwa_product_catalog_get_product_catalog.product_catalog";
    }
    buat pc = root["product_catalog"];
    buat r = peta_baru();
    r["produk"] = [];
    jika tipe(pc["products"]) == "larik" { r["produk"] = pc["products"]; }
    r["next"] = "";
    r["previous"] = "";
    jika tipe(pc["paging"]) == "peta" {
        r["next"] = _biz_teks(pc["paging"]["after"]);
        r["previous"] = _biz_teks(pc["paging"]["before"]);
    }
    hasil r;
}

fungsi biz_dekode_produk_katalog(data) {
    buat v = _biz_json(data);
    buat root = v["xwa_product_catalog_get_product"];
    jika tipe(root) != "peta" || tipe(root["product_catalog"]) != "peta" || tipe(root["product_catalog"]["product"]) != "peta" {
        lempar "respons produk katalog kehilangan xwa_product_catalog_get_product.product_catalog.product";
    }
    hasil root["product_catalog"]["product"];
}

fungsi biz_dekode_koleksi(data) {
    buat v = _biz_json(data);
    buat root = v["xwa_product_catalog_get_collections"];
    jika tipe(root) != "peta" { lempar "respons koleksi kehilangan xwa_product_catalog_get_collections"; }
    buat r = peta_baru();
    r["koleksi"] = [];
    jika tipe(root["collections"]) == "larik" { r["koleksi"] = root["collections"]; }
    r["next"] = "";
    jika tipe(root["paging"]) == "peta" { r["next"] = _biz_teks(root["paging"]["after"]); }
    hasil r;
}

fungsi biz_dekode_koleksi_tunggal(data) {
    buat v = _biz_json(data);
    buat root = v["xwa_product_catalog_get_single_collection"];
    jika tipe(root) != "peta" || tipe(root["collection"]) != "peta" {
        lempar "respons koleksi kehilangan xwa_product_catalog_get_single_collection.collection";
    }
    buat c = root["collection"];
    jika tipe(c["products"]) != "larik" { c["products"] = []; }
    c["next"] = "";
    c["previous"] = "";
    jika tipe(root["paging"]) == "peta" {
        c["next"] = _biz_teks(root["paging"]["after"]);
        c["previous"] = _biz_teks(root["paging"]["before"]);
    }
    hasil c;
}

fungsi biz_dekode_daftar_produk(data, diminta) {
    buat v = _biz_json(data);
    buat root = v["xwa_product_catalog_get_product_list"];
    jika tipe(root) != "peta" || tipe(root["product_list"]) != "peta" {
        lempar "respons daftar produk kehilangan xwa_product_catalog_get_product_list.product_list";
    }
    buat produk = root["product_list"]["products"];
    jika tipe(produk) != "larik" { produk = []; }
    buat by_id = peta_baru();
    untuk (buat i = 0; i < panjang(produk); i = i + 1) {
        buat id = _biz_teks(produk[i]["id"]);
        jika panjang(id) == 0 { lempar "respons daftar produk punya ID produk kosong"; }
        jika tipe(by_id[id]) == "peta" { lempar "respons daftar produk punya ID produk dobel " + id; }
        by_id[id] = produk[i];
    }
    buat out = [];
    untuk (buat i = 0; i < panjang(diminta); i = i + 1) {
        buat id = diminta[i];
        jika tipe(by_id[id]) != "peta" { lempar "respons daftar produk kehilangan produk " + ke_teks(id); }
        tambah(out, by_id[id]);
    }
    hasil out;
}

fungsi _biz_validasi_nama_koleksi(nama) {
    buat n = _biz_trim(nama);
    jika panjang(n) == 0 { lempar "nama koleksi bisnis kosong"; }
    jika panjang(n) > 256 { lempar "nama koleksi bisnis lebih dari 256 byte"; }
    hasil n;
}

fungsi _biz_validasi_id_produk_koleksi(product_ids, boleh_kosong) {
    buat ids = product_ids;
    jika tipe(ids) != "larik" { ids = []; }
    jika (!boleh_kosong && panjang(ids) == 0) || panjang(ids) > BIZ_MAKS_ITEM_KOLEKSI {
        lempar "daftar produk koleksi bisnis harus berisi 1 sampai " + ke_teks(BIZ_MAKS_ITEM_KOLEKSI) + " ID";
    }
    untuk (buat i = 0; i < panjang(ids); i = i + 1) { _biz_validasi_id("produk", ids[i]); }
    _biz_duplikat(ids, "ID produk");
    hasil ids;
}

fungsi biz_vars_buat_koleksi(bisnis_jid, nama, product_ids, catalog_session_id) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat n = _biz_validasi_nama_koleksi(nama);
    buat ids = _biz_validasi_id_produk_koleksi(product_ids, salah);
    _biz_validasi_id("sesi katalog", catalog_session_id);
    buat c = peta_baru();
    c["name"] = n;
    c["product_ids"] = ids;
    c["biz_jid"] = JidTeks;
    c["catalog_session_id"] = catalog_session_id;
    buat inner = peta_baru(); inner["collection"] = c;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_ubah_koleksi(bisnis_jid, collection_id, update, catalog_session_id) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    _biz_validasi_id("koleksi", collection_id);
    _biz_validasi_id("sesi katalog", catalog_session_id);
    buat u = update;
    jika tipe(u) != "peta" { u = peta_baru(); }
    buat tambah_ids = _biz_validasi_id_produk_koleksi(u["add_product_ids"], benar);
    buat hapus_ids = _biz_validasi_id_produk_koleksi(u["remove_product_ids"], benar);
    buat ada_nama = (tipe(u["name"]) == "teks");
    jika !ada_nama && panjang(tambah_ids) == 0 && panjang(hapus_ids) == 0 {
        lempar "update koleksi bisnis kosong";
    }
    buat dihapus = peta_baru();
    untuk (buat i = 0; i < panjang(hapus_ids); i = i + 1) { dihapus[hapus_ids[i]] = benar; }
    untuk (buat i = 0; i < panjang(tambah_ids); i = i + 1) {
        jika dihapus[tambah_ids[i]] == benar {
            lempar "ID produk " + ke_teks(tambah_ids[i]) + " gak bisa ditambah dan dihapus bareng";
        }
    }
    buat c = peta_baru();
    c["id"] = collection_id;
    c["biz_jid"] = JidTeks;
    c["catalog_session_id"] = catalog_session_id;
    jika ada_nama { c["name"] = _biz_validasi_nama_koleksi(u["name"]); }
    jika panjang(tambah_ids) > 0 {
        buat a = peta_baru(); a["ids"] = tambah_ids;
        c["add"] = a;
    }
    jika panjang(hapus_ids) > 0 {
        buat h = peta_baru(); h["ids"] = hapus_ids;
        c["remove"] = h;
    }
    buat inner = peta_baru(); inner["collection"] = c;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_hapus_koleksi(bisnis_jid, collection_ids, catalog_session_id) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    jika tipe(collection_ids) != "larik" || panjang(collection_ids) < 1 || panjang(collection_ids) > BIZ_MAKS_ITEM_KOLEKSI {
        lempar "hapus koleksi bisnis harus berisi 1 sampai " + ke_teks(BIZ_MAKS_ITEM_KOLEKSI) + " ID";
    }
    _biz_validasi_id("sesi katalog", catalog_session_id);
    untuk (buat i = 0; i < panjang(collection_ids); i = i + 1) { _biz_validasi_id("koleksi", collection_ids[i]); }
    _biz_duplikat(collection_ids, "ID koleksi");
    buat c = peta_baru();
    c["collection_ids"] = collection_ids;
    c["biz_jid"] = JidTeks;
    c["catalog_session_id"] = catalog_session_id;
    buat inner = peta_baru(); inner["collections"] = c;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_urut_koleksi(bisnis_jid, moves) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    jika tipe(moves) != "larik" || panjang(moves) < 1 || panjang(moves) > BIZ_MAKS_PINDAH_KOLEKSI {
        lempar "urut koleksi bisnis harus berisi 1 sampai " + ke_teks(BIZ_MAKS_PINDAH_KOLEKSI) + " pindahan";
    }
    buat items = [];
    buat ids = [];
    untuk (buat i = 0; i < panjang(moves); i = i + 1) {
        buat m = moves[i];
        _biz_validasi_id("koleksi", m["collection_id"]);
        buat dari = m["from_index"];
        buat ke = m["to_index"];
        jika tipe(dari) != "angka" || tipe(ke) != "angka" || dari < 0 || ke < 0
            || dari >= BIZ_MAKS_PINDAH_KOLEKSI || ke >= BIZ_MAKS_PINDAH_KOLEKSI {
            lempar "index pindah koleksi bisnis harus antara 0 dan " + ke_teks(BIZ_MAKS_PINDAH_KOLEKSI - 1);
        }
        tambah(ids, m["collection_id"]);
        buat e = peta_baru();
        e["collection_id"] = m["collection_id"];
        e["from_index"] = dari;
        e["to_index"] = ke;
        tambah(items, e);
    }
    _biz_duplikat(ids, "pindahan koleksi");
    buat inner = peta_baru();
    inner["biz_jid"] = JidTeks;
    inner["move"] = items;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_dekode_mutasi_koleksi(data, diskriminator) {
    buat v = _biz_json(data);
    buat root = v[diskriminator];
    jika tipe(root) != "peta" { lempar "respons mutasi koleksi bisnis kehilangan " + diskriminator; }
    buat c = root["collection"];
    jika tipe(c) != "peta" || panjang(_biz_teks(c["id"])) == 0 || tipe(c["status_info"]) != "peta"
        || panjang(_biz_teks(c["status_info"]["status"])) == 0 {
        lempar "respons " + diskriminator + " kehilangan status koleksi";
    }
    buat r = peta_baru();
    r["id"] = c["id"];
    r["review_status"] = c["status_info"]["status"];
    hasil r;
}

fungsi biz_dekode_sukses_katalog(data, diskriminator) {
    buat v = _biz_json(data);
    buat root = v[diskriminator];
    jika tipe(root) != "peta" { lempar "respons katalog bisnis kehilangan " + diskriminator; }
    jika diskriminator == "xfb_whatsapp_catalog_create" {
        jika tipe(root["product_catalog"]) != "peta" {
            lempar "respons " + diskriminator + " kehilangan product_catalog";
        }
        hasil benar;
    }
    jika root["success"] != benar { lempar "respons " + diskriminator + " gak konfirmasi sukses"; }
    hasil benar;
}

fungsi biz_vars_buat_katalog(bisnis_jid) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
