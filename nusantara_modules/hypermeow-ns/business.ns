fungsi biz_vars_visibilitas_produk(bisnis_jid, product_id, disembunyikan) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    _biz_validasi_id("produk", product_id);
    buat p = peta_baru();
    p["product_id"] = product_id;
    p["is_hidden"] = (disembunyikan == benar);
    buat inner = peta_baru();
    inner["jid"] = JidTeks;
    inner["products"] = [p];
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi _biz_validasi_alasan_banding(alasan) {
    buat a = _biz_trim(alasan);
    jika panjang(a) == 0 { lempar "alasan banding katalog bisnis kosong"; }
    jika panjang(a) > BIZ_MAKS_ALASAN_BANDING {
        lempar "alasan banding katalog bisnis lebih dari " + ke_teks(BIZ_MAKS_ALASAN_BANDING) + " byte";
    }
    hasil a;
}

fungsi biz_vars_banding_produk(bisnis_jid, product_id, alasan) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    _biz_validasi_id("produk", product_id);
    buat a = _biz_validasi_alasan_banding(alasan);
    buat inner = peta_baru();
    inner["jid"] = JidTeks;
    inner["product_id"] = product_id;
    inner["reason"] = a;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_banding_koleksi(bisnis_jid, collection_id, alasan) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    _biz_validasi_id("koleksi", collection_id);
    buat a = _biz_validasi_alasan_banding(alasan);
    buat inner = peta_baru();
    inner["product_set_id"] = collection_id;
    inner["jid"] = JidTeks;
    inner["reason"] = a;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_dekode_keranjang(data, diharapkan) {
    buat v = _biz_json(data);
    buat root = v["xfb_whatsapp_smb_commerce_settings"];
    jika tipe(root) != "peta" || tipe(root["cart_enabled"]) != "boolean" {
        lempar "respons pengaturan commerce bisnis kehilangan cart_enabled";
    }
    jika root["cart_enabled"] != (diharapkan == benar) {
        lempar "respons pengaturan commerce bisnis balikin cart_enabled=" + ke_teks(root["cart_enabled"]);
    }
    hasil benar;
}

fungsi biz_tipe_entitas_merchant() {
    hasil ["SOLE_PROPRIETORSHIP", "PARTNERSHIP", "PRIVATE_COMPANY", "PUBLIC_COMPANY",
           "LIMITED_LIABILITY_PARTNERSHIP", "OTHER"];
}

fungsi _biz_validasi_field_merchant(nama, nilai, batas) {
    jika panjang(_biz_teks(nilai)) > batas {
        lempar "merchant bisnis " + nama + " lebih dari " + ke_teks(batas) + " byte";
    }
    hasil benar;
}

fungsi _biz_normalisasi_merchant(info) {
    jika tipe(info) != "peta" { lempar "info kepatuhan merchant bisnis kosong"; }
    buat cc = info["customer_care_details"];
    jika tipe(cc) != "peta" { cc = peta_baru(); }
    buat go_ = info["grievance_officer_details"];
    jika tipe(go_) != "peta" { go_ = peta_baru(); }

    buat r = peta_baru();
    r["entity_name"] = _biz_trim(info["entity_name"]);
    r["entity_type"] = _biz_teks(info["entity_type"]);
    r["is_registered"] = (info["is_registered"] == benar);
    r["entity_type_custom"] = _biz_trim(info["entity_type_custom"]);

    buat cc2 = peta_baru();
    cc2["email"] = _biz_trim(cc["email"]);
    cc2["landline_number"] = _biz_trim(cc["landline_number"]);
    cc2["mobile_number"] = _biz_trim(cc["mobile_number"]);
    r["customer_care_details"] = cc2;

    buat go2 = peta_baru();
    go2["name"] = _biz_trim(go_["name"]);
    go2["email"] = _biz_trim(go_["email"]);
    go2["landline_number"] = _biz_trim(go_["landline_number"]);
    go2["mobile_number"] = _biz_trim(go_["mobile_number"]);
    r["grievance_officer_details"] = go2;

    jika panjang(r["entity_name"]) == 0 { lempar "nama entitas merchant bisnis kosong"; }
    jika panjang(r["entity_type"]) == 0 { lempar "tipe entitas merchant bisnis kosong"; }
    buat tipe_ok = salah;
    buat semua = biz_tipe_entitas_merchant();
    untuk (buat i = 0; i < panjang(semua); i = i + 1) {
        jika semua[i] == r["entity_type"] { tipe_ok = benar; }
    }
    jika !tipe_ok { lempar "tipe entitas merchant bisnis gak didukung: " + r["entity_type"]; }
    jika r["entity_type"] == "OTHER" && panjang(r["entity_type_custom"]) == 0 {
        lempar "tipe entitas custom merchant bisnis kosong";
    }
    _biz_validasi_field_merchant("entity name", r["entity_name"], 256);
    _biz_validasi_field_merchant("custom entity type", r["entity_type_custom"], 256);
    _biz_validasi_field_merchant("customer care email", cc2["email"], 254);
    _biz_validasi_field_merchant("customer care landline", cc2["landline_number"], 64);
    _biz_validasi_field_merchant("customer care mobile", cc2["mobile_number"], 64);
    _biz_validasi_field_merchant("grievance officer name", go2["name"], 256);
    _biz_validasi_field_merchant("grievance officer email", go2["email"], 254);
    _biz_validasi_field_merchant("grievance officer landline", go2["landline_number"], 64);
    _biz_validasi_field_merchant("grievance officer mobile", go2["mobile_number"], 64);
    hasil r;
}

fungsi biz_vars_kepatuhan_query(bisnis_jid) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat inner = peta_baru(); inner["biz_jid"] = JidTeks;
    buat outer = peta_baru(); outer["request"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_kepatuhan_set(bisnis_jid, info) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat n = _biz_normalisasi_merchant(info);
    buat inner = peta_baru();
    inner["biz_jid"] = JidTeks;
    inner["merchant_info"] = n;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_dekode_kepatuhan(data, field) {
    buat v = _biz_json(data);
    buat root = v[field];
    jika tipe(root) != "peta" || tipe(root["merchant_info"]) != "peta" {
        lempar "respons kepatuhan merchant bisnis kehilangan merchant_info";
    }
    hasil root["merchant_info"];
}

fungsi _biz_validasi_input_produk(input) {
    jika tipe(input) != "peta" { lempar "input produk bisnis kosong"; }
    buat nama = _biz_trim(input["name"]);
    jika panjang(nama) == 0 { lempar "nama produk bisnis kosong"; }
    jika panjang(nama) > 256 { lempar "nama produk bisnis lebih dari 256 byte"; }
    jika panjang(_biz_teks(input["description"])) > 4096 { lempar "deskripsi produk bisnis lebih dari 4096 byte"; }
    jika panjang(_biz_teks(input["retailer_id"])) > 256 { lempar "retailer ID produk bisnis lebih dari 256 byte"; }

    buat imgs = input["image_urls"];
    jika tipe(imgs) != "larik" || panjang(imgs) < 1 || panjang(imgs) > 10 {
        lempar "produk bisnis harus punya 1 sampai 10 gambar";
    }
    untuk (buat i = 0; i < panjang(imgs); i = i + 1) { _biz_validasi_url_media(imgs[i]); }

    buat vids = input["video_urls"];
    jika tipe(vids) == "larik" {
        jika panjang(vids) > 10 { lempar "produk bisnis gak boleh lebih dari 10 video"; }
        untuk (buat i = 0; i < panjang(vids); i = i + 1) { _biz_validasi_url_media(vids[i]); }
    }

    buat u = _biz_teks(input["url"]);
    jika panjang(u) > 0 {
        jika panjang(_biz_host(u)) == 0 || panjang(u) > 2048 {
            lempar "URL produk bisnis harus HTTPS absolut maksimal 2048 byte";
        }
    }

    buat harga = _biz_teks(input["price"]);
    buat mata_uang = _biz_teks(input["currency"]);
    buat harga_diskon = _biz_teks(input["sale_price"]);
    jika panjang(harga) == 0 {
        jika panjang(mata_uang) > 0 || panjang(harga_diskon) > 0 {
            lempar "mata uang dan harga diskon produk bisnis butuh harga";
        }
    } lain {
        jika !_biz_mata_uang_valid(mata_uang) { lempar "mata uang produk bisnis harus 3 huruf kapital"; }
        jika !_biz_desimal_valid(harga) { lempar "harga produk bisnis harus bilangan bulat dalam perseribu"; }
        jika panjang(harga_diskon) > 0 && !_biz_desimal_valid(harga_diskon) {
            lempar "harga diskon produk bisnis harus bilangan bulat dalam perseribu";
        }
    }
    jika panjang(_biz_teks(input["compliance_category"])) > 128 {
        lempar "compliance category produk bisnis lebih dari 128 byte";
    }
    buat comp = input["compliance_info"];
    jika tipe(comp) == "peta" {
        jika panjang(_biz_teks(comp["country_code_origin"])) > 3 || panjang(_biz_teks(comp["importer_name"])) > 256 {
            lempar "informasi kepatuhan produk bisnis gak valid";
        }
        buat addr = comp["importer_address"];
        jika tipe(addr) == "peta" {
            jika panjang(_biz_teks(addr["street1"])) > 512 || panjang(_biz_teks(addr["street2"])) > 512
                || panjang(_biz_teks(addr["city"])) > 256 || panjang(_biz_teks(addr["region"])) > 256
                || panjang(_biz_teks(addr["postal_code"])) > 64 || panjang(_biz_teks(addr["country_code"])) > 3 {
                lempar "alamat importir produk bisnis gak valid";
            }
        }
    }
    hasil benar;
}

fungsi _biz_info_produk(input) {
    buat gambar = [];
    untuk (buat i = 0; i < panjang(input["image_urls"]); i = i + 1) {
        buat e = peta_baru(); e["url"] = input["image_urls"][i];
        tambah(gambar, e);
    }
    buat media = peta_baru();
    media["image"] = gambar;
    jika tipe(input["video_urls"]) == "larik" && panjang(input["video_urls"]) > 0 {
        buat video = [];
        untuk (buat i = 0; i < panjang(input["video_urls"]); i = i + 1) {
            buat e = peta_baru(); e["url"] = input["video_urls"][i];
            tambah(video, e);
        }
        media["video"] = video;
    }

    buat info = peta_baru();
    info["name"] = _biz_trim(input["name"]);
    info["media"] = media;
    info["is_hidden"] = (input["is_hidden"] == benar);
    jika panjang(_biz_teks(input["description"])) > 0 { info["description"] = input["description"]; }
    jika panjang(_biz_teks(input["url"])) > 0 { info["url"] = input["url"]; }
    jika panjang(_biz_teks(input["retailer_id"])) > 0 { info["retailer_id"] = input["retailer_id"]; }
    jika panjang(_biz_teks(input["price"])) > 0 {
        info["currency"] = _biz_teks(input["currency"]);
        info["price"] = input["price"];
    }
    jika panjang(_biz_teks(input["sale_price"])) > 0 { info["sale_price"] = input["sale_price"]; }

    buat comp = input["compliance_info"];
    jika tipe(comp) == "peta" {
        buat c = peta_baru();
        c["country_code_origin"] = _biz_teks(comp["country_code_origin"]);
        jika panjang(_biz_teks(comp["importer_name"])) > 0 { c["importer_name"] = comp["importer_name"]; }
        buat addr = comp["importer_address"];
        jika tipe(addr) == "peta" {
            buat a = peta_baru();
            a["country_code"] = _biz_teks(addr["country_code"]);
            a["city"] = _biz_teks(addr["city"]);
            a["street1"] = _biz_teks(addr["street1"]);
            jika panjang(_biz_teks(addr["street2"])) > 0 { a["street2"] = addr["street2"]; }
            jika panjang(_biz_teks(addr["region"])) > 0 { a["region"] = addr["region"]; }
            jika panjang(_biz_teks(addr["postal_code"])) > 0 { a["postal_code"] = addr["postal_code"]; }
            c["importer_address"] = a;
        }
        info["compliance_info"] = c;
    }
    jika panjang(_biz_teks(input["compliance_category"])) > 0 {
        info["compliance_category"] = input["compliance_category"];
    }
    hasil info;
}

fungsi biz_vars_mutasi_produk(bisnis_jid, product_id, input, lebar, tinggi) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat pid = _biz_teks(product_id);
    jika panjang(pid) > 0 { _biz_validasi_id("produk", pid); }
    _biz_validasi_input_produk(input);
    buat d = _biz_dimensi(lebar, tinggi);

    buat p = peta_baru();
    p["biz_jid"] = JidTeks;
    p["width"] = d[0];
    p["height"] = d[1];
    p["product_info"] = _biz_info_produk(input);
    jika panjang(pid) > 0 { p["product_id"] = pid; }
    buat inner = peta_baru(); inner["product"] = p;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_hapus_produk(bisnis_jid, product_ids) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    jika tipe(product_ids) != "larik" || panjang(product_ids) < 1 || panjang(product_ids) > 100 {
        lempar "hapus produk bisnis harus berisi 1 sampai 100 ID";
    }
    untuk (buat i = 0; i < panjang(product_ids); i = i + 1) { _biz_validasi_id("produk", product_ids[i]); }
    _biz_duplikat(product_ids, "ID produk");
    buat inner = peta_baru();
    inner["biz_jid"] = JidTeks;
    inner["product_ids"] = product_ids;
    buat outer = peta_baru(); outer["input"] = inner;
    hasil json_encode(outer);
}

fungsi biz_dekode_mutasi_produk(data, diskriminator) {
    buat v = _biz_json(data);
    buat root = v[diskriminator];
    jika tipe(root) != "peta" { lempar "respons mutasi produk bisnis kehilangan " + diskriminator; }
    buat p = root["product"];
    jika tipe(p) != "peta" || panjang(_biz_teks(p["id"])) == 0 {
        lempar "respons " + diskriminator + " kehilangan produk";
    }
    hasil p;
}

fungsi biz_dekode_hapus_produk(data) {
    buat v = _biz_json(data);
    buat root = v["xfb_whatsapp_catalog_delete_product"];
    jika tipe(root) != "peta" || tipe(root["deleted_count"]) != "angka" || root["deleted_count"] < 0 {
        lempar "respons hapus produk bisnis kehilangan deleted_count";
    }
    hasil root["deleted_count"];
}

fungsi biz_buat_node_nonce(req_id) {
    hasil _biz_iq(req_id, "fb:thrift_iq", "get", "118", []);
}

fungsi biz_buat_node_tukar_token(req_id, nonce) {
    jika panjang(_biz_trim(nonce)) == 0 || panjang(nonce) > 8192 {
        lempar "nonce akses token bisnis gak valid";
    }
    buat kode = _biz_node("code", peta_baru(), [], nonce);
    buat par = _biz_node("parameters", peta_baru(), [kode], kosong);
    hasil _biz_iq(req_id, "fb:thrift_iq", "get", "104", [par]);
}

fungsi biz_urai_respons_nonce(node) {
    buat res = _biz_anak(node, "result");
    jika tipe(res) != "peta" { lempar "respons nonce bisnis kehilangan result"; }
    buat st = _biz_teks(res["attrs"]["status"]);
    jika st == "Success" { hasil benar; }
    jika st == "RecoveryRequired" { lempar "pemulihan akses token bisnis harus dilakukan di perangkat utama"; }
    lempar "permintaan nonce bisnis balikin status gak dikenal: " + st;
}

fungsi biz_urai_token(node) {
    jika tipe(node) != "peta" { lempar "respons akses token bisnis kosong"; }
    buat tok = _biz_anak(node, "access_token");
    jika tipe(tok) != "peta" { lempar "respons akses token bisnis kehilangan access_token"; }
    buat person = _biz_anak(node, "business_person");
    jika tipe(person) != "peta" { lempar "respons akses token bisnis kehilangan business_person"; }
    jika tipe(tok["content"]) != "teks" || panjang(tok["content"]) == 0 || panjang(tok["content"]) > 16384 {
        lempar "respons akses token bisnis punya token gak valid";
    }
    buat actor = _biz_teks(person["attrs"]["id"]);
    jika panjang(actor) == 0 || panjang(actor) > 256 {
        lempar "respons akses token bisnis punya business person gak valid";
    }
    buat r = peta_baru();
    r["access_token"] = tok["content"];
    r["actor_id"] = actor;
    hasil r;
}

fungsi biz_ambil_nonce_notifikasi(node) {
    buat n = _biz_anak(node, "wa_ad_account_nonce");
    jika tipe(n) != "peta" || tipe(n["content"]) != "teks" { hasil ""; }
    jika panjang(n["content"]) == 0 || panjang(n["content"]) > 8192 { hasil ""; }
    hasil n["content"];
}

fungsi biz_klasifikasi_error_token(node) {
    buat e = _biz_anak(node, "error");
    jika tipe(e) != "peta" { hasil ""; }
    buat kode = _biz_teks(e["attrs"]["code"]);
    jika kode == "432" { hasil "nonce_salah"; }
    jika kode == "431" { hasil "terlalu_banyak_percobaan"; }
    hasil "";
}

fungsi biz_auth_baru() {
    buat s = peta_baru();
    s["access_token"] = "";
    s["actor_id"] = "";
    s["nonce"] = "";
    hasil s;
}

fungsi biz_auth_simpan_nonce(state, nonce) {
    jika tipe(state) != "peta" { hasil salah; }
    jika tipe(nonce) != "teks" || panjang(nonce) == 0 { hasil salah; }
    state["nonce"] = nonce;
    hasil benar;
}

fungsi biz_auth_simpan_token(state, token) {
    jika tipe(state) != "peta" || tipe(token) != "peta" { hasil salah; }
    state["access_token"] = _biz_teks(token["access_token"]);
    state["actor_id"] = _biz_teks(token["actor_id"]);
    hasil benar;
}

fungsi biz_auth_batalkan_token(state, token) {
    jika tipe(state) != "peta" { hasil salah; }
    jika state["access_token"] == token {
        state["access_token"] = "";
        state["actor_id"] = "";
        hasil benar;
    }
    hasil salah;
}

fungsi biz_vars_dengan_actor(variables_json, actor_id) {
    jika panjang(_biz_trim(actor_id)) == 0 { lempar "actor ID mutasi katalog bisnis kosong"; }
    buat v = json_decode(variables_json);
    jika tipe(v) != "peta" || tipe(v["input"]) != "peta" {
        lempar "variabel mutasi katalog bisnis kehilangan input";
    }
    v["input"]["actor_id"] = actor_id;
    hasil json_encode(v);
}

fungsi biz_graphql(endpoint, doc_id, access_token, variables_json, device_id) {
    buat body = "{\"access_token\":" + json_encode(access_token)
        + ",\"doc_id\":" + json_encode(doc_id)
        + ",\"variables\":" + variables_json
        + ",\"locale\":\"en_US\"}";
    buat tag = ke_teks(waktu()) + "_" + CP["acak_bytes_hex"](4);
    buat path_body = "/tmp/bizgql_req_" + tag + ".json";
    buat path_resp = "/tmp/bizgql_res_" + tag + ".json";
    tulis_file(path_body, body);

    buat args = ["-sS", "-X", "POST",
        "--connect-timeout", "15", "--max-time", "30",
        "-o", path_resp, "-w", "%{http_code}",
        "-H", "Accept: application/json",
        "-H", "Content-Type: application/json",
        "-H", "Origin: https://web.whatsapp.com",
        "-H", "Referer: https://web.whatsapp.com/"];
    jika tipe(device_id) == "angka" && device_id > 0 {
        tambah(args, "-H");
        tambah(args, "X-WA-Device-ID: " + ke_teks(device_id));
    }
    tambah(args, "--data-binary");
    tambah(args, "@" + path_body);
    tambah(args, endpoint);

    buat res = jalankan_perintah("curl", args);
    buat r = peta_baru();
    r["ok"] = salah;
    r["status"] = 0;
    r["data"] = kosong;
    r["error_codes"] = [];
    r["pesan"] = "";
    jika res["status"] != 0 {
        r["pesan"] = "request GraphQL bisnis gagal: " + ke_teks(res["error"]);
        hasil r;
    }
    r["status"] = ke_angka(_biz_trim(res["keluaran"]));
    buat mentah = baca_file(path_resp);
    jika panjang(mentah) > BIZ_MAKS_RESPONS_GRAPHQL {
        r["pesan"] = "respons GraphQL bisnis lebih dari " + ke_teks(BIZ_MAKS_RESPONS_GRAPHQL) + " byte";
        hasil r;
    }
    buat env = json_decode(mentah);
    jika tipe(env) == "peta" {
        jika tipe(env["errors"]) == "larik" {
            untuk (buat i = 0; i < panjang(env["errors"]); i = i + 1) {
                tambah(r["error_codes"], env["errors"][i]["code"]);
            }
        }
        jika tipe(env["error"]) == "peta" { tambah(r["error_codes"], env["error"]["code"]); }
    }
    jika r["status"] < 200 || r["status"] >= 300 {
        r["pesan"] = "request GraphQL bisnis gagal dengan status " + ke_teks(r["status"]);
        hasil r;
    }
    jika tipe(env) != "peta" {
        r["pesan"] = "respons GraphQL bisnis gak bisa didekode";
        hasil r;
    }
    jika panjang(r["error_codes"]) > 0 {
        r["pesan"] = "request GraphQL bisnis gagal dengan kode error";
        hasil r;
    }
    jika tipe(env["data"]) != "peta" {
        r["pesan"] = "respons GraphQL bisnis kehilangan data";
        hasil r;
    }
    r["ok"] = benar;
    r["data"] = env["data"];
    hasil r;
}

fungsi biz_error_auth(res) {
    jika tipe(res) != "peta" { hasil salah; }
    jika res["status"] == 401 || res["status"] == 403 { hasil benar; }
    untuk (buat i = 0; i < panjang(res["error_codes"]); i = i + 1) {
        jika res["error_codes"][i] == 190 || res["error_codes"][i] == 400 { hasil benar; }
    }
    hasil salah;
}

fungsi biz_eksekusi_mutasi(state, doc_id, variables_json, device_id) {
    jika tipe(state) != "peta" || panjang(_biz_teks(state["access_token"])) == 0 {
        lempar "akses token bisnis belum ada: jalanin alur biz_buat_node_nonce -> biz_buat_node_tukar_token -> biz_auth_simpan_token";
    }
    buat vars = biz_vars_dengan_actor(variables_json, state["actor_id"]);
    buat res = biz_graphql(BIZ_ENDPOINT_GRAPHQL, doc_id, state["access_token"], vars, device_id);
    jika res["ok"] { hasil res["data"]; }
    jika biz_error_auth(res) { biz_auth_batalkan_token(state, state["access_token"]); }
    lempar "mutasi katalog bisnis gagal: " + res["pesan"];
}

fungsi biz_kepatuhan_query(bisnis_jid, device_id) {
    buat vars = biz_vars_kepatuhan_query(bisnis_jid);
    buat res = biz_graphql(BIZ_ENDPOINT_KATALOG, BIZ_Q_KEPATUHAN, BIZ_TOKEN_KATALOG, vars, device_id);
    jika !res["ok"] { lempar "ambil kepatuhan merchant bisnis gagal: " + res["pesan"]; }
    hasil biz_dekode_kepatuhan(res["data"], "xfb_whatsapp_biz_merchant_compliance_info");
}

fungsi _biz_tipe_gambar(gambar) {
    jika tipe(gambar) != "teks" || panjang(gambar) < 8 { hasil ""; }
    jika byte_di(gambar, 0) == 255 && byte_di(gambar, 1) == 216 { hasil "image/jpeg"; }
    jika byte_di(gambar, 0) == 137 && byte_di(gambar, 1) == 80
        && byte_di(gambar, 2) == 78 && byte_di(gambar, 3) == 71 { hasil "image/png"; }
    hasil "";
}

fungsi biz_validasi_gambar_produk(gambar) {
    jika tipe(gambar) != "teks" || panjang(gambar) == 0 { lempar "gambar produk bisnis kosong"; }
    jika panjang(gambar) > BIZ_MAKS_GAMBAR_PRODUK {
        lempar "gambar produk bisnis lebih dari " + ke_teks(BIZ_MAKS_GAMBAR_PRODUK) + " byte";
    }
    jika panjang(_biz_tipe_gambar(gambar)) == 0 { lempar "gambar produk bisnis harus JPEG atau PNG"; }
    hasil CP["hex_decode"](sha256_hex(gambar));
}

fungsi biz_validasi_cover(gambar) {
    jika tipe(gambar) != "teks" || panjang(gambar) == 0 { lempar "foto sampul bisnis kosong"; }
    jika panjang(gambar) > BIZ_MAKS_COVER {
        lempar "foto sampul bisnis lebih dari " + ke_teks(BIZ_MAKS_COVER) + " byte";
    }
    jika panjang(_biz_tipe_gambar(gambar)) == 0 { lempar "foto sampul bisnis harus JPEG atau PNG"; }
    hasil CP["hex_decode"](sha256_hex(gambar));
}

fungsi _biz_unggah(gambar, media_conn, path_prefix, content_type) {
    jika tipe(media_conn) != "peta" || tipe(media_conn["host"]) != "larik" || panjang(media_conn["host"]) == 0 {
        lempar "respons koneksi media gak punya host upload";
    }
    buat hash_bytes = "";
    jika path_prefix == "/product/image/" { hash_bytes = biz_validasi_gambar_produk(gambar); }
    lain { hash_bytes = biz_validasi_cover(gambar); }

    buat token = _biz_base64_url(hash_bytes);
    buat tag = ke_teks(waktu()) + "_" + CP["acak_bytes_hex"](4);
    buat path_body = "/tmp/bizupload_" + tag + ".bin";
    buat path_resp = "/tmp/bizupload_res_" + tag + ".json";
    tulis_file(path_body, gambar);

    buat url = "https://" + media_conn["host"][0] + path_prefix + token
        + "?auth=" + media_conn["auth"] + "&token=" + token;
    buat res = jalankan_perintah("curl", ["-sS", "-X", "POST",
        "--connect-timeout", "15", "--max-time", "60",
        "-o", path_resp, "-w", "%{http_code}",
        "-H", "Content-Type: " + content_type,
        "-H", "Origin: https://web.whatsapp.com",
        "-H", "Referer: https://web.whatsapp.com/",
        "--data-binary", "@" + path_body, url]);
    jika res["status"] != 0 { lempar "unggah bisnis gagal: " + ke_teks(res["error"]); }
    buat kode = ke_angka(_biz_trim(res["keluaran"]));
    jika kode != 200 { lempar "unggah bisnis gagal dengan status " + ke_teks(kode); }
    buat j = json_decode(baca_file(path_resp));
    jika tipe(j) != "peta" { lempar "respons unggah bisnis gak valid"; }
    hasil j;
}

fungsi biz_unggah_gambar_produk(gambar, media_conn) {
    buat j = _biz_unggah(gambar, media_conn, "/product/image/", "application/octet-stream");
    jika panjang(_biz_teks(j["url"])) > 0 {
        _biz_validasi_url_media(j["url"]);
        hasil j["url"];
    }
    buat dp = _biz_teks(j["direct_path"]);
    jika panjang(dp) == 0 || potong(dp, 0, 1) != "/" || panjang(dp) > 4096 {
        lempar "respons unggah gambar produk bisnis gak punya URL valid";
    }
    hasil "https://mmg.whatsapp.net" + dp;
}

fungsi biz_unggah_cover(gambar, media_conn) {
    buat j = _biz_unggah(gambar, media_conn, "/pps/biz-cover-photo/", _biz_tipe_gambar(gambar));
    buat r = peta_baru();
    r["meta_hmac"] = _biz_teks(j["meta_hmac"]);
    r["fbid"] = _biz_teks(j["fbid"]);
    r["ts"] = _biz_teks(j["ts"]);
    jika panjang(r["meta_hmac"]) == 0 || panjang(r["fbid"]) == 0 || panjang(r["ts"]) == 0 {
        lempar "respons unggah foto sampul bisnis gak lengkap";
    }
    hasil r;
}

fungsi _biz_node_mutasi_profil(anak) {
    buat a = peta_baru();
    a["v"] = "3";
    a["mutation_type"] = "delta";
    hasil _biz_node("business_profile", a, anak, kosong);
}

fungsi biz_hari_profil() {
    hasil ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];
}

fungsi biz_mode_jam_profil() {
    hasil ["specific_hours", "open_24h", "appointment_only"];
}

fungsi _biz_ada_di(list, v) {
    untuk (buat i = 0; i < panjang(list); i = i + 1) {
        jika list[i] == v { hasil benar; }
    }
    hasil salah;
}

fungsi _biz_node_jam_bisnis(jam) {
    buat tz = _biz_teks(jam["timezone"]);
    jika panjang(tz) == 0 || panjang(tz) > 128 { lempar "timezone jam bisnis gak valid"; }
    buat hari = jam["days"];
    jika tipe(hari) != "larik" { hari = []; }
    jika panjang(hari) > 7 { lempar "jam bisnis maksimal 7 hari"; }

    buat seen = peta_baru();
    buat konfig = [];
    untuk (buat i = 0; i < panjang(hari); i = i + 1) {
        buat d = hari[i];
        buat dow = _biz_teks(d["day_of_week"]);
        jika !_biz_ada_di(biz_hari_profil(), dow) { lempar "hari jam bisnis gak valid: " + dow; }
        jika seen[dow] == benar { lempar "hari jam bisnis dobel: " + dow; }
        seen[dow] = benar;
        buat mode = _biz_teks(d["mode"]);
        jika !_biz_ada_di(biz_mode_jam_profil(), mode) { lempar "mode jam bisnis gak valid: " + mode; }

        buat a = peta_baru();
        a["day_of_week"] = dow;
        a["mode"] = mode;
        buat buka = d["open_time"];
        buat tutup = d["close_time"];
        jika tipe(buka) != "angka" { buka = 0; }
        jika tipe(tutup) != "angka" { tutup = 0; }
        jika mode == "specific_hours" {
            jika buka < 0 || buka > 1439 || tutup < 0 || tutup > 1439 || buka == tutup {
                lempar "jam spesifik gak valid buat " + dow;
            }
            a["open_time"] = ke_teks(buka);
            a["close_time"] = ke_teks(tutup);
        } lain jika buka != 0 || tutup != 0 {
            lempar "mode " + mode + " gak nerima open/close time";
        }
        tambah(konfig, _biz_node("business_hours_config", a, [], kosong));
    }
    buat ha = peta_baru();
    ha["timezone"] = _biz_trim(tz);
    hasil _biz_node("business_hours", ha, konfig, kosong);
}

fungsi biz_buat_node_update_profil(req_id, update) {
    jika tipe(update) != "peta" { lempar "update profil bisnis kosong"; }
    buat ada_alamat = (tipe(update["address"]) == "teks");
    buat ada_email = (tipe(update["email"]) == "teks");
    buat ada_desk = (tipe(update["description"]) == "teks");
    buat ada_web = (tipe(update["websites"]) == "larik");
    buat ada_jam = (tipe(update["hours"]) == "peta");
    jika !ada_alamat && !ada_email && !ada_desk && !ada_web && !ada_jam {
        lempar "update profil bisnis kosong";
    }
    jika ada_alamat && panjang(update["address"]) > 512 { lempar "alamat bisnis lebih dari 512 byte"; }
    jika ada_desk && panjang(update["description"]) > 1024 { lempar "deskripsi bisnis lebih dari 1024 byte"; }
    jika ada_email {
        jika panjang(update["email"]) > 320 { lempar "email bisnis lebih dari 320 byte"; }
        jika panjang(update["email"]) > 0 {
            buat at = 0;
            buat titik = salah;
            untuk (buat i = 0; i < panjang(update["email"]); i = i + 1) {
                jika byte_di(update["email"], i) == 64 { at = at + 1; }
                jika byte_di(update["email"], i) == 46 && at == 1 { titik = benar; }
            }
            jika at != 1 || !titik { lempar "email bisnis gak valid"; }
        }
    }

    buat anak = [];
    jika ada_alamat { tambah(anak, _biz_node("address", peta_baru(), [], update["address"])); }
    jika ada_email { tambah(anak, _biz_node("email", peta_baru(), [], update["email"])); }
    jika ada_desk { tambah(anak, _biz_node("description", peta_baru(), [], update["description"])); }
    jika ada_web {
        buat ws = update["websites"];
        jika panjang(ws) > 2 { lempar "profil bisnis maksimal 2 website"; }
        jika panjang(ws) == 0 { tambah(anak, _biz_node("website", peta_baru(), [], "")); }
        untuk (buat i = 0; i < panjang(ws); i = i + 1) {
            buat w = _biz_teks(ws[i]);
            jika panjang(w) > 2048 { lempar "website bisnis lebih dari 2048 byte"; }
            buat ok_http = (panjang(w) > 7 && potong(w, 0, 7) == "http://");
            buat ok_https = (panjang(w) > 8 && potong(w, 0, 8) == "https://");
            jika !ok_http && !ok_https { lempar "website bisnis bukan URL HTTP absolut: " + w; }
            tambah(anak, _biz_node("website", peta_baru(), [], w));
        }
    }
    jika ada_jam { tambah(anak, _biz_node_jam_bisnis(update["hours"])); }

    hasil _biz_iq(req_id, "w:biz", "set", kosong, [_biz_node_mutasi_profil(anak)]);
}

fungsi biz_buat_node_set_cover(req_id, unggah) {
    jika tipe(unggah) != "peta" || panjang(_biz_teks(unggah["meta_hmac"])) == 0
        || panjang(_biz_teks(unggah["fbid"])) == 0 || panjang(_biz_teks(unggah["ts"])) == 0 {
        lempar "respons unggah foto sampul bisnis gak lengkap";
    }
    buat a = peta_baru();
    a["id"] = unggah["fbid"];
    a["op"] = "update";
    a["token"] = unggah["meta_hmac"];
    a["ts"] = unggah["ts"];
    buat cover = _biz_node("cover_photo", a, [], kosong);
    hasil _biz_iq(req_id, "w:biz", "set", kosong, [_biz_node_mutasi_profil([cover])]);
}

fungsi biz_buat_node_hapus_cover(req_id, cover_id) {
    jika panjang(_biz_trim(cover_id)) == 0 { lempar "ID foto sampul bisnis kosong"; }
    jika panjang(cover_id) > 256 { lempar "ID foto sampul bisnis lebih dari 256 byte"; }
    buat a = peta_baru();
    a["id"] = cover_id;
    a["op"] = "delete";
    buat cover = _biz_node("cover_photo", a, [], kosong);
    hasil _biz_iq(req_id, "w:biz", "set", kosong, [_biz_node_mutasi_profil([cover])]);
}

fungsi _biz_pemilik_valid(j) {
    coba { _biz_validasi_jid(j); hasil benar; } tangkap (e) { hasil salah; }
}

fungsi biz_bangun_pesan_produk(params) {
    jika tipe(params) != "peta" { lempar "parameter pesan produk bisnis kosong"; }
    jika !_biz_pemilik_valid(params["business_owner_jid"]) { lempar "JID pemilik bisnis gak valid"; }
    buat pemilik = _biz_jid_teks(params["business_owner_jid"]);
    buat pid = _biz_teks(params["product_id"]);
    buat judul = _biz_teks(params["title"]);
    jika panjang(_biz_trim(pid)) == 0 || !_biz_batas(pid, 256)
        || panjang(_biz_trim(judul)) == 0 || !_biz_batas(judul, 256) {
        lempar "identitas produk bisnis gak valid";
    }
    buat deskripsi = _biz_teks(params["description"]);
    buat retailer = _biz_teks(params["retailer_id"]);
    buat url = _biz_teks(params["url"]);
    buat body = _biz_teks(params["body"]);
    buat footer = _biz_teks(params["footer"]);
    jika !_biz_batas(deskripsi, 4096) || !_biz_batas(retailer, 256) || !_biz_batas(url, 2048)
        || !_biz_batas(body, 1024) || !_biz_batas(footer, 60) {
        lempar "field pesan produk bisnis kegedean";
    }
    buat harga = params["price_amount_1000"];
    buat harga_diskon = params["sale_price_amount_1000"];
    jika tipe(harga) != "angka" { harga = 0; }
    jika tipe(harga_diskon) != "angka" { harga_diskon = 0; }
    jika harga < 0 || harga_diskon < 0 { lempar "harga produk bisnis gak valid"; }
    buat mata_uang = _biz_teks(params["currency_code"]);
    buat ada_harga = (harga != 0 || panjang(mata_uang) > 0);
    buat diskon_ada = (params["sale_price_present"] == benar);
    jika !ada_harga && (harga_diskon > 0 || diskon_ada) {
        lempar "harga diskon produk bisnis butuh harga dasar";
    }
    jika ada_harga && !_biz_mata_uang_valid(mata_uang) { lempar "mata uang produk bisnis gak valid"; }
    buat jml_gambar = params["product_image_count"];
    jika tipe(jml_gambar) != "angka" { jml_gambar = 0; }
    jika jml_gambar > 10 { lempar "produk bisnis gak boleh lebih dari 10 gambar"; }
    jika panjang(url) > 0 && panjang(_biz_host(url)) == 0 {
        lempar "URL produk bisnis harus HTTPS absolut";
    }

    buat snap = "";
    jika tipe(params["product_image"]) == "teks" && panjang(params["product_image"]) > 0 {
        snap = snap + PB.PbBytes(1, params["product_image"]);
    }
    snap = snap + PB.PbBytes(2, pid) + PB.PbBytes(3, judul);
    jika panjang(deskripsi) > 0 { snap = snap + PB.PbBytes(4, deskripsi); }
    jika panjang(mata_uang) > 0 { snap = snap + PB.PbBytes(5, mata_uang); }
    jika ada_harga || harga != 0 { snap = snap + PB.PbVarint(6, harga); }
    jika panjang(retailer) > 0 { snap = snap + PB.PbBytes(7, retailer); }
    jika panjang(url) > 0 { snap = snap + PB.PbBytes(8, url); }
    jika jml_gambar > 0 { snap = snap + PB.PbVarint(9, jml_gambar); }
    jika diskon_ada || harga_diskon > 0 { snap = snap + PB.PbVarint(12, harga_diskon); }

    buat f = PB.PbBytes(1, snap) + PB.PbBytes(2, pemilik);
    jika panjang(body) > 0 { f = f + PB.PbBytes(5, body); }
    jika panjang(footer) > 0 { f = f + PB.PbBytes(6, footer); }
    buat ci = MS.BangunContextInfo(params["kutip"]);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(30, f);
}

fungsi biz_bangun_pesan_daftar_produk(params) {
    jika tipe(params) != "peta" { lempar "parameter daftar produk bisnis kosong"; }
    jika !_biz_pemilik_valid(params["business_owner_jid"]) { lempar "JID pemilik bisnis gak valid"; }
    buat pemilik = _biz_jid_teks(params["business_owner_jid"]);
    buat judul = _biz_teks(params["title"]);
    buat deskripsi = _biz_teks(params["description"]);
    buat tombol = _biz_teks(params["button_text"]);
    buat footer = _biz_teks(params["footer"]);
    jika panjang(_biz_trim(judul)) == 0 || !_biz_batas(judul, 60) || !_biz_batas(deskripsi, 1024)
        || panjang(_biz_trim(tombol)) == 0 || !_biz_batas(tombol, 20) || !_biz_batas(footer, 60) {
        lempar "teks daftar produk bisnis gak valid";
    }
    buat seksi = params["sections"];
    jika tipe(seksi) != "larik" || panjang(seksi) == 0 || panjang(seksi) > 10 {
        lempar "daftar produk bisnis harus 1 sampai 10 seksi";
    }
    buat seen = peta_baru();
    buat jml_produk = 0;
    buat seksi_wire = "";
    untuk (buat i = 0; i < panjang(seksi); i = i + 1) {
        buat s = seksi[i];
        buat st = _biz_teks(s["title"]);
        buat ids = s["product_ids"];
        jika tipe(ids) != "larik" { ids = []; }
        jika !_biz_batas(st, 24) || panjang(ids) == 0
            || (panjang(seksi) > 1 && panjang(_biz_trim(st)) == 0) {
            lempar "seksi produk bisnis gak valid: " + ke_teks(i);
        }
        jika panjang(ids) > 30 - jml_produk { lempar "daftar produk bisnis lebih dari 30 produk"; }
        jml_produk = jml_produk + panjang(ids);
        buat produk_wire = "";
        untuk (buat p = 0; p < panjang(ids); p = p + 1) {
            buat pid = _biz_teks(ids[p]);
            jika panjang(_biz_trim(pid)) == 0 || !_biz_batas(pid, 256) {
                lempar "ID produk gak valid di seksi " + ke_teks(i);
            }
            jika seen[pid] == benar { lempar "ID produk dobel " + pid; }
            seen[pid] = benar;
            produk_wire = produk_wire + PB.PbBytes(2, PB.PbBytes(1, pid));
        }
        buat sw = "";
        jika panjang(st) > 0 { sw = sw + PB.PbBytes(1, st); }
        sw = sw + produk_wire;
        seksi_wire = seksi_wire + PB.PbBytes(1, sw);
    }
    buat info = seksi_wire + PB.PbBytes(3, pemilik);

    buat f = PB.PbBytes(1, judul);
    jika panjang(deskripsi) > 0 { f = f + PB.PbBytes(2, deskripsi); }
    f = f + PB.PbBytes(3, tombol) + PB.PbVarint(4, 2) + PB.PbBytes(6, info);
    jika panjang(footer) > 0 { f = f + PB.PbBytes(7, footer); }
    buat ci = MS.BangunContextInfo(params["kutip"]);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(8, ci); }
    hasil PB.PbBytes(36, f);
}

fungsi biz_bangun_pesan_order(params) {
    jika tipe(params) != "peta" { lempar "parameter pesan order bisnis kosong"; }
    jika !_biz_pemilik_valid(params["seller_jid"]) { lempar "JID penjual gak valid"; }
    buat penjual = _biz_jid_teks(params["seller_jid"]);
    buat oid = _biz_teks(params["order_id"]);
    buat token = _biz_teks(params["token"]);
    buat jml = params["item_count"];
    jika tipe(jml) != "angka" { jml = 0; }
    jika panjang(_biz_trim(oid)) == 0 || !_biz_batas(oid, 256)
        || (panjang(token) > 0 && panjang(_biz_trim(token)) == 0) || jml < 1 || jml > 100 {
        lempar "identitas order bisnis gak valid";
    }
    buat status = params["status"];
    jika tipe(status) != "angka" { status = 0; }
    buat total = params["total_amount_1000"];
    jika tipe(total) != "angka" { total = 0; }
    buat mata_uang = _biz_teks(params["total_currency_code"]);
    jika status < 1 || status > 3 || total < 0 || !_biz_mata_uang_valid(mata_uang) {
        lempar "state order bisnis gak valid";
    }
    buat thumb = _biz_teks(params["thumbnail"]);
    buat pesan = _biz_teks(params["message"]);
    buat judul = _biz_teks(params["order_title"]);
    buat katalog = _biz_teks(params["catalog_type"]);
    jika panjang(thumb) > 65536 || !_biz_batas(pesan, 4096) || !_biz_batas(judul, 256)
        || !_biz_batas(token, 8192) || !_biz_batas(katalog, 128) {
        lempar "field pesan order bisnis kegedean";
    }

    buat f = PB.PbBytes(1, oid);
    jika panjang(thumb) > 0 { f = f + PB.PbBytes(2, thumb); }
    f = f + PB.PbVarint(3, jml) + PB.PbVarint(4, status) + PB.PbVarint(5, 1);
    jika panjang(pesan) > 0 { f = f + PB.PbBytes(6, pesan); }
    jika panjang(judul) > 0 { f = f + PB.PbBytes(7, judul); }
    f = f + PB.PbBytes(8, penjual);
    jika panjang(token) > 0 { f = f + PB.PbBytes(9, token); }
    f = f + PB.PbVarint(10, total) + PB.PbBytes(11, mata_uang);
    jika panjang(katalog) > 0 { f = f + PB.PbBytes(15, katalog); }
    buat ci = MS.BangunContextInfo(params["kutip"]);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(38, f);
}

fungsi biz_bangun_pesan_list(params) {
    jika tipe(params) != "peta" { lempar "parameter pesan list bisnis kosong"; }
    buat judul = _biz_teks(params["title"]);
    buat deskripsi = _biz_teks(params["description"]);
    buat tombol = _biz_teks(params["button_text"]);
    buat footer = _biz_teks(params["footer"]);
    jika !_biz_batas(judul, 60) || panjang(_biz_trim(deskripsi)) == 0 || !_biz_batas(deskripsi, 1024)
        || panjang(_biz_trim(tombol)) == 0 || !_biz_batas(tombol, 20) || !_biz_batas(footer, 60) {
        lempar "teks list bisnis gak valid";
    }
    buat seksi = params["sections"];
    jika tipe(seksi) != "larik" || panjang(seksi) == 0 || panjang(seksi) > 10 {
        lempar "list bisnis harus 1 sampai 10 seksi";
    }
    buat seen = peta_baru();
    buat jml_baris = 0;
    buat seksi_wire = "";
    untuk (buat i = 0; i < panjang(seksi); i = i + 1) {
        buat s = seksi[i];
        buat st = _biz_teks(s["title"]);
        buat baris = s["rows"];
        jika tipe(baris) != "larik" { baris = []; }
        jika !_biz_batas(st, 24) || panjang(baris) == 0
            || (panjang(seksi) > 1 && panjang(_biz_trim(st)) == 0) {
            lempar "seksi list bisnis gak valid: " + ke_teks(i);
        }
        jika panjang(baris) > 10 - jml_baris { lempar "list bisnis lebih dari 10 baris"; }
        jml_baris = jml_baris + panjang(baris);
        buat baris_wire = "";
        untuk (buat b = 0; b < panjang(baris); b = b + 1) {
            buat row = baris[b];
            buat rid = _biz_teks(row["id"]);
            buat rjudul = _biz_teks(row["title"]);
            buat rdesk = _biz_teks(row["description"]);
            jika panjang(_biz_trim(rid)) == 0 || !_biz_batas(rid, 200)
                || panjang(_biz_trim(rjudul)) == 0 || !_biz_batas(rjudul, 24) || !_biz_batas(rdesk, 72) {
                lempar "baris list bisnis gak valid " + ke_teks(b) + " di seksi " + ke_teks(i);
            }
            jika seen[rid] == benar { lempar "ID baris list bisnis dobel " + rid; }
            seen[rid] = benar;
            buat rw = PB.PbBytes(1, rjudul);
            jika panjang(rdesk) > 0 { rw = rw + PB.PbBytes(2, rdesk); }
            rw = rw + PB.PbBytes(3, rid);
            baris_wire = baris_wire + PB.PbBytes(2, rw);
        }
        buat sw = "";
        jika panjang(st) > 0 { sw = sw + PB.PbBytes(1, st); }
        sw = sw + baris_wire;
        seksi_wire = seksi_wire + PB.PbBytes(5, sw);
    }

    buat f = PB.PbBytes(1, judul) + PB.PbBytes(2, deskripsi) + PB.PbBytes(3, tombol)
        + PB.PbVarint(4, 1) + seksi_wire;
    jika panjang(footer) > 0 { f = f + PB.PbBytes(7, footer); }
    buat ci = MS.BangunContextInfo(params["kutip"]);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(8, ci); }
    hasil PB.PbBytes(36, f);
}

fungsi biz_bangun_pesan_tombol_native_flow(params) {
    jika tipe(params) != "peta" { lempar "parameter tombol native-flow bisnis kosong"; }
    buat body = _biz_teks(params["body"]);
    buat judul = _biz_teks(params["title"]);
    buat footer = _biz_teks(params["footer"]);
    jika panjang(_biz_trim(body)) == 0 || !_biz_batas(body, 1024)
        || !_biz_batas(judul, 60) || !_biz_batas(footer, 60) {
        lempar "teks native-flow bisnis gak valid";
    }
    buat tombol = params["buttons"];
    jika tipe(tombol) != "larik" || panjang(tombol) == 0 || panjang(tombol) > 3 {
        lempar "pesan native-flow bisnis harus punya 1 sampai 3 tombol";
    }
    buat tombol_wire = "";
    untuk (buat i = 0; i < panjang(tombol); i = i + 1) {
        buat b = tombol[i];
        buat nama = _biz_teks(b["name"]);
        buat pj = _biz_teks(b["params_json"]);
        jika panjang(_biz_trim(nama)) == 0 || !_biz_batas(nama, 64)
            || panjang(_biz_trim(pj)) == 0 || !_biz_batas(pj, 8192) {
            lempar "tombol native-flow bisnis gak valid " + ke_teks(i);
        }
        jika tipe(json_decode(pj)) != "peta" {
            lempar "params native-flow bisnis gak valid buat tombol " + ke_teks(i);
        }
        buat nf = PB.PbBytes(1, nama) + PB.PbBytes(2, pj);
        tombol_wire = tombol_wire + PB.PbBytes(9, PB.PbVarint(3, 2) + PB.PbBytes(4, nf));
    }

    buat f = "";
    buat header_type = 1;
    jika panjang(judul) > 0 {
        f = f + PB.PbBytes(1, judul);
        header_type = 2;
    }
    f = f + PB.PbBytes(6, body);
    jika panjang(footer) > 0 { f = f + PB.PbBytes(7, footer); }
    buat ci = MS.BangunContextInfo(params["kutip"]);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(8, ci); }
    f = f + tombol_wire + PB.PbVarint(10, header_type);
    hasil PB.PbBytes(42, f);
}

fungsi _biz_interaktif_native_flow(body, footer, nama, button_params, kutip) {
    buat nf = PB.PbBytes(1, PB.PbBytes(1, nama) + PB.PbBytes(2, button_params)) + PB.PbVarint(3, 1);
    buat f = PB.PbBytes(2, PB.PbBytes(1, body));
    jika panjang(footer) > 0 { f = f + PB.PbBytes(3, PB.PbBytes(1, footer)); }
    buat ci = MS.BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(15, ci); }
    f = f + PB.PbBytes(6, nf);
    hasil PB.PbBytes(45, f);
}

fungsi biz_bangun_pesan_alamat(params) {
    jika tipe(params) != "peta" { lempar "parameter pesan alamat bisnis kosong"; }
    buat body = _biz_teks(params["body"]);
    buat tombol = _biz_teks(params["button_text"]);
    buat footer = _biz_teks(params["footer"]);
    jika panjang(_biz_trim(body)) == 0 || !_biz_batas(body, 1024)
        || panjang(_biz_trim(tombol)) == 0 || !_biz_batas(tombol, 20) || !_biz_batas(footer, 60) {
        lempar "teks pesan alamat bisnis gak valid";
    }
    buat bp = peta_baru();
    bp["display_text"] = tombol;
    hasil _biz_interaktif_native_flow(body, footer, "address_message", json_encode(bp), params["kutip"]);
}

fungsi biz_bangun_pesan_flow(params) {
    jika tipe(params) != "peta" { lempar "parameter pesan flow bisnis kosong"; }
    buat body = _biz_teks(params["body"]);
    buat tombol = _biz_teks(params["button_text"]);
    buat footer = _biz_teks(params["footer"]);
    jika panjang(_biz_trim(body)) == 0 || !_biz_batas(body, 1024)
        || panjang(_biz_trim(tombol)) == 0 || !_biz_batas(tombol, 20) || !_biz_batas(footer, 60) {
        lempar "teks pesan flow bisnis gak valid";
    }
    buat flow_id = _biz_teks(params["flow_id"]);
    buat flow_token = _biz_teks(params["flow_token"]);
    jika panjang(_biz_trim(flow_id)) == 0 || !_biz_batas(flow_id, 256)
        || panjang(_biz_trim(flow_token)) == 0 || !_biz_batas(flow_token, 8192) {
        lempar "identitas flow bisnis gak valid";
    }
    buat aksi = _biz_teks(params["flow_action"]);
    jika aksi != "navigate" && aksi != "data_exchange" { lempar "aksi flow bisnis gak valid"; }
    buat layar = _biz_teks(params["screen"]);
    jika !_biz_batas(layar, 256) || (aksi == "navigate" && panjang(_biz_trim(layar)) == 0) {
        lempar "layar flow bisnis gak valid";
    }
    buat data_json = _biz_teks(params["data_json"]);
    jika aksi == "data_exchange" && (panjang(layar) > 0 || panjang(data_json) > 0) {
        lempar "flow data-exchange gak boleh bawa action payload";
    }
    jika !_biz_batas(data_json, 16384) { lempar "data flow bisnis kegedean"; }
    buat data_obj = kosong;
    jika panjang(data_json) > 0 {
        data_obj = json_decode(data_json);
        jika tipe(data_obj) != "peta" { lempar "data flow bisnis harus objek JSON"; }
    }

    buat bp = peta_baru();
    bp["flow_message_version"] = "3";
    bp["flow_token"] = flow_token;
    bp["flow_id"] = flow_id;
    bp["flow_cta"] = tombol;
    bp["flow_action"] = aksi;
    jika aksi == "navigate" {
        buat payload = peta_baru();
        jika panjang(layar) > 0 { payload["screen"] = layar; }
        jika tipe(data_obj) == "peta" { payload["data"] = data_obj; }
        bp["flow_action_payload"] = payload;
    }
    hasil _biz_interaktif_native_flow(body, footer, "galaxy_message", json_encode(bp), params["kutip"]);
}
