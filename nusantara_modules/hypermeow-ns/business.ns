    buat limit = p["limit"];
    jika tipe(limit) != "angka" || limit == 0 { limit = 50; }
    jika limit < 1 || limit > 100 { lempar "limit item koleksi harus antara 1 dan 100"; }
    buat d = _biz_dimensi(p["width"], p["height"]);

    buat req = peta_baru();
    req["biz_jid"] = JidTeks;
    req["id"] = collection_id;
    req["limit"] = ke_teks(limit);
    req["width"] = ke_teks(d[0]);
