}

fungsi biz_vars_daftar_produk(bisnis_jid, product_ids, lebar, tinggi) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    jika tipe(product_ids) != "larik" || panjang(product_ids) < 1 || panjang(product_ids) > 100 {
        lempar "daftar produk harus berisi 1 sampai 100 ID";
    }
    buat produk = [];
    untuk (buat i = 0; i < panjang(product_ids); i = i + 1) {
        _biz_validasi_id("produk", product_ids[i]);
        buat e = peta_baru(); e["id"] = product_ids[i];
        tambah(produk, e);
    }
    _biz_duplikat(product_ids, "ID produk");
    buat d = _biz_dimensi(lebar, tinggi);

    buat req = peta_baru();
    req["jid"] = JidTeks;
    req["products"] = produk;
    req["width"] = ke_teks(d[0]);
    req["height"] = ke_teks(d[1]);
    buat inner = peta_baru(); inner["product_list"] = req;
    buat outer = peta_baru(); outer["request"] = inner;
    hasil json_encode(outer);
}

