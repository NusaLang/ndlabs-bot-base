buat PB  = impor("proto/pb.ns");
buat MS  = impor("msgsend.ns");
buat JIDM = impor("types/jid.ns");
buat CP  = muat_plugin("crypto");

buat BIZ_SERVER      = "s.whatsapp.net";
buat BIZ_SERVER_LID  = "lid";

buat BIZ_ENDPOINT_KATALOG  = "https://graph.whatsapp.com/graphql/catalog";
buat BIZ_ENDPOINT_GRAPHQL  = "https://graph.facebook.com/graphql";
buat BIZ_TOKEN_KATALOG     = "WA|787118555984857|7bb1544a3599aa180ac9a3f7688ba243";

buat BIZ_Q_KATALOG            = "30445081048424116";
buat BIZ_Q_PRODUK_KATALOG     = "9660926520672123";
buat BIZ_Q_KOLEKSI            = "9430970660362540";
buat BIZ_Q_DAFTAR_PRODUK      = "30125049463760630";
buat BIZ_Q_KOLEKSI_TUNGGAL    = "9546992575408789";

buat BIZ_M_BUAT_KOLEKSI       = "29361942130088470";
buat BIZ_M_HAPUS_KOLEKSI      = "29970196299234260";
buat BIZ_M_UBAH_KOLEKSI       = "24486970300891371";
buat BIZ_M_URUT_KOLEKSI       = "9930298893688430";
buat BIZ_M_BUAT_KATALOG       = "29232780583035464";
buat BIZ_M_UBAH_COMMERCE      = "9797519763673469";
buat BIZ_M_VISIBILITAS_PRODUK = "9665162096898581";
buat BIZ_M_BANDING_PRODUK     = "29276343172013990";
buat BIZ_M_BANDING_KOLEKSI    = "9971242039605207";
buat BIZ_M_TAMBAH_PRODUK      = "24249359867999500";
buat BIZ_M_UBAH_PRODUK        = "9889773371084956";
buat BIZ_M_HAPUS_PRODUK       = "9376108569185474";
buat BIZ_Q_KEPATUHAN          = "25960403573553316";
buat BIZ_M_KEPATUHAN          = "25188352884120072";

buat BIZ_MAKS_ITEM_KOLEKSI    = 100;
buat BIZ_MAKS_PINDAH_KOLEKSI  = 100;
buat BIZ_MAKS_ALASAN_BANDING  = 4096;
buat BIZ_MAKS_GAMBAR_PRODUK   = 16777216;
buat BIZ_MAKS_COVER           = 5242880;
buat BIZ_MAKS_RESPONS_GRAPHQL = 4194304;

fungsi _biz_node(tag, attrs, children, content) {
    buat n = peta_baru();
    n["tag"] = tag;
    jika tipe(attrs) == "peta" { n["attrs"] = attrs; } lain { n["attrs"] = peta_baru(); }
    jika tipe(children) == "larik" { n["children"] = children; } lain { n["children"] = []; }
    jika tipe(content) == "teks" { n["content"] = content; n["ada_isi"] = benar; }
    lain jika panjang(n["children"]) > 0 { n["content"] = kosong; n["ada_isi"] = benar; }
    lain { n["content"] = kosong; n["ada_isi"] = salah; }
    hasil n;
}

fungsi _biz_jid(usr, srv) {
    buat j = peta_baru();
    j["jid"] = benar; j["user"] = usr; j["server"] = srv; j["device"] = 0; j["agent"] = 0;
    hasil j;
}

fungsi _biz_iq(req_id, xmlns, tipe_iq, smax_id, anak) {
    buat a = peta_baru();
    a["id"] = req_id;
    a["xmlns"] = xmlns;
    a["type"] = tipe_iq;
    a["to"] = _biz_jid("", BIZ_SERVER);
    jika tipe(smax_id) == "teks" && panjang(smax_id) > 0 { a["smax_id"] = smax_id; }
    hasil _biz_node("iq", a, anak, kosong);
}

fungsi _biz_anak(node, tag) {
    jika tipe(node) != "peta" || tipe(node["children"]) != "larik" { hasil kosong; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] == tag { hasil node["children"][i]; }
    }
    hasil kosong;
}

fungsi _biz_anak_semua(node, tag) {
    buat out = [];
    jika tipe(node) != "peta" || tipe(node["children"]) != "larik" { hasil out; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] == tag { tambah(out, node["children"][i]); }
    }
    hasil out;
}

fungsi _biz_teks_anak(node, tag) {
    buat c = _biz_anak(node, tag);
    jika tipe(c) != "peta" || tipe(c["content"]) != "teks" { hasil ""; }
    hasil c["content"];
}

fungsi _biz_trim(s) {
    jika tipe(s) != "teks" { hasil ""; }
    buat a = 0;
    buat b = panjang(s);
    selama (a < b) {
        buat c = byte_di(s, a);
        jika c != 32 && c != 9 && c != 10 && c != 13 { berhenti; }
        a = a + 1;
    }
    selama (b > a) {
        buat c = byte_di(s, b - 1);
        jika c != 32 && c != 9 && c != 10 && c != 13 { berhenti; }
        b = b - 1;
    }
    hasil potong(s, a, b);
}

fungsi _biz_teks(v) {
    jika tipe(v) != "teks" { hasil ""; }
    hasil v;
}

fungsi _biz_batas(v, maks) {
    hasil panjang(_biz_teks(v)) <= maks;
}

fungsi _biz_validasi_id(kind, id) {
    jika panjang(_biz_trim(id)) == 0 { lempar "ID " + kind + " kosong"; }
    jika panjang(id) > 256 { lempar "ID " + kind + " lebih dari 256 byte"; }
    hasil benar;
}

fungsi _biz_base64_url(s) {
    buat b = base64_encode(s);
    buat out = "";
    untuk (buat i = 0; i < panjang(b); i = i + 1) {
        buat c = potong(b, i, i + 1);
        jika c == "+" { out = out + "-"; }
        lain jika c == "/" { out = out + "_"; }
        lain { out = out + c; }
    }
    hasil out;
}

fungsi _biz_host(u) {
    jika tipe(u) != "teks" || panjang(u) < 9 { hasil ""; }
    jika potong(u, 0, 8) != "https://" { hasil ""; }
    buat i = 8;
    selama (i < panjang(u)) {
        buat c = byte_di(u, i);
        jika c == 47 || c == 63 || c == 35 { berhenti; }
        i = i + 1;
    }
    hasil huruf_kecil(potong(u, 8, i));
}

fungsi _biz_akhiran(s, suf) {
    jika panjang(suf) > panjang(s) { hasil salah; }
    hasil potong(s, panjang(s) - panjang(suf), panjang(s)) == suf;
}

fungsi _biz_validasi_url_media(u) {
    jika panjang(_biz_teks(u)) > 4096 { lempar "URL lebih dari 4096 byte"; }
    buat h = _biz_host(u);
    jika panjang(h) == 0 { lempar "URL harus HTTPS absolut"; }
    jika h == "whatsapp.net" || _biz_akhiran(h, ".whatsapp.net") { hasil benar; }
    jika h == "fbcdn.net" || _biz_akhiran(h, ".fbcdn.net") { hasil benar; }
    jika h == "facebook.com" || _biz_akhiran(h, ".facebook.com") { hasil benar; }
    lempar "URL harus pakai host media WhatsApp atau Meta";
}

fungsi _biz_mata_uang_valid(kode) {
    jika tipe(kode) != "teks" || panjang(kode) != 3 { hasil salah; }
    untuk (buat i = 0; i < 3; i = i + 1) {
        buat c = byte_di(kode, i);
        jika c < 65 || c > 90 { hasil salah; }
    }
    hasil benar;
}

fungsi _biz_desimal_valid(v) {
    jika tipe(v) != "teks" || panjang(v) == 0 || panjang(v) > 18 { hasil salah; }
    untuk (buat i = 0; i < panjang(v); i = i + 1) {
        buat c = byte_di(v, i);
        jika c < 48 || c > 57 { hasil salah; }
    }
    hasil benar;
}

fungsi _biz_dimensi(lebar, tinggi) {
    buat w = lebar;
    buat h = tinggi;
    jika tipe(w) != "angka" || w == 0 { w = 100; }
    jika tipe(h) != "angka" || h == 0 { h = 100; }
    jika w < 1 || w > 1024 || h < 1 || h > 1024 {
        lempar "dimensi gambar katalog harus antara 1 dan 1024";
    }
    hasil [w, h];
}

fungsi _biz_jid_teks(j) {
    jika tipe(j) == "teks" { hasil j; }
    jika tipe(j) != "peta" { hasil ""; }
    hasil JIDM.JidKeTeks(JIDM.JidToNonAd(j));
}

fungsi _biz_validasi_jid(j) {
    buat t = _biz_jid_teks(j);
    jika panjang(t) == 0 { lempar "JID bisnis kosong"; }
    buat at = 0;
    buat ada = salah;
    untuk (buat i = 0; i < panjang(t); i = i + 1) {
        jika byte_di(t, i) == 64 { at = i; ada = benar; }
    }
    jika !ada || at == 0 { lempar "JID bisnis kosong"; }
    buat srv = potong(t, at + 1, panjang(t));
    jika srv != BIZ_SERVER && srv != BIZ_SERVER_LID {
        lempar "JID bisnis harus JID user atau LID";
    }
    hasil t;
}

fungsi _biz_duplikat(list, label) {
    buat seen = peta_baru();
    untuk (buat i = 0; i < panjang(list); i = i + 1) {
        buat k = list[i];
        jika seen[k] == benar { lempar "duplikat " + label + " " + ke_teks(k); }
        seen[k] = benar;
    }
    hasil benar;
}

fungsi biz_sesi_katalog_baru() {
    buat h = CP["acak_bytes_hex"](16);
    buat varian = ["8", "9", "a", "b"];
    buat vi = byte_di(CP["hex_decode"](CP["acak_bytes_hex"](1)), 0) % 4;
    hasil potong(h, 0, 8) + "-" + potong(h, 8, 12) + "-4" + potong(h, 13, 16)
        + "-" + varian[vi] + potong(h, 17, 20) + "-" + potong(h, 20, 32);
}

fungsi _biz_validasi_order(order_id, token) {
    jika panjang(_biz_trim(order_id)) == 0 { lempar "ID order kosong"; }
    jika panjang(order_id) > 256 { lempar "ID order lebih dari 256 byte"; }
    jika panjang(_biz_trim(token)) == 0 { lempar "token order kosong"; }
    jika panjang(token) > 8192 { lempar "token order lebih dari 8192 byte"; }
    hasil benar;
}

fungsi biz_buat_node_detail_order(req_id, order_id, token_base64) {
    _biz_validasi_order(order_id, token_base64);
    buat dim = _biz_node("image_dimensions", peta_baru(), [
        _biz_node("width", peta_baru(), [], "100"),
        _biz_node("height", peta_baru(), [], "100")
    ], kosong);
    buat oa = peta_baru();
    oa["op"] = "get";
    oa["id"] = order_id;
    buat order = _biz_node("order", oa, [dim, _biz_node("token", peta_baru(), [], token_base64)], kosong);
    hasil _biz_iq(req_id, "fb:thrift_iq", "get", "5", [order]);
}

fungsi biz_urai_detail_order(resp_node) {
    buat r = peta_baru();
    r["ok"] = salah;
    r["id"] = "";
    r["dibuat"] = 0;
    r["catalog_id"] = "";
    r["harga"] = peta_baru();
    r["produk"] = [];

    buat order = _biz_anak(resp_node, "order");
    jika tipe(order) != "peta" { hasil r; }
    r["id"] = _biz_teks(order["attrs"]["id"]);
    jika tipe(order["attrs"]["creation_ts"]) == "teks" { r["dibuat"] = ke_angka(order["attrs"]["creation_ts"]); }

    buat harga_node = _biz_anak(order, "price");
    jika tipe(harga_node) == "peta" {
        buat h = peta_baru();
        h["subtotal"] = ke_angka(_biz_teks_anak(harga_node, "subtotal"));
        h["total"] = ke_angka(_biz_teks_anak(harga_node, "total"));
        h["currency"] = _biz_teks_anak(harga_node, "currency");
        h["price_status"] = _biz_teks_anak(harga_node, "price_status");
        r["harga"] = h;
    }
    buat katalog = _biz_anak(order, "catalog");
    jika tipe(katalog) == "peta" { r["catalog_id"] = _biz_teks_anak(katalog, "id"); }

    buat plist = _biz_anak_semua(order, "product");
    untuk (buat i = 0; i < panjang(plist); i = i + 1) {
        buat pn = plist[i];
        buat p = peta_baru();
        p["id"] = _biz_teks_anak(pn, "id");
        p["price"] = ke_angka(_biz_teks_anak(pn, "price"));
        p["currency"] = _biz_teks_anak(pn, "currency");
        p["name"] = _biz_teks_anak(pn, "name");
        p["quantity"] = ke_angka(_biz_teks_anak(pn, "quantity"));
        p["image_id"] = "";
        p["image_url"] = "";
        p["variant_properties"] = "";
        buat img = _biz_anak(pn, "image");
        jika tipe(img) == "peta" {
            p["image_id"] = _biz_teks_anak(img, "id");
            p["image_url"] = _biz_teks_anak(img, "url");
        }
        buat vr = _biz_anak(pn, "variant_info");
        jika tipe(vr) == "peta" { p["variant_properties"] = _biz_teks_anak(vr, "properties"); }
        tambah(r["produk"], p);
    }
    r["ok"] = benar;
    hasil r;
}

fungsi biz_fitur_kelayakan() {
    hasil ["meta_verified", "marketing_messages", "gen_ai", "gen_ai_image", "meta_one", "bb_pro"];
}

fungsi _biz_fitur_dikenal(f) {
    buat semua = biz_fitur_kelayakan();
    untuk (buat i = 0; i < panjang(semua); i = i + 1) {
        jika semua[i] == f { hasil benar; }
    }
    hasil salah;
}

fungsi biz_buat_node_akun_tertaut(req_id) {
    hasil _biz_iq(req_id, "fb:thrift_iq", "get", "42", [_biz_node("linked_accounts", peta_baru(), [], kosong)]);
}

fungsi biz_buat_node_kelayakan(req_id, fitur_list) {
    buat fs = fitur_list;
    jika tipe(fs) != "larik" || panjang(fs) == 0 { fs = biz_fitur_kelayakan(); }
    buat attrs = peta_baru();
    untuk (buat i = 0; i < panjang(fs); i = i + 1) {
        jika !_biz_fitur_dikenal(fs[i]) { lempar "fitur bisnis tidak dikenal: " + ke_teks(fs[i]); }
        jika attrs[fs[i]] == "true" { lempar "fitur bisnis dobel: " + ke_teks(fs[i]); }
        attrs[fs[i]] = "true";
    }
    hasil _biz_iq(req_id, "w:biz", "get", "139", [_biz_node("features", attrs, [], kosong)]);
}

fungsi _biz_status_iklan(node) {
    buat r = peta_baru();
    r["has_active_ctwa_ad"] = salah;
    r["has_created_ad"] = salah;
    buat s = _biz_anak(node, "ad_status");
    jika tipe(s) != "peta" { lempar "ad_status hilang di " + ke_teks(node["tag"]); }
    r["has_active_ctwa_ad"] = (s["attrs"]["has_active_ctwa_ad"] == "true");
    r["has_created_ad"] = (s["attrs"]["has_created_ad"] == "true");
    hasil r;
}

fungsi _biz_teks_wajib(node, tag, maks) {
    buat c = _biz_anak(node, tag);
    jika tipe(c) != "peta" { lempar tag + " hilang di " + ke_teks(node["tag"]); }
    jika tipe(c["content"]) != "teks" { lempar tag + " di " + ke_teks(node["tag"]) + " isinya bukan teks"; }
    jika panjang(c["content"]) == 0 { lempar tag + " kosong"; }
    jika panjang(c["content"]) > maks { lempar tag + " lebih dari " + ke_teks(maks) + " byte"; }
    hasil c["content"];
}

fungsi _biz_bool_wajib(node, tag) {
    buat v = _biz_teks_wajib(node, tag, 5);
    jika v == "true" || v == "1" { hasil benar; }
    jika v == "false" || v == "0" { hasil salah; }
    lempar "nilai " + tag + " tidak valid: " + v;
}

fungsi _biz_enum_attr(node, attr, diizinkan) {
    buat v = _biz_teks(node["attrs"][attr]);
    untuk (buat i = 0; i < panjang(diizinkan); i = i + 1) {
        jika v == diizinkan[i] { hasil v; }
    }
    lempar ke_teks(node["tag"]) + " " + attr + " tidak valid: " + v;
}

fungsi _biz_url_foto(node) {
    buat p = _biz_anak(node, "profile_picture");
    jika tipe(p) != "peta" { lempar "profile_picture hilang di " + ke_teks(node["tag"]); }
    hasil _biz_teks_wajib(p, "url", 4096);
}

fungsi _biz_urai_fb_page(node) {
    buat r = peta_baru();
    r["id"] = _biz_teks(node["attrs"]["id"]);
    jika panjang(r["id"]) == 0 || panjang(r["id"]) > 256 { lempar "ID Facebook Page tidak valid"; }
    r["display_name"] = _biz_teks_wajib(node, "display_name", 512);
    r["profile_picture_url"] = _biz_url_foto(node);
    r["show_on_profile"] = _biz_bool_wajib(node, "show_on_profile");
    r["profile_sync"] = "";
    buat sync = _biz_anak(node, "profile_sync");
    jika tipe(sync) == "peta" { r["profile_sync"] = _biz_enum_attr(sync, "state", ["disable", "import"]); }
    buat iklan = _biz_status_iklan(node);
    r["has_active_ctwa_ad"] = iklan["has_active_ctwa_ad"];
    r["has_created_ad"] = iklan["has_created_ad"];
    buat btn = _biz_anak(node, "whatsapp_as_page_button");
    jika tipe(btn) != "peta" { lempar "whatsapp_as_page_button hilang di Facebook Page"; }
    r["whatsapp_as_page_button"] = (_biz_enum_attr(btn, "state", ["off", "on"]) == "on");
    hasil r;
}

fungsi _biz_urai_fb_biz(node) {
    buat r = peta_baru();
    r["id"] = _biz_teks(node["attrs"]["id"]);
    jika panjang(r["id"]) == 0 || panjang(r["id"]) > 256 { lempar "ID bisnis Facebook tidak valid"; }
    r["display_name"] = _biz_teks_wajib(node, "display_name", 512);
    r["catalog_id"] = "";
    r["catalog_state"] = "";
    buat kat = _biz_anak(node, "catalog");
    jika tipe(kat) == "peta" {
        r["catalog_id"] = _biz_teks(kat["attrs"]["id"]);
        jika panjang(r["catalog_id"]) == 0 || panjang(r["catalog_id"]) > 256 { lempar "ID katalog tidak valid"; }
        r["catalog_state"] = _biz_enum_attr(kat, "state", ["disable", "import"]);
    }
    hasil r;
}

fungsi _biz_urai_ig(node) {
    buat r = peta_baru();
    r["handle"] = _biz_teks_wajib(node, "ig_handle", 512);
    r["display_name"] = _biz_teks_wajib(node, "display_name", 512);
    r["profile_picture_url"] = _biz_url_foto(node);
    r["show_on_profile"] = _biz_bool_wajib(node, "show_on_profile");
    hasil r;
}

fungsi _biz_urai_ad_identity(node) {
    buat r = peta_baru();
    r["id"] = _biz_teks(node["attrs"]["id"]);
    jika panjang(r["id"]) == 0 || panjang(r["id"]) > 256 { lempar "ID WhatsApp ad identity tidak valid"; }
    buat iklan = _biz_status_iklan(node);
    r["has_active_ctwa_ad"] = iklan["has_active_ctwa_ad"];
    r["has_created_ad"] = iklan["has_created_ad"];
    hasil r;
}

fungsi biz_urai_akun_tertaut(resp_node) {
    buat r = peta_baru();
    r["ok"] = salah;
    r["facebook_page"] = kosong;
    r["facebook_business"] = kosong;
    r["instagram"] = kosong;
    r["whatsapp_ad_identity"] = kosong;

    buat root = _biz_anak(resp_node, "linked_accounts");
    jika tipe(root) != "peta" { hasil r; }
    untuk (buat i = 0; i < panjang(root["children"]); i = i + 1) {
        buat n = root["children"][i];
        jika n["tag"] == "fb_page" { r["facebook_page"] = _biz_urai_fb_page(n); }
        lain jika n["tag"] == "fb_biz" { r["facebook_business"] = _biz_urai_fb_biz(n); }
        lain jika n["tag"] == "ig_professional" { r["instagram"] = _biz_urai_ig(n); }
        lain jika n["tag"] == "whatsapp_ad_identity" { r["whatsapp_ad_identity"] = _biz_urai_ad_identity(n); }
    }
    r["ok"] = benar;
    hasil r;
}

fungsi _biz_status_kelayakan_valid(fitur, status) {
    buat diizinkan = ["FAIL", "SUCCESS"];
    jika fitur == "marketing_messages" { diizinkan = ["FAIL", "PAUSED", "SUCCESS", "WARNING"]; }
    jika fitur == "bb_pro" { diizinkan = ["ELIGIBLE_TO_ONBOARD", "NOT_ELIGIBLE", "ONBOARDED"]; }
    untuk (buat i = 0; i < panjang(diizinkan); i = i + 1) {
        jika status == diizinkan[i] { hasil benar; }
    }
    lempar "status kelayakan " + fitur + " tidak valid: " + ke_teks(status);
}

fungsi biz_urai_kelayakan(resp_node) {
    buat r = peta_baru();
    r["ok"] = salah;
    r["fitur"] = [];
    jika tipe(resp_node) != "peta" || tipe(resp_node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(resp_node["children"]); i = i + 1) {
        buat n = resp_node["children"][i];
        jika !_biz_fitur_dikenal(n["tag"]) { lanjut; }
        buat e = peta_baru();
        e["fitur"] = n["tag"];
        e["status"] = _biz_teks(n["attrs"]["status"]);
        e["expiration"] = 0;
        jika tipe(n["attrs"]["expiration"]) == "teks" { e["expiration"] = ke_angka(n["attrs"]["expiration"]); }
        e["additional_params"] = _biz_teks(n["attrs"]["additional_params"]);
        e["show_privacy_interstitial"] = kosong;
        jika tipe(n["attrs"]["should_show_privacy_interstitial_to_new_users"]) == "teks" {
            e["show_privacy_interstitial"] = (n["attrs"]["should_show_privacy_interstitial_to_new_users"] == "true");
        }
        e["v1_enabled"] = kosong;
        jika tipe(n["attrs"]["v1_enabled"]) == "teks" { e["v1_enabled"] = (n["attrs"]["v1_enabled"] == "true"); }
        _biz_status_kelayakan_valid(e["fitur"], e["status"]);
        jika panjang(e["additional_params"]) > 16384 {
            lempar e["fitur"] + " additional_params lebih dari 16384 byte";
        }
        tambah(r["fitur"], e);
    }
    r["ok"] = benar;
    hasil r;
}

fungsi biz_buat_node_mex(req_id, query_id, variables_json) {
    buat qa = peta_baru(); qa["query_id"] = query_id;
    buat payload = "{\"variables\":" + variables_json + "}";
    hasil _biz_iq(req_id, "w:mex", "get", kosong, [_biz_node("query", qa, [], payload)]);
}

fungsi biz_urai_respons_mex(node) {
    buat r = peta_baru();
    r["ok"] = salah;
    r["data"] = "";
    jika tipe(node) != "peta" || tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] == "result" {
            r["ok"] = benar;
            r["data"] = node["children"][i]["content"];
            hasil r;
        }
    }
    hasil r;
}

fungsi biz_vars_katalog(bisnis_jid, params) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat p = params;
    jika tipe(p) != "peta" { p = peta_baru(); }
    buat after = _biz_teks(p["after"]);
    jika panjang(after) > 2048 { lempar "kursor katalog lebih dari 2048 byte"; }
    buat limit = p["limit"];
    jika tipe(limit) != "angka" || limit == 0 { limit = 50; }
    jika limit < 1 || limit > 100 { lempar "limit katalog harus antara 1 dan 100"; }
    buat d = _biz_dimensi(p["width"], p["height"]);

    buat req = peta_baru();
    req["jid"] = JidTeks;
    req["limit"] = ke_teks(limit);
    req["width"] = ke_teks(d[0]);
    req["height"] = ke_teks(d[1]);
    req["variant_thumbnail_width"] = ke_teks(d[0]);
    req["variant_thumbnail_height"] = ke_teks(d[1]);
    req["variant_info_fields"] = peta_baru();
    req["allow_shop_source"] = "ALLOWSHOPSOURCE_FALSE";
    jika panjang(after) > 0 { req["after"] = after; }

    buat inner = peta_baru(); inner["product_catalog"] = req;
    buat outer = peta_baru(); outer["request"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_produk_katalog(bisnis_jid, product_id, lebar, tinggi) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    _biz_validasi_id("produk", product_id);
    buat d = _biz_dimensi(lebar, tinggi);
    buat req = peta_baru();
    req["jid"] = JidTeks;
    req["product_id"] = product_id;
    req["width"] = ke_teks(d[0]);
    req["height"] = ke_teks(d[1]);
    req["variant_thumbnail_width"] = ke_teks(d[0]);
    req["variant_thumbnail_height"] = ke_teks(d[1]);
    req["variant_info_fields"] = peta_baru();
    req["fetch_compliance_info"] = "true";
    buat inner = peta_baru(); inner["product"] = req;
    buat outer = peta_baru(); outer["request"] = inner;
    hasil json_encode(outer);
}

fungsi biz_vars_koleksi(bisnis_jid, params) {
    buat JidTeks = _biz_validasi_jid(bisnis_jid);
    buat p = params;
    jika tipe(p) != "peta" { p = peta_baru(); }
    buat after = _biz_teks(p["after"]);
    jika panjang(after) > 2048 { lempar "kursor koleksi lebih dari 2048 byte"; }
    buat cl = p["collection_limit"];
    jika tipe(cl) != "angka" || cl == 0 { cl = 20; }
    jika cl < 1 || cl > 20 { lempar "limit koleksi harus antara 1 dan 20"; }
    buat il = p["item_limit"];
    jika tipe(il) != "angka" || il == 0 { il = 50; }
    jika il < 1 || il > 100 { lempar "limit item koleksi harus antara 1 dan 100"; }
    buat d = _biz_dimensi(p["width"], p["height"]);

    buat req = peta_baru();
    req["biz_jid"] = JidTeks;
    req["collection_limit"] = ke_teks(cl);
    req["item_limit"] = ke_teks(il);
    req["width"] = ke_teks(d[0]);
    req["height"] = ke_teks(d[1]);
    req["variant_thumbnail_width"] = ke_teks(d[0]);
    req["variant_thumbnail_height"] = ke_teks(d[1]);
    req["variant_info_fields"] = peta_baru();
    jika panjang(after) > 0 { req["after"] = after; }

    buat inner = peta_baru(); inner["collections"] = req;
    buat outer = peta_baru(); outer["request"] = inner;
    hasil json_encode(outer);
}

