    buat users = [];
    untuk (buat i = 0; i < panjang(user_list); i = i + 1) {
        buat u = user_list[i];
        buat ua = peta_baru(); ua["jid"] = _jid(u["user"], u["server"]);
        tambah(users, _node("user", ua, [], kosong));
    }
    buat qa = peta_baru(); qa["version"] = "2";
    buat q = [_node("devices", qa, [], kosong)];
