    buat ba = peta_baru(); ba["v"] = "2";
    buat a = peta_baru();
    a["id"] = req_id; a["to"] = _jid("", SERVER_USER); a["type"] = "get"; a["xmlns"] = "bot";
    hasil _node("iq", a, [_node("bot", ba, [], kosong)], kosong);
}

