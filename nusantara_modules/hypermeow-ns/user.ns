buat SERVER_USER = "s.whatsapp.net";

fungsi _jid(usr, srv) {
    buat j = peta_baru();
    j["jid"] = benar; j["user"] = usr; j["server"] = srv; j["device"] = 0; j["agent"] = 0;
    hasil j;
}

fungsi _node(tag, attrs, children, content) {
    buat n = peta_baru();
    n["tag"] = tag;
    jika tipe(attrs) == "peta" { n["attrs"] = attrs; } lain { n["attrs"] = peta_baru(); }
    jika tipe(children) == "larik" { n["children"] = children; } lain { n["children"] = []; }
    jika tipe(content) == "teks" { n["content"] = content; n["ada_isi"] = benar; }
    lain jika panjang(n["children"]) > 0 { n["content"] = kosong; n["ada_isi"] = benar; }
    lain { n["content"] = kosong; n["ada_isi"] = salah; }
    hasil n;
}

fungsi _iq(req_id, tujuan, tipe_iq, xmlns, anak) {
    buat a = peta_baru();
    a["id"] = req_id; a["to"] = tujuan; a["type"] = tipe_iq; a["xmlns"] = xmlns;
    hasil _node("iq", a, anak, kosong);
}

fungsi _usync(req_id, users_node, query_node, mode, konteks) {
    buat ua = peta_baru();
    ua["sid"] = req_id; ua["mode"] = mode; ua["last"] = "true"; ua["index"] = "0"; ua["context"] = konteks;
    buat isi = [_node("query", peta_baru(), query_node, kosong), _node("list", peta_baru(), users_node, kosong)];
    hasil _iq(req_id, _jid("", SERVER_USER), "get", "usync", [_node("usync", ua, isi, kosong)]);
}

fungsi buat_node_cek_nomor(req_id, nomor_list) {
    buat users = [];
    untuk (buat i = 0; i < panjang(nomor_list); i = i + 1) {
        buat n = nomor_list[i];
        jika potong(n, 0, 1) != "+" { n = "+" + n; }
        tambah(users, _node("user", peta_baru(), [_node("contact", peta_baru(), [], n)], kosong));
    }
    buat ca = peta_baru(); ca["addressing_mode"] = "lid";
    buat q = [
        _node("contact", ca, [], kosong),
        _node("business", peta_baru(), [_node("verified_name", peta_baru(), [], kosong)], kosong),
        _node("disappearing_mode", peta_baru(), [], kosong),
        _node("username", peta_baru(), [], kosong)
    ];
    hasil _usync(req_id, users, q, "query", "interactive");
}

fungsi buat_node_info_user(req_id, user_list) {
    buat users = [];
    untuk (buat i = 0; i < panjang(user_list); i = i + 1) {
        buat ua = peta_baru();
        ua["jid"] = _jid(user_list[i], SERVER_USER);
        tambah(users, _node("user", ua, [], kosong));
    }
    buat q = [
        _node("status", peta_baru(), [], kosong),
        _node("picture", peta_baru(), [], kosong),
        _node("devices", peta_baru(), [], kosong),
        _node("business", peta_baru(), [_node("verified_name", peta_baru(), [], kosong)], kosong)
    ];
    hasil _usync(req_id, users, q, "full", "interactive");
}

fungsi buat_node_dapatkan_foto_profil(req_id, target_user, target_server, preview) {
    buat pa = peta_baru();
    pa["query"] = "url";
    jika preview { pa["type"] = "preview"; } lain { pa["type"] = "image"; }
    hasil _iq(req_id, _jid(target_user, target_server), "get", "w:profile:picture", [_node("picture", pa, [], kosong)]);
}

fungsi buat_node_daftar_blokir(req_id) {
    hasil _iq(req_id, _jid("", SERVER_USER), "get", "blocklist", []);
}

fungsi buat_node_ubah_blokir(req_id, target_user, target_server, aksi) {
    jika aksi != "block" && aksi != "unblock" { lempar "aksi blokir harus block/unblock"; }
    buat ia = peta_baru();
    ia["action"] = aksi;
    ia["jid"] = _jid(target_user, target_server);
    hasil _iq(req_id, _jid("", SERVER_USER), "set", "blocklist", [_node("item", ia, [], kosong)]);
}

fungsi buat_node_set_status(req_id, teks_status) {
    hasil _iq(req_id, _jid("", SERVER_USER), "set", "status", [_node("status", peta_baru(), [], teks_status)]);
}

fungsi buat_node_pengaturan_privasi(req_id) {
    hasil _iq(req_id, _jid("", SERVER_USER), "get", "privacy", [_node("privacy", peta_baru(), [], kosong)]);
}

fungsi buat_node_set_privasi(req_id, nama, nilai) {
    buat ca = peta_baru(); ca["name"] = nama; ca["value"] = nilai;
    buat p = _node("privacy", peta_baru(), [_node("category", ca, [], kosong)], kosong);
    hasil _iq(req_id, _jid("", SERVER_USER), "set", "privacy", [p]);
}

fungsi urai_respons_cek_nomor(node) {
    buat r = peta_baru(); r["ok"] = salah; r["hasil"] = [];
    buat list_node = _cari_list_usync(node);
    jika tipe(list_node) != "peta" { hasil r; }
    untuk (buat i = 0; i < panjang(list_node["children"]); i = i + 1) {
        buat u = list_node["children"][i];
        jika u["tag"] != "user" { lanjut; }
        buat e = peta_baru();
        e["terdaftar"] = salah;
        e["nomor"] = "";
        e["jid"] = kosong;
        e["lid"] = kosong;
        untuk (buat c = 0; c < panjang(u["children"]); c = c + 1) {
            buat ch = u["children"][c];
            jika ch["tag"] == "contact" {
                jika ch["attrs"]["type"] == "in" { e["terdaftar"] = benar; }
                jika tipe(ch["content"]) == "teks" { e["nomor"] = ch["content"]; }
                jika tipe(ch["attrs"]["lid"]) == "peta" { e["lid"] = ch["attrs"]["lid"]; }
            }
        }
        jika tipe(u["attrs"]["jid"]) == "peta" { e["jid"] = u["attrs"]["jid"]; }
        tambah(r["hasil"], e);
    }
    r["ok"] = benar;
    hasil r;
}

fungsi _cari_list_usync(node) {
    jika tipe(node["children"]) != "larik" { hasil kosong; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat us = node["children"][i];
        jika us["tag"] != "usync" || tipe(us["children"]) != "larik" { lanjut; }
        untuk (buat j = 0; j < panjang(us["children"]); j = j + 1) {
            jika us["children"][j]["tag"] == "list" { hasil us["children"][j]; }
        }
    }
    hasil kosong;
}

fungsi urai_respons_info_user(node) {
    buat r = peta_baru(); r["ok"] = salah; r["user"] = [];
    buat list_node = _cari_list_usync(node);
    jika tipe(list_node) != "peta" { hasil r; }
    untuk (buat i = 0; i < panjang(list_node["children"]); i = i + 1) {
        buat u = list_node["children"][i];
        jika u["tag"] != "user" { lanjut; }
        buat e = peta_baru();
        e["jid"] = u["attrs"]["jid"];
        e["status"] = "";
        e["foto_id"] = "";
        e["nama_verified"] = "";
        e["device"] = [];
        untuk (buat c = 0; c < panjang(u["children"]); c = c + 1) {
            buat ch = u["children"][c];
            jika ch["tag"] == "status" && tipe(ch["content"]) == "teks" { e["status"] = ch["content"]; }
            jika ch["tag"] == "picture" && tipe(ch["attrs"]["id"]) == "teks" { e["foto_id"] = ch["attrs"]["id"]; }
            jika ch["tag"] == "devices" && tipe(ch["children"]) == "larik" {
                untuk (buat d = 0; d < panjang(ch["children"]); d = d + 1) {
                    buat dl = ch["children"][d];
                    jika dl["tag"] != "device-list" || tipe(dl["children"]) != "larik" { lanjut; }
                    untuk (buat d2 = 0; d2 < panjang(dl["children"]); d2 = d2 + 1) {
                        jika dl["children"][d2]["tag"] == "device" {
                            tambah(e["device"], dl["children"][d2]["attrs"]["id"]);
                        }
                    }
                }
            }
            jika ch["tag"] == "business" && tipe(ch["children"]) == "larik" {
                untuk (buat b = 0; b < panjang(ch["children"]); b = b + 1) {
                    jika ch["children"][b]["tag"] == "verified_name" && tipe(ch["children"][b]["content"]) == "teks" {
                        e["nama_verified"] = ch["children"][b]["content"];
                    }
                }
            }
        }
        tambah(r["user"], e);
    }
    r["ok"] = benar;
    hasil r;
}

fungsi urai_respons_foto_profil(node) {
    buat r = peta_baru(); r["ok"] = salah;
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat c = node["children"][i];
        jika c["tag"] == "picture" {
            r["ok"] = benar;
            r["url"] = c["attrs"]["url"];
            r["id"] = c["attrs"]["id"];
            r["tipe"] = c["attrs"]["type"];
            r["hash_langsung"] = c["attrs"]["direct_path"];
            hasil r;
        }
    }
    hasil r;
}

fungsi urai_respons_daftar_blokir(node) {
    buat r = peta_baru(); r["ok"] = salah; r["jid"] = [];
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat l = node["children"][i];
        jika l["tag"] != "list" || tipe(l["children"]) != "larik" { lanjut; }
        untuk (buat j = 0; j < panjang(l["children"]); j = j + 1) {
            jika l["children"][j]["tag"] == "item" {
                tambah(r["jid"], l["children"][j]["attrs"]["jid"]);
            }
        }
        r["ok"] = benar;
    }
    hasil r;
}

