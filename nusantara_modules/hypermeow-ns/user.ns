        buat isi = _node("bot", peta_baru(), [_node("profile", pa, [], kosong)], kosong);
        tambah(users, _node("user", ua, [isi], kosong));
    }
    hasil _usync(req_id, users, [], "query", "interactive");
}

fungsi buat_node_usync_username(req_id, username, key) {
    buat ca = peta_baru(); ca["username"] = username;
    jika tipe(key) == "teks" && panjang(key) > 0 { ca["pin"] = key; }
    buat users = [_node("user", peta_baru(), [_node("contact", ca, [], kosong)], kosong)];
    buat q = [
        _node("contact", peta_baru(), [], kosong),
        _node("business", peta_baru(), [_node("verified_name", peta_baru(), [], kosong)], kosong)
    ];
    hasil _usync(req_id, users, q, "query", "interactive");
}

fungsi urai_respons_daftar_bot(node) {
    buat r = peta_baru(); r["ok"] = salah; r["bot"] = [];
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] != "bot" { lanjut; }
        buat sections = node["children"][i]["children"];
        jika tipe(sections) != "larik" { lanjut; }
        untuk (buat s = 0; s < panjang(sections); s = s + 1) {
            jika sections[s]["tag"] != "section" || sections[s]["attrs"]["type"] != "all" { lanjut; }
            buat bots = sections[s]["children"];
            jika tipe(bots) != "larik" { lanjut; }
            untuk (buat b = 0; b < panjang(bots); b = b + 1) {
                jika bots[b]["tag"] != "bot" { lanjut; }
                buat e = peta_baru();
                e["persona_id"] = bots[b]["attrs"]["persona_id"];
                e["jid"] = bots[b]["attrs"]["jid"];
                tambah(r["bot"], e);
            }
        }
        r["ok"] = benar;
    }
    hasil r;
}

fungsi urai_respons_link_bisnis(node) {
    buat r = peta_baru(); r["ok"] = salah;
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat qr = node["children"][i];
        jika qr["tag"] != "qr" { lanjut; }
        r["ok"] = benar;
        r["jid"] = qr["attrs"]["jid"];
        r["nama_dorong"] = "";
        jika tipe(qr["attrs"]["notify"]) == "teks" { r["nama_dorong"] = qr["attrs"]["notify"]; }
        r["pesan"] = "";
        r["nama_verified"] = "";
        r["level_verified"] = "";
        r["ditandatangani"] = salah;
        jika tipe(qr["children"]) == "larik" {
            untuk (buat c = 0; c < panjang(qr["children"]); c = c + 1) {
                buat ch = qr["children"][c];
                jika ch["tag"] == "message" && tipe(ch["content"]) == "teks" { r["pesan"] = ch["content"]; }
                jika ch["tag"] == "business" {
                    jika tipe(ch["attrs"]["is_signed"]) == "teks" { r["ditandatangani"] = ch["attrs"]["is_signed"] == "true"; }
                    jika tipe(ch["attrs"]["verified_name"]) == "teks" { r["nama_verified"] = ch["attrs"]["verified_name"]; }
                    jika tipe(ch["attrs"]["verified_level"]) == "teks" { r["level_verified"] = ch["attrs"]["verified_level"]; }
                }
            }
        }
        hasil r;
    }
    hasil r;
}

fungsi urai_respons_link_kontak(node) {
    buat r = peta_baru(); r["ok"] = salah;
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat qr = node["children"][i];
        jika qr["tag"] != "qr" { lanjut; }
        r["ok"] = benar;
        r["jid"] = qr["attrs"]["jid"];
        r["nama_dorong"] = "";
        jika tipe(qr["attrs"]["notify"]) == "teks" { r["nama_dorong"] = qr["attrs"]["notify"]; }
        r["tipe"] = "";
        jika tipe(qr["attrs"]["type"]) == "teks" { r["tipe"] = qr["attrs"]["type"]; }
        hasil r;
    }
    hasil r;
}

fungsi urai_respons_link_qr_kontak(node) {
    buat r = peta_baru(); r["ok"] = salah; r["kode"] = "";
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        buat qr = node["children"][i];
        jika qr["tag"] != "qr" { lanjut; }
        jika tipe(qr["attrs"]["code"]) == "teks" {
            r["ok"] = benar;
            r["kode"] = qr["attrs"]["code"];
            hasil r;
        }
    }
    hasil r;
}

fungsi urai_respons_privasi(node) {
    buat r = peta_baru(); r["ok"] = salah; r["pengaturan"] = peta_baru();
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] != "privacy" { lanjut; }
        buat kats = node["children"][i]["children"];
        jika tipe(kats) != "larik" { lanjut; }
        untuk (buat c = 0; c < panjang(kats); c = c + 1) {
            jika kats[c]["tag"] != "category" { lanjut; }
            jika tipe(kats[c]["attrs"]["name"]) == "teks" {
                r["pengaturan"][kats[c]["attrs"]["name"]] = kats[c]["attrs"]["value"];
            }
        }
        r["ok"] = benar;
    }
    hasil r;
}

fungsi urai_respons_profil_bisnis(node) {
    buat r = peta_baru(); r["ok"] = salah;
    jika tipe(node["children"]) != "larik" { hasil r; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] != "business_profile" { lanjut; }
        buat prof = kosong;
        untuk (buat c = 0; c < panjang(node["children"][i]["children"]); c = c + 1) {
            jika node["children"][i]["children"][c]["tag"] == "profile" { prof = node["children"][i]["children"][c]; }
        }
        jika tipe(prof) != "peta" { lanjut; }
        r["ok"] = benar;
        r["jid"] = prof["attrs"]["jid"];
        r["alamat"] = ""; r["email"] = ""; r["deskripsi"] = ""; r["website"] = []; r["kategori"] = [];
        r["id_sampul"] = ""; r["zona_waktu"] = ""; r["jam_operasional"] = [];
        untuk (buat p = 0; p < panjang(prof["children"]); p = p + 1) {
            buat pc = prof["children"][p];
            jika pc["tag"] == "address" && tipe(pc["content"]) == "teks" { r["alamat"] = pc["content"]; }
            jika pc["tag"] == "email" && tipe(pc["content"]) == "teks" { r["email"] = pc["content"]; }
            jika pc["tag"] == "description" && tipe(pc["content"]) == "teks" { r["deskripsi"] = pc["content"]; }
            jika pc["tag"] == "website" && tipe(pc["content"]) == "teks" { tambah(r["website"], pc["content"]); }
            jika pc["tag"] == "cover_photo" { r["id_sampul"] = pc["attrs"]["id"]; }
            jika pc["tag"] == "business_hours" {
                r["zona_waktu"] = pc["attrs"]["timezone"];
                untuk (buat bh = 0; bh < panjang(pc["children"]); bh = bh + 1) {
                    jika pc["children"][bh]["tag"] != "business_hours_config" { lanjut; }
                    buat bha = pc["children"][bh]["attrs"];
                    buat jam = peta_baru();
                    jam["hari"] = bha["day_of_week"]; jam["mode"] = bha["mode"];
                    jam["buka"] = bha["open_time"]; jam["tutup"] = bha["close_time"];
                    tambah(r["jam_operasional"], jam);
                }
            }
            jika pc["tag"] == "categories" && tipe(pc["children"]) == "larik" {
                untuk (buat kt = 0; kt < panjang(pc["children"]); kt = kt + 1) {
                    jika pc["children"][kt]["tag"] != "category" { lanjut; }
                    buat kat = peta_baru();
                    kat["id"] = pc["children"][kt]["attrs"]["id"];
                    kat["nama"] = "";
                    jika tipe(pc["children"][kt]["content"]) == "teks" { kat["nama"] = pc["children"][kt]["content"]; }
                    tambah(r["kategori"], kat);
                }
            }
        }
        hasil r;
    }
    hasil r;
}

fungsi urai_respons_profil_bot(node) {
    buat r = peta_baru(); r["ok"] = salah; r["profil"] = [];
    buat list_node = _cari_list_usync(node);
    jika tipe(list_node) != "peta" { hasil r; }
    untuk (buat i = 0; i < panjang(list_node["children"]); i = i + 1) {
        buat u = list_node["children"][i];
        jika u["tag"] != "user" { lanjut; }
        buat bot = kosong;
        untuk (buat c = 0; c < panjang(u["children"]); c = c + 1) {
            jika u["children"][c]["tag"] == "bot" { bot = u["children"][c]; }
        }
        jika tipe(bot) != "peta" { lanjut; }
        buat profile = kosong;
        untuk (buat c2 = 0; c2 < panjang(bot["children"]); c2 = c2 + 1) {
            jika bot["children"][c2]["tag"] == "profile" { profile = bot["children"][c2]; }
        }
        jika tipe(profile) != "peta" { lanjut; }
        buat e = peta_baru();
        e["jid"] = u["attrs"]["jid"];
        e["persona_id"] = profile["attrs"]["persona_id"];
        e["nama"] = ""; e["atribut"] = ""; e["deskripsi"] = ""; e["kategori"] = "";
        e["prompt"] = []; e["perintah"] = []; e["deskripsi_perintah"] = ""; e["default"] = salah;
        untuk (buat p = 0; p < panjang(profile["children"]); p = p + 1) {
            buat pc = profile["children"][p];
            jika pc["tag"] == "name" && tipe(pc["content"]) == "teks" { e["nama"] = pc["content"]; }
            jika pc["tag"] == "attributes" && tipe(pc["content"]) == "teks" { e["atribut"] = pc["content"]; }
            jika pc["tag"] == "description" && tipe(pc["content"]) == "teks" { e["deskripsi"] = pc["content"]; }
            jika pc["tag"] == "category" && tipe(pc["content"]) == "teks" { e["kategori"] = pc["content"]; }
            jika pc["tag"] == "default" { e["default"] = benar; }
            jika pc["tag"] == "commands" && tipe(pc["children"]) == "larik" {
                untuk (buat cc = 0; cc < panjang(pc["children"]); cc = cc + 1) {
                    jika pc["children"][cc]["tag"] == "description" && tipe(pc["children"][cc]["content"]) == "teks" {
                        e["deskripsi_perintah"] = pc["children"][cc]["content"];
                    }
                    jika pc["children"][cc]["tag"] == "command" {
                        buat cmd = peta_baru(); cmd["nama"] = ""; cmd["deskripsi"] = "";
                        untuk (buat cd = 0; cd < panjang(pc["children"][cc]["children"]); cd = cd + 1) {
                            buat cdn = pc["children"][cc]["children"][cd];
                            jika cdn["tag"] == "name" && tipe(cdn["content"]) == "teks" { cmd["nama"] = cdn["content"]; }
                            jika cdn["tag"] == "description" && tipe(cdn["content"]) == "teks" { cmd["deskripsi"] = cdn["content"]; }
                        }
                        tambah(e["perintah"], cmd);
                    }
                }
            }
            jika pc["tag"] == "prompts" && tipe(pc["children"]) == "larik" {
                untuk (buat pp = 0; pp < panjang(pc["children"]); pp = pp + 1) {
                    jika pc["children"][pp]["tag"] != "prompt" { lanjut; }
                    buat emoji = ""; buat teks_prompt = "";
                    untuk (buat pd = 0; pd < panjang(pc["children"][pp]["children"]); pd = pd + 1) {
                        buat pdn = pc["children"][pp]["children"][pd];
                        jika pdn["tag"] == "emoji" && tipe(pdn["content"]) == "teks" { emoji = pdn["content"]; }
                        jika pdn["tag"] == "text" && tipe(pdn["content"]) == "teks" { teks_prompt = pdn["content"]; }
                    }
                    tambah(e["prompt"], emoji + " " + teks_prompt);
                }
            }
        }
        tambah(r["profil"], e);
    }
    r["ok"] = benar;
    hasil r;
}

fungsi urai_respons_usync_devices(node) {
    buat r = peta_baru(); r["ok"] = salah; r["device"] = [];
    buat list_node = _cari_list_usync(node);
    jika tipe(list_node) != "peta" { hasil r; }
    untuk (buat i = 0; i < panjang(list_node["children"]); i = i + 1) {
        buat u = list_node["children"][i];
        jika u["tag"] != "user" || tipe(u["attrs"]["jid"]) != "peta" { lanjut; }
        buat basis = u["attrs"]["jid"];
        untuk (buat c = 0; c < panjang(u["children"]); c = c + 1) {
            jika u["children"][c]["tag"] != "devices" { lanjut; }
            buat dl_wrap = u["children"][c]["children"];
            jika tipe(dl_wrap) != "larik" { lanjut; }
            untuk (buat d = 0; d < panjang(dl_wrap); d = d + 1) {
                jika dl_wrap[d]["tag"] != "device-list" || tipe(dl_wrap[d]["children"]) != "larik" { lanjut; }
                untuk (buat d2 = 0; d2 < panjang(dl_wrap[d]["children"]); d2 = d2 + 1) {
                    buat dv = dl_wrap[d]["children"][d2];
                    jika dv["tag"] != "device" { lanjut; }
                    buat dev_id = 0;
                    jika tipe(dv["attrs"]["id"]) == "teks" {
                        coba { dev_id = ke_angka(dv["attrs"]["id"]); } tangkap (err) {}
                    }
                    buat e = peta_baru();
                    e["user"] = basis["user"]; e["server"] = basis["server"]; e["device"] = dev_id;
                    e["is_hosted"] = (dv["attrs"]["is_hosted"] == "true");
                    tambah(r["device"], e);
                }
            }
        }
    }
    r["ok"] = benar;
    hasil r;
}

fungsi urai_respons_usync_username(node) {
    buat r = peta_baru(); r["ok"] = salah; r["butuh_kunci"] = salah;
    buat list_node = _cari_list_usync(node);
    jika tipe(list_node) != "peta" || panjang(list_node["children"]) != 1 { hasil r; }
    buat u = list_node["children"][0];
    jika u["tag"] != "user" { hasil r; }
    buat contact = kosong;
    untuk (buat c = 0; c < panjang(u["children"]); c = c + 1) {
        jika u["children"][c]["tag"] == "contact" { contact = u["children"][c]; }
    }
    jika tipe(contact) != "peta" { hasil r; }
    jika contact["attrs"]["type"] == "out" { hasil r; }
    jika tipe(u["attrs"]["jid"]) != "peta" {
        r["ok"] = benar;
        r["butuh_kunci"] = benar;
        hasil r;
    }
    r["ok"] = benar;
    r["lid"] = u["attrs"]["jid"];
    r["username"] = "";
    jika tipe(contact["attrs"]["username"]) == "teks" { r["username"] = contact["attrs"]["username"]; }
    hasil r;
}
