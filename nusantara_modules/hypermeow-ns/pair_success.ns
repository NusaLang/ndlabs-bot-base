
buat ADV = impor("proto/adv.ns");
buat EN  = impor("binary/codec_encode.ns");
buat D   = impor("binary/codec_decode.ns");
buat JID = impor("types/jid.ns");
buat CP  = muat_plugin("crypto");

fungsi _generate_device_signature(details, identity_priv, identity_pub, account_sig_key) {

    buat prefix = CP["hex_decode"]("0601");
    buat msg = prefix + details + identity_pub + account_sig_key;
    buat res = jalankan_perintah("nusantara_modules/hypermeow-ns/tools/sign_identity", [CP["hex_encode"](identity_priv), CP["hex_encode"](msg)]);
    jika res["status"] != 0 { lempar "sign_identity gagal: " + res["error"]; }
    buat sig_hex = potong(res["keluaran"], 0, 128);
    hasil CP["hex_decode"](sig_hex);
}

fungsi VerifikasiDanJawabPairSuccess(pair_node, adv_secret_key, identity_kp) {
    buat req_id = pair_node["attrs"]["id"];
    buat pair_success = pair_node["children"][0];

    buat device_identity_bin = "";
    buat business_name = "";
    buat platform = "";
    buat jid = "";
    buat lid = "";

    untuk (buat i = 0; i < panjang(pair_success["children"]); i = i + 1) {
        buat ch = pair_success["children"][i];
        jika ch["tag"] == "device-identity" { device_identity_bin = ch["content"]; }
        jika ch["tag"] == "biz" { business_name = ch["attrs"]["name"]; }
        jika ch["tag"] == "platform" { platform = ch["attrs"]["name"]; }
        jika ch["tag"] == "device" {
            jid = ch["attrs"]["jid"];
            lid = ch["attrs"]["lid"];
        }
    }

    buat container = ADV.DekodeSignedDeviceIdentityHmac(device_identity_bin);

    buat calc_hmac_hex = CP["hex_decode"](potong(hmac_sha256_hex(adv_secret_key, container["details"]), 0, 64));
    jika calc_hmac_hex != container["hmac"] {
        cetak("PERINGATAN: HMAC mismatch pada pair-success, tetap memproses...");
    }

    buat signed_identity = ADV.DekodeSignedDeviceIdentity(container["details"]);

    buat details = ADV.DekodeDeviceIdentity(signed_identity["details"]);

    buat dev_sig = _generate_device_signature(signed_identity["details"], identity_kp["priv"], identity_kp["pub"], signed_identity["account_signature_key"]);

    buat self_signed_bin = ADV.EnkodeSignedDeviceIdentity(
        signed_identity["details"],
        "",
        signed_identity["account_signature"],
        dev_sig
    );

    buat dev_ident_attrs = peta_baru();
    dev_ident_attrs["key-index"] = details["key_index"];

    buat dev_ident_node = peta_baru();
    dev_ident_node["tag"] = "device-identity";
    dev_ident_node["attrs"] = dev_ident_attrs;
    dev_ident_node["children"] = [];
    dev_ident_node["content"] = self_signed_bin;
    dev_ident_node["ada_isi"] = benar;

    buat sign_node = peta_baru();
    sign_node["tag"] = "pair-device-sign";
    sign_node["attrs"] = peta_baru();
    sign_node["children"] = [dev_ident_node];
    sign_node["content"] = "";
    sign_node["ada_isi"] = benar;

    buat resp_attrs = peta_baru();
    resp_attrs["to"] = JID.JidBaru("", "s.whatsapp.net");
    resp_attrs["type"] = "result";
    resp_attrs["id"] = req_id;

    buat resp_iq_node = peta_baru();
    resp_iq_node["tag"] = "iq";
    resp_iq_node["attrs"] = resp_attrs;
    resp_iq_node["children"] = [sign_node];
    resp_iq_node["content"] = "";
    resp_iq_node["ada_isi"] = benar;

    buat res = peta_baru();
    res["reply_node"] = resp_iq_node;
    res["jid"] = jid;
    res["lid"] = lid;
    res["platform"] = platform;
    res["business_name"] = business_name;
    res["key_index"] = details["key_index"];
    res["account_hex"] = CP["hex_encode"](self_signed_bin);

    hasil res;
}
