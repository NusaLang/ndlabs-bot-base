
buat GCM = impor("../util/gcm.ns");
buat HKDF = impor("../util/hkdf.ns");
buat CP = muat_plugin("crypto");

fungsi _sha256bin(data) { hasil CP["hex_decode"](potong(sha256_hex(data), 0, 64)); }

fungsi GenIv(count) {
    buat c3 = count % 256;      buat s1 = (count - c3) / 256;
    buat c2 = s1 % 256;         buat s2 = (s1 - c2) / 256;
    buat c1 = s2 % 256;         buat s3 = (s2 - c1) / 256;
    buat c0 = s3 % 256;
    buat z8 = "";
    untuk (buat i = 0; i < 8; i = i + 1) { z8 = z8 + teks_dari(0); }
    hasil z8 + teks_dari(c0) + teks_dari(c1) + teks_dari(c2) + teks_dari(c3);
}

fungsi baru() {
    buat nh = peta_baru();
    nh["hash"] = ""; nh["salt"] = ""; nh["key"] = ""; nh["counter"] = 0;
    hasil nh;
}

fungsi mulai(nh, pattern, header) {
    jika panjang(pattern) == 32 { nh["hash"] = pattern; } lain { nh["hash"] = _sha256bin(pattern); }
    nh["salt"] = nh["hash"];
    nh["key"] = nh["hash"];
    autentikasi(nh, header);
}

fungsi autentikasi(nh, data) {
    nh["hash"] = _sha256bin(nh["hash"] + data);
}

fungsi _naik_counter(nh) {
    buat c = nh["counter"];
    nh["counter"] = (c + 1) % 4294967296;
    hasil c;
}

fungsi enkripsi(nh, plaintext) {
    buat ct = GCM.GcmEnkripsi(nh["key"], GenIv(_naik_counter(nh)), plaintext, nh["hash"]);
    buat out = ct["ct"] + ct["tag"];
    autentikasi(nh, out);
    hasil out;
}

fungsi dekripsi(nh, ciphertext) {
    jika panjang(ciphertext) < 16 { lempar "ciphertext noise terlalu pendek"; }
    buat ct = potong(ciphertext, 0, panjang(ciphertext) - 16);
    buat tag = potong(ciphertext, panjang(ciphertext) - 16, panjang(ciphertext));
    buat pt = GCM.GcmDekripsi(nh["key"], GenIv(_naik_counter(nh)), ct, nh["hash"], tag);
    autentikasi(nh, ciphertext);
    hasil pt;
}

fungsi MixSharedSecretIntoKey(nh, priv, pub) {
    buat CPX = muat_plugin("crypto");
    buat secret_hex = CPX["x25519"](CPX["hex_encode"](priv), CPX["hex_encode"](pub));
    mix_into_key(nh, CPX["hex_decode"](secret_hex));
}

fungsi mix_into_key(nh, data) {
    nh["counter"] = 0;
    buat kr = extract_and_expand(nh["salt"], data);
    nh["salt"] = kr["write"];
    nh["key"] = kr["read"];
}

fungsi extract_and_expand(salt, data) {
    buat prk_hex = HKDF.HkdfExtract(salt, data);
    buat okm = HKDF.HkdfExpand(prk_hex, "", 64);
    buat r = peta_baru();
    r["write"] = potong(okm, 0, 32);
    r["read"] = potong(okm, 32, 64);
    hasil r;
}

fungsi selesai(nh) {
    buat kr = extract_and_expand(nh["salt"], "");
    buat ns = peta_baru();
    ns["write_key"] = kr["write"];
    ns["read_key"] = kr["read"];
    ns["wc"] = 0; ns["rc"] = 0;
    hasil ns;
}
