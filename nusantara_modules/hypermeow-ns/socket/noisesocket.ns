
buat GCM = impor("../util/gcm.ns");
buat _CPG = muat_plugin("crypto");
buat _PAKAI_GCM_NATIVE = (tipe(_CPG["gcm_enkripsi"]) == "fungsi");

fungsi _idx_pipa(s) {
    untuk (buat i = 0; i < panjang(s); i = i + 1) { jika potong(s, i, i + 1) == "|" { hasil i; } }
    hasil -1;
}

fungsi gcm_enkripsi_cepat(key, iv, plaintext, aad) {
    jika !_PAKAI_GCM_NATIVE { hasil GCM.GcmEnkripsi(key, iv, plaintext, aad); }
    buat r = _CPG["gcm_enkripsi"](_CPG["hex_encode"](key), _CPG["hex_encode"](iv), _CPG["hex_encode"](plaintext), aad);
    buat idx = _idx_pipa(r);
    buat out = peta_baru();
    out["ct"] = _CPG["hex_decode"](potong(r, 0, idx));
    out["tag"] = _CPG["hex_decode"](potong(r, idx + 1, panjang(r)));
    hasil out;
}

fungsi gcm_dekripsi_cepat(key, iv, ciphertext, aad, tag) {
    jika !_PAKAI_GCM_NATIVE { hasil GCM.GcmDekripsi(key, iv, ciphertext, aad, tag); }
    buat r = _CPG["gcm_dekripsi"](_CPG["hex_encode"](key), _CPG["hex_encode"](iv), _CPG["hex_encode"](ciphertext), aad, _CPG["hex_encode"](tag));
    jika tipe(r) != "teks" { lempar "autentikasi GCM gagal"; }
    hasil _CPG["hex_decode"](r);
}
buat NH = impor("noisehandshake.ns");
buat FS = impor("framesocket.ns");
buat WSP = muat_plugin("ws");

buat kunci_kirim = kanal_baru(1);
kanal_kirim(kunci_kirim, 1);

fungsi KirimAman(ws_id, ns, plaintext) {
    kanal_terima(kunci_kirim);
    buat err = kosong;
    buat r = kosong;
    coba {
        r = json_decode(WSP["ws_kirim"](ws_id, FS.FrameBungkus(KirimFrame(ns, plaintext)), 2));
    } tangkap (e) {
        err = ke_teks(e);
    }
    kanal_kirim(kunci_kirim, 1);
    jika err != kosong { lempar err; }
    jika tipe(r) != "peta" || r["ok"] != benar { lempar "ws_kirim gagal: " + ke_teks(r); }
    hasil benar;
}

fungsi KirimFrame(ns, plaintext) {
    buat iv = NH.GenIv(ns["wc"]);
    ns["wc"] = (ns["wc"] + 1) % 4294967296;
    buat ct = gcm_enkripsi_cepat(ns["write_key"], iv, plaintext, "");
    hasil ct["ct"] + ct["tag"];
}

fungsi TerimaFrame(ns, ciphertext) {
    jika panjang(ciphertext) < 16 { lempar "frame noise terlalu pendek"; }
    buat ct = potong(ciphertext, 0, panjang(ciphertext) - 16);
    buat tag = potong(ciphertext, panjang(ciphertext) - 16, panjang(ciphertext));
    buat iv = NH.GenIv(ns["rc"]);
    ns["rc"] = (ns["rc"] + 1) % 4294967296;
    hasil gcm_dekripsi_cepat(ns["read_key"], iv, ct, "", tag);
}
