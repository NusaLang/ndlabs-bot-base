
buat SCK = impor("socket/noisehandshake.ns");
buat FS  = impor("socket/framesocket.ns");
buat CST = impor("socket/constants.ns");
buat KEYS = impor("util/keys.ns");
buat PHS = impor("proto/handshake.ns");
buat CPL = impor("proto/client_payload.ns");
buat CP  = muat_plugin("crypto");

fungsi _urai_jid(session_jid) {
    buat hasil_peta = peta_baru();
    buat sebelum_at = session_jid;
    untuk (buat i = 0; i < panjang(session_jid); i = i + 1) {
        jika session_jid[i] == "@" {
            sebelum_at = potong(session_jid, 0, i);
            berhenti;
        }
    }
    buat user_num = sebelum_at;
    buat device_num = "0";
    untuk (buat i = 0; i < panjang(sebelum_at); i = i + 1) {
        jika sebelum_at[i] == ":" {
            user_num = potong(sebelum_at, 0, i);
            device_num = potong(sebelum_at, i + 1, panjang(sebelum_at));
            berhenti;
        }
    }
    hasil_peta["user"] = ke_angka(user_num);
    hasil_peta["device"] = ke_angka(device_num);
    hasil hasil_peta;
}

fungsi LakukanHandshake(io, noise_kp, identity_kp, session_jid, fixed_reg_id, nama_device) {
    jika tipe(identity_kp) != "peta" {
        identity_kp = KEYS.KeypairBaru();
    }

    buat nh = SCK.baru();
    SCK.mulai(nh, CST.NOISE_START_PATTERN, CST.WaConnHeader());

    buat ephemeral = KEYS.KeypairBaru();
    SCK.autentikasi(nh, ephemeral["pub"]);

    buat pb_client_hello = PHS.EnkodeClientHello(ephemeral["pub"]);
    io["kirim"](CST.WaConnHeader() + FS.FrameBungkus(pb_client_hello));

    buat resp = io["terima"]();
    buat sh = PHS.DekodeServerHello(resp);

    buat server_eph = sh["ephemeral"];
    buat server_static_ct = sh["static"];
    buat cert_ct = sh["payload"];

    jika panjang(server_eph) != 32 {
        jika panjang(resp) >= 32 {
            server_eph = potong(resp, 0, 32);
            server_static_ct = potong(resp, 32, panjang(resp));
        } lain {
            lempar "respons server hello terlalu pendek";
        }
    }

    SCK.autentikasi(nh, server_eph);
    SCK.MixSharedSecretIntoKey(nh, ephemeral["priv"], server_eph);

    buat static_pt = SCK.dekripsi(nh, server_static_ct);
    jika panjang(static_pt) != 32 { lempar "panjang static plaintext tak terduga"; }
    SCK.MixSharedSecretIntoKey(nh, ephemeral["priv"], static_pt);

    jika panjang(cert_ct) > 0 {
        SCK.dekripsi(nh, cert_ct);
    }

    buat enc_pubkey = SCK.enkripsi(nh, noise_kp["pub"]);
    SCK.MixSharedSecretIntoKey(nh, noise_kp["priv"], server_eph);

    buat raw_client_payload = kosong;
    jika tipe(session_jid) == "teks" && panjang(session_jid) > 0 {
        buat jid_info = _urai_jid(session_jid);
        cetak("[HANDSHAKE] Pakai LOGIN payload (device udah di-pairing), user=" + ke_teks(jid_info["user"]) + " device=" + ke_teks(jid_info["device"]));
        raw_client_payload = CPL.EnkodeLoginClientPayload(jid_info["user"], jid_info["device"], nama_device);
    } lain {
        buat identity_pub = identity_kp["pub"];

        buat signed_prekey_pub = identity_kp["signed_prekey_pub"];
        buat signed_prekey_sig = identity_kp["signed_prekey_sig"];
        jika tipe(signed_prekey_pub) != "teks" || tipe(signed_prekey_sig) != "teks" {
            cetak("[HANDSHAKE] WARN: signed_prekey gak disediain caller, pake hardcoded LAMA (KEMUNGKINAN BESAR MISMATCH sama identity_kp random -- bisa gagal pairing).");
            signed_prekey_pub = CP["hex_decode"]("63aca651996b5bf56a654493b4a0cb9be68b3dacab3d46a8cb9dc269f828a03f");
            signed_prekey_sig = CP["hex_decode"]("14472f7daa13fce1a9228761c22ea70d924ba359761fb36120ef9e01dd28df794f530b3e1b3b0bdf9635df8e7697077723bb83d2227880525bb91e6932636a86");
        }

        buat reg_id = 0;
        jika tipe(fixed_reg_id) == "angka" && fixed_reg_id > 0 {
            reg_id = fixed_reg_id;
            cetak("[HANDSHAKE] Pakai REGISTRATION payload (reconnect pairing), regId tetap=" + ke_teks(reg_id));
        } lain {
            buat reg_id_hex = CP["acak_bytes_hex"](4);
            reg_id = byte_di(CP["hex_decode"](reg_id_hex), 0) * 16777216
                + byte_di(CP["hex_decode"](reg_id_hex), 1) * 65536
                + byte_di(CP["hex_decode"](reg_id_hex), 2) * 256
                + byte_di(CP["hex_decode"](reg_id_hex), 3);
            cetak("[HANDSHAKE] Pakai REGISTRATION payload (pairing baru), regId acak=" + ke_teks(reg_id));
        }
        raw_client_payload = CPL.EnkodeRegistrationClientPayload(reg_id, identity_pub, 1, signed_prekey_pub, signed_prekey_sig, nama_device);
    }

    buat enc_client_payload = SCK.enkripsi(nh, raw_client_payload);

    buat pb_client_finish = PHS.EnkodeClientFinish(enc_pubkey, enc_client_payload);

    cetak("[DEBUG] ClientFinish length: " + ke_teks(panjang(pb_client_finish)));
    cetak("[DEBUG] ClientFinish hex (first 100): " + CP["hex_encode"](potong(pb_client_finish, 0, 100)));

    io["kirim"](FS.FrameBungkus(pb_client_finish));

    hasil SCK.selesai(nh);
}
