}

fungsi AmbilMaxPrekeyId() {
    jika handle_db == 0 { hasil 0; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT MAX(key_id) AS m FROM prekeys_privat;"));
    jika res["ok"] && panjang(res["rows"]) > 0 && tipe(res["rows"][0]["m"]) == "angka" {
        hasil res["rows"][0]["m"];
    }
    hasil 0;
}

