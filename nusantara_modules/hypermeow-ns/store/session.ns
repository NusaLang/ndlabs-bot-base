fungsi SimpanMsgSecret(chat, sender, msg_id, secret_hex) {
    jika handle_db == 0 { hasil salah; }
    buat q = "INSERT OR REPLACE INTO msg_secrets (chat, sender, msg_id, secret) VALUES ('" + chat + "', '" + sender + "', '" + msg_id + "', '" + secret_hex + "');";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi CariMsgSecret(chat, sender, msg_id) {
    jika handle_db == 0 { hasil kosong; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT secret, sender FROM msg_secrets WHERE chat='" + chat + "' AND msg_id='" + msg_id + "' AND sender='" + sender + "';"));
    jika res["ok"] && panjang(res["rows"]) > 0 { hasil res["rows"][0]; }
    buat res2 = json_decode(SQL["db_query"](handle_db, "SELECT secret, sender FROM msg_secrets WHERE chat='" + chat + "' AND msg_id='" + msg_id + "';"));
    jika res2["ok"] && panjang(res2["rows"]) > 0 { hasil res2["rows"][0]; }
    hasil kosong;
}

