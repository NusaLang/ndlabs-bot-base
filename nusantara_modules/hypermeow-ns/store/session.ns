fungsi CariSesiKirim(DeviceKey) {
    jika handle_db == 0 { hasil kosong; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT our_identity_pub, their_identity_pub, our_ratchet_priv, our_ratchet_pub, sending_chain_key, chain_index, base_pub, their_spk_id, otp_id, acked FROM send_sessions WHERE device_key='" + DeviceKey + "';"));
    jika res["ok"] && panjang(res["rows"]) > 0 {
        hasil res["rows"][0];
    }
    hasil kosong;
}

fungsi MuatSemuaSesiKirim() {
    jika handle_db == 0 { hasil peta_baru(); }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT device_key, our_identity_pub, their_identity_pub, our_ratchet_priv, our_ratchet_pub, sending_chain_key, chain_index, base_pub, their_spk_id, otp_id, acked FROM send_sessions;"));
    buat out = peta_baru();
    jika res["ok"] {
        untuk (buat i = 0; i < panjang(res["rows"]); i = i + 1) {
            buat row = res["rows"][i];
            out[row["device_key"]] = row;
        }
    }
    hasil out;
}

fungsi SimpanSesiKirim(DeviceKey, our_identity_pub_hex, their_identity_pub_hex, our_ratchet_priv_hex, our_ratchet_pub_hex, sending_chain_key_hex, chain_index, base_pub_hex, their_spk_id, otp_id) {
    jika handle_db == 0 { hasil salah; }
    buat otp_sql = "NULL";
    jika tipe(otp_id) == "angka" { otp_sql = ke_teks(otp_id); }
    buat q = "INSERT OR REPLACE INTO send_sessions (device_key, our_identity_pub, their_identity_pub, our_ratchet_priv, our_ratchet_pub, sending_chain_key, chain_index, base_pub, their_spk_id, otp_id, acked) VALUES ('" + DeviceKey + "', '" + our_identity_pub_hex + "', '" + their_identity_pub_hex + "', '" + our_ratchet_priv_hex + "', '" + our_ratchet_pub_hex + "', '" + sending_chain_key_hex + "', " + ke_teks(chain_index) + ", '" + base_pub_hex + "', " + ke_teks(their_spk_id) + ", " + otp_sql + ", 0);";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

