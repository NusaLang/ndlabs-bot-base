
buat SQL = muat_plugin("sqlite");
buat handle_db = 0;

fungsi InisialisasiStore(db_path) {
    handle_db = SQL["db_buka"](db_path);
    jika handle_db != 0 {
        SQL["db_jalankan"](handle_db, "PRAGMA journal_mode=WAL;");
        SQL["db_jalankan"](handle_db, "PRAGMA synchronous=NORMAL;");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS session (id TEXT PRIMARY KEY, noise_priv TEXT, identity_priv TEXT, jid TEXT, lid TEXT, adv_secret TEXT, registration_id TEXT, account_hex TEXT);");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS sender_keys (id TEXT PRIMARY KEY, key_id INTEGER, iteration INTEGER, chain_key TEXT, signing_pub TEXT);");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS sender_key_skipped (id TEXT, iteration INTEGER, seed_hex TEXT, PRIMARY KEY(id, iteration));");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS sender_keys_out (group_user TEXT PRIMARY KEY, key_id INTEGER, iteration INTEGER, chain_key TEXT, signing_priv TEXT, signing_pub TEXT);");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS send_sessions (device_key TEXT PRIMARY KEY, our_identity_pub TEXT, their_identity_pub TEXT, our_ratchet_priv TEXT, our_ratchet_pub TEXT, sending_chain_key TEXT, chain_index INTEGER);");
        SQL["db_jalankan"](handle_db, "ALTER TABLE send_sessions ADD COLUMN base_pub TEXT;");
        SQL["db_jalankan"](handle_db, "ALTER TABLE send_sessions ADD COLUMN their_spk_id INTEGER;");
        SQL["db_jalankan"](handle_db, "ALTER TABLE send_sessions ADD COLUMN otp_id INTEGER;");
        SQL["db_jalankan"](handle_db, "ALTER TABLE send_sessions ADD COLUMN acked INTEGER DEFAULT 0;");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS group_devices (group_user TEXT, device_user TEXT, device_server TEXT, device_num INTEGER, PRIMARY KEY(group_user, device_user, device_num));");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS user_devices (lid_user TEXT PRIMARY KEY, devices_json TEXT);");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS msg_secrets (chat TEXT, sender TEXT, msg_id TEXT, secret TEXT, PRIMARY KEY(chat, sender, msg_id));");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS appstate_keys (key_id TEXT PRIMARY KEY, key_data TEXT);");
        SQL["db_jalankan"](handle_db, "CREATE TABLE IF NOT EXISTS appstate_version (name TEXT PRIMARY KEY, version INTEGER, hash TEXT);");
        hasil benar;
    }
    hasil salah;
}

fungsi MulaiTransaksi() {
    jika handle_db != 0 { SQL["db_jalankan"](handle_db, "BEGIN TRANSACTION;"); }
}

fungsi SelesaiTransaksi() {
    jika handle_db != 0 { SQL["db_jalankan"](handle_db, "COMMIT;"); }
}

fungsi BatalTransaksi() {
    jika handle_db != 0 { SQL["db_jalankan"](handle_db, "ROLLBACK;"); }
}

fungsi SimpanSesi(session_id, noise_priv_hex, identity_priv_hex, jid, lid, adv_secret_hex) {
    jika handle_db == 0 { hasil salah; }
    buat q = "INSERT INTO session (id, noise_priv, identity_priv, jid, lid, adv_secret) VALUES ('" + session_id + "', '" + noise_priv_hex + "', '" + identity_priv_hex + "', '" + jid + "', '" + lid + "', '" + adv_secret_hex + "') ON CONFLICT(id) DO UPDATE SET noise_priv='" + noise_priv_hex + "', identity_priv='" + identity_priv_hex + "', jid='" + jid + "', lid='" + lid + "', adv_secret='" + adv_secret_hex + "';";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi SimpanPrekeyInfo(session_id, signed_prekey_priv_hex, signed_prekey_id_str, registration_id_str, account_hex) {
    jika handle_db == 0 { hasil salah; }
    buat q = "UPDATE session SET signed_prekey_priv='" + signed_prekey_priv_hex + "', signed_prekey_id='" + signed_prekey_id_str + "', registration_id='" + registration_id_str + "', account_hex='" + account_hex + "' WHERE id='" + session_id + "';";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi MuatSesi(session_id) {
    jika handle_db == 0 { hasil peta_baru(); }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT noise_priv, identity_priv, jid, lid, adv_secret, registration_id, account_hex, signed_prekey_priv, signed_prekey_id FROM session WHERE id='" + session_id + "';"));
    jika res["ok"] && panjang(res["rows"]) > 0 {
        hasil res["rows"][0];
    }
    hasil peta_baru();
}

fungsi CariPrekeyPrivat(key_id) {
    jika handle_db == 0 { hasil kosong; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT priv FROM prekeys_privat WHERE key_id=" + ke_teks(key_id) + ";"));
    jika res["ok"] && panjang(res["rows"]) > 0 {
        hasil res["rows"][0]["priv"];
    }
    hasil kosong;
}

fungsi SimpanPrekeyPrivat(key_id, priv_hex) {
    jika handle_db == 0 { hasil salah; }
    buat q = "INSERT OR REPLACE INTO prekeys_privat (key_id, priv) VALUES (" + ke_teks(key_id) + ", '" + priv_hex + "');";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
