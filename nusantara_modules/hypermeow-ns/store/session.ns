fungsi SimpanGroupDevices(group_user, devices) {
    jika handle_db == 0 { hasil salah; }
    SQL["db_jalankan"](handle_db, "DELETE FROM group_devices WHERE group_user='" + group_user + "';");
    untuk (buat i = 0; i < panjang(devices); i = i + 1) {
        buat d = devices[i];
        buat q = "INSERT OR IGNORE INTO group_devices (group_user, device_user, device_server, device_num) VALUES ('" + group_user + "', '" + d["user"] + "', '" + d["server"] + "', " + ke_teks(d["device"]) + ");";
        SQL["db_jalankan"](handle_db, q);
    }
    hasil benar;
}

fungsi HapusGroupUserDevices(group_user, target_user) {
    jika handle_db == 0 { hasil salah; }
    buat res = json_decode(SQL["db_jalankan"](handle_db, "DELETE FROM group_devices WHERE group_user='" + group_user + "' AND device_user='" + target_user + "';"));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi HapusGroupDevices(group_user) {
