fungsi HapusSemuaGroupDevices() {
    jika handle_db == 0 { hasil salah; }
    buat res = json_decode(SQL["db_jalankan"](handle_db, "DELETE FROM group_devices;"));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi CariGroupDevices(group_user) {
    jika handle_db == 0 { hasil []; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT device_user, device_server, device_num FROM group_devices WHERE group_user='" + group_user + "';"));
    buat out = [];
    jika res["ok"] {
        untuk (buat i = 0; i < panjang(res["rows"]); i = i + 1) {
            buat row = res["rows"][i];
            buat d = peta_baru();
            d["user"] = row["device_user"]; d["server"] = row["device_server"]; d["device"] = row["device_num"];
            tambah(out, d);
        }
    }
    hasil out;
}

// Cache device list per-PARTICIPANT (bukan per-grup) -- niru GetUserDevices
// whatsmeow asli: sekali dapet device list user X, dipake lagi di grup
// manapun X ada, dan cuma di-invalidate kalau ada notifikasi "devices"
// dari X sendiri (device baru/dicabut), bukan pas ada member lain
// keluar-masuk grup.
fungsi CariUserDevices(lid_user) {
    jika handle_db == 0 { hasil []; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT devices_json FROM user_devices WHERE lid_user='" + lid_user + "';"));
    jika res["ok"] && panjang(res["rows"]) > 0 {
        buat parsed = json_decode(res["rows"][0]["devices_json"]);
        jika tipe(parsed) == "larik" { hasil parsed; }
    }
    hasil [];
}

fungsi SimpanUserDevices(lid_user, devices) {
    jika handle_db == 0 { hasil salah; }
    buat q = "INSERT INTO user_devices (lid_user, devices_json) VALUES (?, ?) ON CONFLICT(lid_user) DO UPDATE SET devices_json=excluded.devices_json;";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q, json_encode([lid_user, json_encode(devices)])));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi HapusUserDevices(lid_user) {
    jika handle_db == 0 { hasil salah; }
    buat res = json_decode(SQL["db_jalankan"](handle_db, "DELETE FROM user_devices WHERE lid_user='" + lid_user + "';"));
    jika res["ok"] { hasil benar; }
    hasil salah;
}
