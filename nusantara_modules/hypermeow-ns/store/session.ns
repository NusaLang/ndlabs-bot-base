// Sender-key ratchet cuma bisa maju (HMAC one-way) -- kalau pesan out-of-
// order bikin state lompat maju ngelewatin beberapa iterasi, message-key
// buat iterasi yang dilewatin disimpen di sini dulu (sekali pakai, di-
// hapus begitu dipakai) supaya pesan yang telat masih bisa didekripsi
// tanpa perlu mundurin ratchet (yang emang gak mungkin secara kriptografi).
fungsi SimpanSkippedKey(id, iteration, seed_hex) {
    jika handle_db == 0 { hasil salah; }
    buat q = "INSERT INTO sender_key_skipped (id, iteration, seed_hex) VALUES ('" + id + "', " + ke_teks(iteration) + ", '" + seed_hex + "') ON CONFLICT(id, iteration) DO UPDATE SET seed_hex='" + seed_hex + "';";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

fungsi AmbilSkippedKey(id, iteration) {
    jika handle_db == 0 { hasil kosong; }
    buat res = json_decode(SQL["db_query"](handle_db, "SELECT seed_hex FROM sender_key_skipped WHERE id='" + id + "' AND iteration=" + ke_teks(iteration) + ";"));
    jika res["ok"] && panjang(res["rows"]) > 0 { hasil res["rows"][0]["seed_hex"]; }
    hasil kosong;
}

fungsi HapusSkippedKey(id, iteration) {
    jika handle_db == 0 { hasil salah; }
    buat res = json_decode(SQL["db_jalankan"](handle_db, "DELETE FROM sender_key_skipped WHERE id='" + id + "' AND iteration=" + ke_teks(iteration) + ";"));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

// Batesin jumlah skipped-key per sender-key id (paling lama dibuang duluan)
// biar tabel gak numpuk gak abis-abis kalau ada sender yang terus-terusan
// out-of-order.
fungsi PruneSkippedKeys(id, maks_simpan) {
    jika handle_db == 0 { hasil salah; }
    buat q = "DELETE FROM sender_key_skipped WHERE id='" + id + "' AND iteration NOT IN (SELECT iteration FROM sender_key_skipped WHERE id='" + id + "' ORDER BY iteration DESC LIMIT " + ke_teks(maks_simpan) + ");";
    buat res = json_decode(SQL["db_jalankan"](handle_db, q));
    jika res["ok"] { hasil benar; }
    hasil salah;
}

