
buat MUTED_FOREVER = 253402300799;

fungsi baru_app_state_sync_key() {
    buat m = peta_baru();
    m["data"] = ""; m["fingerprint"] = ""; m["timestamp"] = 0;
    hasil m;
}

fungsi baru_app_state_mutation_mac() {
    buat m = peta_baru();
    m["index_mac"] = ""; m["value_mac"] = "";
    hasil m;
}

fungsi baru_contact_entry() {
    buat m = peta_baru();
    m["jid"] = kosong; m["first_name"] = ""; m["full_name"] = ""; m["username"] = ""; m["username_set"] = salah;
    hasil m;
}

fungsi baru_redacted_phone_entry() {
    buat m = peta_baru();
    m["jid"] = kosong; m["redacted_phone"] = "";
    hasil m;
}

fungsi baru_contact_username_entry() {
    buat m = peta_baru();
    m["jid"] = kosong; m["username"] = "";
    hasil m;
}

fungsi baru_message_secret_insert() {
    buat m = peta_baru();
    m["chat"] = kosong; m["sender"] = kosong; m["id"] = ""; m["secret"] = "";
    hasil m;
}

fungsi baru_privacy_token() {
    buat m = peta_baru();
    m["user"] = kosong; m["token"] = ""; m["timestamp"] = 0; m["sender_timestamp"] = 0;
    hasil m;
}

fungsi baru_buffered_event() {
    buat m = peta_baru();
    m["plaintext"] = ""; m["insert_time"] = 0; m["server_time"] = 0;
    hasil m;
}

fungsi baru_lid_mapping() {
    buat m = peta_baru();
    m["lid"] = kosong; m["pn"] = kosong;
    hasil m;
}

fungsi baru_device() {
    buat m = peta_baru();
    m["noise_key"] = kosong; m["identity_key"] = kosong; m["signed_prekey"] = kosong;
    m["registration_id"] = 0; m["adv_secret_key"] = "";
    m["id"] = kosong; m["lid"] = kosong;
    m["account"] = kosong; m["platform"] = ""; m["business_name"] = ""; m["push_name"] = "";
    m["lid_migration_timestamp"] = 0; m["companion_meta_nonce"] = "";
    m["initialized"] = salah; m["deleted"] = salah;
    hasil m;
}

fungsi device_jid_teks(dev) {
    jika dev["id"] == kosong { hasil ""; }
    buat JID = impor("../types/jid.ns");
    hasil JID.JidKeTeks(dev["id"]);
}

fungsi alt_jid_arah(jid_server) {
    buat JID = impor("../types/jid.ns");
    jika jid_server == JID.SRV_DEF { hasil "pn_ke_lid"; }
    jika jid_server == JID.SRV_LID { hasil "lid_ke_pn"; }
    hasil "";
}
