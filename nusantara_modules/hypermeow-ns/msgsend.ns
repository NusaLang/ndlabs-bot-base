
buat KEYS = impor("util/keys.ns");
buat HKDF = impor("util/hkdf.ns");
buat PB   = impor("proto/pb.ns");
buat ST   = impor("store/session.ns");
buat CP   = muat_plugin("crypto");

fungsi _cari_anak(node, tag) {
    jika tipe(node["children"]) != "larik" { hasil kosong; }
    untuk (buat i = 0; i < panjang(node["children"]); i = i + 1) {
        jika node["children"][i]["tag"] == tag { hasil node["children"][i]; }
    }
    hasil kosong;
}

fungsi _jid_peta(usr, srv, dev) {
    buat j = peta_baru();
    j["jid"] = benar;
    j["user"] = usr;
    j["server"] = srv;
    j["device"] = dev;
    j["agent"] = 0;
    hasil j;
}

fungsi BuatIqUsync(req_id, target_user) {
    buat n_devices = peta_baru();
    n_devices["tag"] = "devices";
    n_devices["attrs"] = peta_baru();
    n_devices["attrs"]["version"] = "2";
    n_devices["children"] = [];
    n_devices["content"] = kosong;
    n_devices["ada_isi"] = salah;

    buat n_query = peta_baru();
    n_query["tag"] = "query";
    n_query["attrs"] = peta_baru();
    n_query["children"] = [n_devices];
    n_query["content"] = kosong;
    n_query["ada_isi"] = benar;

    buat n_target = peta_baru();
    n_target["tag"] = "user";
    n_target["attrs"] = peta_baru();
    n_target["attrs"]["jid"] = _jid_peta(target_user, "s.whatsapp.net", 0);
    n_target["children"] = [];
    n_target["content"] = kosong;
    n_target["ada_isi"] = salah;

    buat n_list = peta_baru();
    n_list["tag"] = "list";
    n_list["attrs"] = peta_baru();
    n_list["children"] = [n_target];
    n_list["content"] = kosong;
    n_list["ada_isi"] = benar;

    buat n_usync = peta_baru();
    n_usync["tag"] = "usync";
    n_usync["attrs"] = peta_baru();
    n_usync["attrs"]["sid"] = req_id;

    n_usync["attrs"]["mode"] = "query";
    n_usync["attrs"]["last"] = "true";
    n_usync["attrs"]["index"] = "0";
    n_usync["attrs"]["context"] = "message";
    n_usync["children"] = [n_query, n_list];
    n_usync["content"] = kosong;
    n_usync["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id;
    iq_attrs["to"] = _jid_peta("", "s.whatsapp.net", 0);
    iq_attrs["type"] = "get";
    iq_attrs["xmlns"] = "usync";

    buat iq = peta_baru();
    iq["tag"] = "iq";
    iq["attrs"] = iq_attrs;
    iq["children"] = [n_usync];
    iq["content"] = kosong;
    iq["ada_isi"] = benar;
    hasil iq;
}

fungsi BuatIqUsyncBanyak(req_id, target_lid_users) {
    buat n_devices = peta_baru();
    n_devices["tag"] = "devices"; n_devices["attrs"] = peta_baru(); n_devices["attrs"]["version"] = "2";
    n_devices["children"] = []; n_devices["content"] = kosong; n_devices["ada_isi"] = salah;

    buat n_query = peta_baru();
    n_query["tag"] = "query"; n_query["attrs"] = peta_baru();
    n_query["children"] = [n_devices]; n_query["content"] = kosong; n_query["ada_isi"] = benar;

    buat anak_user = [];
    untuk (buat i = 0; i < panjang(target_lid_users); i = i + 1) {
        buat n_target = peta_baru();
        n_target["tag"] = "user"; n_target["attrs"] = peta_baru();
        n_target["attrs"]["jid"] = _jid_peta(target_lid_users[i], "lid", 0);
        n_target["children"] = []; n_target["content"] = kosong; n_target["ada_isi"] = salah;
        tambah(anak_user, n_target);
    }
    buat n_list = peta_baru();
    n_list["tag"] = "list"; n_list["attrs"] = peta_baru();
    n_list["children"] = anak_user; n_list["content"] = kosong; n_list["ada_isi"] = benar;

    buat n_usync = peta_baru();
    n_usync["tag"] = "usync"; n_usync["attrs"] = peta_baru();
    n_usync["attrs"]["sid"] = req_id; n_usync["attrs"]["mode"] = "query"; n_usync["attrs"]["last"] = "true";
    n_usync["attrs"]["index"] = "0"; n_usync["attrs"]["context"] = "message";
    n_usync["children"] = [n_query, n_list]; n_usync["content"] = kosong; n_usync["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id; iq_attrs["to"] = _jid_peta("", "s.whatsapp.net", 0);
    iq_attrs["type"] = "get"; iq_attrs["xmlns"] = "usync";

    buat iq = peta_baru();
    iq["tag"] = "iq"; iq["attrs"] = iq_attrs; iq["children"] = [n_usync]; iq["content"] = kosong; iq["ada_isi"] = benar;
    hasil iq;
}

fungsi BuatIqGroupInfo(req_id, group_user) {
    buat n_query = peta_baru();
    n_query["tag"] = "query"; n_query["attrs"] = peta_baru();
    n_query["attrs"]["request"] = "interactive";
    n_query["children"] = []; n_query["content"] = kosong; n_query["ada_isi"] = salah;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id; iq_attrs["to"] = _jid_peta(group_user, "g.us", 0);
    iq_attrs["type"] = "get"; iq_attrs["xmlns"] = "w:g2";

    buat iq = peta_baru();
    iq["tag"] = "iq"; iq["attrs"] = iq_attrs; iq["children"] = [n_query]; iq["content"] = kosong; iq["ada_isi"] = benar;
    hasil iq;
}

fungsi UraiResponsGroupInfo(resp_node) {
    buat hasil_peta = peta_baru();
    hasil_peta["ok"] = salah;
    hasil_peta["participants"] = [];

    buat n_group = _cari_anak(resp_node, "group");
    jika tipe(n_group) != "peta" { hasil hasil_peta; }

    untuk (buat i = 0; i < panjang(n_group["children"]); i = i + 1) {
        buat n_p = n_group["children"][i];
        jika n_p["tag"] != "participant" { lanjut; }
        buat jid_val = _urai_jid_val(n_p["attrs"]["jid"]);

        buat lid_user = kosong;
        buat pn_user = kosong;
        jika jid_val["server"] == "lid" {
            lid_user = jid_val["user"];
            jika tipe(n_p["attrs"]["phone_number"]) == "peta" { pn_user = n_p["attrs"]["phone_number"]["user"]; }
        } lain {
            pn_user = jid_val["user"];
            jika tipe(n_p["attrs"]["lid"]) == "peta" { lid_user = n_p["attrs"]["lid"]["user"]; }
        }

        jika tipe(lid_user) == "teks" && panjang(lid_user) > 0 {
            buat tp = n_p["attrs"]["type"];
            buat entri = peta_baru();
            entri["lid_user"] = lid_user;
            entri["pn_user"] = pn_user;
            entri["server"] = jid_val["server"];
            entri["admin"] = (tp == "admin" || tp == "superadmin");
            entri["super_admin"] = (tp == "superadmin");
            tambah(hasil_peta["participants"], entri);
        }
    }
    hasil_peta["ok"] = benar;
    hasil hasil_peta;
}

fungsi _urai_jid_val(jid_val) {
    buat hasil_peta = peta_baru();
    jika tipe(jid_val) == "peta" {
        hasil_peta["user"] = jid_val["user"];
        hasil_peta["server"] = jid_val["server"];
        hasil_peta["device"] = 0;
        jika tipe(jid_val["device"]) == "angka" { hasil_peta["device"] = jid_val["device"]; }
        hasil hasil_peta;
    }

    buat at_idx = -1;
    untuk (buat i = 0; i < panjang(jid_val); i = i + 1) {
        jika jid_val[i] == "@" { at_idx = i; berhenti; }
    }
    buat sebelum_at = jid_val;
    buat srv = "s.whatsapp.net";
    jika at_idx >= 0 {
        sebelum_at = potong(jid_val, 0, at_idx);
        srv = potong(jid_val, at_idx + 1, panjang(jid_val));
    }
    buat colon_idx = -1;
    untuk (buat i = 0; i < panjang(sebelum_at); i = i + 1) {
        jika sebelum_at[i] == ":" { colon_idx = i; berhenti; }
    }
    jika colon_idx >= 0 {
        hasil_peta["user"] = potong(sebelum_at, 0, colon_idx);
        hasil_peta["device"] = ke_angka(potong(sebelum_at, colon_idx + 1, panjang(sebelum_at)));
    } lain {
        hasil_peta["user"] = sebelum_at;
        hasil_peta["device"] = 0;
    }
    hasil_peta["server"] = srv;
    hasil hasil_peta;
}

fungsi UraiResponsUsync(resp_node) {
    buat hasil_peta = peta_baru();
    hasil_peta["ok"] = salah;
    hasil_peta["devices"] = [];

    buat n_usync = _cari_anak(resp_node, "usync");
    jika tipe(n_usync) != "peta" { hasil hasil_peta; }
    buat n_list = _cari_anak(n_usync, "list");
    jika tipe(n_list) != "peta" { hasil hasil_peta; }

    untuk (buat u = 0; u < panjang(n_list["children"]); u = u + 1) {
        buat n_user = n_list["children"][u];
        jika n_user["tag"] != "user" { lanjut; }
        buat base = _urai_jid_val(n_user["attrs"]["jid"]);

        buat addr = base;
        buat n_lid = _cari_anak(n_user, "lid");
        jika tipe(n_lid) == "peta" && (tipe(n_lid["attrs"]["val"]) == "teks" || tipe(n_lid["attrs"]["val"]) == "peta") {
            buat lid_val = _urai_jid_val(n_lid["attrs"]["val"]);
            jika tipe(lid_val["user"]) == "teks" && panjang(lid_val["user"]) > 0 {
                addr = lid_val;
            }
        }

        buat n_devices2 = _cari_anak(n_user, "devices");
        jika tipe(n_devices2) != "peta" { lanjut; }
        buat n_devlist = _cari_anak(n_devices2, "device-list");
        jika tipe(n_devlist) != "peta" { lanjut; }
        untuk (buat d = 0; d < panjang(n_devlist["children"]); d = d + 1) {
            buat n_dev = n_devlist["children"][d];
            jika n_dev["tag"] != "device" { lanjut; }
            jika tipe(n_dev["attrs"]["is_hosted"]) == "teks" { lanjut; }
            buat dev_id = ke_angka(n_dev["attrs"]["id"]);
            buat entri = peta_baru();
            entri["user"] = addr["user"];
            entri["server"] = addr["server"];
            entri["device"] = dev_id;
            tambah(hasil_peta["devices"], entri);
        }
    }
    hasil_peta["ok"] = benar;
    hasil hasil_peta;
}

fungsi _byte_ulang(v, n) {
    buat s = "";
    untuk (buat i = 0; i < n; i = i + 1) { s = s + teks_dari(v); }
    hasil s;
}

fungsi _u24_be_ke_angka(b3) {
    hasil byte_di(b3, 0) * 65536 + byte_di(b3, 1) * 256 + byte_di(b3, 2);
}

fungsi _u32_be_hex(v) {
    buat b0 = (v - (v % 16777216)) / 16777216;
    buat r0 = v % 16777216;
    buat b1 = (r0 - (r0 % 65536)) / 65536;
    buat r1 = r0 % 65536;
    buat b2 = (r1 - (r1 % 256)) / 256;
    buat b3 = r1 % 256;
    hasil teks_dari(b0) + teks_dari(b1) + teks_dari(b2) + teks_dari(b3);
}

fungsi BuatIqPrekeyFetch(req_id, devices) {
    buat anak_user = [];
    untuk (buat i = 0; i < panjang(devices); i = i + 1) {
        buat dv = devices[i];

        buat n_user = peta_baru();
        n_user["tag"] = "user";
        n_user["attrs"] = peta_baru();
        n_user["attrs"]["jid"] = _jid_peta(dv["user"], dv["server"], dv["device"]);
        n_user["attrs"]["reason"] = "identity";
        n_user["children"] = [];
        n_user["content"] = kosong;
        n_user["ada_isi"] = salah;
        tambah(anak_user, n_user);
    }

    buat n_key = peta_baru();
    n_key["tag"] = "key";
    n_key["attrs"] = peta_baru();
    n_key["children"] = anak_user;
    n_key["content"] = kosong;
    n_key["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id;
    iq_attrs["to"] = _jid_peta("", "s.whatsapp.net", 0);
    iq_attrs["type"] = "get";
    iq_attrs["xmlns"] = "encrypt";

    buat iq = peta_baru();
    iq["tag"] = "iq";
    iq["attrs"] = iq_attrs;
    iq["children"] = [n_key];
    iq["content"] = kosong;
    iq["ada_isi"] = benar;
    hasil iq;
}

fungsi UraiResponsPrekey(resp_node) {
    buat gagal = peta_baru();
    gagal["ok"] = salah;

    buat n_list = _cari_anak(resp_node, "list");
    jika tipe(n_list) != "peta" { hasil gagal; }

    buat bundles = [];
    untuk (buat u = 0; u < panjang(n_list["children"]); u = u + 1) {
        buat b = _urai_satu_prekey_user(n_list["children"][u]);
        jika tipe(b) == "peta" && b["ok"] == benar { tambah(bundles, b); }
    }
    jika panjang(bundles) == 0 { hasil gagal; }
    buat hasil_peta = peta_baru();
    hasil_peta["ok"] = benar;
    hasil_peta["bundles"] = bundles;
    hasil hasil_peta;
}

fungsi _urai_satu_prekey_user(n_user) {
    jika n_user["tag"] != "user" { hasil kosong; }
    buat hasil_peta = peta_baru();
    buat base = _urai_jid_val(n_user["attrs"]["jid"]);
    hasil_peta["user"] = base["user"];
    hasil_peta["server"] = base["server"];
    hasil_peta["device"] = base["device"];

    buat sumber = n_user;
    buat n_keys = _cari_anak(n_user, "keys");
    jika tipe(n_keys) == "peta" { sumber = n_keys; }

    buat n_reg = _cari_anak(n_user, "registration");
    jika tipe(n_reg) != "peta" { hasil hasil_peta; }
    hasil_peta["reg_id"] = byte_di(n_reg["content"], 0) * 16777216
        + byte_di(n_reg["content"], 1) * 65536
        + byte_di(n_reg["content"], 2) * 256
        + byte_di(n_reg["content"], 3);

    buat n_ident = _cari_anak(sumber, "identity");
    jika tipe(n_ident) != "peta" { hasil hasil_peta; }
    hasil_peta["identity_pub"] = n_ident["content"];

    buat n_skey = _cari_anak(sumber, "skey");
    jika tipe(n_skey) != "peta" { hasil hasil_peta; }
    buat skid = _cari_anak(n_skey, "id");
    buat skval = _cari_anak(n_skey, "value");
    buat sksig = _cari_anak(n_skey, "signature");
    jika tipe(skid) != "peta" || tipe(skval) != "peta" || tipe(sksig) != "peta" { hasil hasil_peta; }
    hasil_peta["signed_prekey_id"] = _u24_be_ke_angka(skid["content"]);
    hasil_peta["signed_prekey_pub"] = skval["content"];
    hasil_peta["signed_prekey_sig"] = sksig["content"];

    buat n_key = _cari_anak(sumber, "key");
    jika tipe(n_key) == "peta" {
        buat kid = _cari_anak(n_key, "id");
        buat kval = _cari_anak(n_key, "value");
        jika tipe(kid) == "peta" && tipe(kval) == "peta" {
            hasil_peta["onetime_prekey_id"] = _u24_be_ke_angka(kid["content"]);
            hasil_peta["onetime_prekey_pub"] = kval["content"];
        }
    }

    hasil_peta["ok"] = benar;
    hasil hasil_peta;
}

fungsi bangun_sesi_x3dh(identity_kp, bundle) {
    buat our_base_kp = KEYS.KeypairBaru();

    buat identity_pub_hex = CP["hex_encode"](identity_kp["pub"]);
    buat identity_priv_hex = CP["hex_encode"](identity_kp["priv"]);
    buat base_priv_hex = CP["hex_encode"](our_base_kp["priv"]);
    buat their_identity_hex = CP["hex_encode"](bundle["identity_pub"]);
    buat their_spk_hex = CP["hex_encode"](bundle["signed_prekey_pub"]);

    buat dh1 = CP["hex_decode"](CP["x25519"](identity_priv_hex, their_spk_hex));
    buat dh2 = CP["hex_decode"](CP["x25519"](base_priv_hex, their_identity_hex));
    buat dh3 = CP["hex_decode"](CP["x25519"](base_priv_hex, their_spk_hex));

    buat master_secret = _byte_ulang(255, 32) + dh1 + dh2 + dh3;
    buat pakai_otp = tipe(bundle["onetime_prekey_pub"]) == "teks";
    jika pakai_otp {
        buat their_otp_hex = CP["hex_encode"](bundle["onetime_prekey_pub"]);
        buat dh4 = CP["hex_decode"](CP["x25519"](base_priv_hex, their_otp_hex));
        master_secret = master_secret + dh4;
    }

    buat derived = HKDF.HkdfSha256(master_secret, "", "WhisperText", 64);
    buat initial_root_key = potong(derived, 0, 32);

    buat our_sending_ratchet_kp = KEYS.KeypairBaru();
    buat ratchet_priv_hex = CP["hex_encode"](our_sending_ratchet_kp["priv"]);
    buat dh5 = CP["hex_decode"](CP["x25519"](ratchet_priv_hex, their_spk_hex));

    buat chain_derived = HKDF.HkdfSha256(dh5, initial_root_key, "WhisperRatchet", 64);
    buat sending_chain_key = potong(chain_derived, 32, 64);

    buat sesi = peta_baru();
    sesi["sending_chain_key"] = sending_chain_key;
    sesi["chain_index"] = 0;
    sesi["our_sending_ratchet_kp"] = our_sending_ratchet_kp;
    sesi["our_base_kp"] = our_base_kp;
    sesi["our_identity_pub"] = identity_kp["pub"];
    sesi["their_identity_pub"] = bundle["identity_pub"];
    sesi["their_signed_prekey_id"] = bundle["signed_prekey_id"];
    sesi["pakai_otp"] = pakai_otp;
    jika pakai_otp { sesi["onetime_prekey_id"] = bundle["onetime_prekey_id"]; }
    hasil sesi;
}

fungsi _djb_prefix(pubkey32) {
    hasil teks_dari(5) + pubkey32;
}

fungsi _pad_plaintext(pt) {
    buat pad_hex = CP["acak_bytes_hex"](1);
    buat pad_byte = byte_di(CP["hex_decode"](pad_hex), 0) % 16;
    jika pad_byte == 0 { pad_byte = 15; }
    hasil pt + _byte_ulang(pad_byte, pad_byte);
}

fungsi enkripsi_pesan_pertama(sesi, teks) {
    hasil enkripsi_pesan_pertama_raw(sesi, PB.PbBytes(1, teks));
}

fungsi enkripsi_pesan_pertama_raw(sesi, msg_protobuf) {

    buat base_material = CP["hex_decode"](hmac_sha256_hex(sesi["sending_chain_key"], teks_dari(1)));
    buat key_material = HKDF.HkdfSha256(base_material, "", "WhisperMessageKeys", 80);
    buat cipher_key = potong(key_material, 0, 32);
    buat mac_key = potong(key_material, 32, 64);
    buat iv = potong(key_material, 64, 80);

    buat plaintext_padded = _pad_plaintext(msg_protobuf);

    buat ciphertext_body = CP["hex_decode"](CP["aes_enkripsi"](CP["hex_encode"](plaintext_padded), CP["hex_encode"](cipher_key), "cbc", CP["hex_encode"](iv)));

    buat signal_proto = PB.PbBytes(1, _djb_prefix(sesi["our_sending_ratchet_kp"]["pub"]))
        + PB.PbVarint(2, sesi["chain_index"])
        + PB.PbVarint(3, 0)
        + PB.PbBytes(4, ciphertext_body);

    buat version_byte = teks_dari(51);
    buat serialized_for_mac = version_byte + signal_proto;
    buat mac_msg = _djb_prefix(sesi["our_identity_pub"]) + _djb_prefix(sesi["their_identity_pub"]) + serialized_for_mac;
    buat mac_full = CP["hex_decode"](hmac_sha256_hex(mac_key, mac_msg));
    buat mac = potong(mac_full, 0, 8);

    hasil version_byte + signal_proto + mac;
}

fungsi BungkusPrekeyMessage(sesi, signal_message_wire, our_registration_id) {
    buat proto = "";
    jika sesi["pakai_otp"] {
        proto = proto + PB.PbVarint(1, sesi["onetime_prekey_id"]);
    }
    proto = proto + PB.PbBytes(2, _djb_prefix(sesi["our_base_kp"]["pub"]));
    proto = proto + PB.PbBytes(3, _djb_prefix(sesi["our_identity_pub"]));
    proto = proto + PB.PbBytes(4, signal_message_wire);
    proto = proto + PB.PbVarint(5, our_registration_id);
    proto = proto + PB.PbVarint(6, sesi["their_signed_prekey_id"]);

    buat version_byte = teks_dari(51);
    hasil version_byte + proto;
}

fungsi BuatNodePesan(msg_id, target_user, target_lid_user, enc_list, account_bytes) {
    buat n_to_list = [];
    buat ada_pkmsg = salah;
    untuk (buat i = 0; i < panjang(enc_list); i = i + 1) {
        buat ent = enc_list[i];

        buat ent_type = "pkmsg";
        jika tipe(ent["type"]) == "teks" { ent_type = ent["type"]; }

        buat n_enc = peta_baru();
        n_enc["tag"] = "enc";
        n_enc["attrs"] = peta_baru();
        n_enc["attrs"]["v"] = "2";
        n_enc["attrs"]["type"] = ent_type;
        n_enc["children"] = [];
        n_enc["content"] = ent["wire"];
        n_enc["ada_isi"] = benar;
        jika ent_type == "pkmsg" { ada_pkmsg = benar; }

        buat n_to = peta_baru();
        n_to["tag"] = "to";
        n_to["attrs"] = peta_baru();
        n_to["attrs"]["jid"] = _jid_peta(ent["user"], ent["server"], ent["device"]);
        n_to["children"] = [n_enc];
        n_to["content"] = kosong;
        n_to["ada_isi"] = benar;

        tambah(n_to_list, n_to);
    }

    buat n_participants = peta_baru();
    n_participants["tag"] = "participants";
    n_participants["attrs"] = peta_baru();
    n_participants["children"] = n_to_list;
    n_participants["content"] = kosong;
    n_participants["ada_isi"] = benar;

    buat msg_children = [n_participants];
    jika ada_pkmsg {
        buat n_device_identity = peta_baru();
        n_device_identity["tag"] = "device-identity";
        n_device_identity["attrs"] = peta_baru();
        n_device_identity["children"] = [];
        n_device_identity["content"] = account_bytes;
        n_device_identity["ada_isi"] = benar;
        tambah(msg_children, n_device_identity);
    }

    buat msg_attrs = peta_baru();
    msg_attrs["id"] = msg_id;
    msg_attrs["type"] = "text";
    msg_attrs["to"] = _jid_peta(target_lid_user, "lid", 0);
    msg_attrs["peer_recipient_pn"] = _jid_peta(target_user, "s.whatsapp.net", 0);

    buat msg = peta_baru();
    msg["tag"] = "message";
    msg["attrs"] = msg_attrs;
    msg["children"] = msg_children;
    msg["content"] = kosong;
    msg["ada_isi"] = benar;
    hasil msg;
}

fungsi UraiPrekeyMessage(wire) {
    buat body = potong(wire, 1, panjang(wire));
    buat fields = PB.PbDekode(body);
    buat hasil_peta = peta_baru();
    hasil_peta["ada_otp"] = tipe(fields["1"]) == "angka";
    jika hasil_peta["ada_otp"] { hasil_peta["prekey_id"] = fields["1"]; }

    hasil_peta["base_key"] = potong(fields["2"], 1, panjang(fields["2"]));
    hasil_peta["identity_key"] = potong(fields["3"], 1, panjang(fields["3"]));
    hasil_peta["signal_message_wire"] = fields["4"];
    hasil_peta["registration_id"] = fields["5"];
    hasil_peta["signed_prekey_id"] = fields["6"];
    hasil hasil_peta;
}

fungsi UraiSignalMessage(wire) {
    buat mac = potong(wire, panjang(wire) - 8, panjang(wire));
    buat serialized_for_mac = potong(wire, 0, panjang(wire) - 8);
    buat body = potong(serialized_for_mac, 1, panjang(serialized_for_mac));
    buat fields = PB.PbDekode(body);
    buat hasil_peta = peta_baru();
    hasil_peta["ratchet_key"] = potong(fields["1"], 1, panjang(fields["1"]));
    hasil_peta["counter"] = fields["2"];
    hasil_peta["ciphertext"] = fields["4"];
    hasil_peta["mac"] = mac;
    hasil_peta["serialized_for_mac"] = serialized_for_mac;
    hasil hasil_peta;
}

fungsi BangunSesiX3dhPenerima(our_identity_kp, our_signed_prekey_priv, our_otp_priv, pkmsg) {
    buat their_identity_hex = CP["hex_encode"](pkmsg["identity_key"]);
    buat their_base_hex = CP["hex_encode"](pkmsg["base_key"]);
    buat our_identity_priv_hex = CP["hex_encode"](our_identity_kp["priv"]);
    buat our_spk_priv_hex = CP["hex_encode"](our_signed_prekey_priv);

    buat dh1 = CP["hex_decode"](CP["x25519"](our_spk_priv_hex, their_identity_hex));
    buat dh2 = CP["hex_decode"](CP["x25519"](our_identity_priv_hex, their_base_hex));
    buat dh3 = CP["hex_decode"](CP["x25519"](our_spk_priv_hex, their_base_hex));
    buat master_secret = _byte_ulang(255, 32) + dh1 + dh2 + dh3;
    jika pkmsg["ada_otp"] && tipe(our_otp_priv) == "teks" {
        buat dh4 = CP["hex_decode"](CP["x25519"](CP["hex_encode"](our_otp_priv), their_base_hex));
        master_secret = master_secret + dh4;
    }

    buat derived = HKDF.HkdfSha256(master_secret, "", "WhisperText", 64);
    buat sesi = peta_baru();
    sesi["x3dh_root_key"] = potong(derived, 0, 32);
    sesi["our_signed_prekey_priv"] = our_signed_prekey_priv;
    sesi["our_identity_pub"] = our_identity_kp["pub"];
    sesi["their_identity_pub"] = pkmsg["identity_key"];
    hasil sesi;
}

fungsi DekripsiPesanPertamaPenerima(sesi, sm) {

    buat their_ratchet_hex = CP["hex_encode"](sm["ratchet_key"]);
    buat our_spk_priv_hex = CP["hex_encode"](sesi["our_signed_prekey_priv"]);
    buat dh_ratchet = CP["hex_decode"](CP["x25519"](our_spk_priv_hex, their_ratchet_hex));
    buat chain_derived = HKDF.HkdfSha256(dh_ratchet, sesi["x3dh_root_key"], "WhisperRatchet", 64);
    buat receiving_chain_key = potong(chain_derived, 32, 64);

    buat chain_key_maju = receiving_chain_key;
    untuk (buat _ci = 0; _ci < sm["counter"]; _ci = _ci + 1) {
        chain_key_maju = CP["hex_decode"](hmac_sha256_hex(chain_key_maju, teks_dari(2)));
    }

    buat base_material = CP["hex_decode"](hmac_sha256_hex(chain_key_maju, teks_dari(1)));
    buat key_material = HKDF.HkdfSha256(base_material, "", "WhisperMessageKeys", 80);
    buat cipher_key = potong(key_material, 0, 32);
    buat mac_key = potong(key_material, 32, 64);
    buat iv = potong(key_material, 64, 80);

    buat mac_msg = _djb_prefix(sesi["their_identity_pub"]) + _djb_prefix(sesi["our_identity_pub"]) + sm["serialized_for_mac"];
    buat mac_full = CP["hex_decode"](hmac_sha256_hex(mac_key, mac_msg));
    buat mac_hitung = potong(mac_full, 0, 8);
    jika mac_hitung != sm["mac"] { lempar "MAC gak cocok -- dekripsi gagal atau pesan corrupt."; }

    buat plaintext_padded = CP["hex_decode"](CP["aes_dekripsi"](CP["hex_encode"](sm["ciphertext"]), CP["hex_encode"](cipher_key), "cbc", CP["hex_encode"](iv)));
    buat pad_len = byte_di(plaintext_padded, panjang(plaintext_padded) - 1);
    buat msg_protobuf = potong(plaintext_padded, 0, panjang(plaintext_padded) - pad_len);

    buat msg_fields = PB.PbDekode(msg_protobuf);

    buat r = peta_baru();

    r["teks"] = ekstrak_teks(msg_fields);
    r["skdm_wire"] = msg_fields["2"];
    r["fields"] = msg_fields;
    r["wire_mentah"] = msg_protobuf;
    hasil r;
}

fungsi _sub(fields, tag, subtag) {
    jika tipe(fields[tag]) != "teks" { hasil kosong; }
    buat f = PB.PbDekode(fields[tag]);
    jika tipe(f[subtag]) == "teks" { hasil f[subtag]; }
    hasil kosong;
}

fungsi buka_bungkus(fields) {
    buat pembungkus = ["40", "37", "55", "59", "53", "58", "74"];
    buat kini = fields;
    untuk (buat putaran = 0; putaran < 5; putaran = putaran + 1) {
        buat ketemu = salah;
        untuk (buat i = 0; i < panjang(pembungkus); i = i + 1) {
            buat dalam = _sub(kini, pembungkus[i], "1");
            jika tipe(dalam) == "teks" {
                kini = PB.PbDekode(dalam);
                ketemu = benar;
                berhenti;
            }
        }
        jika !ketemu { hasil kini; }
    }
    hasil kini;
}

fungsi TipePesan(fields) {
    buat f = buka_bungkus(fields);
    jika tipe(f["1"]) == "teks"  { hasil "conversation"; }
    jika tipe(f["6"]) == "teks"  { hasil "extendedText"; }
    jika tipe(f["3"]) == "teks"  { hasil "image"; }
    jika tipe(f["7"]) == "teks"  { hasil "document"; }
    jika tipe(f["8"]) == "teks"  { hasil "audio"; }
    jika tipe(f["9"]) == "teks"  { hasil "video"; }
    jika tipe(f["26"]) == "teks" { hasil "sticker"; }
    jika tipe(f["43"]) == "teks" { hasil "buttonsResponse"; }
    jika tipe(f["39"]) == "teks" { hasil "listResponse"; }
    jika tipe(f["29"]) == "teks" { hasil "templateButtonReply"; }
    jika tipe(f["48"]) == "teks" { hasil "interactiveResponse"; }
    jika tipe(f["46"]) == "teks" { hasil "reaction"; }
    jika tipe(f["56"]) == "teks" { hasil "encReaction"; }
    jika tipe(f["49"]) == "teks" { hasil "pollCreation"; }
    jika tipe(f["50"]) == "teks" { hasil "pollUpdate"; }
    jika tipe(f["4"]) == "teks"  { hasil "contact"; }
    jika tipe(f["5"]) == "teks"  { hasil "location"; }
    jika tipe(f["12"]) == "teks" { hasil "protocol"; }
    jika tipe(f["75"]) == "teks" { hasil "event"; }
    hasil "lain";
}

fungsi ekstrak_teks(fields) {
    jika tipe(fields) != "peta" { hasil ""; }
    buat f = buka_bungkus(fields);
    buat v = kosong;

    jika tipe(f["1"]) == "teks" { hasil f["1"]; }

    v = _sub(f, "6", "1");   jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "3", "3");   jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "9", "7");   jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "7", "20");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "7", "8");   jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "26", "9");  jika tipe(v) == "teks" { hasil v; }

    v = _sub(f, "43", "1");  jika tipe(v) == "teks" { hasil v; }
    jika tipe(f["39"]) == "teks" {
        buat lf = PB.PbDekode(f["39"]);
        buat ssr = _sub(lf, "3", "1");
        jika tipe(ssr) == "teks" { hasil ssr; }
        jika tipe(lf["1"]) == "teks" { hasil lf["1"]; }
    }
    v = _sub(f, "29", "1");  jika tipe(v) == "teks" { hasil v; }
    jika tipe(f["48"]) == "teks" {
        buat inf = PB.PbDekode(f["48"]);
        buat nf = _sub(inf, "2", "2");
        jika tipe(nf) == "teks" {
            buat pj = json_decode_aman(nf);
            jika tipe(pj) == "peta" && tipe(pj["id"]) == "teks" { hasil pj["id"]; }
            hasil nf;
        }
    }

    v = _sub(f, "46", "2");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "49", "2");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "4", "1");   jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "5", "3");   jika tipe(v) == "teks" { hasil v; }

    hasil "";
}

fungsi _context_info_dari(fields) {
    jika tipe(fields) != "peta" { hasil kosong; }
    buat f = buka_bungkus(fields);
    buat v = kosong;
    v = _sub(f, "6", "17");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "3", "17");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "9", "17");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "7", "17");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "8", "17");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "26", "12"); jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "43", "3");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "39", "4");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "29", "3");  jika tipe(v) == "teks" { hasil v; }
    v = _sub(f, "49", "5");  jika tipe(v) == "teks" { hasil v; }
    hasil kosong;
}

fungsi ekstrak_mention(fields) {
    buat ci = _context_info_dari(fields);
    jika tipe(ci) != "teks" { hasil []; }
    hasil PB.PbDekodeBerulang(ci, "15");
}

fungsi ekstrak_kutipan(fields) {
    buat ci = _context_info_dari(fields);
    jika tipe(ci) != "teks" { hasil kosong; }
    buat cf = PB.PbDekode(ci);
    jika tipe(cf["1"]) != "teks" { hasil kosong; }
    buat r = peta_baru();
    r["stanza_id"] = cf["1"];
    r["participant"] = cf["2"];
    r["pesan_wire"] = cf["3"];
    r["teks"] = "";
    r["media"] = kosong;
    r["ada_media"] = salah;
    jika tipe(cf["3"]) == "teks" {
        buat qf = PB.PbDekode(cf["3"]);
        r["teks"] = ekstrak_teks(qf);
        buat qf2 = buka_bungkus(qf);
        buat tag_media = kosong;
        jika tipe(qf2["3"]) == "teks"  { tag_media = "3"; }
        jika tipe(qf2["9"]) == "teks"  { tag_media = "9"; }
        jika tipe(qf2["8"]) == "teks"  { tag_media = "8"; }
        jika tipe(qf2["7"]) == "teks"  { tag_media = "7"; }
        jika tipe(qf2["26"]) == "teks" { tag_media = "26"; }
        jika tipe(tag_media) == "teks" {
            r["media"] = _media_dari(qf2, tag_media);
            r["ada_media"] = benar;
        }
    }
    hasil r;
}

fungsi BuatNodeAckPesan(msg_id, sender_jid) {
    buat attrs = peta_baru();
    attrs["class"] = "message"; attrs["id"] = msg_id; attrs["to"] = sender_jid;
    buat n = peta_baru();
    n["tag"] = "ack"; n["attrs"] = attrs; n["children"] = []; n["content"] = kosong; n["ada_isi"] = salah;
    hasil n;
}

fungsi BuatNodeAck(node) {
    buat na = node["attrs"];
    jika tipe(na) != "peta" { lempar "node tanpa attrs, gak bisa di-ack"; }
    buat attrs = peta_baru();
    attrs["class"] = node["tag"];
    attrs["id"] = na["id"];
    attrs["to"] = na["from"];
    jika tipe(na["participant"]) == "peta" { attrs["participant"] = na["participant"]; }
    jika tipe(na["recipient"]) == "peta" { attrs["recipient"] = na["recipient"]; }
    jika node["tag"] != "message" && tipe(na["type"]) == "teks" { attrs["type"] = na["type"]; }
    buat n = peta_baru();
    n["tag"] = "ack"; n["attrs"] = attrs; n["children"] = []; n["content"] = kosong; n["ada_isi"] = salah;
    hasil n;
}

fungsi BuatNodeReceiptInactive(msg_id, sender_jid, participant_attr) {
    buat attrs = peta_baru();
    attrs["id"] = msg_id; attrs["type"] = "inactive";
    jika tipe(participant_attr) == "peta" {
        attrs["participant"] = participant_attr;
        attrs["to"] = sender_jid;
    } lain {
        attrs["to"] = sender_jid;
    }
    buat n = peta_baru();
    n["tag"] = "receipt"; n["attrs"] = attrs; n["children"] = []; n["content"] = kosong; n["ada_isi"] = salah;
    hasil n;
}

fungsi ResolveSenderString(node, sender_jid) {
    buat s = sender_jid["user"] + "@" + sender_jid["server"];
    jika tipe(node["attrs"]["sender_pn"]) == "peta" { s = node["attrs"]["sender_pn"]["user"] + "@s.whatsapp.net"; }
    jika tipe(node["attrs"]["participant_pn"]) == "peta" { s = node["attrs"]["participant_pn"]["user"] + "@s.whatsapp.net"; }
    hasil s;
}

fungsi _u24_be(v) {
    buat b0 = (v - (v % 65536)) / 65536 % 256;
    buat b1 = (v - (v % 256)) / 256 % 256;
    buat b2 = v % 256;
    hasil teks_dari(b0) + teks_dari(b1) + teks_dari(b2);
}

fungsi SiapkanKonteksRetry(identity_kp, session_data) {
    buat ctx = peta_baru();
    ctx["ada"] = salah;
    jika tipe(session_data["signed_prekey_priv"]) != "teks" || panjang(session_data["signed_prekey_priv"]) == 0 { hasil ctx; }
    jika tipe(session_data["account_hex"]) != "teks" || panjang(session_data["account_hex"]) == 0 { hasil ctx; }

    buat spk_priv = CP["hex_decode"](session_data["signed_prekey_priv"]);
    buat spk_pub = KEYS.KeypairDariPriv(spk_priv)["pub"];
    buat spk_id = 1;
    jika tipe(session_data["signed_prekey_id"]) == "teks" && panjang(session_data["signed_prekey_id"]) > 0 {
        spk_id = ke_angka(session_data["signed_prekey_id"]);
    }
    buat sig_res = jalankan_perintah("nusantara_modules/hypermeow-ns/tools/sign_identity", [CP["hex_encode"](identity_kp["priv"]), CP["hex_encode"](teks_dari(5) + spk_pub)]);
    jika sig_res["status"] != 0 { hasil ctx; }

    ctx["ada"] = benar;
    ctx["signed_prekey_id"] = spk_id;
    ctx["signed_prekey_pub"] = spk_pub;
    ctx["signed_prekey_sig"] = CP["hex_decode"](potong(sig_res["keluaran"], 0, 128));
    ctx["account_hex"] = session_data["account_hex"];
    hasil ctx;
}

buat _pesan_retry_count = peta_baru();
buat _next_otp_id = -1;
fungsi _otp_id_berikutnya() {
    jika _next_otp_id < 0 {
        _next_otp_id = ST.AmbilMaxPrekeyId() + 1;
        jika _next_otp_id < 2050 { _next_otp_id = 2050; }
    }
    buat id = _next_otp_id;
    _next_otp_id = _next_otp_id + 1;
    hasil id;
}

fungsi BuatNodeRetryReceipt(msg_id, sender_jid, msg_t, our_registration_id, identity_kp, retry_ctx, participant_attr, paksa_sisip_keys) {
    buat retry_count = 1;
    jika tipe(_pesan_retry_count[msg_id]) == "angka" { retry_count = _pesan_retry_count[msg_id] + 1; }
    _pesan_retry_count[msg_id] = retry_count;

    buat n_retry = peta_baru();
    buat retry_inner = peta_baru();
    retry_inner["count"] = ke_teks(retry_count); retry_inner["id"] = msg_id; retry_inner["t"] = msg_t; retry_inner["v"] = "1";
    n_retry["tag"] = "retry"; n_retry["attrs"] = retry_inner; n_retry["children"] = []; n_retry["content"] = kosong; n_retry["ada_isi"] = salah;

    buat n_reg = peta_baru();
    n_reg["tag"] = "registration"; n_reg["attrs"] = peta_baru(); n_reg["children"] = []; n_reg["content"] = _u32_be_hex(our_registration_id); n_reg["ada_isi"] = benar;

    buat children = [n_retry, n_reg];
    buat otp_id_dipake = kosong;

    jika (retry_count > 1 || paksa_sisip_keys == benar) && tipe(retry_ctx) == "peta" && retry_ctx["ada"] {
        buat kp = KEYS.KeypairBaru();
        buat otp_id = _otp_id_berikutnya();
        ST.SimpanPrekeyPrivat(otp_id, CP["hex_encode"](kp["priv"]));
        otp_id_dipake = otp_id;

        buat n_ktype = peta_baru(); n_ktype["tag"] = "type"; n_ktype["attrs"] = peta_baru(); n_ktype["children"] = []; n_ktype["content"] = teks_dari(5); n_ktype["ada_isi"] = benar;
        buat n_kident = peta_baru(); n_kident["tag"] = "identity"; n_kident["attrs"] = peta_baru(); n_kident["children"] = []; n_kident["content"] = identity_kp["pub"]; n_kident["ada_isi"] = benar;

        buat n_otp_id = peta_baru(); n_otp_id["tag"] = "id"; n_otp_id["attrs"] = peta_baru(); n_otp_id["children"] = []; n_otp_id["content"] = _u24_be(otp_id); n_otp_id["ada_isi"] = benar;
        buat n_otp_val = peta_baru(); n_otp_val["tag"] = "value"; n_otp_val["attrs"] = peta_baru(); n_otp_val["children"] = []; n_otp_val["content"] = kp["pub"]; n_otp_val["ada_isi"] = benar;
        buat n_otp_key = peta_baru(); n_otp_key["tag"] = "key"; n_otp_key["attrs"] = peta_baru(); n_otp_key["children"] = [n_otp_id, n_otp_val]; n_otp_key["content"] = kosong; n_otp_key["ada_isi"] = benar;

        buat n_skey_id = peta_baru(); n_skey_id["tag"] = "id"; n_skey_id["attrs"] = peta_baru(); n_skey_id["children"] = []; n_skey_id["content"] = _u24_be(retry_ctx["signed_prekey_id"]); n_skey_id["ada_isi"] = benar;
        buat n_skey_val = peta_baru(); n_skey_val["tag"] = "value"; n_skey_val["attrs"] = peta_baru(); n_skey_val["children"] = []; n_skey_val["content"] = retry_ctx["signed_prekey_pub"]; n_skey_val["ada_isi"] = benar;
        buat n_skey_sig = peta_baru(); n_skey_sig["tag"] = "signature"; n_skey_sig["attrs"] = peta_baru(); n_skey_sig["children"] = []; n_skey_sig["content"] = retry_ctx["signed_prekey_sig"]; n_skey_sig["ada_isi"] = benar;
        buat n_skey = peta_baru(); n_skey["tag"] = "skey"; n_skey["attrs"] = peta_baru(); n_skey["children"] = [n_skey_id, n_skey_val, n_skey_sig]; n_skey["content"] = kosong; n_skey["ada_isi"] = benar;

        buat n_devident = peta_baru(); n_devident["tag"] = "device-identity"; n_devident["attrs"] = peta_baru(); n_devident["children"] = []; n_devident["content"] = CP["hex_decode"](retry_ctx["account_hex"]); n_devident["ada_isi"] = benar;

        buat n_keys = peta_baru();
        n_keys["tag"] = "keys"; n_keys["attrs"] = peta_baru();
        n_keys["children"] = [n_ktype, n_kident, n_otp_key, n_skey, n_devident];
        n_keys["content"] = kosong; n_keys["ada_isi"] = benar;
        tambah(children, n_keys);
    }

    buat attrs = peta_baru();
    attrs["id"] = msg_id; attrs["to"] = sender_jid; attrs["type"] = "retry";
    jika tipe(participant_attr) == "peta" { attrs["participant"] = participant_attr; }
    buat retry_node = peta_baru();
    retry_node["tag"] = "receipt"; retry_node["attrs"] = attrs; retry_node["children"] = children; retry_node["content"] = kosong; retry_node["ada_isi"] = benar;

    buat hasil_map = peta_baru();
    hasil_map["node"] = retry_node;
    hasil_map["retry_count"] = retry_count;
    hasil_map["otp_id"] = otp_id_dipake;
    hasil hasil_map;
}

fungsi SenderKeyId(group_user, sender_lid_user, sender_device) {
    hasil group_user + "|" + sender_lid_user + "|" + ke_teks(sender_device);
}

fungsi ProsesSenderKeyDistribution(sender_lid_user, sender_device, outer_skdm_bytes, fallback_group_user) {
    buat outer_fields = PB.PbDekode(outer_skdm_bytes);
    buat group_user = kosong;
    jika tipe(outer_fields["1"]) == "teks" && panjang(outer_fields["1"]) > 0 {
        buat group_id_full = outer_fields["1"];
        group_user = group_id_full;
        untuk (buat gi = 0; gi < panjang(group_id_full); gi = gi + 1) {
            jika byte_di(group_id_full, gi) == 64 { group_user = potong(group_id_full, 0, gi); berhenti; }
        }
    } lain jika tipe(fallback_group_user) == "teks" && panjang(fallback_group_user) > 0 {
        group_user = fallback_group_user;
    } lain {
        lempar "SenderKeyDistributionMessage gak bawa groupID dan gak ada fallback -- gak bisa nentuin grup mana.";
    }
    jika tipe(outer_fields["2"]) != "teks" || panjang(outer_fields["2"]) == 0 {
        lempar "SenderKeyDistributionMessage gak punya field axolotlSenderKeyDistributionMessage (field 2).";
    }
    buat skdm_wire = outer_fields["2"];
    buat body = potong(skdm_wire, 1, panjang(skdm_wire));
    buat fields = PB.PbDekode(body);
    buat key_id = fields["1"];
    buat iteration = fields["2"];
    buat chain_key = fields["3"];
    buat signing_key_prefixed = fields["4"];
    buat signing_pub = potong(signing_key_prefixed, 1, panjang(signing_key_prefixed));

    buat id = SenderKeyId(group_user, sender_lid_user, sender_device);
    ST.SimpanSenderKey(id, key_id, iteration, CP["hex_encode"](chain_key), CP["hex_encode"](signing_pub));
    hasil id;
}

fungsi UraiSenderKeyMessage(wire) {
    buat sig_len = 64;
    buat protobuf_part = potong(wire, 1, panjang(wire) - sig_len);
    buat fields = PB.PbDekode(protobuf_part);
    buat hasil_peta = peta_baru();
    hasil_peta["key_id"] = fields["1"];
    hasil_peta["iteration"] = fields["2"];
    hasil_peta["ciphertext"] = fields["3"];
    hasil hasil_peta;
}

// Selesain dekripsi dari message-key seed yang udah ada (baik yang baru
// diturunin dari ratchet, atau yang diambil dari cache skipped-key buat
// pesan out-of-order). Dibungkus coba/tangkap sendiri -- kegagalan AES/
// padding di sini artinya seed-nya emang salah, bukan bug interpreter.
fungsi _selesaikan_dekripsi_sk(message_key_seed, sm) {
    buat gagal = peta_baru();
    gagal["ok"] = salah;
    coba {
        buat derivative = HKDF.HkdfSha256(message_key_seed, "", "WhisperGroup", 48);
        buat iv = potong(derivative, 0, 16);
        buat cipher_key = potong(derivative, 16, 48);

        buat plaintext_padded = CP["hex_decode"](CP["aes_dekripsi"](CP["hex_encode"](sm["ciphertext"]), CP["hex_encode"](cipher_key), "cbc", CP["hex_encode"](iv)));
        buat pad_len = byte_di(plaintext_padded, panjang(plaintext_padded) - 1);
        buat msg_protobuf = potong(plaintext_padded, 0, panjang(plaintext_padded) - pad_len);
        buat msg_fields = PB.PbDekode(msg_protobuf);

        buat r = peta_baru();
        r["ok"] = benar;
        r["teks"] = ekstrak_teks(msg_fields);
        r["fields"] = msg_fields;
        r["wire_mentah"] = msg_protobuf;
        hasil r;
    } tangkap (e) {
        gagal["error"] = "gagal dekripsi pakai message-key: " + ke_teks(e);
        hasil gagal;
    }
}

fungsi DekripsiGroupMessage(id, state, sm) {
    buat gagal = peta_baru();
    gagal["ok"] = salah;

    jika state["key_id"] != sm["key_id"] {
        gagal["error"] = "key_id sender-key beda (mungkin dirotasi) -- state basi.";
        hasil gagal;
    }

    jika sm["iteration"] < state["iteration"] {
        // Ratchet cuma bisa maju -- gak bisa mundurin chain_key buat sampe
        // ke iterasi yang udah kelewat. Satu-satunya cara masih bisa baca
        // pesan ini: message-key iterasi itu udah kesimpen duluan (dari
        // lompatan sebelumnya yang ngelewatin iterasi ini).
        buat seed_hex = ST.AmbilSkippedKey(id, sm["iteration"]);
        jika tipe(seed_hex) == "teks" && panjang(seed_hex) > 0 {
            buat r2 = _selesaikan_dekripsi_sk(CP["hex_decode"](seed_hex), sm);
            jika r2["ok"] {
                ST.HapusSkippedKey(id, sm["iteration"]);
                r2["iterasi_baru"] = state["iteration"];
                r2["chain_key_baru_hex"] = state["chain_key"];
                hasil r2;
            }
        }
        gagal["error"] = "iterasi pesan (" + ke_teks(sm["iteration"]) + ") lebih kecil dari state (" + ke_teks(state["iteration"]) + ") dan gak ada di cache skipped-key -- pesan basi/udah kepake.";
        hasil gagal;
    }

    buat chain_key = CP["hex_decode"](state["chain_key"]);
    untuk (buat i = state["iteration"]; i < sm["iteration"]; i = i + 1) {
        // chain_key di titik ini "milik" iterasi i -- sebelum dilewatin,
        // simpen dulu message-key-nya biar kalau pesan iterasi i nyusul
        // belakangan (out-of-order), masih bisa didekripsi.
        buat seed_i = CP["hex_decode"](hmac_sha256_hex(chain_key, teks_dari(1)));
        ST.SimpanSkippedKey(id, i, CP["hex_encode"](seed_i));
        chain_key = CP["hex_decode"](hmac_sha256_hex(chain_key, teks_dari(2)));
    }
    jika sm["iteration"] > state["iteration"] {
        ST.PruneSkippedKeys(id, 40);
    }

    buat message_key_seed = CP["hex_decode"](hmac_sha256_hex(chain_key, teks_dari(1)));
    buat chain_key_lanjut = CP["hex_decode"](hmac_sha256_hex(chain_key, teks_dari(2)));

    buat r = _selesaikan_dekripsi_sk(message_key_seed, sm);
    jika !r["ok"] { hasil r; }
    r["iterasi_baru"] = sm["iteration"] + 1;
    r["chain_key_baru_hex"] = CP["hex_encode"](chain_key_lanjut);
    hasil r;
}

fungsi SiapkanSenderKeyKirim(group_user) {
    buat row = ST.CariSenderKeyKirim(group_user);
    jika tipe(row) == "peta" {
        buat st = peta_baru();
        st["group_user"] = group_user;
        st["key_id"] = row["key_id"];
        st["iteration"] = row["iteration"];
        st["chain_key"] = CP["hex_decode"](row["chain_key"]);
        st["signing_priv"] = CP["hex_decode"](row["signing_priv"]);
        st["signing_pub"] = CP["hex_decode"](row["signing_pub"]);
        hasil st;
    }

    buat signing_kp = KEYS.KeypairBaru();
    buat chain_key = CP["hex_decode"](CP["acak_bytes_hex"](32));
    buat key_id_hex = CP["acak_bytes_hex"](4);
    buat key_id_bytes = CP["hex_decode"](key_id_hex);
    buat key_id = byte_di(key_id_bytes, 0) * 16777216 + byte_di(key_id_bytes, 1) * 65536 + byte_di(key_id_bytes, 2) * 256 + byte_di(key_id_bytes, 3);

    ST.SimpanSenderKeyKirim(group_user, key_id, 0, CP["hex_encode"](chain_key), CP["hex_encode"](signing_kp["priv"]), CP["hex_encode"](signing_kp["pub"]));

    buat st = peta_baru();
    st["group_user"] = group_user;
    st["key_id"] = key_id;
    st["iteration"] = 0;
    st["chain_key"] = chain_key;
    st["signing_priv"] = signing_kp["priv"];
    st["signing_pub"] = signing_kp["pub"];
    hasil st;
}

fungsi _bangun_skdm_wire(state) {
    buat proto = PB.PbVarint(1, state["key_id"])
        + PB.PbVarint(2, state["iteration"])
        + PB.PbBytes(3, state["chain_key"])
        + PB.PbBytes(4, _djb_prefix(state["signing_pub"]));
    hasil teks_dari(51) + proto;
}

fungsi BangunSkdmMessageProtobuf(group_user, state) {
    buat skdm_wire = _bangun_skdm_wire(state);
    buat outer_skdm_bytes = PB.PbBytes(1, group_user + "@g.us") + PB.PbBytes(2, skdm_wire);
    hasil PB.PbBytes(2, outer_skdm_bytes);
}

fungsi enkripsi_group_message(state, teks) {
    hasil EnkripsiGroupMessageWire(state, PB.PbBytes(1, teks));
}

fungsi EnkripsiGroupMessageWire(state, msg_protobuf) {
    buat message_key_seed = CP["hex_decode"](hmac_sha256_hex(state["chain_key"], teks_dari(1)));
    buat derivative = HKDF.HkdfSha256(message_key_seed, "", "WhisperGroup", 48);
    buat iv = potong(derivative, 0, 16);
    buat cipher_key = potong(derivative, 16, 48);

    buat plaintext_padded = _pad_plaintext(msg_protobuf);
    buat ciphertext = CP["hex_decode"](CP["aes_enkripsi"](CP["hex_encode"](plaintext_padded), CP["hex_encode"](cipher_key), "cbc", CP["hex_encode"](iv)));

    buat protobuf_part = PB.PbVarint(1, state["key_id"]) + PB.PbVarint(2, state["iteration"]) + PB.PbBytes(3, ciphertext);
    buat unsigned_wire = teks_dari(51) + protobuf_part;

    buat sig_res = jalankan_perintah("nusantara_modules/hypermeow-ns/tools/sign_identity", [CP["hex_encode"](state["signing_priv"]), CP["hex_encode"](unsigned_wire)]);
    jika sig_res["status"] != 0 { lempar "Gagal sign SenderKeyMessage: " + sig_res["error"]; }
    buat signature = CP["hex_decode"](potong(sig_res["keluaran"], 0, 128));

    buat chain_key_lanjut = CP["hex_decode"](hmac_sha256_hex(state["chain_key"], teks_dari(2)));

    buat r = peta_baru();
    r["skmsg_wire"] = unsigned_wire + signature;
    r["iterasi_baru"] = state["iteration"] + 1;
    r["chain_key_baru_hex"] = CP["hex_encode"](chain_key_lanjut);
    hasil r;
}

fungsi BuatNodePesanGrup(msg_id, group_user, enc_list, account_bytes, skmsg_wire, node_ekstra, edit_attr) {
    buat n_to_list = [];
    buat ada_pkmsg = salah;
    untuk (buat i = 0; i < panjang(enc_list); i = i + 1) {
        buat ent = enc_list[i];
        buat ent_type = "pkmsg";
        jika tipe(ent["type"]) == "teks" { ent_type = ent["type"]; }

        buat n_enc = peta_baru();
        n_enc["tag"] = "enc"; n_enc["attrs"] = peta_baru();
        n_enc["attrs"]["v"] = "2"; n_enc["attrs"]["type"] = ent_type;
        n_enc["children"] = []; n_enc["content"] = ent["wire"]; n_enc["ada_isi"] = benar;
        jika ent_type == "pkmsg" { ada_pkmsg = benar; }

        buat n_to = peta_baru();
        n_to["tag"] = "to"; n_to["attrs"] = peta_baru();
        n_to["attrs"]["jid"] = _jid_peta(ent["user"], ent["server"], ent["device"]);
        n_to["children"] = [n_enc]; n_to["content"] = kosong; n_to["ada_isi"] = benar;

        tambah(n_to_list, n_to);
    }

    buat n_participants = peta_baru();
    n_participants["tag"] = "participants"; n_participants["attrs"] = peta_baru();
    n_participants["children"] = n_to_list; n_participants["content"] = kosong; n_participants["ada_isi"] = benar;

    buat msg_children = [n_participants];
    jika ada_pkmsg {
        buat n_device_identity = peta_baru();
        n_device_identity["tag"] = "device-identity"; n_device_identity["attrs"] = peta_baru();
        n_device_identity["children"] = []; n_device_identity["content"] = account_bytes; n_device_identity["ada_isi"] = benar;
        tambah(msg_children, n_device_identity);
    }

    buat n_enc_grup = peta_baru();
    n_enc_grup["tag"] = "enc"; n_enc_grup["attrs"] = peta_baru();
    n_enc_grup["attrs"]["v"] = "2"; n_enc_grup["attrs"]["type"] = "skmsg";
    n_enc_grup["children"] = []; n_enc_grup["content"] = skmsg_wire; n_enc_grup["ada_isi"] = benar;
    tambah(msg_children, n_enc_grup);

    jika tipe(node_ekstra) == "peta" { tambah(msg_children, node_ekstra); }
    lain jika tipe(node_ekstra) == "larik" {
        untuk (buat nei = 0; nei < panjang(node_ekstra); nei = nei + 1) { tambah(msg_children, node_ekstra[nei]); }
    }

    buat msg_attrs = peta_baru();
    msg_attrs["id"] = msg_id;
    msg_attrs["type"] = "text";
    msg_attrs["to"] = _jid_peta(group_user, "g.us", 0);
    jika tipe(edit_attr) == "teks" && panjang(edit_attr) > 0 { msg_attrs["edit"] = edit_attr; }

    buat msg = peta_baru();
    msg["tag"] = "message"; msg["attrs"] = msg_attrs; msg["children"] = msg_children;
    msg["content"] = kosong; msg["ada_isi"] = benar;
    hasil msg;
}

fungsi BuatNodeRetryKirim(msg_id, msg_t, group_user, participant, enc_wire, enc_type, retry_count, account_bytes, skmsg_wire) {
    buat n_enc = peta_baru();
    n_enc["tag"] = "enc"; n_enc["attrs"] = peta_baru();
    n_enc["attrs"]["v"] = "2"; n_enc["attrs"]["type"] = enc_type;
    n_enc["attrs"]["count"] = ke_teks(retry_count);
    n_enc["children"] = []; n_enc["content"] = enc_wire; n_enc["ada_isi"] = benar;

    buat n_to = peta_baru();
    n_to["tag"] = "to"; n_to["attrs"] = peta_baru();
    n_to["attrs"]["jid"] = _jid_peta(participant["user"], participant["server"], participant["device"]);
    n_to["children"] = [n_enc]; n_to["content"] = kosong; n_to["ada_isi"] = benar;

    buat n_participants = peta_baru();
    n_participants["tag"] = "participants"; n_participants["attrs"] = peta_baru();
    n_participants["children"] = [n_to]; n_participants["content"] = kosong; n_participants["ada_isi"] = benar;

    buat msg_children = [n_participants];
    jika enc_type == "pkmsg" {
        buat n_di = peta_baru();
        n_di["tag"] = "device-identity"; n_di["attrs"] = peta_baru();
        n_di["children"] = []; n_di["content"] = account_bytes; n_di["ada_isi"] = benar;
        tambah(msg_children, n_di);
    }

    buat n_skmsg = peta_baru();
    n_skmsg["tag"] = "enc"; n_skmsg["attrs"] = peta_baru();
    n_skmsg["attrs"]["v"] = "2"; n_skmsg["attrs"]["type"] = "skmsg";
    n_skmsg["children"] = []; n_skmsg["content"] = skmsg_wire; n_skmsg["ada_isi"] = benar;
    tambah(msg_children, n_skmsg);

    buat msg_attrs = peta_baru();
    msg_attrs["id"] = msg_id;
    msg_attrs["type"] = "text";
    msg_attrs["to"] = _jid_peta(group_user, "g.us", 0);
    jika tipe(msg_t) == "teks" && panjang(msg_t) > 0 { msg_attrs["t"] = msg_t; }
    msg_attrs["participant"] = _jid_peta(participant["user"], participant["server"], participant["device"]);

    buat msg = peta_baru();
    msg["tag"] = "message"; msg["attrs"] = msg_attrs; msg["children"] = msg_children;
    msg["content"] = kosong; msg["ada_isi"] = benar;
    hasil msg;
}

fungsi BuatIqUploadPrekeys(req_id, identity_kp, our_registration_id, retry_ctx, jumlah) {
    jika tipe(retry_ctx) != "peta" || !retry_ctx["ada"] { lempar "retry_ctx belum siap (device belum punya material signed-prekey)."; }

    buat prekeys_baru = [];
    untuk (buat i = 0; i < jumlah; i = i + 1) {
        buat kp = KEYS.KeypairBaru();
        buat id = _otp_id_berikutnya();
        ST.SimpanPrekeyPrivat(id, CP["hex_encode"](kp["priv"]));
        buat entri = peta_baru();
        entri["id"] = id; entri["pub"] = kp["pub"];
        tambah(prekeys_baru, entri);
    }

    buat n_reg = peta_baru();
    n_reg["tag"] = "registration"; n_reg["attrs"] = peta_baru(); n_reg["children"] = []; n_reg["content"] = _u32_be_hex(our_registration_id); n_reg["ada_isi"] = benar;
    buat n_type = peta_baru();
    n_type["tag"] = "type"; n_type["attrs"] = peta_baru(); n_type["children"] = []; n_type["content"] = teks_dari(5); n_type["ada_isi"] = benar;
    buat n_ident = peta_baru();
    n_ident["tag"] = "identity"; n_ident["attrs"] = peta_baru(); n_ident["children"] = []; n_ident["content"] = identity_kp["pub"]; n_ident["ada_isi"] = benar;

    buat anak_list = [];
    untuk (buat i = 0; i < panjang(prekeys_baru); i = i + 1) {
        buat p = prekeys_baru[i];
        buat n_id = peta_baru(); n_id["tag"] = "id"; n_id["attrs"] = peta_baru(); n_id["children"] = []; n_id["content"] = _u24_be(p["id"]); n_id["ada_isi"] = benar;
        buat n_val = peta_baru(); n_val["tag"] = "value"; n_val["attrs"] = peta_baru(); n_val["children"] = []; n_val["content"] = p["pub"]; n_val["ada_isi"] = benar;
        buat n_key = peta_baru(); n_key["tag"] = "key"; n_key["attrs"] = peta_baru(); n_key["children"] = [n_id, n_val]; n_key["content"] = kosong; n_key["ada_isi"] = benar;
        tambah(anak_list, n_key);
    }
    buat n_list = peta_baru();
    n_list["tag"] = "list"; n_list["attrs"] = peta_baru(); n_list["children"] = anak_list; n_list["content"] = kosong; n_list["ada_isi"] = benar;

    buat n_skey_id = peta_baru(); n_skey_id["tag"] = "id"; n_skey_id["attrs"] = peta_baru(); n_skey_id["children"] = []; n_skey_id["content"] = _u24_be(retry_ctx["signed_prekey_id"]); n_skey_id["ada_isi"] = benar;
    buat n_skey_val = peta_baru(); n_skey_val["tag"] = "value"; n_skey_val["attrs"] = peta_baru(); n_skey_val["children"] = []; n_skey_val["content"] = retry_ctx["signed_prekey_pub"]; n_skey_val["ada_isi"] = benar;
    buat n_skey_sig = peta_baru(); n_skey_sig["tag"] = "signature"; n_skey_sig["attrs"] = peta_baru(); n_skey_sig["children"] = []; n_skey_sig["content"] = retry_ctx["signed_prekey_sig"]; n_skey_sig["ada_isi"] = benar;
    buat n_skey = peta_baru();
    n_skey["tag"] = "skey"; n_skey["attrs"] = peta_baru(); n_skey["children"] = [n_skey_id, n_skey_val, n_skey_sig]; n_skey["content"] = kosong; n_skey["ada_isi"] = benar;

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id; iq_attrs["to"] = _jid_peta("", "s.whatsapp.net", 0); iq_attrs["type"] = "set"; iq_attrs["xmlns"] = "encrypt";
    buat iq = peta_baru();
    iq["tag"] = "iq"; iq["attrs"] = iq_attrs;
    iq["children"] = [n_reg, n_type, n_ident, n_list, n_skey];
    iq["content"] = kosong; iq["ada_isi"] = benar;
    hasil iq;
}

fungsi DeviceKey(user, server, device) {
    hasil user + "|" + server + "|" + ke_teks(device);
}

fungsi AmbilAtauBangunSesiKirim(identity_kp, bundle_atau_kosong, dk, sessions_cache) {
    buat row = kosong;
    jika tipe(sessions_cache) == "peta" && tipe(sessions_cache[dk]) == "peta" {
        row = sessions_cache[dk];
    } lain {
        row = ST.CariSesiKirim(dk);
    }
    buat r = peta_baru();
    jika tipe(row) == "peta" {
        buat sesi = peta_baru();
        sesi["sending_chain_key"] = CP["hex_decode"](row["sending_chain_key"]);
        sesi["chain_index"] = row["chain_index"];
        buat rkp = peta_baru();
        rkp["priv"] = CP["hex_decode"](row["our_ratchet_priv"]);
        rkp["pub"] = CP["hex_decode"](row["our_ratchet_pub"]);
        sesi["our_sending_ratchet_kp"] = rkp;
        sesi["our_identity_pub"] = CP["hex_decode"](row["our_identity_pub"]);
        sesi["their_identity_pub"] = CP["hex_decode"](row["their_identity_pub"]);
        jika tipe(row["base_pub"]) == "teks" && panjang(row["base_pub"]) > 0 {
            buat bkp = peta_baru();
            bkp["pub"] = CP["hex_decode"](row["base_pub"]);
            sesi["our_base_kp"] = bkp;
            sesi["their_signed_prekey_id"] = row["their_spk_id"];
            jika tipe(row["otp_id"]) == "angka" {
                sesi["pakai_otp"] = benar;
                sesi["onetime_prekey_id"] = row["otp_id"];
            } lain {
                sesi["pakai_otp"] = salah;
            }
        }
        r["sesi"] = sesi;
        r["fresh"] = salah;
        r["acked"] = (row["acked"] == 1);
        hasil r;
    }
    jika tipe(bundle_atau_kosong) != "peta" { lempar "Device belum punya sesi kirim tersimpan DAN gak ada bundle prekey buat bangun baru."; }
    r["sesi"] = bangun_sesi_x3dh(identity_kp, bundle_atau_kosong);
    r["fresh"] = benar;
    r["acked"] = salah;
    hasil r;
}

fungsi EnkripsiPesanKirim(sesi, msg_protobuf) {
    buat wire = enkripsi_pesan_pertama_raw(sesi, msg_protobuf);
    buat chain_key_baru = CP["hex_decode"](hmac_sha256_hex(sesi["sending_chain_key"], teks_dari(2)));
    buat r = peta_baru();
    r["wire"] = wire;
    r["chain_index_baru"] = sesi["chain_index"] + 1;
    r["chain_key_baru_hex"] = CP["hex_encode"](chain_key_baru);
    hasil r;
}

fungsi SimpanSesiKirimBaru(dk, sesi, chain_index_baru, chain_key_baru_hex) {
    buat otp = kosong;
    jika sesi["pakai_otp"] { otp = sesi["onetime_prekey_id"]; }
    ST.SimpanSesiKirim(dk, CP["hex_encode"](sesi["our_identity_pub"]), CP["hex_encode"](sesi["their_identity_pub"]), CP["hex_encode"](sesi["our_sending_ratchet_kp"]["priv"]), CP["hex_encode"](sesi["our_sending_ratchet_kp"]["pub"]), chain_key_baru_hex, chain_index_baru, CP["hex_encode"](sesi["our_base_kp"]["pub"]), sesi["their_signed_prekey_id"], otp);
}

fungsi _jid_teks(j) {
    jika tipe(j) == "teks" { hasil j; }
    jika tipe(j) != "peta" { hasil ""; }
    hasil j["user"] + "@" + j["server"];
}

fungsi BangunContextInfo(kutip) {
    jika tipe(kutip) != "peta" { hasil ""; }
    buat f = "";
    jika tipe(kutip["stanza_id"]) == "teks" { f = f + PB.PbBytes(1, kutip["stanza_id"]); }
    jika tipe(kutip["participant"]) != "kosong" { f = f + PB.PbBytes(2, _jid_teks(kutip["participant"])); }
    jika tipe(kutip["pesan_wire"]) == "teks" { f = f + PB.PbBytes(3, kutip["pesan_wire"]); }
    jika tipe(kutip["remote_jid"]) != "kosong" { f = f + PB.PbBytes(4, _jid_teks(kutip["remote_jid"])); }
    jika tipe(kutip["mention"]) == "larik" {
        untuk (buat i = 0; i < panjang(kutip["mention"]); i = i + 1) {
            f = f + PB.PbBytes(15, _jid_teks(kutip["mention"][i]));
        }
    }
    hasil f;
}

fungsi BangunPesanTeks(teks) {
    hasil PB.PbBytes(1, teks);
}

fungsi BangunPesanTeksExt(teks) {
    hasil PB.PbBytes(6, PB.PbBytes(1, teks));
}

fungsi BangunPesanTeksKutip(teks, kutip) {
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) == 0 { hasil BangunPesanTeks(teks); }
    buat ext = PB.PbBytes(1, teks) + PB.PbBytes(17, ci);
    hasil PB.PbBytes(6, ext);
}

fungsi bangun_pesan_gambar_mentah(up, caption, mimetype, lebar, tinggi, kutip) {
    buat f = PB.PbBytes(1, up["url"]);
    f = f + PB.PbBytes(2, mimetype);
    jika tipe(caption) == "teks" && panjang(caption) > 0 { f = f + PB.PbBytes(3, caption); }
    f = f + PB.PbBytes(4, up["file_sha256"]);
    f = f + PB.PbVarint(5, up["file_length"]);
    jika tipe(tinggi) == "angka" && tinggi > 0 { f = f + PB.PbVarint(6, tinggi); }
    jika tipe(lebar) == "angka" && lebar > 0 { f = f + PB.PbVarint(7, lebar); }
    f = f + PB.PbBytes(8, up["media_key"]);
    f = f + PB.PbBytes(9, up["file_enc_sha256"]);
    jika tipe(up["direct_path"]) == "teks" { f = f + PB.PbBytes(11, up["direct_path"]); }
    f = f + PB.PbVarint(12, waktu());
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil f;
}

fungsi BangunPesanGambar(up, caption, mimetype, lebar, tinggi, kutip, asosiasi) {
    buat wire = PB.PbBytes(3, bangun_pesan_gambar_mentah(up, caption, mimetype, lebar, tinggi, kutip));
    jika tipe(asosiasi) == "teks" && panjang(asosiasi) > 0 { wire = wire + asosiasi; }
    hasil wire;
}

// Nempelin Message.messageContextInfo.messageAssociation (field 35 di
// Message, field 10 di MessageContextInfo) -- ini yang bikin WA client
// ngegabungin beberapa pesan gambar/video jadi satu tampilan album, tiap
// pesan nunjuk balik ke ID pesan AlbumMessage placeholder-nya lewat
// parentMessageKey + urutan (messageIndex). associationType=1 = MEDIA_ALBUM.
fungsi BangunAsosiasiAlbum(remote_jid, msg_id_induk, idx) {
    buat mk = PB.PbBytes(1, remote_jid);
    mk = mk + PB.PbVarint(2, 1);
    mk = mk + PB.PbBytes(3, msg_id_induk);
    buat assoc = PB.PbVarint(1, 1);
    assoc = assoc + PB.PbBytes(2, mk);
    assoc = assoc + PB.PbVarint(3, idx);
    buat mci = PB.PbBytes(10, assoc);
    hasil PB.PbBytes(35, mci);
}

fungsi BangunPesanDokumen(up, nama_file, mimetype, kutip) {
    buat f = PB.PbBytes(1, up["url"]);
    f = f + PB.PbBytes(2, mimetype);
    f = f + PB.PbBytes(3, nama_file);
    f = f + PB.PbBytes(4, up["file_sha256"]);
    f = f + PB.PbVarint(5, up["file_length"]);
    f = f + PB.PbBytes(7, up["media_key"]);
    f = f + PB.PbBytes(8, nama_file);
    f = f + PB.PbBytes(9, up["file_enc_sha256"]);
    jika tipe(up["direct_path"]) == "teks" { f = f + PB.PbBytes(10, up["direct_path"]); }
    f = f + PB.PbVarint(11, waktu());
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(7, f);
}

fungsi BangunPesanAudio(up, mimetype, detik, ptt, kutip) {
    buat f = PB.PbBytes(1, up["url"]);
    f = f + PB.PbBytes(2, mimetype);
    f = f + PB.PbBytes(3, up["file_sha256"]);
    f = f + PB.PbVarint(4, up["file_length"]);
    jika tipe(detik) == "angka" && detik > 0 { f = f + PB.PbVarint(5, detik); }
    jika ptt { f = f + PB.PbVarint(6, 1); }
    f = f + PB.PbBytes(7, up["media_key"]);
    f = f + PB.PbBytes(8, up["file_enc_sha256"]);
    jika tipe(up["direct_path"]) == "teks" { f = f + PB.PbBytes(9, up["direct_path"]); }
    f = f + PB.PbVarint(10, waktu());
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(8, f);
}

fungsi BangunPesanVideo(up, caption, mimetype, detik, kutip, asosiasi) {
    buat f = PB.PbBytes(1, up["url"]);
    f = f + PB.PbBytes(2, mimetype);
    f = f + PB.PbBytes(3, up["file_sha256"]);
    f = f + PB.PbVarint(4, up["file_length"]);
    jika tipe(detik) == "angka" && detik > 0 { f = f + PB.PbVarint(5, detik); }
    f = f + PB.PbBytes(6, up["media_key"]);
    jika tipe(caption) == "teks" && panjang(caption) > 0 { f = f + PB.PbBytes(7, caption); }
    f = f + PB.PbBytes(11, up["file_enc_sha256"]);
    jika tipe(up["direct_path"]) == "teks" { f = f + PB.PbBytes(13, up["direct_path"]); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    buat wire = PB.PbBytes(9, f);
    jika tipe(asosiasi) == "teks" && panjang(asosiasi) > 0 { wire = wire + asosiasi; }
    hasil wire;
}

fungsi _media_dari(f, tag) {
    jika tipe(f[tag]) != "teks" { hasil kosong; }
    buat m = PB.PbDekode(f[tag]);
    buat r = peta_baru();
    r["url"] = m["1"];
    r["mimetype"] = m["2"];
    r["direct_path"] = kosong;
    r["media_key"] = kosong;
    r["file_sha256"] = kosong;
    r["file_enc_sha256"] = kosong;
    r["file_length"] = 0;
    r["caption"] = "";
    r["nama_file"] = kosong;
    r["detik"] = kosong;
    r["lebar"] = kosong;
    r["tinggi"] = kosong;

    jika tag == "3" {
        r["caption"] = m["3"]; r["file_sha256"] = m["4"]; r["file_length"] = m["5"];
        r["tinggi"] = m["6"]; r["lebar"] = m["7"]; r["media_key"] = m["8"];
        r["file_enc_sha256"] = m["9"]; r["direct_path"] = m["11"];
        r["tipe_media"] = "image";
    }
    jika tag == "9" {
        r["file_sha256"] = m["3"]; r["file_length"] = m["4"]; r["detik"] = m["5"];
        r["media_key"] = m["6"]; r["caption"] = m["7"]; r["file_enc_sha256"] = m["11"];
        r["direct_path"] = m["13"];
        r["tipe_media"] = "video";
    }
    jika tag == "8" {
        r["file_sha256"] = m["3"]; r["file_length"] = m["4"]; r["detik"] = m["5"];
        r["media_key"] = m["7"]; r["file_enc_sha256"] = m["8"]; r["direct_path"] = m["9"];
        r["tipe_media"] = "audio";
        jika m["6"] == 1 { r["tipe_media"] = "ptt"; }
    }
    jika tag == "7" {
        r["file_sha256"] = m["4"]; r["file_length"] = m["5"]; r["media_key"] = m["7"];
        r["nama_file"] = m["8"]; r["file_enc_sha256"] = m["9"]; r["direct_path"] = m["10"];
        r["caption"] = m["20"];
        r["tipe_media"] = "document";
    }
    jika tag == "26" {
        r["file_sha256"] = m["2"]; r["file_enc_sha256"] = m["3"]; r["media_key"] = m["4"];
        r["mimetype"] = m["5"]; r["tinggi"] = m["6"]; r["lebar"] = m["7"];
        r["direct_path"] = m["8"]; r["file_length"] = m["9"];
        r["tipe_media"] = "sticker";
    }
    jika tipe(r["caption"]) != "teks" { r["caption"] = ""; }
    jika tipe(r["file_length"]) != "angka" { r["file_length"] = 0; }
    hasil r;
}

fungsi EkstrakBudy(fields) {
    buat b = peta_baru();
    b["ada"] = salah;
    b["body"] = "";
    b["tipe"] = "lain";
    b["mention"] = [];
    b["kutipan"] = kosong;
    b["media"] = kosong;
    b["ada_media"] = salah;
    b["fields"] = fields;

    jika tipe(fields) != "peta" { hasil b; }

    buat f = buka_bungkus(fields);
    b["fields_dalam"] = f;
    b["dibungkus"] = (f != fields);
    b["tipe"] = TipePesan(fields);
    b["body"] = ekstrak_teks(fields);
    b["mention"] = ekstrak_mention(fields);
    b["kutipan"] = ekstrak_kutipan(fields);
    b["ada"] = benar;

    buat tag_media = kosong;
    jika tipe(f["3"]) == "teks"  { tag_media = "3"; }
    jika tipe(f["9"]) == "teks"  { tag_media = "9"; }
    jika tipe(f["8"]) == "teks"  { tag_media = "8"; }
    jika tipe(f["7"]) == "teks"  { tag_media = "7"; }
    jika tipe(f["26"]) == "teks" { tag_media = "26"; }
    jika tipe(tag_media) == "teks" {
        b["media"] = _media_dari(f, tag_media);
        b["ada_media"] = benar;
    }

    jika b["tipe"] == "reaction" {
        buat rf = PB.PbDekode(f["46"]);
        b["reaksi"] = rf["2"];
        b["reaksi_target"] = rf["1"];
    }
    jika b["tipe"] == "pollCreation" {
        buat pf = PB.PbDekode(f["49"]);
        buat op = PB.PbDekodeBerulang(f["49"], "3");
        buat nama_opsi = [];
        untuk (buat i = 0; i < panjang(op); i = i + 1) {
            buat of = PB.PbDekode(op[i]);
            jika tipe(of["1"]) == "teks" { tambah(nama_opsi, of["1"]); }
        }
        b["poll_nama"] = pf["2"];
        b["poll_opsi"] = nama_opsi;
    }
    hasil b;
}

fungsi BangunPesanLokasi(nama, alamat, thumb_jpeg, kutip) {
    buat f = PB.PbFixed64(1, PB.DoubleNol()) + PB.PbFixed64(2, PB.DoubleNol());
    jika tipe(nama) == "teks" && panjang(nama) > 0 { f = f + PB.PbBytes(3, nama); }
    jika tipe(alamat) == "teks" && panjang(alamat) > 0 { f = f + PB.PbBytes(4, alamat); }
    jika tipe(thumb_jpeg) == "teks" && panjang(thumb_jpeg) > 0 { f = f + PB.PbBytes(16, thumb_jpeg); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(5, f);
}

fungsi bangun_ad_reply(judul, isi, thumb_jpeg, thumb_besar, thumb_url, source_url) {
    buat f = "";
    jika tipe(judul) == "teks" && panjang(judul) > 0 { f = f + PB.PbBytes(1, judul); }
    jika tipe(isi) == "teks" && panjang(isi) > 0 { f = f + PB.PbBytes(2, isi); }
    f = f + PB.PbVarint(3, 1);
    jika tipe(thumb_url) == "teks" && panjang(thumb_url) > 0 { f = f + PB.PbBytes(4, thumb_url); }
    jika tipe(thumb_jpeg) == "teks" && panjang(thumb_jpeg) > 0 { f = f + PB.PbBytes(6, thumb_jpeg); }
    jika tipe(source_url) == "teks" && panjang(source_url) > 0 { f = f + PB.PbBytes(9, source_url); }
    jika thumb_besar { f = f + PB.PbVarint(11, 1); }
    hasil f;
}

fungsi BuatNodeBizBypass() {
    buat nf = peta_baru();
    nf["tag"] = "native_flow"; nf["attrs"] = peta_baru();
    nf["attrs"]["v"] = "9"; nf["attrs"]["name"] = "mixed";
    nf["children"] = []; nf["content"] = kosong; nf["ada_isi"] = salah;

    buat it = peta_baru();
    it["tag"] = "interactive"; it["attrs"] = peta_baru();
    it["attrs"]["type"] = "native_flow"; it["attrs"]["v"] = "1";
    it["children"] = [nf]; it["content"] = kosong; it["ada_isi"] = benar;

    buat biz = peta_baru();
    biz["tag"] = "biz"; biz["attrs"] = peta_baru();
    biz["children"] = [it]; biz["content"] = kosong; biz["ada_isi"] = benar;
    hasil biz;
}

fungsi BangunPesanTeksAd(teks, judul, isi_kecil, thumb_jpeg, thumb_besar, kutip, thumb_url, source_url) {
    buat ci = BangunContextInfo(kutip);
    ci = ci + PB.PbBytes(28, bangun_ad_reply(judul, isi_kecil, thumb_jpeg, thumb_besar, thumb_url, source_url));
    buat ext = PB.PbBytes(1, teks) + PB.PbBytes(17, ci);
    hasil PB.PbBytes(6, ext);
}

fungsi BangunPesanPreviewMedia(teks, url_cocok, judul, deskripsi, thumb_jpeg, up, lebar, tinggi, kutip) {
    buat f = PB.PbBytes(1, teks);
    jika tipe(url_cocok) == "teks" && panjang(url_cocok) > 0 { f = f + PB.PbBytes(2, url_cocok); }
    jika tipe(deskripsi) == "teks" && panjang(deskripsi) > 0 { f = f + PB.PbBytes(5, deskripsi); }
    jika tipe(judul) == "teks" && panjang(judul) > 0 { f = f + PB.PbBytes(6, judul); }
    f = f + PB.PbVarint(10, 5);
    jika tipe(thumb_jpeg) == "teks" && panjang(thumb_jpeg) > 0 { f = f + PB.PbBytes(16, thumb_jpeg); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    jika tipe(up) == "peta" {
        f = f + PB.PbBytes(19, up["direct_path"]);
        f = f + PB.PbBytes(20, up["file_sha256"]);
        f = f + PB.PbBytes(21, up["file_enc_sha256"]);
        f = f + PB.PbBytes(22, up["media_key"]);
        f = f + PB.PbVarint(23, waktu());
    }
    jika tipe(tinggi) == "angka" && tinggi > 0 { f = f + PB.PbVarint(24, tinggi); }
    jika tipe(lebar) == "angka" && lebar > 0 { f = f + PB.PbVarint(25, lebar); }
    hasil PB.PbBytes(6, f);
}

fungsi BangunPesanPreview(teks, url_cocok, judul, deskripsi, thumb_jpeg, lebar, tinggi, preview_besar, kutip) {
    buat f = PB.PbBytes(1, teks);
    jika tipe(url_cocok) == "teks" && panjang(url_cocok) > 0 { f = f + PB.PbBytes(2, url_cocok); }
    jika tipe(deskripsi) == "teks" && panjang(deskripsi) > 0 { f = f + PB.PbBytes(5, deskripsi); }
    jika tipe(judul) == "teks" && panjang(judul) > 0 { f = f + PB.PbBytes(6, judul); }
    f = f + PB.PbVarint(10, 5);
    jika tipe(thumb_jpeg) == "teks" && panjang(thumb_jpeg) > 0 { f = f + PB.PbBytes(16, thumb_jpeg); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    jika tipe(tinggi) == "angka" && tinggi > 0 { f = f + PB.PbVarint(24, tinggi); }
    jika tipe(lebar) == "angka" && lebar > 0 { f = f + PB.PbVarint(25, lebar); }
    hasil PB.PbBytes(6, f);
}

fungsi BangunPesanSticker(up, lebar, tinggi, animasi, kutip) {
    buat f = PB.PbBytes(1, up["url"]);
    f = f + PB.PbBytes(2, up["file_sha256"]);
    f = f + PB.PbBytes(3, up["file_enc_sha256"]);
    f = f + PB.PbBytes(4, up["media_key"]);
    f = f + PB.PbBytes(5, "image/webp");
    jika tipe(tinggi) == "angka" && tinggi > 0 { f = f + PB.PbVarint(6, tinggi); }
    jika tipe(lebar) == "angka" && lebar > 0 { f = f + PB.PbVarint(7, lebar); }
    jika tipe(up["direct_path"]) == "teks" { f = f + PB.PbBytes(8, up["direct_path"]); }
    f = f + PB.PbVarint(9, up["file_length"]);
    f = f + PB.PbVarint(10, waktu());
    jika animasi { f = f + PB.PbVarint(13, 1); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(17, ci); }
    hasil PB.PbBytes(26, f);
}

fungsi BangunPesanMintaHistory(chat_jid, oldest_msg_id, oldest_from_me, oldest_ts, count) {
    buat req = PB.PbBytes(1, chat_jid);
    req = req + PB.PbBytes(2, oldest_msg_id);
    jika oldest_from_me { req = req + PB.PbVarint(3, 1); } lain { req = req + PB.PbVarint(3, 0); }
    req = req + PB.PbVarint(4, count);
    req = req + PB.PbVarint(5, oldest_ts);
    buat pdop = PB.PbVarint(1, 3) + PB.PbBytes(4, req);
    buat proto_msg = PB.PbVarint(1, 16) + PB.PbBytes(16, pdop);
    hasil PB.PbBytes(12, proto_msg);
}

fungsi UraiHistorySyncNotification(pm_bytes) {
    buat r = peta_baru();
    r["ok"] = salah;
    buat pm = PB.PbDekode(pm_bytes);
    jika tipe(pm["6"]) != "teks" { hasil r; }
    buat hsn = PB.PbDekode(pm["6"]);
    jika tipe(hsn["3"]) != "teks" || tipe(hsn["5"]) != "teks" { hasil r; }
    r["ok"] = benar;
    r["file_sha256"] = hsn["1"];
    r["media_key"] = hsn["3"];
    r["file_enc_sha256"] = hsn["4"];
    r["direct_path"] = hsn["5"];
    hasil r;
}

fungsi UraiHistorySyncBlob(data) {
    buat r = peta_baru();
    r["conversations"] = [];
    buat conv_list = PB.PbDekodeBerulang(data, "2");
    untuk (buat i = 0; i < panjang(conv_list); i = i + 1) {
        buat cv = PB.PbDekode(conv_list[i]);
        buat conv = peta_baru();
        conv["id"] = cv["1"];
        conv["pesan"] = [];
        buat msg_list = PB.PbDekodeBerulang(conv_list[i], "2");
        untuk (buat j = 0; j < panjang(msg_list); j = j + 1) {
            buat hsm = PB.PbDekode(msg_list[j]);
            jika tipe(hsm["1"]) != "teks" { lanjut; }
            buat wmi = PB.PbDekode(hsm["1"]);
            jika tipe(wmi["1"]) != "teks" { lanjut; }
            buat key = PB.PbDekode(wmi["1"]);
            buat p = peta_baru();
            p["id"] = key["3"];
            p["from_me"] = (key["2"] == 1);
            p["participant"] = key["4"];
            p["timestamp"] = wmi["3"];
            p["message_wire"] = wmi["2"];
            tambah(conv["pesan"], p);
        }
        tambah(r["conversations"], conv);
    }
    hasil r;
}

fungsi BangunTombolNativeFlow(nama, params_json) {
    hasil PB.PbBytes(1, nama) + PB.PbBytes(2, params_json);
}

fungsi BangunPesanTombolLokasi(judul, alamat, isi, footer, tombol_list, thumb_jpeg, kutip) {
    buat loc = PB.PbBytes(3, judul);
    jika tipe(alamat) == "teks" && panjang(alamat) > 0 { loc = loc + PB.PbBytes(4, alamat); }
    jika tipe(thumb_jpeg) == "teks" && panjang(thumb_jpeg) > 0 { loc = loc + PB.PbBytes(16, thumb_jpeg); }

    buat f = PB.PbBytes(5, loc);
    jika tipe(isi) == "teks" && panjang(isi) > 0 { f = f + PB.PbBytes(6, isi); }
    jika tipe(footer) == "teks" && panjang(footer) > 0 { f = f + PB.PbBytes(7, footer); }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(8, ci); }

    untuk (buat i = 0; i < panjang(tombol_list); i = i + 1) {
        buat btn = PB.PbBytes(1, "btn" + ke_teks(i)) + PB.PbBytes(4, tombol_list[i]);
        f = f + PB.PbBytes(9, btn);
    }
    f = f + PB.PbVarint(10, 6);
    hasil PB.PbBytes(42, f);
}

fungsi BangunPesanInteraktif(teks, tombol_list, footer_teks, kutip, header_gambar_up, header_mimetype) {
    buat body = PB.PbBytes(2, PB.PbBytes(1, teks));

    buat nf = "";
    untuk (buat i = 0; i < panjang(tombol_list); i = i + 1) {
        nf = nf + PB.PbBytes(1, tombol_list[i]);
    }
    nf = nf + PB.PbVarint(3, 1);
    buat nf_field = PB.PbBytes(6, nf);

    buat f = body + nf_field;
    jika tipe(header_gambar_up) == "peta" {
        buat img_mentah = bangun_pesan_gambar_mentah(header_gambar_up, kosong, header_mimetype, kosong, kosong, kosong);
        buat header = PB.PbBytes(4, img_mentah);
        header = header + PB.PbVarint(5, 1);
        f = f + PB.PbBytes(1, header);
    }
    jika tipe(footer_teks) == "teks" && panjang(footer_teks) > 0 {
        f = f + PB.PbBytes(3, PB.PbBytes(1, footer_teks));
    }
    buat ci = BangunContextInfo(kutip);
    jika panjang(ci) > 0 { f = f + PB.PbBytes(15, ci); }
    hasil PB.PbBytes(45, f);
}

fungsi _ada_potongan_key(s, cari) {
    jika tipe(s) != "teks" { hasil salah; }
    buat n = panjang(cari);
    untuk (buat i = 0; i + n <= panjang(s); i = i + 1) {
        jika potong(s, i, i + n) == cari { hasil benar; }
    }
    hasil salah;
}

fungsi bangun_message_key(remote_jid, participant, msg_id, dari_saya) {
    buat f = PB.PbBytes(1, remote_jid);
    jika dari_saya { f = f + PB.PbVarint(2, 1); } lain { f = f + PB.PbVarint(2, 0); }
    f = f + PB.PbBytes(3, msg_id);
    buat pt_full = _jid_teks(participant);
    jika panjang(pt_full) > 0 {
        jika !_ada_potongan_key(pt_full, "@") { pt_full = pt_full + "@s.whatsapp.net"; }
        f = f + PB.PbBytes(4, pt_full);
    }
    hasil f;
}

fungsi BangunPesanDisappearing(detik, setting_ts) {
    buat pm = PB.PbVarint(2, 3) + PB.PbVarint(4, detik) + PB.PbVarint(5, setting_ts);
    hasil PB.PbBytes(12, pm);
}

fungsi BangunPesanEdit(remote_jid, msg_id, konten_baru_wire) {
    buat key = bangun_message_key(remote_jid, kosong, msg_id, benar);
    buat pm = PB.PbBytes(1, key)
        + PB.PbVarint(2, 14)
        + PB.PbBytes(14, konten_baru_wire)
        + PB.PbVarint(15, waktu() * 1000);
    buat dalam_message = PB.PbBytes(12, pm);
    buat fpm = PB.PbBytes(1, dalam_message);
    hasil PB.PbBytes(58, fpm);
}

fungsi BangunPesanHapus(remote_jid, participant, msg_id, dari_saya) {
    buat key = bangun_message_key(remote_jid, participant, msg_id, dari_saya);
    buat pm = PB.PbBytes(1, key) + PB.PbVarint(2, 0);
    hasil PB.PbBytes(12, pm);
}

fungsi bangun_pesan_minta_ulang(remote_jid, participant, msg_id, dari_saya) {
    buat key = bangun_message_key(remote_jid, participant, msg_id, dari_saya);
    buat resend_req = PB.PbBytes(1, key);
    buat pdom = PB.PbVarint(1, 4) + PB.PbBytes(5, resend_req);
    buat pm = PB.PbVarint(2, 16) + PB.PbBytes(16, pdom);
    hasil PB.PbBytes(12, pm);
}

fungsi bangun_pesan_pemulihan_appstate(nama_koleksi) {
    buat req = PB.PbBytes(1, nama_koleksi) + PB.PbVarint(2, waktu());
    buat pdom = PB.PbVarint(1, 8) + PB.PbBytes(7, req);
    buat pm = PB.PbVarint(2, 16) + PB.PbBytes(16, pdom);
    hasil PB.PbBytes(12, pm);
}

fungsi BuatIqEphemeralGrup(req_id, group_user, detik) {
    buat anak = [];
    jika detik == 0 {
        buat n_off = peta_baru();
        n_off["tag"] = "not_ephemeral"; n_off["attrs"] = peta_baru();
        n_off["children"] = []; n_off["content"] = kosong; n_off["ada_isi"] = salah;
        tambah(anak, n_off);
    } lain {
        buat n_on = peta_baru();
        n_on["tag"] = "ephemeral"; n_on["attrs"] = peta_baru();
        n_on["attrs"]["expiration"] = ke_teks(detik);
        n_on["children"] = []; n_on["content"] = kosong; n_on["ada_isi"] = salah;
        tambah(anak, n_on);
    }

    buat iq_attrs = peta_baru();
    iq_attrs["id"] = req_id; iq_attrs["to"] = _jid_peta(group_user, "g.us", 0);
    iq_attrs["type"] = "set"; iq_attrs["xmlns"] = "w:g2";

    buat iq = peta_baru();
    iq["tag"] = "iq"; iq["attrs"] = iq_attrs; iq["children"] = anak;
    iq["content"] = kosong; iq["ada_isi"] = benar;
    hasil iq;
}

fungsi urai_disappearing_timer(val) {
    buat r = peta_baru();
    r["ok"] = salah;
    r["detik"] = 0;

    buat v = "";
    untuk (buat i = 0; i < panjang(val); i = i + 1) {
        buat c = potong(val, i, i + 1);
        jika c != " " { v = v + huruf_kecil(c); }
    }

    jika v == "0d" || v == "0h" || v == "0s" || v == "0" || v == "off" {
        r["ok"] = benar; r["detik"] = DISAPPEARING_MATI; hasil r;
    }
    jika v == "1day" || v == "day" || v == "1d" || v == "1" || v == "24h" || v == "24" || v == "86400s" || v == "86400" {
        r["ok"] = benar; r["detik"] = DISAPPEARING_24_JAM; hasil r;
    }
    jika v == "1week" || v == "week" || v == "7d" || v == "7" || v == "168h" || v == "168" || v == "604800s" || v == "604800" {
        r["ok"] = benar; r["detik"] = DISAPPEARING_7_HARI; hasil r;
    }
    jika v == "3months" || v == "3m" || v == "3mo" || v == "90d" || v == "90" || v == "2160h" || v == "2160" || v == "7776000s" || v == "7776000" {
        r["ok"] = benar; r["detik"] = DISAPPEARING_90_HARI; hasil r;
    }
    hasil r;
}

// Pasang contextInfo (stanzaID/participant/quotedMessage) ke sebuah struct
// Message, dipakai SendMessage(msg, {quoted: ctx}). `kutip_ctx` bisa `m`
// (konteks pesan yang lagi diproses) atau `m.quoted` -- keduanya sama-sama
// punya field id/senderJid(atau sender)/message. Kalau msg cuma
// "conversation" (teks polos, gak punya slot contextInfo di proto), otomatis
// di-upgrade jadi extendedTextMessage biar quote-nya kepasang.
fungsi TerapkanKutip(msg, kutip_ctx) {
    jika tipe(msg) != "peta" || tipe(kutip_ctx) != "peta" { hasil msg; }
    buat stanza_id = kutip_ctx["id"];
    buat participant = kutip_ctx["senderJid"];
    jika tipe(participant) != "teks" { participant = kutip_ctx["sender"]; }
    buat quoted_message = kutip_ctx["message"];
    jika tipe(stanza_id) != "teks" || panjang(stanza_id) == 0 || tipe(quoted_message) != "peta" { hasil msg; }

    buat ctx = peta_baru();
    ctx["stanzaID"] = stanza_id;
    jika tipe(participant) == "teks" && panjang(participant) > 0 { ctx["participant"] = participant; }
    ctx["quotedMessage"] = quoted_message;

    jika tipe(msg["conversation"]) == "teks" {
        buat ext = peta_baru();
        ext["text"] = msg["conversation"];
        ext["contextInfo"] = ctx;
        buat baru = peta_baru();
        buat kunci = peta_kunci(msg);
        untuk (buat i = 0; i < panjang(kunci); i = i + 1) {
            jika kunci[i] != "conversation" { baru[kunci[i]] = msg[kunci[i]]; }
        }
        baru["extendedTextMessage"] = ext;
        hasil baru;
    }

    buat kunci2 = peta_kunci(msg);
    untuk (buat i2 = 0; i2 < panjang(kunci2); i2 = i2 + 1) {
        jika tipe(msg[kunci2[i2]]) == "peta" { msg[kunci2[i2]]["contextInfo"] = ctx; }
    }
    hasil msg;
}
