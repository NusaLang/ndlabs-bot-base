
fungsi baru_basic_call_meta() {
    buat m = peta_baru();
    m["from"] = kosong; m["timestamp"] = 0;
    m["call_creator"] = kosong; m["call_creator_alt"] = kosong;
    m["call_id"] = ""; m["group_jid"] = kosong;
    hasil m;
}

fungsi baru_call_remote_meta() {
    buat m = peta_baru();
    m["remote_platform"] = ""; m["remote_version"] = "";
    hasil m;
}
