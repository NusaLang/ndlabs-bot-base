fungsi baru_business_facebook_page() {
    buat m = peta_baru();
    m["id"] = ""; m["display_name"] = ""; m["profile_sync"] = "";
    m["has_active_ctwa_ad"] = salah; m["has_created_ad"] = salah;
    m["profile_picture_url"] = ""; m["show_on_profile"] = salah; m["whatsapp_as_page_button"] = salah;
    hasil m;
}

