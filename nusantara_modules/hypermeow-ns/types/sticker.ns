
fungsi baru_sticker_pack() {
    buat m = peta_baru();
    m["sticker-pack-id"] = ""; m["name"] = ""; m["publisher"] = ""; m["description"] = "";
    m["file-size"] = ""; m["image-data-hash"] = ""; m["stickers"] = [];
    m["animated"] = 0; m["lottie"] = 0; m["preview-image-ids"] = [];
    m["tray-image-id"] = ""; m["tray-image-preview"] = "";
    hasil m;
}

fungsi baru_sticker_pack_item() {
    buat m = peta_baru();
    m["media-key"] = ""; m["enc-file-hash"] = ""; m["file-hash"] = "";
    m["direct-path"] = ""; m["url"] = ""; m["file-size"] = 0; m["mimetype"] = "";
    m["height"] = 0; m["width"] = 0; m["emojis"] = []; m["accessibility-text"] = "";
    m["handle"] = ""; m["sticker-hash-without-meta"] = ""; m["preview-webp-id"] = "";
    hasil m;
}

fungsi sticker_pack_item_direct_path(spi) { hasil spi["direct-path"]; }
fungsi sticker_pack_item_media_key(spi) { hasil spi["media-key"]; }
fungsi sticker_pack_item_file_sha256(spi) { hasil spi["file-hash"]; }
fungsi sticker_pack_item_file_enc_sha256(spi) { hasil spi["enc-file-hash"]; }
fungsi sticker_pack_item_file_size_bytes(spi) { hasil spi["file-size"]; }
