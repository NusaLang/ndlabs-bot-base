fungsi baru_business_product() {
    buat m = peta_baru();
    m["id"] = ""; m["retailer_id"] = ""; m["belongs_to"] = ""; m["name"] = "";
    m["description"] = ""; m["price"] = ""; m["currency"] = ""; m["url"] = ""; m["shimmed_url"] = "";
    m["is_hidden"] = salah; m["is_sanctioned"] = salah; m["max_available"] = 0;
    m["product_availability"] = ""; m["compliance_category"] = ""; m["compliance_info"] = kosong;
    m["media"] = baru_business_product_media(); m["sale_price"] = kosong;
    m["status_info"] = baru_business_product_status(); m["variant_info"] = kosong;
    hasil m;
}

