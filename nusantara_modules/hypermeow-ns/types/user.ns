fungsi baru_verified_name() {
    buat m = peta_baru();
    m["certificate"] = kosong; m["details"] = kosong;
    m["verified_level"] = ""; m["version"] = 0; m["host_storage"] = 0; m["actual_actors"] = 0;
    m["privacy_mode_ts"] = 0;
    hasil m;
}

