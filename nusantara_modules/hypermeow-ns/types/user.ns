}

fungsi baru_set_status_input(teks, emoji_konten, durasi_detik) {
    buat m = peta_baru();
    m["text"] = teks;
    jika emoji_konten == kosong { m["emoji"] = kosong; } lain {
        buat e = peta_baru(); e["content"] = emoji_konten; m["emoji"] = e;
    }
    m["ephemeral_duration_sec"] = durasi_detik;
    hasil m;
}

