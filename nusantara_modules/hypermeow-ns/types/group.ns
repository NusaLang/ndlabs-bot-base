
buat GROUP_MEMBER_ADD_MODE_ADMIN = "admin_add";
buat GROUP_MEMBER_ADD_MODE_ALL_MEMBER = "all_member_add";

buat GROUP_LINK_CHANGE_TYPE_PARENT = "parent_group";
buat GROUP_LINK_CHANGE_TYPE_SUB = "sub_group";
buat GROUP_LINK_CHANGE_TYPE_SIBLING = "sibling_group";

buat GROUP_UNLINK_REASON_DEFAULT = "unlink_group";
buat GROUP_UNLINK_REASON_DELETE = "delete_parent";

fungsi baru_group_membership_approval_mode() {
    buat m = peta_baru();
    m["is_join_approval_required"] = salah;
    hasil m;
}

fungsi baru_group_parent() {
    buat m = peta_baru();
    m["is_parent"] = salah;
    m["default_membership_approval_mode"] = "";
    hasil m;
}

fungsi baru_group_linked_parent() {
    buat m = peta_baru();
    m["linked_parent_jid"] = kosong;
    hasil m;
}

fungsi baru_group_is_default_sub() {
    buat m = peta_baru();
    m["is_default_sub_group"] = salah;
    hasil m;
}

fungsi baru_group_name() {
    buat m = peta_baru();
    m["name"] = ""; m["name_set_at"] = 0; m["name_set_by"] = kosong; m["name_set_by_pn"] = kosong;
    hasil m;
}

fungsi baru_group_topic() {
    buat m = peta_baru();
    m["topic"] = ""; m["topic_id"] = ""; m["topic_set_at"] = 0;
    m["topic_set_by"] = kosong; m["topic_set_by_pn"] = kosong; m["topic_deleted"] = salah;
    hasil m;
}

fungsi baru_group_locked() {
    buat m = peta_baru();
    m["is_locked"] = salah;
    hasil m;
}

fungsi baru_group_announce() {
    buat m = peta_baru();
    m["is_announce"] = salah; m["announce_version_id"] = "";
    hasil m;
}

fungsi baru_group_incognito() {
    buat m = peta_baru();
    m["is_incognito"] = salah;
    hasil m;
}

fungsi baru_group_participant_add_request() {
    buat m = peta_baru();
    m["code"] = ""; m["expiration"] = 0;
    hasil m;
}

fungsi baru_group_participant() {
    buat m = peta_baru();
    m["jid"] = kosong; m["phone_number"] = kosong; m["lid"] = kosong; m["username"] = "";
    m["is_admin"] = salah; m["is_super_admin"] = salah;
    m["display_name"] = "";
    m["error"] = 0; m["add_request"] = kosong;
    hasil m;
}

fungsi baru_group_ephemeral() {
    buat m = peta_baru();
    m["is_ephemeral"] = salah; m["disappearing_timer"] = 0;
    hasil m;
}

fungsi baru_group_delete() {
    buat m = peta_baru();
    m["deleted"] = salah; m["delete_reason"] = "";
    hasil m;
}

fungsi baru_group_link_target() {
    buat m = peta_baru();
    m["jid"] = kosong;
    m["name"] = baru_group_name();
    m["is_default_sub"] = baru_group_is_default_sub();
    hasil m;
}

fungsi baru_group_link_change() {
    buat m = peta_baru();
    m["type"] = "";
    m["unlink_reason"] = "";
    m["group"] = baru_group_link_target();
    hasil m;
}

fungsi baru_group_participant_request() {
    buat m = peta_baru();
    m["jid"] = kosong; m["requested_at"] = 0;
    hasil m;
}

fungsi baru_group_info() {
    buat m = peta_baru();
    m["jid"] = kosong; m["owner_jid"] = kosong; m["owner_pn"] = kosong;
    m["name"] = baru_group_name();
    m["topic"] = baru_group_topic();
    m["locked"] = baru_group_locked();
    m["announce"] = baru_group_announce();
    m["ephemeral"] = baru_group_ephemeral();
    m["incognito"] = baru_group_incognito();
    m["parent"] = baru_group_parent();
    m["linked_parent"] = baru_group_linked_parent();
    m["is_default_sub"] = baru_group_is_default_sub();
    m["membership_approval_mode"] = baru_group_membership_approval_mode();
    m["addressing_mode"] = "";
    m["group_created"] = 0;
    m["creator_country_code"] = "";
    m["participant_version_id"] = "";
    m["participants"] = [];
    m["participant_count"] = 0;
    m["member_add_mode"] = "";
    m["suspended"] = salah;
    hasil m;
}
