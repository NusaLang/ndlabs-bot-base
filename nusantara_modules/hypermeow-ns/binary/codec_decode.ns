
buat T = impor("_token_data.ns");
buat SINGLE = T["SINGLE"];
buat DOUBLE = T["DOUBLE"];

fungsi _rv(t, v) { buat m = peta_baru(); m["t"] = t; m["v"] = v; hasil m; }
fungsi _eos(d, n) { jika d["idx"] + n > panjang(d["data"]) { lempar "unexpected EOF"; } }
fungsi _rb(d) {
    _eos(d, 1);
    buat b = byte_di(d["data"], d["idx"]);
    d["idx"] = d["idx"] + 1;
    hasil b;
}
fungsi _int16(d) {
    _eos(d, 2);
    buat v = byte_di(d["data"], d["idx"]) * 256 + byte_di(d["data"], d["idx"] + 1);
    d["idx"] = d["idx"] + 2;
    hasil v;
}
fungsi _int20(d) {
    _eos(d, 3);
    buat v = (byte_di(d["data"], d["idx"]) % 16) * 65536 + byte_di(d["data"], d["idx"] + 1) * 256 + byte_di(d["data"], d["idx"] + 2);
    d["idx"] = d["idx"] + 3;
    hasil v;
}
fungsi _int32(d) {
    _eos(d, 4);
    buat v = 0;
    untuk (buat i = 0; i < 4; i = i + 1) { v = v * 256 + byte_di(d["data"], d["idx"] + i); }
    d["idx"] = d["idx"] + 4;
    hasil v;
}
fungsi _raw(d, n) {
    _eos(d, n);
    buat s = potong(d["data"], d["idx"], d["idx"] + n);
    d["idx"] = d["idx"] + n;
    hasil s;
}
fungsi _nib_hi(b) {
    buat h = 0;
    untuk (buat k = 1; k < 16; k = k + 1) { jika b >= k * 16 { h = k; } }
    hasil h;
}
fungsi _setengah(x) {
    buat h = 0;
    untuk (buat j = 0; j + 1 < x; j = j + 2) { h = h + 1; }
    hasil h;
}
fungsi _unpack_nibble(v) {
    jika v < 10 { hasil teks_dari(48 + v); }
    jika v == 10 { hasil "-"; }
    jika v == 11 { hasil "."; }
    jika v == 15 { hasil teks_dari(0); }
    lempar "unpackNibble dengan nilai " + ke_teks(v);
}
fungsi _unpack_hex(v) {
    jika v < 10 { hasil teks_dari(48 + v); }
    jika v < 16 { hasil teks_dari(55 + v); }
    lempar "unpackHex dengan nilai " + ke_teks(v);
}
fungsi _unpack_byte(tag, v) {
    jika tag == 255 { hasil _unpack_nibble(v); }
    jika tag == 251 { hasil _unpack_hex(v); }
    lempar "unpackByte dengan tag tak dikenal " + ke_teks(tag);
}
fungsi _packed8(d, tag) {
    buat sb = _rb(d);
    buat cnt = sb % 128;
    buat res = "";
    untuk (buat i = 0; i < cnt; i = i + 1) {
        buat b = _rb(d);
        res = res + _unpack_byte(tag, _nib_hi(b)) + _unpack_byte(tag, b % 16);
    }
    jika sb >= 128 {
        jika panjang(res) == 0 { lempar "packed string punya flag ganjil tanpa data"; }
        res = potong(res, 0, panjang(res) - 1);
    }
    hasil res;
}
fungsi _list_size(d, tag) {
    jika tag == 0 { hasil 0; }
    jika tag == 248 { hasil _rb(d); }
    jika tag == 249 { hasil _int16(d); }
    lempar "readListSize dengan tag tak dikenal " + ke_teks(tag);
}
fungsi _list(d, tag) {
    buat size = _list_size(d, tag);
    buat arr = [];
    untuk (buat i = 0; i < size; i = i + 1) { tambah(arr, _node(d)); }
    hasil arr;
}
fungsi _new_jid(u, s) {
    buat j = peta_baru();
    j["jid"] = benar; j["user"] = u; j["server"] = s; j["device"] = 0; j["agent"] = 0; j["integrator"] = 0;
    hasil j;
}
fungsi _jidpair(d) {
    buat u = _read(d, benar);
    buat us = "";
    jika u["t"] == "kosong" { us = ""; } lain {
        jika u["t"] != "teks" { lempar "tipe JID tidak valid (user)"; }
        us = u["v"];
    }
    buat s = _read(d, benar);
    jika s["t"] != "teks" { lempar "tipe JID tidak valid (server)"; }
    hasil _rv("jid", _new_jid(us, s["v"]));
}
fungsi _fbjid(d) {
    buat u = _read(d, benar);
    jika u["t"] != "teks" { lempar "tipe JID tidak valid (fb user)"; }
    buat dev = _int16(d);
    buat s = _read(d, benar);
    jika s["t"] != "teks" { lempar "tipe JID tidak valid (fb server)"; }
    jika s["v"] != "msgr" { lempar "tipe JID tidak valid: server fb harus msgr"; }
    buat j = _new_jid(u["v"], "msgr");
    j["device"] = dev;
    hasil _rv("jid", j);
}
fungsi _interop(d) {
    buat u = _read(d, benar);
    jika u["t"] != "teks" { lempar "tipe JID tidak valid (interop user)"; }
    buat dev = _int16(d);
    buat integ = _int16(d);
    buat s = _read(d, benar);
    jika s["t"] != "teks" { lempar "tipe JID tidak valid (interop server)"; }
    jika s["v"] != "interop" { lempar "tipe JID tidak valid: server interop harus interop"; }
    buat j = _new_jid(u["v"], "interop");
    j["device"] = dev; j["integrator"] = integ;
    hasil _rv("jid", j);
}
fungsi _adjid(d) {
    buat agent = _rb(d);
    buat dev = _rb(d);
    buat u = _read(d, benar);
    jika u["t"] != "teks" { lempar "tipe JID tidak valid (ad user)"; }
    buat server = ""; buat ag = agent;
    jika agent == 1 { server = "lid"; ag = 0; }
    jika agent == 128 { server = "hosted"; ag = 0; }
    jika agent == 129 { server = "hosted.lid"; ag = 0; }
    jika agent == 0 { server = "s.whatsapp.net"; }
    buat j = _new_jid(u["v"], server);
    j["device"] = dev; j["agent"] = ag;
    hasil _rv("jid", j);
}
fungsi _read(d, mode_teks) {
    buat tag = _rb(d);
    jika tag == 0 { hasil _rv("kosong", kosong); }
    jika tag == 248 { hasil _rv("larik", _list(d, tag)); }
    jika tag == 249 { hasil _rv("larik", _list(d, tag)); }
    jika tag == 252 {
        buat n = _rb(d);
        jika mode_teks { hasil _rv("teks", _raw(d, n)); }
        hasil _rv("bytes", _raw(d, n));
    }
    jika tag == 253 {
        buat n = _int20(d);
        jika mode_teks { hasil _rv("teks", _raw(d, n)); }
        hasil _rv("bytes", _raw(d, n));
    }
    jika tag == 254 {
        buat n = _int32(d);
        jika mode_teks { hasil _rv("teks", _raw(d, n)); }
        hasil _rv("bytes", _raw(d, n));
    }
    jika tag >= 236 {
        jika tag <= 239 {
            buat i = _rb(d);
            buat row = DOUBLE[tag - 236];
            jika i >= panjang(row) { lempar "indeks token ganda di luar jangkauan"; }
            hasil _rv("teks", row[i]);
        }
        jika tag == 245 { hasil _interop(d); }
        jika tag == 246 { hasil _fbjid(d); }
        jika tag == 247 { hasil _adjid(d); }
        jika tag == 250 { hasil _jidpair(d); }
        jika tag == 251 { hasil _rv("teks", _packed8(d, tag)); }
        jika tag == 255 { hasil _rv("teks", _packed8(d, tag)); }
        lempar "token tidak valid " + ke_teks(tag);
    }
    jika tag < panjang(SINGLE) { hasil _rv("teks", SINGLE[tag]); }
    lempar "token tidak valid " + ke_teks(tag);
}
fungsi _attrs(d, n) {
    buat m = peta_baru();
    jika n == 0 { hasil m; }
    untuk (buat i = 0; i < n; i = i + 1) {
        buat k = _read(d, benar);
        jika k["t"] != "teks" { lempar "kunci atribut bukan string"; }
        buat v = _read(d, benar);
        m[k["v"]] = v["v"];
    }
    hasil m;
}
fungsi _node(d) {
    buat size = _rb(d);
    buat ls = _list_size(d, size);
    buat raw = _read(d, benar);
    jika raw["t"] != "teks" { lempar "invalid node"; }
    buat tag = raw["v"];
    jika ls == 0 { lempar "invalid node"; }
    jika tag == "" { lempar "invalid node"; }
    buat n = peta_baru();
    n["tag"] = tag;
    n["attrs"] = _attrs(d, _setengah(ls - 1));
    n["children"] = [];
    n["content"] = kosong;
    n["ada_isi"] = salah;
    n["ctipe"] = "kosong";
    jika ls % 2 == 1 { hasil n; }
    buat c = _read(d, salah);
    jika c["t"] == "larik" {
        n["children"] = c["v"]; n["ada_isi"] = benar; n["ctipe"] = "larik";
    } lain {
        jika c["t"] != "kosong" {
            n["content"] = c["v"]; n["ada_isi"] = benar; n["ctipe"] = c["t"];
        }
    }
    hasil n;
}
fungsi BcUnmarshal(data) {
    buat d = peta_baru();
    d["data"] = data; d["idx"] = 0;
    buat n = _node(d);
    jika d["idx"] != panjang(data) {
        lempar ke_teks(panjang(data) - d["idx"]) + " leftover bytes setelah decoding";
    }
    hasil n;
}
