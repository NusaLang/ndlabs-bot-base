
fungsi buat_message_context(sender_jid, text_content, socket, wa_snapshot) {
    // snapshot dikunci -- socket["WA"] bisa ketimpa pesan lain kalau dibaca belakangan
    jika tipe(wa_snapshot) == "kosong" { wa_snapshot = socket["WA"]; }
    buat msg = peta_baru();
    msg["Sender"] = sender_jid;
    msg["Text"] = text_content;
    msg["Socket"] = socket;
    msg["WA"] = wa_snapshot;
    msg["react"] = fungsi(emoji) {
        jika tipe(wa_snapshot) != "kosong" && tipe(wa_snapshot["react"]) == "fungsi" {
            coba { wa_snapshot["react"](emoji); } tangkap (e) {}
        }
    };
    msg["budy"] = peta_baru();
    jika tipe(wa_snapshot) != "kosong" && tipe(wa_snapshot["budy"]) == "peta" {
        msg["budy"] = wa_snapshot["budy"];
    }

    msg["Reply"] = fungsi(reply_text) {
        cetak("[BOT REPLY TO " + sender_jid + "]: " + reply_text);
        hasil reply_text;
    };

    hasil msg;
}
